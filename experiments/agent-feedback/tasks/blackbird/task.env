REPO=https://github.com/FasterXML/jackson-modules-base
COMMIT=c056b527acc56e6a94f625b8f0e7369e9a107e21
FIX=7638c9d42ff02caceaeba877f03d3859cebc6f06
# The fix is in blackbird. ReaderErrorsDiffTest (blackbird-tests) is the test the fix changed; the three Blackbird tests
# fail before the fix for the same cause and pass after it, unchanged by the fix (their copies in hidden/ are as
# they are at both commits).
MODULES="blackbird-tests"
TESTS="ReaderErrorsDiffTest,BBCodecStockChecksTest,TestBuilders,TestSetterFailures"
MAVEN_ARGS_EXTRA=""
JENESIS_ARGS_EXTRA=""
# Removed for both arms, so that both tools build the same project:
# - the Maven wrapper, so that no arm fetches a Maven of its own;
# - the project's instructions for agents, which name Maven and its commands and would advise one arm only;
# - every module but the three Blackbird ones (prepare.sh takes them out of the reactor), and Blackbird's
#   benchmarks, a project of its own that no reactor builds.
REMOVE="mvnw mvnw.cmd .mvn CLAUDE.md afterburner afterburner-tests android-record guice guice7 jakarta-xmlbind jaxb mrbean
 no-ctor-deser osgi spi-subtypes blackbird/benchmarks"
