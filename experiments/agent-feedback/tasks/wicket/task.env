MAVEN_ARGS_EXTRA=""
JENESIS_ARGS_EXTRA=""
# Modules dropped from the reactor (prepare.sh says why), the project's instructions for agents, which tell an agent
# to build with Maven, and tests that only pass in a module's own folder or with the network:
# WellFormedXmlTest and ApacheLicenceHeaderTest walk the working directory, FormTesterTest and
# MultiFileUploadFieldTest open src/test/... and target/test-classes/... by a relative path,
# ConnectionsTest fetches a URL of wicket.apache.org.
REMOVE="wicket-examples archetypes wicket-user-guide wicket-coverage testing wicket-benchmarks wicket-velocity wicket-migration
