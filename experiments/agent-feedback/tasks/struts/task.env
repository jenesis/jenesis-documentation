REPO=https://github.com/apache/struts
COMMIT=707457f584072113d5c03d5e32d0c481cb20f6a5
FIX=38e3640220f5e194908c4dc168cb24101f989618
# The three modules that hold the hidden tests; the fix is in core and in the plugin stacks of the other two.
MODULES="core,plugins/bean-validation,plugins/rest"
TESTS="HttpMethodInterceptorTest,HttpMethodHierarchyTest,HttpMethodDefaultStacksTest,RestStackHttpMethodEnforcementTest,BeanValidationStackHttpMethodEnforcementTest"
# The first flag lets an offline Maven use a repository another settings file filled. The other two switch off
# checks that are no part of building to test, which Jenesis does not run either.
MAVEN_ARGS_EXTRA="-Daether.enhancedLocalRepository.trackingFilename=_none -Denforcer.skip=true -Dremoteresources.skip=true"
JENESIS_ARGS_EXTRA=""
# Removed for both arms, so that both tools build the same project:
# - the Maven wrapper, so that no arm fetches a Maven of its own;
# - the project's instructions for agents, which name Maven and its commands and would advise one arm only;
# - modules whose content a Maven plugin produces or that depend on such a module (jakarta, velocity, tiles,
#   config-browser, apps, assembly), and two plugins Jenesis does not build or test here (cdi, jasperreports7);
# - test classes that need an environment variable, a module's own folder or class path scanning Jenesis does
#   not offer. NOTES.md names the reason for each.
REMOVE="mvnw mvnw.cmd .mvn AGENTS.md CLAUDE.md .claude jakarta apps assembly plugins/velocity plugins/tiles plugins/config-browser plugins/cdi plugins/jasperreports7
 core/src/test/java/org/apache/struts2/config/providers/EnvsValueSubstitutorTest.java
 core/src/test/java/org/apache/struts2/config/providers/XmlConfigurationProviderEnvsSubstitutionTest.java
 core/src/test/java/org/apache/struts2/config/providers/XmlConfigurationProviderTest.java
 core/src/test/java/org/apache/struts2/views/freemarker/FreemarkerResultMockedTest.java
 core/src/test/java/org/apache/struts2/views/jsp/DynAttribsTest.java
 core/src/test/java/org/apache/struts2/util/fs/JarEntryRevisionTest.java
 plugins/convention/src/test/java/org/apache/struts2/convention/ConventionHttpMethodTest.java
 plugins/convention/src/test/java/org/apache/struts2/convention/ConventionJUnit4Test.java
 plugins/convention/src/test/java/org/apache/struts2/convention/ConventionScopedResultPathTest.java
 plugins/convention/src/test/java/org/apache/struts2/convention/DefaultResultMapBuilderTest.java
 plugins/convention/src/test/java/org/apache/struts2/convention/PackageBasedActionConfigBuilderTest.java
 plugins/jasperreports/src/test/java/org/apache/struts2/views/jasperreports/JasperReportsResultTest.java"
