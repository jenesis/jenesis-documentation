REPO=https://github.com/netty/netty
COMMIT=9bd81544aa5a308d6b5a2efb7a33b0761d82713b
FIX=79baf17ff5e6313b82a299bb16c454d6f9341367
# The module that holds the hidden test; the fix is in transport, the state machine it meets is in common.
MODULES="transport"
TESTS="SingleThreadIoEventLoopTest"
# The flag lets an offline Maven use a repository another settings file filled.
MAVEN_ARGS_EXTRA="-Daether.enhancedLocalRepository.trackingFilename=_none"
JENESIS_ARGS_EXTRA=""
# Removed for both arms, so that both tools build the same project (prepare.sh reduces the reactor to match):
# - the Maven wrapper, and the project's instructions and skills for agents, which name Maven and would advise one
#   arm only; the dev container, docker and release scripts;
# - every module but dev-tools, common, buffer, resolver, transport, testsuite-common and the three stubs: the
#   native transports compile C with make, codec-http2 and handler need an OS classifier and tcnative, the others
#   are codecs, test suites of the packaging (OSGi, shading, JPMS, native image) or examples nothing here needs;
# - one test that asserts on the build rather than the code (NOTES.md).
REMOVE=".claude .devcontainer .mvn AGENTS.md Brewfile all bom codec codec-base codec-classes-quic codec-compression codec-dns codec-haproxy codec-http codec-http2 codec-http3 codec-marshalling codec-memcache codec-mqtt codec-native-quic codec-protobuf codec-redis codec-smtp codec-socks codec-stomp codec-xml docker example handler handler-proxy handler-ssl-ocsp microbench mvnw mvnw.cmd nohttp-checkstyle-suppressions.xml nohttp-checkstyle.xml pkitesting resolver-dns resolver-dns-classes-macos resolver-dns-native-macos run-example.sh scripts testsuite testsuite-autobahn testsuite-http2 testsuite-jpms testsuite-karaf testsuite-native testsuite-native-image testsuite-native-image-client testsuite-native-image-client-runtime-init testsuite-osgi testsuite-shading transport-blockhound-tests transport-classes-epoll transport-classes-io_uring transport-classes-kqueue transport-native-epoll transport-native-io_uring transport-native-kqueue transport-native-unix-common transport-native-unix-common-tests transport-rxtx transport-sctp transport-udt transport/src/test/java/io/netty/channel/NativeImageHandlerMetadataTest.java"
