+    /**
+     * Aborts the connection after an outgoing message entity could not be written
+     * completely. The content output stream must not be closed in this case, as closing
+     * it would terminate the message (e.g. by writing the last chunk) and make a truncated
+     * message look complete to the opposite endpoint.
+     */
+    void abortIncompleteOutgoingEntity(final SocketHolder socketHolder) {
+        try {
+            this.outbuffer.flush(socketHolder.getOutputStream());
+        } catch (final IOException ignore) {
+            // ignore
+        }
+        close(CloseMode.IMMEDIATE);
+    }
