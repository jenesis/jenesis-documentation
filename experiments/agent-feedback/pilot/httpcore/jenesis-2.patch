+        Mockito.when(socket.getOutputStream()).thenReturn(outStream);
+
+        conn.bind(socket);
+
+        final ClassicHttpRequest request = new BasicClassicHttpRequest(Method.POST, "/stuff");
+        request.addHeader("Transfer-Encoding", "chunked");
+        request.setEntity(new InputStreamEntity(failingStream(20000), -1, ContentType.TEXT_PLAIN));
+
+        conn.sendRequestHeader(request);
+        Assertions.assertThrows(EOFException.class, () -> conn.sendRequestEntity(request));
+
+        final String s = new String(outStream.toByteArray(), StandardCharsets.US_ASCII);
+        Assertions.assertFalse(s.endsWith("0\r\n\r\n"));
+        Assertions.assertFalse(conn.isOpen());
+        Assertions.assertFalse(conn.isConsistent());
+    }
+
+    @Test
+    void testWriteRequestEntityChunkCodedEarlyResponse() throws Exception {
+        final ResponseOutOfOrderStrategy strategy = (request, connection, inputStream, totalBytesSent, nextWriteSize) ->
+                totalBytesSent > 0;
+        conn = new DefaultBHttpClientConnection(Http1Config.DEFAULT,
+                null, null,
+                DefaultContentLengthStrategy.INSTANCE,
+                DefaultContentLengthStrategy.INSTANCE,
+                strategy,
+                DefaultHttpRequestWriterFactory.INSTANCE,
+                DefaultHttpResponseParserFactory.INSTANCE);
+
+        final ByteArrayOutputStream outStream = new ByteArrayOutputStream();
+        Mockito.when(socket.getOutputStream()).thenReturn(outStream);
+        Mockito.when(socket.getInputStream()).thenReturn(new ByteArrayInputStream(
+                "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n".getBytes(StandardCharsets.US_ASCII)));
+
+        conn.bind(socket);
+
+        final ClassicHttpRequest request = new BasicClassicHttpRequest(Method.POST, "/stuff");
+        request.addHeader("Transfer-Encoding", "chunked");
+        request.setEntity(new ByteArrayEntity(new byte[100000], ContentType.TEXT_PLAIN, true));
+
+        conn.sendRequestHeader(request);
+        conn.sendRequestEntity(request);
+        conn.flush();
+
+        final String s = new String(outStream.toByteArray(), StandardCharsets.US_ASCII);
+        Assertions.assertFalse(s.endsWith("0\r\n\r\n"));
+        Assertions.assertTrue(conn.isOpen());
+        Assertions.assertFalse(conn.isConsistent());
+        final ClassicHttpResponse response = conn.receiveResponseHeader();
+        Assertions.assertEquals(400, response.getCode());
+    }
+
 }
