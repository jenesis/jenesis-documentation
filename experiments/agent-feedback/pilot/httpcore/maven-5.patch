+    /**
+     * Shuts down the connection after a message could not be written completely,
+     * without terminating the incomplete message, so that the opposite endpoint
+     * can detect the message as truncated.
+     */
+    void abortIncompleteMessage() {
+        final SocketHolder socketHolder = this.socketHolderRef.get();
+        if (socketHolder != null) {
+            try {
+                // Make sure the data written so far reaches the peer (no message terminator is written)
+                this.outbuffer.flush(socketHolder.getOutputStream());
+            } catch (final IOException | RuntimeException ignore) {
+                // best effort
+            }
+        }
+        close(CloseMode.IMMEDIATE);
+    }
