+package com.google.common.collect;
+
+import static com.google.common.collect.Maps.immutableEntry;
+import static org.junit.Assert.assertThrows;
+
+import com.google.common.annotations.GwtIncompatible;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map.Entry;
+import java.util.NavigableMap;
+import java.util.TreeMap;
+import junit.framework.TestCase;
+import org.jspecify.annotations.NullUnmarked;
+
+/** Tests for the navigation methods of {@link Maps#filterEntries} views of a NavigableMap. */
+@GwtIncompatible // NavigableMap
+@NullUnmarked
+public class FilteredNavigableMapTest extends TestCase {
+
+  private static NavigableMap<Integer, String> oneTwoThree() {
+    NavigableMap<Integer, String> map = new TreeMap<>();
+    map.put(1, "one");
+    map.put(2, "two");
+    map.put(3, "three");
+    return map;
+  }
+
+  public void testPollFirstEntry_returnsRemovedMapping() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    NavigableMap<Integer, String> filtered = Maps.filterKeys(unfiltered, k -> k != 1);
+    assertEquals(immutableEntry(2, "two"), filtered.pollFirstEntry());
+    assertEquals(ImmutableMap.of(1, "one", 3, "three"), unfiltered);
+  }
+
+  public void testPollEntries_drain() {
+    NavigableMap<Integer, Integer> unfiltered = new TreeMap<>();
+    for (int i = 0; i < 10; i++) {
+      unfiltered.put(i, i);
+    }
+    NavigableMap<Integer, Integer> filtered = Maps.filterKeys(unfiltered, k -> k % 2 == 1);
+    List<Integer> polled = new ArrayList<>();
+    Entry<Integer, Integer> e;
+    while ((e = filtered.pollFirstEntry()) != null) {
+      polled.add(e.getKey());
+    }
+    assertEquals(ImmutableList.of(1, 3, 5, 7, 9), polled);
+
+    for (int i = 0; i < 10; i++) {
+      unfiltered.put(i, i);
+    }
+    polled.clear();
+    while ((e = filtered.pollLastEntry()) != null) {
+      polled.add(e.getKey());
+    }
+    assertEquals(ImmutableList.of(9, 7, 5, 3, 1), polled);
+  }
+
+  public void testNavigationEntriesAreImmutableSnapshots() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    NavigableMap<Integer, String> filtered =
+        Maps.filterValues(unfiltered, v -> !v.equals("rejected"));
+    List<Entry<Integer, String>> entries = new ArrayList<>();
+    entries.add(filtered.firstEntry());
+    entries.add(filtered.lastEntry());
+    entries.add(filtered.ceilingEntry(2));
+    entries.add(filtered.floorEntry(2));
+    entries.add(filtered.higherEntry(1));
+    entries.add(filtered.lowerEntry(3));
+    entries.add(filtered.descendingMap().firstEntry());
+    entries.add(filtered.headMap(2, true).lastEntry());
+    for (Entry<Integer, String> entry : entries) {
+      Entry<Integer, String> copy = immutableEntry(entry.getKey(), entry.getValue());
+      assertThrows(UnsupportedOperationException.class, () -> entry.setValue("rejected"));
+      assertThrows(UnsupportedOperationException.class, () -> entry.setValue("ok"));
+      assertEquals(copy, entry);
+    }
+    assertEquals(oneTwoThree(), unfiltered);
+    Entry<Integer, String> polled = filtered.pollLastEntry();
+    assertThrows(UnsupportedOperationException.class, () -> polled.setValue("x"));
+  }
+
+  public void testEntrySetEntriesStayLive() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    NavigableMap<Integer, String> filtered =
+        Maps.filterValues(unfiltered, v -> !v.equals("rejected"));
+    Entry<Integer, String> entry = filtered.entrySet().iterator().next();
+    entry.setValue("uno");
+    assertEquals("uno", unfiltered.get(1));
+    assertThrows(IllegalArgumentException.class, () -> entry.setValue("rejected"));
+    Entry<Integer, String> descending = filtered.descendingMap().entrySet().iterator().next();
+    descending.setValue("tres");
+    assertEquals("tres", unfiltered.get(3));
+  }
+}
