+  static <K extends @Nullable Object, V extends @Nullable Object> @Nullable Entry<K, V>
+      snapshotOrNull(@Nullable Entry<K, V> entry) {
+    return (entry == null) ? null : Maps.immutableEntry(entry.getKey(), entry.getValue());
+  }
+
+  /**
+   * Removes the next entry of {@code iterator} and returns a snapshot of it taken <i>before</i> the
+   * removal, since some maps (like {@link java.util.TreeMap}) reuse the removed entry object.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object> @Nullable Entry<K, V>
+      pollSnapshot(Iterator<Entry<K, V>> iterator) {
+    if (!iterator.hasNext()) {
+      return null;
+    }
+    Entry<K, V> result = snapshotOrNull(iterator.next());
+    iterator.remove();
+    return result;
   }
 
