+    unfiltered.put(3, "three");
+    NavigableMap<Integer, String> filtered = Maps.filterValues(unfiltered, v -> v.length() == 3);
+    for (NavigableMap<Integer, String> view :
+        ImmutableList.of(filtered, filtered.descendingMap(), filtered.headMap(3, true))) {
+      for (Entry<Integer, String> e :
+          Lists.newArrayList(
+              view.firstEntry(),
+              view.lastEntry(),
+              view.ceilingEntry(2),
+              view.floorEntry(2),
+              view.higherEntry(1),
+              view.lowerEntry(2))) {
+        if (e == null) {
+          continue;
+        }
+        Entry<Integer, String> snapshot = immutableEntry(e.getKey(), e.getValue());
+        assertThrows(UnsupportedOperationException.class, () -> e.setValue("rejected"));
+        assertEquals(snapshot, e);
+      }
+    }
+    assertEquals(ImmutableMap.of(1, "one", 2, "two", 3, "three"), unfiltered);
+
+    // Entries reached by iteration stay live and validated.
+    Entry<Integer, String> live = filtered.entrySet().iterator().next();
+    assertThrows(IllegalArgumentException.class, () -> live.setValue("rejected"));
+    live.setValue("uno");
+    assertEquals("uno", unfiltered.get(1));
+  }
