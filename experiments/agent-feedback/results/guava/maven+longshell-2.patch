+  private Entry<K, V> checkImmutable(Entry<K, V> entry) {
+    if (entry == null) {
+      return null;
+    }
+    K key = entry.getKey();
+    V value = entry.getValue();
+    assertThrows(UnsupportedOperationException.class, () -> entry.setValue(v3()));
+    assertThrows(UnsupportedOperationException.class, () -> entry.setValue(value));
+    assertEquals(key, entry.getKey());
