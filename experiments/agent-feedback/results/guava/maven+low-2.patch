+        @Nullable Entry<K, V> pollFirstMatching(
+            Iterator<Entry<K, V>> iterator, Predicate<? super Entry<K, V>> predicate) {
+      while (iterator.hasNext()) {
+        Entry<K, V> entry = iterator.next();
+        if (predicate.apply(entry)) {
+          // Snapshot before removing: the backing map may reuse its entry objects on removal.
+          Entry<K, V> snapshot = immutableEntry(entry.getKey(), entry.getValue());
+          iterator.remove();
+          return snapshot;
+        }
+      }
