+    for (NavigableMap<Integer, String> view :
+        ImmutableList.of(filtered, filtered.descendingMap(), filtered.headMap(3, true))) {
+      for (Entry<Integer, String> entry :
+          Arrays.asList(
+              view.firstEntry(),
+              view.lastEntry(),
+              view.ceilingEntry(2),
+              view.floorEntry(2),
+              view.higherEntry(1),
+              view.lowerEntry(2))) {
+        if (entry != null) {
+          assertThrows(UnsupportedOperationException.class, () -> entry.setValue("rejected"));
+        }
+      }
+    }
