+    unfiltered.put(1, "one");
+    unfiltered.put(2, "two");
+    unfiltered.put(3, "three");
+    NavigableMap<Integer, String> filtered = Maps.filterKeys(unfiltered, k -> k != 1);
+    assertEquals(immutableEntry(2, "two"), filtered.pollFirstEntry());
+    assertEquals(ImmutableMap.of(1, "one", 3, "three"), unfiltered);
+
+    NavigableMap<Integer, Integer> numbers = new TreeMap<>();
+    for (int i = 0; i < 10; i++) {
+      numbers.put(i, i);
+    }
+    NavigableMap<Integer, Integer> odd = Maps.filterKeys(numbers, k -> k % 2 == 1);
+    List<Integer> polled = Lists.newArrayList();
+    for (Entry<Integer, Integer> e = odd.pollFirstEntry(); e != null; e = odd.pollFirstEntry()) {
+      assertEquals(e.getKey(), e.getValue());
+      polled.add(e.getKey());
+    }
+    assertEquals(asList(1, 3, 5, 7, 9), polled);
+
+    for (int i = 0; i < 10; i++) {
+      numbers.put(i, i);
+    }
+    polled.clear();
+    for (Entry<Integer, Integer> e = odd.pollLastEntry(); e != null; e = odd.pollLastEntry()) {
+      assertEquals(e.getKey(), e.getValue());
+      polled.add(e.getKey());
+    }
+    assertEquals(asList(9, 7, 5, 3, 1), polled);
+    assertEquals(ImmutableMap.of(0, 0, 2, 2, 4, 4, 6, 6, 8, 8), numbers);
+  }
