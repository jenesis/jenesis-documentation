+  /**
+   * Asserts that {@code entry}, returned by one of the navigation methods, is a snapshot: {@code
+   * setValue} throws {@link UnsupportedOperationException} and neither the entry nor the map
+   * changes. Returns {@code entry}.
+   */
+  private @Nullable Entry<K, V> immutable(@Nullable Entry<K, V> entry) {
+    if (entry == null) {
+      return null;
+    }
+    K key = entry.getKey();
+    V value = entry.getValue();
+    boolean wasPresent = navigableMap.containsKey(key);
+    V mapValue = navigableMap.get(key);
+    for (V newValue : asList(v3(), value)) {
+      assertThrows(UnsupportedOperationException.class, () -> entry.setValue(newValue));
+      assertEquals(key, entry.getKey());
+      assertEquals(value, entry.getValue());
+      assertEquals(wasPresent, navigableMap.containsKey(key));
+      assertEquals(mapValue, navigableMap.get(key));
+    }
+    return entry;
+  }
