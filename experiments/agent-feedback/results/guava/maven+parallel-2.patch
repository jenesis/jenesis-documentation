+  public void testFilteredNavigableMapNavigationEntriesAreSnapshots() {
+    NavigableMap<Integer, String> unfiltered = new TreeMap<>();
+    unfiltered.put(1, "one");
+    unfiltered.put(2, "two");
+    unfiltered.put(3, "three");
+    NavigableMap<Integer, String> filtered = Maps.filterValues(unfiltered, v -> v.length() == 3);
+    List<Entry<Integer, String>> entries =
+        asList(
+            filtered.firstEntry(),
+            filtered.lastEntry(),
+            filtered.ceilingEntry(2),
+            filtered.floorEntry(3),
+            filtered.higherEntry(1),
+            filtered.lowerEntry(3),
+            filtered.descendingMap().firstEntry(),
+            filtered.headMap(3, false).lastEntry(),
+            filtered.pollFirstEntry(),
+            filtered.pollLastEntry());
+    for (Entry<Integer, String> entry : entries) {
+      String value = entry.getValue();
+      assertThrows(UnsupportedOperationException.class, () -> entry.setValue("three"));
+      assertEquals(value, entry.getValue());
+    }
+    assertEquals(ImmutableMap.of(3, "three"), unfiltered);
+
+    // Entry-set entries stay live.
+    unfiltered.put(1, "one");
+    Entry<Integer, String> live = filtered.entrySet().iterator().next();
+    assertThrows(IllegalArgumentException.class, () -> live.setValue("three"));
+    assertEquals("one", live.setValue("uno"));
+    assertEquals("uno", unfiltered.get(1));
+    Entry<Integer, String> liveDescending = filtered.descendingMap().entrySet().iterator().next();
+    assertEquals("uno", liveDescending.setValue("ein"));
+    assertEquals("ein", unfiltered.get(1));
+  }
