+  /**
+   * Returns an immutable snapshot of the given entry, or {@code null} if it is {@code null}. Entries
+   * returned by the single-entry methods of {@link NavigableMap} must be snapshots.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object> @Nullable Entry<K, V>
+      snapshotOrNull(@Nullable Entry<K, V> entry) {
+    return (entry == null) ? null : immutableEntry(entry.getKey(), entry.getValue());
+  }
+
+  /**
+   * Removes the next entry of {@code iterator} and returns a snapshot of it taken <i>before</i> the
+   * removal, as some maps (such as {@link java.util.TreeMap}) reuse the removed entry object.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object> @Nullable Entry<K, V> pollSnapshot(
+      Iterator<Entry<K, V>> iterator) {
+    if (!iterator.hasNext()) {
+      return null;
+    }
+    Entry<K, V> snapshot = snapshotOrNull(iterator.next());
+    iterator.remove();
+    return snapshot;
+  }
+
+  private static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> pollFirstMatching(
+          Iterator<Entry<K, V>> iterator, Predicate<? super Entry<K, V>> predicate) {
+    while (iterator.hasNext()) {
+      Entry<K, V> next = iterator.next();
+      if (predicate.apply(next)) {
+        Entry<K, V> snapshot = immutableEntry(next.getKey(), next.getValue());
+        iterator.remove();
+        return snapshot;
+      }
+    }
+    return null;
+  }
+
