+        Entry<Integer, String> copy = immutableEntry(entry.getKey(), entry.getValue());
+        assertThrows(UnsupportedOperationException.class, () -> entry.setValue("rejected"));
+        assertEquals(copy, entry);
+      }
+    }
+    assertEquals(ImmutableMap.of(1, "one", 2, "two", 3, "three", 4, "four"), unfiltered);
+    Entry<Integer, String> polled = filtered.pollFirstEntry();
+    assertThrows(UnsupportedOperationException.class, () -> polled.setValue("uno"));
+
+    // Iteration still hands out live entries that validate the new value.
+    // (the poll above removed 1, leaving {2=two, 4=four} in the filtered view)
+    Entry<Integer, String> live = filtered.entrySet().iterator().next();
+    assertEquals(Integer.valueOf(2), live.getKey());
+    assertEquals("two", live.setValue("TWO"));
+    assertEquals("TWO", unfiltered.get(2));
+    assertThrows(IllegalArgumentException.class, () -> live.setValue("rejected"));
+    Entry<Integer, String> liveDescending = filtered.descendingMap().entrySet().iterator().next();
+    assertEquals(Integer.valueOf(4), liveDescending.getKey());
+    assertEquals("four", liveDescending.setValue("FOUR"));
+    assertEquals("FOUR", unfiltered.get(4));
+    assertThrows(IllegalArgumentException.class, () -> liveDescending.setValue("rejected"));
+  }
