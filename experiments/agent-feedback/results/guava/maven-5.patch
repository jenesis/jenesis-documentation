+  /**
+   * Returns an immutable snapshot of the next entry of {@code iterator}, or {@code null} if there is
+   * none, removing the entry afterwards if {@code remove} is set. The snapshot is taken before the
+   * removal, since some maps (like {@code TreeMap}) reuse entry objects for other mappings when an
+   * entry is removed.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> snapshotNext(Iterator<Entry<K, V>> iterator, boolean remove) {
+    if (!iterator.hasNext()) {
+      return null;
+    }
+    Entry<K, V> entry = iterator.next();
+    Entry<K, V> snapshot = Maps.immutableEntry(entry.getKey(), entry.getValue());
+    if (remove) {
+      iterator.remove();
+    }
+    return snapshot;
   }
 
