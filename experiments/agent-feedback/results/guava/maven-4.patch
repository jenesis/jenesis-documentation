+  /**
+   * Returns an immutable snapshot of {@code entry}, or {@code null} if it is null. Used by the
+   * navigation methods of {@link NavigableMap} views, which must return snapshot entries.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object> @Nullable Entry<K, V>
+      snapshotOrNull(@Nullable Entry<K, V> entry) {
+    return (entry == null) ? null : immutableEntry(entry.getKey(), entry.getValue());
+  }
+
+  /**
+   * Removes the first entry of {@code iterator} and returns an immutable snapshot of it taken
+   * <i>before</i> removal (some maps, like {@code TreeMap}, reuse entry objects on removal), or
+   * returns {@code null} if the iterator is empty.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object> @Nullable Entry<K, V>
+      pollEntrySnapshot(Iterator<Entry<K, V>> iterator) {
+    if (iterator.hasNext()) {
+      Entry<K, V> result = snapshotOrNull(iterator.next());
+      iterator.remove();
+      return result;
+    }
+    return null;
+  }
+
+  /**
+   * Like {@link #pollEntrySnapshot}, but removes the first entry matching {@code predicate}.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object> @Nullable Entry<K, V>
+      pollFirstMatchingEntrySnapshot(
+          Iterator<Entry<K, V>> iterator, Predicate<? super Entry<K, V>> predicate) {
+    while (iterator.hasNext()) {
+      Entry<K, V> next = iterator.next();
+      if (predicate.apply(next)) {
+        Entry<K, V> result = snapshotOrNull(next);
+        iterator.remove();
+        return result;
+      }
+    }
+    return null;
+  }
