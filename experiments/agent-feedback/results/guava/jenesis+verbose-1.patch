+  /**
+   * Returns an immutable snapshot of the given entry, or {@code null} if it is null, as {@link
+   * NavigableMap} requires of the entries returned by its navigation methods.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> immutableEntryOrNull(@Nullable Entry<K, V> entry) {
+    return (entry == null) ? null : immutableEntry(entry.getKey(), entry.getValue());
+  }
+
+  /**
+   * Removes the next entry of the iterator and returns a snapshot of it taken before the removal,
+   * or returns {@code null} if the iterator has no next entry. The snapshot is taken first because
+   * some maps, such as {@link java.util.TreeMap}, reuse the removed entry object for another
+   * mapping.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> pollNextEntry(Iterator<Entry<K, V>> iterator) {
+    if (iterator.hasNext()) {
+      Entry<K, V> result = immutableEntryOrNull(iterator.next());
+      iterator.remove();
+      return result;
+    }
+    return null;
+  }
+
+  /**
+   * Removes the first entry of the iterator that satisfies the predicate and returns a snapshot of
+   * it taken before the removal, or returns {@code null} if there is no such entry.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> pollFirstMatchingEntry(
+          Iterator<Entry<K, V>> iterator, Predicate<? super Entry<K, V>> predicate) {
+    while (iterator.hasNext()) {
+      Entry<K, V> next = iterator.next();
+      if (predicate.apply(next)) {
+        Entry<K, V> result = immutableEntry(next.getKey(), next.getValue());
+        iterator.remove();
+        return result;
+      }
+    }
+    return null;
+  }
