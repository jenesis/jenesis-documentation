+  /**
+   * Returns an immutable snapshot of the given entry, or {@code null} if it is {@code null}, as
+   * required of the entries returned by the navigation methods of {@link NavigableMap}.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> snapshotOrNull(@Nullable Entry<K, V> entry) {
+    return (entry == null) ? null : immutableEntry(entry.getKey(), entry.getValue());
+  }
+
+  /** Removes and returns a snapshot of the next entry of {@code iterator}, or returns null. */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> pollNextSnapshot(Iterator<Entry<K, V>> iterator) {
+    if (iterator.hasNext()) {
+      // Snapshot before removal: some maps (like TreeMap) reuse the removed entry object.
+      Entry<K, V> result = snapshotOrNull(iterator.next());
+      iterator.remove();
+      return result;
+    }
+    return null;
+  }
+
+  /**
+   * Removes the first entry of {@code iterator} that matches {@code predicate} and returns a
+   * snapshot of it, or returns null if there is none.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> removeFirstMatchingSnapshot(
+          Iterator<Entry<K, V>> iterator, Predicate<? super Entry<K, V>> predicate) {
+    while (iterator.hasNext()) {
+      Entry<K, V> next = iterator.next();
+      if (predicate.apply(next)) {
+        // Snapshot before removal: some maps (like TreeMap) reuse the removed entry object.
+        Entry<K, V> result = immutableEntry(next.getKey(), next.getValue());
+        iterator.remove();
+        return result;
+      }
+    }
+    return null;
+  }
