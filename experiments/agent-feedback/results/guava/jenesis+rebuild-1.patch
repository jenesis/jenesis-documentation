+              view.higherEntry(2),
+              view.lowerEntry(2))) {
+        Entry<Integer, String> before = immutableEntry(entry.getKey(), entry.getValue());
+        assertThrows(UnsupportedOperationException.class, () -> entry.setValue("bad"));
+        assertEquals(before, entry);
+      }
+    }
+    assertEquals(ImmutableMap.of(1, "one", 2, "two", 3, "three"), unfiltered);
+
+    Entry<Integer, String> polled = filtered.pollFirstEntry();
+    assertThrows(UnsupportedOperationException.class, () -> polled.setValue("uno"));
+    assertEquals(immutableEntry(1, "one"), polled);
+
+    // Iteration still hands out live entries.
+    Entry<Integer, String> live = filtered.entrySet().iterator().next();
+    live.setValue("deux");
+    assertEquals("deux", unfiltered.get(2));
+    assertThrows(IllegalArgumentException.class, () -> live.setValue("bad"));
+  }
 }
