+import java.util.TreeMap;
+import junit.framework.TestCase;
+import org.jspecify.annotations.NullMarked;
+
+/** Tests for the entries returned by the navigation methods of filtered {@link NavigableMap}s. */
+@GwtIncompatible
+@NullMarked
+public class FilteredNavigableMapTest extends TestCase {
+
+  private static NavigableMap<Integer, String> oneTwoThree() {
+    NavigableMap<Integer, String> map = new TreeMap<>();
+    map.put(1, "one");
+    map.put(2, "two");
+    map.put(3, "three");
+    return map;
+  }
+
+  public void testPollFirstEntryReturnsRemovedMapping() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    NavigableMap<Integer, String> filtered = Maps.filterKeys(unfiltered, k -> k != 1);
+    assertEquals(immutableEntry(2, "two"), filtered.pollFirstEntry());
+    assertEquals(ImmutableMap.of(1, "one", 3, "three"), unfiltered);
+  }
+
+  public void testPollEntriesDrainInOrder() {
+    NavigableMap<Integer, Integer> unfiltered = new TreeMap<>();
+    for (int i = 0; i < 10; i++) {
+      unfiltered.put(i, i);
+    }
+    NavigableMap<Integer, Integer> filtered = Maps.filterKeys(unfiltered, k -> k % 2 == 1);
+    List<Integer> polled = new ArrayList<>();
+    for (Entry<Integer, Integer> e; (e = filtered.pollFirstEntry()) != null; ) {
+      assertEquals(e.getKey(), e.getValue());
+      polled.add(e.getKey());
+    }
+    assertThat(polled).containsExactly(1, 3, 5, 7, 9).inOrder();
+
+    for (int i = 0; i < 10; i++) {
+      unfiltered.put(i, i);
+    }
+    filtered = Maps.filterKeys(unfiltered, k -> k % 2 == 0);
+    polled.clear();
+    for (Entry<Integer, Integer> e; (e = filtered.pollLastEntry()) != null; ) {
+      assertEquals(e.getKey(), e.getValue());
+      polled.add(e.getKey());
+    }
+    assertThat(polled).containsExactly(8, 6, 4, 2, 0).inOrder();
+    assertThat(unfiltered.keySet()).containsExactly(1, 3, 5, 7, 9).inOrder();
+  }
+
+  private static void assertSnapshot(Entry<Integer, String> expected, Entry<Integer, String> e) {
+    assertEquals(expected, e);
+    assertThrows(UnsupportedOperationException.class, () -> e.setValue("bad"));
+    assertEquals(expected, e);
+  }
+
+  public void testNavigationEntriesAreSnapshots() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    unfiltered.put(4, "four");
+    unfiltered.put(5, "five");
+    NavigableMap<Integer, String> filtered =
+        Maps.filterValues(unfiltered, v -> !v.equals("bad") && !v.equals("one"));
+    assertSnapshot(immutableEntry(2, "two"), filtered.firstEntry());
+    assertSnapshot(immutableEntry(5, "five"), filtered.lastEntry());
+    assertSnapshot(immutableEntry(3, "three"), filtered.ceilingEntry(3));
+    assertSnapshot(immutableEntry(3, "three"), filtered.floorEntry(3));
+    assertSnapshot(immutableEntry(4, "four"), filtered.higherEntry(3));
+    assertSnapshot(immutableEntry(2, "two"), filtered.lowerEntry(3));
+    assertSnapshot(immutableEntry(5, "five"), filtered.descendingMap().firstEntry());
+    assertSnapshot(immutableEntry(2, "two"), filtered.descendingMap().higherEntry(3));
+    assertSnapshot(immutableEntry(3, "three"), filtered.headMap(4, false).lastEntry());
+    assertSnapshot(immutableEntry(2, "two"), filtered.pollFirstEntry());
+    assertSnapshot(immutableEntry(5, "five"), filtered.pollLastEntry());
+    assertEquals(ImmutableMap.of(1, "one", 3, "three", 4, "four"), unfiltered);
+  }
+
+  public void testEntrySetEntriesStayLive() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    NavigableMap<Integer, String> filtered = Maps.filterValues(unfiltered, v -> !v.equals("bad"));
+    Entry<Integer, String> entry = filtered.entrySet().iterator().next();
+    entry.setValue("uno");
+    assertEquals("uno", unfiltered.get(1));
+    assertThrows(IllegalArgumentException.class, () -> entry.setValue("bad"));
+    Entry<Integer, String> descending = filtered.descendingMap().entrySet().iterator().next();
+    descending.setValue("tres");
+    assertEquals("tres", unfiltered.get(3));
+    assertThrows(IllegalArgumentException.class, () -> descending.setValue("bad"));
+  }
+}
