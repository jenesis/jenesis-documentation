+  /** Returns an immutable snapshot of {@code entry}, or {@code null} if it is {@code null}. */
+  static <K extends @Nullable Object, V extends @Nullable Object> @Nullable Entry<K, V> snapshotOrNull(
+      @Nullable Entry<K, V> entry) {
+    return (entry == null) ? null : immutableEntry(entry.getKey(), entry.getValue());
+  }
+
+  /**
+   * Removes the next entry of the iterator and returns an immutable snapshot of it, taken before the
+   * removal (some maps reuse entry objects on removal), or returns {@code null} if there is none.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object> @Nullable Entry<K, V> pollSnapshot(
+      Iterator<Entry<K, V>> iterator) {
+    if (iterator.hasNext()) {
+      Entry<K, V> snapshot = snapshotOrNull(iterator.next());
+      iterator.remove();
+      return snapshot;
+    }
+    return null;
+  }
+
+  /**
+   * Removes the first entry of the iterator that matches the predicate and returns an immutable
+   * snapshot of it, taken before the removal, or returns {@code null} if there is none.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> removeFirstMatchingSnapshot(
+          Iterator<Entry<K, V>> iterator, Predicate<? super Entry<K, V>> predicate) {
+    while (iterator.hasNext()) {
+      Entry<K, V> next = iterator.next();
+      if (predicate.apply(next)) {
+        Entry<K, V> snapshot = snapshotOrNull(next);
+        iterator.remove();
+        return snapshot;
+      }
+    }
+    return null;
+  }
