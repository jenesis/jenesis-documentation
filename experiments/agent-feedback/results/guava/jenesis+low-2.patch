+    assertEquals(immutableEntry(1, "v1"), first);
+    assertThrows(UnsupportedOperationException.class, () -> first.setValue("x"));
+    assertEquals(immutableEntry(9, "v9"), filtered.pollLastEntry());
+    assertEquals(immutableEntry(3, "v3"), filtered.pollFirstEntry());
+
+    NavigableMap<Integer, String> byValue = Maps.filterValues(unfiltered, v -> !v.equals("v4"));
+    Entry<Integer, String> ceiling = byValue.ceilingEntry(4);
+    assertEquals(immutableEntry(5, "v5"), ceiling);
+    assertThrows(UnsupportedOperationException.class, () -> ceiling.setValue("v4"));
+    assertThrows(
