+  /**
+   * Returns an immutable snapshot of {@code entry}, as {@link NavigableMap} requires of the entries
+   * returned by its navigation methods.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> snapshotOrNull(@Nullable Entry<K, V> entry) {
+    return (entry == null) ? null : Maps.immutableEntry(entry.getKey(), entry.getValue());
+  }
+
+  /**
+   * Removes the next element of {@code iterator} and returns a snapshot of it. The snapshot is taken
+   * before the removal, since some maps (like {@link java.util.TreeMap}) reuse the removed entry
+   * object for another mapping.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> pollSnapshot(Iterator<Entry<K, V>> iterator) {
+    if (!iterator.hasNext()) {
+      return null;
+    }
+    Entry<K, V> result = snapshotOrNull(iterator.next());
+    iterator.remove();
+    return result;
   }
 
