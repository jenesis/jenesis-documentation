+  /**
+   * Returns an immutable snapshot of the given entry, as {@link NavigableMap} specifies for the
+   * entries returned by its navigation methods, or {@code null} if the entry is {@code null}.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object> @Nullable Entry<K, V>
+      snapshotOrNull(@Nullable Entry<K, V> entry) {
+    return (entry == null) ? null : immutableEntry(entry.getKey(), entry.getValue());
+  }
+
+  /**
+   * Removes the next entry of the iterator and returns a snapshot of it taken before the removal,
+   * or returns {@code null} if the iterator has no next entry. The snapshot is taken first because
+   * some maps (such as {@link java.util.TreeMap}) reuse the entry object of a removed mapping.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object> @Nullable Entry<K, V>
+      pollSnapshot(Iterator<Entry<K, V>> iterator) {
+    if (iterator.hasNext()) {
+      Entry<K, V> result = snapshotOrNull(iterator.next());
+      iterator.remove();
+      return result;
+    }
+    return null;
+  }
+
+  /**
+   * Like {@link #pollSnapshot}, but removes the first entry matching the predicate.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object> @Nullable Entry<K, V>
+      removeFirstMatchingSnapshot(
+          Iterator<Entry<K, V>> iterator, Predicate<? super Entry<K, V>> predicate) {
+    while (iterator.hasNext()) {
+      Entry<K, V> next = iterator.next();
+      if (predicate.apply(next)) {
+        Entry<K, V> result = snapshotOrNull(next);
+        iterator.remove();
+        return result;
+      }
+    }
+    return null;
+  }
