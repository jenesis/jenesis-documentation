+  /**
+   * Returns an immutable snapshot of the given entry, or {@code null}. Navigation methods of {@link
+   * NavigableMap} must return snapshots, and the entry objects of a backing map may be reused by
+   * it (as {@link java.util.TreeMap} does upon removal).
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> snapshotOrNull(@Nullable Entry<K, V> entry) {
+    return (entry == null) ? null : immutableEntry(entry.getKey(), entry.getValue());
+  }
+
+  /**
+   * Removes the next entry of the iterator, returning an immutable snapshot of it taken before the
+   * removal, or {@code null} if the iterator has no more entries.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> pollSnapshot(Iterator<Entry<K, V>> iterator) {
+    if (!iterator.hasNext()) {
+      return null;
+    }
+    Entry<K, V> snapshot = snapshotOrNull(iterator.next());
+    iterator.remove();
+    return snapshot;
+  }
+
+  /**
+   * Removes the first entry of the iterator matching the predicate, returning an immutable snapshot
+   * of it taken before the removal, or {@code null} if no entry matches.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> pollFirstMatchingSnapshot(
+          Iterator<Entry<K, V>> iterator, Predicate<? super Entry<K, V>> predicate) {
+    checkNotNull(predicate);
+    while (iterator.hasNext()) {
+      Entry<K, V> next = iterator.next();
+      if (predicate.apply(next)) {
+        Entry<K, V> snapshot = snapshotOrNull(next);
+        iterator.remove();
+        return snapshot;
+      }
+    }
+    return null;
+  }
