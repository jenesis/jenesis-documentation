+    unfiltered.put(2, "two");
+    unfiltered.put(3, "three");
+    NavigableMap<Integer, String> filtered = Maps.filterValues(unfiltered, v -> !v.equals("bad"));
+    List<Entry<Integer, String>> entries =
+        asList(
+            filtered.firstEntry(),
+            filtered.lastEntry(),
+            filtered.ceilingEntry(2),
+            filtered.floorEntry(2),
+            filtered.higherEntry(1),
+            filtered.lowerEntry(3),
+            filtered.descendingMap().firstEntry(),
+            filtered.headMap(3, true).lastEntry());
+    for (Entry<Integer, String> entry : entries) {
+      String value = entry.getValue();
+      assertThrows(UnsupportedOperationException.class, () -> entry.setValue("bad"));
+      assertEquals(value, entry.getValue());
+    }
+    assertEquals(ImmutableMap.of(1, "one", 2, "two", 3, "three"), unfiltered);
+
+    // Entries of the entry set stay live.
+    Entry<Integer, String> live = filtered.entrySet().iterator().next();
+    assertThrows(IllegalArgumentException.class, () -> live.setValue("bad"));
+    live.setValue("uno");
+    assertEquals("uno", unfiltered.get(1));
+  }
