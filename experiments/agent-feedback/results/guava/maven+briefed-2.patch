+  /**
+   * Returns an immutable snapshot of {@code entry}, or {@code null} if it is {@code null}. Used by
+   * the {@link NavigableMap} navigation methods, which must return snapshots that do not support
+   * {@code setValue}.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> snapshotOrNull(@Nullable Entry<K, V> entry) {
+    return (entry == null) ? null : immutableEntry(entry.getKey(), entry.getValue());
+  }
+
+  /**
+   * Removes the next entry of {@code iterator} and returns a snapshot of it taken <i>before</i> the
+   * removal (some maps, like {@code TreeMap}, reuse the removed entry object for another mapping),
+   * or returns {@code null} if the iterator is exhausted.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> pollSnapshot(Iterator<Entry<K, V>> iterator) {
+    if (iterator.hasNext()) {
+      Entry<K, V> result = snapshotOrNull(iterator.next());
+      iterator.remove();
+      return result;
+    }
+    return null;
+  }
+
+  /**
+   * Removes the first entry of {@code iterator} that satisfies {@code predicate} and returns a
+   * snapshot of it taken before the removal, or returns {@code null} if there is none.
+   */
+  @GwtIncompatible // NavigableMap
+  private static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> pollFirstMatchingSnapshot(
+          Iterator<Entry<K, V>> iterator, Predicate<? super Entry<K, V>> predicate) {
+    while (iterator.hasNext()) {
+      Entry<K, V> next = iterator.next();
+      if (predicate.apply(next)) {
+        Entry<K, V> result = immutableEntry(next.getKey(), next.getValue());
+        iterator.remove();
+        return result;
+      }
+    }
+    return null;
+  }
