+package com.google.common.collect;
+
+import static com.google.common.truth.Truth.assertThat;
+import static org.junit.Assert.assertThrows;
+
+import com.google.common.annotations.GwtIncompatible;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map.Entry;
+import java.util.NavigableMap;
+import java.util.TreeMap;
+import junit.framework.TestCase;
+import org.jspecify.annotations.NullMarked;
+
+/** Tests the entries returned by the navigation methods of filtered {@link NavigableMap} views. */
+@GwtIncompatible // NavigableMap
+@NullMarked
+public class FilteredNavigableMapTest extends TestCase {
+
+  private static NavigableMap<Integer, String> oneTwoThree() {
+    NavigableMap<Integer, String> map = new TreeMap<>();
+    map.put(1, "one");
+    map.put(2, "two");
+    map.put(3, "three");
+    return map;
+  }
+
+  public void testPollFirstEntry_returnsRemovedMapping() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    NavigableMap<Integer, String> filtered = Maps.filterKeys(unfiltered, k -> k != 1);
+    Entry<Integer, String> polled = filtered.pollFirstEntry();
+    assertThat(polled).isEqualTo(Maps.immutableEntry(2, "two"));
+    assertThat(unfiltered).containsExactly(1, "one", 3, "three").inOrder();
+  }
+
+  public void testPollLastEntry_returnsRemovedMapping() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    NavigableMap<Integer, String> filtered = Maps.filterKeys(unfiltered, k -> k != 3);
+    assertThat(filtered.pollLastEntry()).isEqualTo(Maps.immutableEntry(2, "two"));
+    assertThat(unfiltered).containsExactly(1, "one", 3, "three").inOrder();
+  }
+
+  public void testPollFirstEntry_drain() {
+    NavigableMap<Integer, Integer> unfiltered = new TreeMap<>();
+    for (int i = 0; i < 10; i++) {
+      unfiltered.put(i, i);
+    }
+    NavigableMap<Integer, Integer> filtered = Maps.filterKeys(unfiltered, k -> k % 2 == 1);
+    List<Integer> polled = new ArrayList<>();
+    for (Entry<Integer, Integer> e; (e = filtered.pollFirstEntry()) != null; ) {
+      polled.add(e.getKey());
+    }
+    assertThat(polled).containsExactly(1, 3, 5, 7, 9).inOrder();
+    assertThat(unfiltered.keySet()).containsExactly(0, 2, 4, 6, 8).inOrder();
+  }
+
+  public void testNavigationEntriesAreSnapshots() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    NavigableMap<Integer, String> filtered = Maps.filterValues(unfiltered, v -> v.length() == 3);
+    List<Entry<Integer, String>> entries = new ArrayList<>();
+    entries.add(filtered.firstEntry());
+    entries.add(filtered.lastEntry());
+    entries.add(filtered.ceilingEntry(2));
+    entries.add(filtered.floorEntry(2));
+    entries.add(filtered.higherEntry(1));
+    entries.add(filtered.lowerEntry(3));
+    entries.add(filtered.descendingMap().firstEntry());
+    entries.add(filtered.headMap(2, true).lastEntry());
+    for (Entry<Integer, String> entry : entries) {
+      String before = entry.getValue();
+      assertThrows(UnsupportedOperationException.class, () -> entry.setValue("rejected"));
+      assertThat(entry.getValue()).isEqualTo(before);
+    }
+    assertThat(unfiltered).isEqualTo(oneTwoThree());
+  }
+
+  public void testEntrySetEntriesAreLive() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    NavigableMap<Integer, String> filtered = Maps.filterValues(unfiltered, v -> v.length() == 3);
+    Entry<Integer, String> entry = filtered.entrySet().iterator().next();
+    assertThrows(IllegalArgumentException.class, () -> entry.setValue("rejected"));
+    entry.setValue("uno");
+    assertThat(unfiltered).containsEntry(1, "uno");
+    Entry<Integer, String> last = filtered.descendingMap().entrySet().iterator().next();
+    last.setValue("dos");
+    assertThat(unfiltered).containsEntry(2, "dos");
+  }
+
+  public void testForwardingStandardPollFirstEntry() {
+    NavigableMap<Integer, String> backing = oneTwoThree().tailMap(2, true);
+    NavigableMap<Integer, String> forwarding =
+        new ForwardingNavigableMap<Integer, String>() {
+          @Override
+          protected NavigableMap<Integer, String> delegate() {
+            return backing;
+          }
+
+          @Override
+          public Entry<Integer, String> pollFirstEntry() {
+            return standardPollFirstEntry();
+          }
+
+          @Override
+          public Entry<Integer, String> firstEntry() {
+            return standardFirstEntry();
+          }
+        };
+    Entry<Integer, String> first = forwarding.firstEntry();
+    assertThrows(UnsupportedOperationException.class, () -> first.setValue("x"));
+    assertThat(forwarding.pollFirstEntry()).isEqualTo(Maps.immutableEntry(2, "two"));
+  }
+}
