+  public void testFilteredNavigableMapNavigationEntriesAreSnapshots() {
+    NavigableMap<Integer, String> unfiltered = new TreeMap<>();
+    unfiltered.put(1, "one");
+    unfiltered.put(2, "two");
+    unfiltered.put(3, "three");
+    NavigableMap<Integer, String> filtered = Maps.filterValues(unfiltered, v -> v.length() == 3);
+    List<NavigableMap<Integer, String>> views =
+        asList(filtered, filtered.descendingMap(), filtered.headMap(3, true));
+    for (NavigableMap<Integer, String> view : views) {
+      List<Entry<Integer, String>> results =
+          asList(
+              view.firstEntry(),
+              view.lastEntry(),
+              view.ceilingEntry(2),
+              view.floorEntry(2),
+              view.higherEntry(1),
+              view.lowerEntry(2));
+      for (Entry<Integer, String> entry : results) {
+        if (entry == null) {
+          continue;
+        }
+        Entry<Integer, String> before = immutableEntry(entry.getKey(), entry.getValue());
+        assertThrows(UnsupportedOperationException.class, () -> entry.setValue("rejected"));
+        assertEquals(before, entry);
+      }
+    }
+    assertEquals(ImmutableMap.of(1, "one", 2, "two", 3, "three"), unfiltered);
+
+    // Iteration still hands out live entries.
+    Entry<Integer, String> live = filtered.entrySet().iterator().next();
+    assertThrows(IllegalArgumentException.class, () -> live.setValue("rejected"));
+    live.setValue("uno");
+    assertEquals("uno", unfiltered.get(1));
+  }
