+  public void testFilteredNavigableMapNavigationEntriesAreSnapshots() {
+    NavigableMap<Integer, String> unfiltered = new TreeMap<>();
+    unfiltered.put(1, "one");
+    unfiltered.put(2, "two");
+    unfiltered.put(3, "three");
+    unfiltered.put(4, "four");
+    NavigableMap<Integer, String> filtered = Maps.filterValues(unfiltered, v -> v.length() == 3);
+    List<Entry<Integer, String>> entries =
+        asList(
+            filtered.firstEntry(),
+            filtered.lastEntry(),
+            filtered.ceilingEntry(2),
+            filtered.floorEntry(2),
+            filtered.higherEntry(1),
+            filtered.lowerEntry(2),
+            filtered.descendingMap().firstEntry(),
+            filtered.headMap(3, true).lastEntry());
+    for (Entry<Integer, String> entry : entries) {
+      Entry<Integer, String> expected = immutableEntry(entry.getKey(), entry.getValue());
+      assertThrows(UnsupportedOperationException.class, () -> entry.setValue("x"));
+      assertThrows(UnsupportedOperationException.class, () -> entry.setValue("six"));
+      assertEquals(expected, entry);
+    }
+    Entry<Integer, String> polled = filtered.pollLastEntry();
+    assertEquals(immutableEntry(2, "two"), polled);
+    assertThrows(UnsupportedOperationException.class, () -> polled.setValue("six"));
+    assertEquals(ImmutableMap.of(1, "one", 3, "three", 4, "four"), unfiltered);
+
+    // Entries met during iteration stay live and check the predicate.
+    Entry<Integer, String> live = filtered.entrySet().iterator().next();
+    assertEquals("one", live.setValue("uno"));
+    assertEquals("uno", unfiltered.get(1));
+    assertThrows(IllegalArgumentException.class, () -> live.setValue("x"));
+    Entry<Integer, String> liveDescending = filtered.descendingMap().entrySet().iterator().next();
+    assertEquals("uno", liveDescending.setValue("ein"));
+    assertEquals("ein", unfiltered.get(1));
+  }
