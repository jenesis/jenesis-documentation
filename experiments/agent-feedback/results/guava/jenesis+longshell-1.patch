+    for (int i = 0; i < 10; i++) {
+      drained.put(i, "v" + i);
+    }
+    NavigableMap<Integer, String> even = Maps.filterKeys(drained, k -> k % 2 == 0);
+    List<Integer> polledLast = new java.util.ArrayList<>();
+    for (Entry<Integer, String> e; (e = even.pollLastEntry()) != null; ) {
+      polledLast.add(e.getKey());
+      assertEquals("v" + e.getKey(), e.getValue());
+    }
+    assertEquals(asList(8, 6, 4, 2, 0), polledLast);
+  }
