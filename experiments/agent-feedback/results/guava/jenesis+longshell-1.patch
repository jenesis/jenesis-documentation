+  /**
+   * Returns an immutable snapshot of {@code entry}, or {@code null} if it is {@code null}. Unlike
+   * {@link #unmodifiableOrNull}, the result does not reflect later changes to {@code entry}.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> immutableEntryOrNull(@Nullable Entry<K, ? extends V> entry) {
+    return (entry == null) ? null : Maps.<K, V>immutableEntry(entry.getKey(), entry.getValue());
+  }
+
+  /**
+   * Returns an immutable snapshot of the next element of {@code iterator} that satisfies {@code
+   * predicate} and removes that element, or returns {@code null} if there is none. The snapshot is
+   * taken before the removal, as removing may reuse the entry object for another mapping.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> pollFirstMatchingSnapshot(
+          Iterator<Entry<K, V>> iterator, Predicate<? super Entry<K, V>> predicate) {
+    while (iterator.hasNext()) {
+      Entry<K, V> next = iterator.next();
+      if (predicate.apply(next)) {
+        Entry<K, V> snapshot = immutableEntry(next.getKey(), next.getValue());
+        iterator.remove();
+        return snapshot;
+      }
+    }
+    return null;
+  }
+
