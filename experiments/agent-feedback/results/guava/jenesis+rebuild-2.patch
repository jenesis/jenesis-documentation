+  /**
+   * Returns an immutable snapshot of {@code entry}, as {@link NavigableMap} specifies for the
+   * entries returned by its navigation methods, or {@code null} if {@code entry} is null.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> snapshotOrNull(@Nullable Entry<K, V> entry) {
+    return (entry == null) ? null : immutableEntry(entry.getKey(), entry.getValue());
+  }
+
+  /**
+   * Removes the first entry of {@code iterator} that matches {@code predicate} and returns an
+   * immutable snapshot of it, taken before the removal, or {@code null} if no entry matches.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> pollFirstMatchingSnapshot(
+          Iterator<Entry<K, V>> iterator, Predicate<? super Entry<K, V>> predicate) {
+    while (iterator.hasNext()) {
+      Entry<K, V> next = iterator.next();
+      if (predicate.apply(next)) {
+        Entry<K, V> snapshot = immutableEntry(next.getKey(), next.getValue());
+        iterator.remove();
+        return snapshot;
+      }
+    }
+    return null;
+  }
+
+  /**
+   * Removes the next entry of {@code iterator} and returns an immutable snapshot of it, taken
+   * before the removal, or {@code null} if the iterator has no next entry.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> pollNextSnapshot(Iterator<Entry<K, V>> iterator) {
+    if (iterator.hasNext()) {
+      Entry<K, V> next = iterator.next();
+      Entry<K, V> snapshot = immutableEntry(next.getKey(), next.getValue());
+      iterator.remove();
+      return snapshot;
+    }
+    return null;
+  }
