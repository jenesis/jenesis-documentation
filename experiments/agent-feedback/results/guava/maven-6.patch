+  /**
+   * Returns an immutable snapshot of {@code entry}, or {@code null} if {@code entry} is null, as
+   * required of the entries returned by the navigation methods of {@link NavigableMap}.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> snapshotOrNull(@Nullable Entry<K, V> entry) {
+    return (entry == null) ? null : immutableEntry(entry.getKey(), entry.getValue());
+  }
+
+  /**
+   * Removes the next element of {@code iterator} that satisfies {@code predicate} and returns an
+   * immutable snapshot of it, taken before its removal; returns {@code null} if there is none.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> pollFirstMatchingSnapshot(
+          Iterator<Entry<K, V>> iterator, Predicate<? super Entry<K, V>> predicate) {
+    while (iterator.hasNext()) {
+      Entry<K, V> next = iterator.next();
+      if (predicate.apply(next)) {
+        Entry<K, V> snapshot = immutableEntry(next.getKey(), next.getValue());
+        iterator.remove();
+        return snapshot;
+      }
+    }
+    return null;
+  }
+
   static <K extends @Nullable Object> @Nullable K keyOrNull(@Nullable Entry<K, ?> entry) {
     return (entry == null) ? null : entry.getKey();
   }
