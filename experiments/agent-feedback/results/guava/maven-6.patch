+package com.google.common.collect;
+
+import static com.google.common.truth.Truth.assertThat;
+import static org.junit.Assert.assertThrows;
+
+import com.google.common.annotations.GwtIncompatible;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map.Entry;
+import java.util.NavigableMap;
+import java.util.TreeMap;
+import junit.framework.TestCase;
+import org.jspecify.annotations.NullMarked;
+
+/** Tests for the entries returned by navigation methods of filtered {@link NavigableMap} views. */
+@GwtIncompatible
+@NullMarked
+public class FilteredNavigableMapTest extends TestCase {
+
+  private static NavigableMap<Integer, String> oneTwoThree() {
+    NavigableMap<Integer, String> map = new TreeMap<>();
+    map.put(1, "one");
+    map.put(2, "two");
+    map.put(3, "three");
+    return map;
+  }
+
+  public void testPollFirstEntryReturnsRemovedMapping() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    NavigableMap<Integer, String> filtered = Maps.filterKeys(unfiltered, k -> k != 1);
+    Entry<Integer, String> polled = filtered.pollFirstEntry();
+    assertEquals(Maps.immutableEntry(2, "two"), polled);
+    assertEquals(ImmutableMap.of(1, "one", 3, "three"), unfiltered);
+    assertThrows(UnsupportedOperationException.class, () -> polled.setValue("x"));
+  }
+
+  public void testPollLastEntryReturnsRemovedMapping() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    NavigableMap<Integer, String> filtered = Maps.filterKeys(unfiltered, k -> k != 3);
+    assertEquals(Maps.immutableEntry(2, "two"), filtered.pollLastEntry());
+    assertEquals(ImmutableMap.of(1, "one", 3, "three"), unfiltered);
+  }
+
+  public void testDrainWithPollFirstEntry() {
+    NavigableMap<Integer, String> unfiltered = new TreeMap<>();
+    for (int i = 0; i < 10; i++) {
+      unfiltered.put(i, "v" + i);
+    }
+    NavigableMap<Integer, String> filtered = Maps.filterKeys(unfiltered, k -> k % 2 == 1);
+    List<Integer> keys = new ArrayList<>();
+    for (Entry<Integer, String> e; (e = filtered.pollFirstEntry()) != null; ) {
+      keys.add(e.getKey());
+      assertEquals("v" + e.getKey(), e.getValue());
+    }
+    assertThat(keys).containsExactly(1, 3, 5, 7, 9).inOrder();
+    assertThat(unfiltered.keySet()).containsExactly(0, 2, 4, 6, 8).inOrder();
+  }
+
+  public void testNavigationEntriesAreImmutable() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    NavigableMap<Integer, String> filtered = Maps.filterValues(unfiltered, v -> v.length() == 3);
+    List<Entry<Integer, String>> returned = new ArrayList<>();
+    returned.add(filtered.firstEntry());
+    returned.add(filtered.lastEntry());
+    returned.add(filtered.ceilingEntry(2));
+    returned.add(filtered.floorEntry(2));
+    returned.add(filtered.higherEntry(1));
+    returned.add(filtered.lowerEntry(3));
+    returned.add(filtered.descendingMap().firstEntry());
+    returned.add(filtered.headMap(3, false).lastEntry());
+    for (Entry<Integer, String> e : returned) {
+      assertThrows(UnsupportedOperationException.class, () -> e.setValue("rejected"));
+    }
+    assertEquals(oneTwoThree(), unfiltered);
+  }
+
+  public void testEntrySetEntriesStayLive() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    NavigableMap<Integer, String> filtered = Maps.filterValues(unfiltered, v -> v.length() == 3);
+    Entry<Integer, String> first = filtered.entrySet().iterator().next();
+    assertThrows(IllegalArgumentException.class, () -> first.setValue("rejected"));
+    first.setValue("uno");
+    assertEquals("uno", unfiltered.get(1));
+    Entry<Integer, String> last = filtered.descendingMap().entrySet().iterator().next();
+    last.setValue("dos");
+    assertEquals("dos", unfiltered.get(2));
+  }
