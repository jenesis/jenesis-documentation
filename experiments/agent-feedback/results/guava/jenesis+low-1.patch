+  /** Removes the first matching entry and returns a snapshot of it taken before removal. */
+  private static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> pollFirstMatching(
+          Iterator<Entry<K, V>> iterator, Predicate<? super Entry<K, V>> predicate) {
+    while (iterator.hasNext()) {
+      Entry<K, V> next = iterator.next();
+      if (predicate.apply(next)) {
+        Entry<K, V> result = snapshot(next);
+        iterator.remove();
+        return result;
+      }
+    }
+    return null;
+  }
+
+  /** Returns an immutable snapshot of the given entry, or null. */
+  static <K extends @Nullable Object, V extends @Nullable Object> @Nullable Entry<K, V> snapshot(
+      @Nullable Entry<K, V> entry) {
+    return entry == null ? null : immutableEntry(entry.getKey(), entry.getValue());
+  }
+
+  /**
+   * Removes the next entry of the iterator and returns a snapshot of it taken before removal, or
+   * null if there is none. (Some maps, like TreeMap, reuse entry objects on removal.)
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> pollSnapshot(Iterator<Entry<K, V>> iterator) {
+    if (!iterator.hasNext()) {
+      return null;
+    }
+    Entry<K, V> result = snapshot(iterator.next());
+    iterator.remove();
+    return result;
+  }
