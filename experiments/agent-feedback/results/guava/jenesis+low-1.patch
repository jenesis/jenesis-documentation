+  /**
+   * Asserts that an entry returned by a navigation method is an immutable snapshot, as {@link
+   * NavigableMap} specifies, and returns it.
+   */
+  private static <E extends @Nullable Entry<?, ?>> E immutable(E entry) {
+    if (entry != null) {
+      Entry<?, ?> e = entry;
+      Object key = e.getKey();
+      Object value = e.getValue();
+      @SuppressWarnings("unchecked")
+      Entry<Object, Object> raw = (Entry<Object, Object>) e;
+      assertThrows(UnsupportedOperationException.class, () -> raw.setValue(value));
+      assertEquals(key, e.getKey());
+      assertEquals(value, e.getValue());
+    }
+    return entry;
+  }
