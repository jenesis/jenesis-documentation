+  public void testFilteredNavigableMapPollReturnsRemovedMapping() {
+    NavigableMap<Integer, String> unfiltered = new TreeMap<>();
+    unfiltered.put(1, "one");
+    unfiltered.put(2, "two");
+    unfiltered.put(3, "three");
+    NavigableMap<Integer, String> filtered = Maps.filterKeys(unfiltered, k -> k != 1);
+    assertEquals(immutableEntry(2, "two"), filtered.pollFirstEntry());
+    assertEquals(ImmutableMap.of(1, "one", 3, "three"), unfiltered);
+
+    NavigableMap<Integer, Integer> odds = new TreeMap<>();
+    for (int i = 0; i < 10; i++) {
+      odds.put(i, i);
+    }
+    NavigableMap<Integer, Integer> filteredOdds = Maps.filterKeys(odds, k -> k % 2 == 1);
+    List<Integer> polled = Lists.newArrayList();
+    for (Entry<Integer, Integer> e; (e = filteredOdds.pollFirstEntry()) != null; ) {
+      polled.add(e.getKey());
+    }
+    assertEquals(ImmutableList.of(1, 3, 5, 7, 9), polled);
