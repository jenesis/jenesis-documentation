+  /** Returns an immutable snapshot of the given entry, or null if it is null. */
+  static <K extends @Nullable Object, V extends @Nullable Object> @Nullable Entry<K, V> snapshotOrNull(
+      @Nullable Entry<? extends K, ? extends V> entry) {
+    return (entry == null) ? null : immutableEntry(entry.getKey(), entry.getValue());
+  }
+
+  /** Removes the first matching entry and returns an immutable snapshot taken before removal. */
+  private static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> removeFirstMatchingSnapshot(
+          Iterable<Entry<K, V>> removeFrom, Predicate<? super Entry<K, V>> predicate) {
+    Iterator<Entry<K, V>> iterator = removeFrom.iterator();
+    while (iterator.hasNext()) {
+      Entry<K, V> next = iterator.next();
+      if (predicate.apply(next)) {
+        Entry<K, V> snapshot = immutableEntry(next.getKey(), next.getValue());
+        iterator.remove();
+        return snapshot;
+      }
+    }
+    return null;
+  }
