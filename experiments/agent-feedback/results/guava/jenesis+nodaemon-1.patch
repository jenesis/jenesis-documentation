+  /**
+   * Returns an immutable snapshot of {@code entry}, or {@code null} if {@code entry} is null. Used
+   * by navigation methods of {@link NavigableMap} implementations, which are specified to return
+   * snapshots that do not support {@link Entry#setValue}.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> immutableEntryOrNull(@Nullable Entry<? extends K, ? extends V> entry) {
+    return (entry == null) ? null : immutableEntry(entry.getKey(), entry.getValue());
+  }
+
+  /**
+   * Removes the first entry of {@code iterator} that matches {@code predicate} (all, if it is
+   * null) and returns an immutable snapshot of it taken <i>before</i> the removal, or {@code null}
+   * if there is no such entry. The snapshot matters: some maps, such as {@link java.util.TreeMap},
+   * reuse the removed entry object for another mapping.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object> @Nullable Entry<K, V> pollEntry(
+      Iterator<Entry<K, V>> iterator, @Nullable Predicate<? super Entry<K, V>> predicate) {
+    while (iterator.hasNext()) {
+      Entry<K, V> next = iterator.next();
+      if (predicate == null || predicate.apply(next)) {
+        Entry<K, V> snapshot = immutableEntry(next.getKey(), next.getValue());
+        iterator.remove();
+        return snapshot;
+      }
+    }
+    return null;
+  }
