+  public void testStandardPollAndFirstLastEntry_returnSnapshots() {
+    NavigableMap<Integer, String> treeMap = new java.util.TreeMap<>();
+    treeMap.put(1, "one");
+    treeMap.put(2, "two");
+    treeMap.put(3, "three");
+    NavigableMap<Integer, String> forwarding =
+        new StandardImplForwardingNavigableMap<>(treeMap.tailMap(2, true));
+
+    Entry<Integer, String> first = forwarding.firstEntry();
+    assertThrows(UnsupportedOperationException.class, () -> first.setValue("x"));
+    Entry<Integer, String> last = forwarding.lastEntry();
+    assertThrows(UnsupportedOperationException.class, () -> last.setValue("x"));
+    assertEquals(ImmutableMap.of(1, "one", 2, "two", 3, "three"), treeMap);
+
+    Entry<Integer, String> polledFirst = forwarding.pollFirstEntry();
+    assertEquals(immutableEntry(2, "two"), polledFirst);
+    assertThrows(UnsupportedOperationException.class, () -> polledFirst.setValue("x"));
+    assertEquals(ImmutableMap.of(1, "one", 3, "three"), treeMap);
+
+    treeMap.put(2, "two");
+    treeMap.put(4, "four");
+    Entry<Integer, String> polledLast = forwarding.pollLastEntry();
+    assertEquals(immutableEntry(4, "four"), polledLast);
+    assertThrows(UnsupportedOperationException.class, () -> polledLast.setValue("x"));
+    assertEquals(ImmutableMap.of(1, "one", 2, "two", 3, "three"), treeMap);
+  }
