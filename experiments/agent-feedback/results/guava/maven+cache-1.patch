+package com.google.common.collect;
+
+import static com.google.common.collect.Maps.immutableEntry;
+import static org.junit.Assert.assertThrows;
+
+import com.google.common.annotations.GwtIncompatible;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map.Entry;
+import java.util.NavigableMap;
+import java.util.TreeMap;
+import junit.framework.TestCase;
+import org.jspecify.annotations.NullMarked;
+
+/** Tests for the single-entry navigation methods of filtered {@link NavigableMap} views. */
+@GwtIncompatible // NavigableMap
+@NullMarked
+public class FilteredNavigableMapTest extends TestCase {
+
+  private static NavigableMap<Integer, String> oneTwoThree() {
+    NavigableMap<Integer, String> map = new TreeMap<>();
+    map.put(1, "one");
+    map.put(2, "two");
+    map.put(3, "three");
+    return map;
+  }
+
+  public void testPollFirstEntry_returnsRemovedMapping() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    NavigableMap<Integer, String> filtered = Maps.filterKeys(unfiltered, k -> k != 1);
+    assertEquals(immutableEntry(2, "two"), filtered.pollFirstEntry());
+    assertEquals(ImmutableMap.of(1, "one", 3, "three"), unfiltered);
+  }
+
+  public void testPollEntry_drain() {
+    for (boolean first : new boolean[] {true, false}) {
+      NavigableMap<Integer, Integer> unfiltered = new TreeMap<>();
+      for (int i = 0; i < 10; i++) {
+        unfiltered.put(i, i * 10);
+      }
+      NavigableMap<Integer, Integer> filtered = Maps.filterKeys(unfiltered, k -> k % 2 == 1);
+      List<Integer> keys = new ArrayList<>();
+      Entry<Integer, Integer> entry;
+      while ((entry = first ? filtered.pollFirstEntry() : filtered.pollLastEntry()) != null) {
+        assertEquals(entry.getKey() * 10, (int) entry.getValue());
+        keys.add(entry.getKey());
+      }
+      assertEquals(
+          first ? ImmutableList.of(1, 3, 5, 7, 9) : ImmutableList.of(9, 7, 5, 3, 1), keys);
+      assertEquals(ImmutableMap.of(0, 0, 2, 20, 4, 40, 6, 60, 8, 80), unfiltered);
+    }
+  }
+
+  public void testNavigationEntries_areSnapshots() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    NavigableMap<Integer, String> filtered = Maps.filterValues(unfiltered, v -> !v.equals("x"));
+    List<NavigableMap<Integer, String>> views =
+        ImmutableList.of(
+            filtered, filtered.descendingMap(), filtered.headMap(3, true), filtered.tailMap(1, true));
+    for (NavigableMap<Integer, String> view : views) {
+      List<Entry<Integer, String>> entries = new ArrayList<>();
+      entries.add(view.firstEntry());
+      entries.add(view.lastEntry());
+      entries.add(view.ceilingEntry(2));
+      entries.add(view.floorEntry(2));
+      entries.add(view.higherEntry(2));
+      entries.add(view.lowerEntry(2));
+      for (Entry<Integer, String> entry : entries) {
+        String value = entry.getValue();
+        assertThrows(UnsupportedOperationException.class, () -> entry.setValue("x"));
+        assertThrows(UnsupportedOperationException.class, () -> entry.setValue("y"));
+        assertEquals(value, entry.getValue());
+      }
+      assertEquals(oneTwoThree(), unfiltered);
+    }
+    Entry<Integer, String> polled = filtered.pollLastEntry();
+    assertEquals(immutableEntry(3, "three"), polled);
+    assertThrows(UnsupportedOperationException.class, () -> polled.setValue("y"));
+  }
+
+  public void testEntrySetEntries_stayLive() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    NavigableMap<Integer, String> filtered = Maps.filterValues(unfiltered, v -> !v.equals("x"));
+    for (NavigableMap<Integer, String> view :
+        ImmutableList.of(filtered, filtered.descendingMap())) {
+      Entry<Integer, String> entry = view.entrySet().iterator().next();
+      entry.setValue("y");
+      assertEquals("y", unfiltered.get(entry.getKey()));
+      assertThrows(IllegalArgumentException.class, () -> entry.setValue("x"));
+    }
+  }
+}
