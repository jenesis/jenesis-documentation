+  /**
+   * Returns an immutable snapshot of the next entry of {@code iterator}, or {@code null} if there is
+   * none, optionally removing it afterwards. The snapshot is taken before removal, since some maps
+   * (like {@code TreeMap}) reuse the removed entry object for another mapping.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> snapshotOfNext(Iterator<Entry<K, V>> iterator, boolean remove) {
+    if (!iterator.hasNext()) {
+      return null;
+    }
+    Entry<K, V> entry = iterator.next();
+    Entry<K, V> snapshot = Maps.immutableEntry(entry.getKey(), entry.getValue());
+    if (remove) {
+      iterator.remove();
+    }
+    return snapshot;
   }
 
