+  /**
+   * Returns an immutable snapshot of {@code entry}, or {@code null} if it is {@code null}, as the
+   * navigation methods of {@link NavigableMap} specify.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> snapshotOrNull(@Nullable Entry<K, V> entry) {
+    return (entry == null) ? null : immutableEntry(entry.getKey(), entry.getValue());
+  }
+
+  /**
+   * Removes the next entry of {@code iterator} that satisfies {@code predicate} and returns an
+   * immutable snapshot of it, taken before the removal (some maps, like {@link TreeMap}, reuse
+   * entry objects on removal), or returns {@code null} if there is none.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> pollFirstMatchingEntry(
+          Iterator<Entry<K, V>> iterator, Predicate<? super Entry<K, V>> predicate) {
+    checkNotNull(predicate);
+    while (iterator.hasNext()) {
+      Entry<K, V> next = iterator.next();
+      if (predicate.apply(next)) {
+        Entry<K, V> snapshot = immutableEntry(next.getKey(), next.getValue());
+        iterator.remove();
+        return snapshot;
+      }
+    }
+    return null;
+  }
