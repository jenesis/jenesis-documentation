+    assertEquals(immutableEntry(2, "b"), Maps.filterKeys(small, k -> k != 1).pollFirstEntry());
+    small = new TreeMap<>(ImmutableMap.of(1, "a", 2, "b", 3, "c"));
+    assertEquals(immutableEntry(2, "b"), Maps.filterKeys(small, k -> k != 3).pollLastEntry());
+  }
+
+  @GwtIncompatible // NavigableMap
+  public void testFilteredNavigableMapNavigationEntriesAreSnapshots() {
+    NavigableMap<Integer, String> unfiltered =
+        new TreeMap<>(ImmutableMap.of(1, "a", 2, "bb", 3, "c", 4, "dd"));
+    NavigableMap<Integer, String> filtered = Maps.filterValues(unfiltered, v -> v.length() == 2);
+    for (NavigableMap<Integer, String> view :
+        ImmutableList.of(filtered, filtered.descendingMap(), filtered.headMap(4, true))) {
+      List<Entry<Integer, String>> entries =
+          asList(
+              view.firstEntry(),
+              view.lastEntry(),
+              view.ceilingEntry(2),
+              view.floorEntry(4),
+              view.higherEntry(3),
+              view.lowerEntry(3));
+      for (Entry<Integer, String> entry : entries) {
+        if (entry != null) {
+          String value = entry.getValue();
+          assertThrows(UnsupportedOperationException.class, () -> entry.setValue("x"));
+          assertEquals(value, entry.getValue());
+        }
+      }
+    }
+    assertEquals(ImmutableMap.of(1, "a", 2, "bb", 3, "c", 4, "dd"), unfiltered);
+    Entry<Integer, String> polled = filtered.pollFirstEntry();
+    assertThrows(UnsupportedOperationException.class, () -> polled.setValue("zz"));
+
+    // Entries handed out by iteration stay live.
+    Entry<Integer, String> live = filtered.entrySet().iterator().next();
+    assertThrows(IllegalArgumentException.class, () -> live.setValue("x"));
+    live.setValue("ee");
+    assertEquals("ee", unfiltered.get(4));
+    Entry<Integer, String> descendingLive = filtered.descendingMap().entrySet().iterator().next();
+    descendingLive.setValue("ff");
+    assertEquals("ff", unfiltered.get(4));
+  }
 }
