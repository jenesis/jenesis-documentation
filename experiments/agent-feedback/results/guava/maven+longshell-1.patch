+  /**
+   * Returns an immutable snapshot of the given entry, or {@code null} if it is {@code null}, as
+   * required of the entry-returning navigation methods of {@link NavigableMap}.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> snapshotOrNull(@Nullable Entry<K, V> entry) {
+    return (entry == null) ? null : immutableEntry(entry.getKey(), entry.getValue());
+  }
+
+  /**
+   * Returns an immutable snapshot of the next entry of the iterator and then removes it, or returns
+   * {@code null} if the iterator has no next entry. The snapshot is taken before removal, because
+   * some maps (like {@link java.util.TreeMap}) reuse the removed entry object for another mapping.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> pollNextSnapshot(Iterator<Entry<K, V>> iterator) {
+    if (!iterator.hasNext()) {
+      return null;
+    }
+    Entry<K, V> snapshot = snapshotOrNull(iterator.next());
+    iterator.remove();
+    return snapshot;
+  }
+
+  /**
+   * Removes the first entry of {@code entries} that satisfies the predicate and returns an
+   * immutable snapshot of it, or returns {@code null} if there is no such entry.
+   */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> removeFirstMatchingSnapshot(
+          Iterable<Entry<K, V>> entries, Predicate<? super Entry<K, V>> predicate) {
+    checkNotNull(predicate);
+    Iterator<Entry<K, V>> iterator = entries.iterator();
+    while (iterator.hasNext()) {
+      Entry<K, V> next = iterator.next();
+      if (predicate.apply(next)) {
+        Entry<K, V> snapshot = immutableEntry(next.getKey(), next.getValue());
+        iterator.remove();
+        return snapshot;
+      }
+    }
+    return null;
+  }
