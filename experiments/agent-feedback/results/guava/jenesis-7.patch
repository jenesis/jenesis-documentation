+package com.google.common.collect;
+
+import static com.google.common.collect.Maps.immutableEntry;
+import static com.google.common.truth.Truth.assertThat;
+import static org.junit.Assert.assertThrows;
+
+import com.google.common.annotations.GwtIncompatible;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map.Entry;
+import java.util.NavigableMap;
+import java.util.TreeMap;
+import junit.framework.TestCase;
+import org.jspecify.annotations.NullMarked;
+
+/** Tests for the navigation methods of filtered {@link NavigableMap} views. */
+@GwtIncompatible // NavigableMap
+@NullMarked
+public class FilteredNavigableMapTest extends TestCase {
+
+  private static NavigableMap<Integer, String> oneTwoThree() {
+    NavigableMap<Integer, String> unfiltered = new TreeMap<>();
+    unfiltered.put(1, "one");
+    unfiltered.put(2, "two");
+    unfiltered.put(3, "three");
+    return unfiltered;
+  }
+
+  public void testPollFirstEntry_returnsRemovedMapping() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    NavigableMap<Integer, String> filtered = Maps.filterKeys(unfiltered, k -> k != 1);
+    assertEquals(immutableEntry(2, "two"), filtered.pollFirstEntry());
+    assertEquals(ImmutableMap.of(1, "one", 3, "three"), unfiltered);
+  }
+
+  public void testPollLastEntry_returnsRemovedMapping() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    NavigableMap<Integer, String> filtered = Maps.filterKeys(unfiltered, k -> k != 3);
+    assertEquals(immutableEntry(2, "two"), filtered.pollLastEntry());
+    assertEquals(ImmutableMap.of(1, "one", 3, "three"), unfiltered);
+  }
+
+  public void testPollFirstEntry_drain() {
+    NavigableMap<Integer, Integer> unfiltered = new TreeMap<>();
+    for (int i = 0; i < 10; i++) {
+      unfiltered.put(i, i);
+    }
+    NavigableMap<Integer, Integer> filtered = Maps.filterKeys(unfiltered, k -> k % 2 == 1);
+    List<Integer> polled = new ArrayList<>();
+    for (Entry<Integer, Integer> e = filtered.pollFirstEntry();
+        e != null;
+        e = filtered.pollFirstEntry()) {
+      assertEquals(e.getKey(), e.getValue());
+      polled.add(e.getKey());
+    }
+    assertThat(polled).containsExactly(1, 3, 5, 7, 9).inOrder();
+    assertThat(unfiltered.keySet()).containsExactly(0, 2, 4, 6, 8).inOrder();
+  }
+
+  public void testNavigationEntriesAreImmutableSnapshots() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    NavigableMap<Integer, String> filtered = Maps.filterValues(unfiltered, v -> !v.equals("bad"));
+    List<NavigableMap<Integer, String>> views =
+        ImmutableList.of(filtered, filtered.descendingMap(), filtered.headMap(3, true));
+    for (NavigableMap<Integer, String> view : views) {
+      List<Entry<Integer, String>> entries = new ArrayList<>();
+      entries.add(view.firstEntry());
+      entries.add(view.lastEntry());
+      entries.add(view.ceilingEntry(2));
+      entries.add(view.floorEntry(2));
+      entries.add(view.higherEntry(2));
+      entries.add(view.lowerEntry(2));
+      for (Entry<Integer, String> entry : entries) {
+        String value = entry.getValue();
+        assertThrows(UnsupportedOperationException.class, () -> entry.setValue("bad"));
+        assertThrows(UnsupportedOperationException.class, () -> entry.setValue("good"));
+        assertEquals(value, entry.getValue());
+      }
+    }
+    assertEquals(oneTwoThree(), unfiltered);
+
+    Entry<Integer, String> first = filtered.firstEntry();
+    unfiltered.put(1, "uno");
+    assertEquals(immutableEntry(1, "one"), first);
+
+    Entry<Integer, String> polled = filtered.pollFirstEntry();
+    assertThrows(UnsupportedOperationException.class, () -> polled.setValue("x"));
+    assertEquals(immutableEntry(1, "uno"), polled);
+  }
+
+  public void testEntrySetEntriesStayLive() {
+    NavigableMap<Integer, String> unfiltered = oneTwoThree();
+    NavigableMap<Integer, String> filtered = Maps.filterValues(unfiltered, v -> !v.equals("bad"));
+    for (NavigableMap<Integer, String> view : ImmutableList.of(filtered, filtered.descendingMap())) {
+      Entry<Integer, String> entry = view.entrySet().iterator().next();
+      Integer key = entry.getKey();
+      entry.setValue("good");
+      assertEquals("good", unfiltered.get(key));
+      assertThrows(IllegalArgumentException.class, () -> entry.setValue("bad"));
+    }
+  }
