+  @GwtIncompatible // NavigableMap
+  public void testFilteredNavigableMapPollReturnsSnapshot() {
+    NavigableMap<Integer, String> unfiltered = new TreeMap<>();
+    unfiltered.put(1, "one");
+    unfiltered.put(2, "two");
+    unfiltered.put(3, "three");
+    NavigableMap<Integer, String> filtered = Maps.filterKeys(unfiltered, k -> k != 1);
+    assertEquals(Maps.immutableEntry(2, "two"), filtered.pollFirstEntry());
+    assertEquals(Maps.immutableEntry(3, "three"), filtered.pollLastEntry());
+    assertEquals(ImmutableMap.of(1, "one"), unfiltered);
+  }
+
+  @GwtIncompatible // NavigableMap
+  public void testFilteredNavigableMapEntriesAreImmutable() {
+    NavigableMap<Integer, String> unfiltered = new TreeMap<>();
+    unfiltered.put(1, "one");
+    unfiltered.put(2, "two");
+    unfiltered.put(3, "three");
+    NavigableMap<Integer, String> filtered = Maps.filterValues(unfiltered, v -> !v.equals("one"));
+    java.util.Map.Entry<Integer, String> first = filtered.firstEntry();
+    assertThrows(UnsupportedOperationException.class, () -> first.setValue("x"));
+    assertThrows(
+        UnsupportedOperationException.class, () -> filtered.descendingMap().firstEntry().setValue("x"));
+    assertThrows(
+        UnsupportedOperationException.class, () -> filtered.ceilingEntry(1).setValue("x"));
+    assertEquals("two", unfiltered.get(2));
+    assertEquals(Maps.immutableEntry(2, "two"), first);
+    // iteration stays live
+    filtered.entrySet().iterator().next().setValue("zwei");
+    assertEquals("zwei", unfiltered.get(2));
+  }
