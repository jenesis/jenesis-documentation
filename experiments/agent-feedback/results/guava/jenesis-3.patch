+    NavigableMap<Integer, Integer> even = Maps.filterKeys(numbers, k -> k % 2 == 0);
+    polled.clear();
+    for (Entry<Integer, Integer> e; (e = even.pollLastEntry()) != null; ) {
+      polled.add(e.getKey());
+    }
