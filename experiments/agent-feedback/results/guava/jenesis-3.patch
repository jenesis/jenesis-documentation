+   */
+  static <K extends @Nullable Object, V extends @Nullable Object> @Nullable Entry<K, V>
+      pollSnapshot(Iterator<Entry<K, V>> iterator) {
+    if (!iterator.hasNext()) {
+      return null;
+    }
