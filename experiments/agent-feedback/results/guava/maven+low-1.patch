+  /** Returns an immutable snapshot of {@code entry}, or null if it is null. */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> snapshotOrNull(@Nullable Entry<K, V> entry) {
+    return (entry == null) ? null : immutableEntry(entry.getKey(), entry.getValue());
+  }
+
+  /** Returns the first element of {@code iterator} as a snapshot, or null; does not remove it. */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> nextSnapshotOrNull(Iterator<Entry<K, V>> iterator) {
+    return iterator.hasNext() ? snapshotOrNull(iterator.next()) : null;
+  }
+
+  /** Removes the first element of {@code iterator}, returning a snapshot taken before removal. */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> pollSnapshot(Iterator<Entry<K, V>> iterator) {
+    if (!iterator.hasNext()) {
+      return null;
+    }
+    Entry<K, V> result = snapshotOrNull(iterator.next());
+    iterator.remove();
+    return result;
+  }
+
+  /** Removes the first entry matching {@code predicate}, returning a snapshot of it. */
+  static <K extends @Nullable Object, V extends @Nullable Object>
+      @Nullable Entry<K, V> pollFirstMatchingSnapshot(
+          Iterator<Entry<K, V>> iterator, Predicate<? super Entry<K, V>> predicate) {
+    while (iterator.hasNext()) {
+      Entry<K, V> next = iterator.next();
+      if (predicate.apply(next)) {
+        Entry<K, V> result = immutableEntry(next.getKey(), next.getValue());
+        iterator.remove();
+        return result;
+      }
+    }
+    return null;
+  }
