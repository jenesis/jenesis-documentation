+    @Test(expected = IllegalStateException.class)
+    public void testDroppingOfUninitializedThisFrameAfterFullFrameInConstructor() throws Exception {
+        new ByteBuddy()
+                .subclass(Object.class, ConstructorStrategy.Default.NO_CONSTRUCTORS)
+                .defineConstructor(Visibility.PUBLIC)
+                .intercept(new Implementation.Simple(
+                        new StackManipulation.AbstractBase() {
+                            @Override
+                            public Size apply(MethodVisitor methodVisitor, Implementation.Context implementationContext) {
+                                methodVisitor.visitInsn(Opcodes.NOP);
+                                methodVisitor.visitFrame(Opcodes.F_FULL, 1, new Object[]{Opcodes.UNINITIALIZED_THIS}, 0, new Object[0]);
+                                methodVisitor.visitInsn(Opcodes.NOP);
+                                methodVisitor.visitFrame(Opcodes.F_CHOP, 1, null, 0, null);
+                                methodVisitor.visitInsn(Opcodes.NOP);
+                                return Size.ZERO;
+                            }
+                        },
+                        MethodVariableAccess.loadThis(),
+                        MethodInvocation.invoke(new MethodDescription.ForLoadedConstructor(Object.class.getConstructor()))
+                                .special(TypeDescription.ForLoadedType.of(Object.class)),
+                        MethodReturn.VOID
+                ))
+                .visit(Advice.to(EmptyExitAdvice.class).on(isConstructor()))
+                .make();
+    }
