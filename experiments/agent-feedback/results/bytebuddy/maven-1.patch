+    @Test
+    public void testConstructorCompactFrameWithLongParameter() throws Exception {
+        Class<?> type = new ByteBuddy()
+                .redefine(LongParameterConstructorChild.class)
+                .visit(Advice.to(EmptyExitAdvice.class).on(isConstructor()))
+                .make()
+                .load(LongParameterConstructorChild.class.getClassLoader(), ClassLoadingStrategy.Default.CHILD_FIRST)
+                .getLoaded();
+        assertThat(type.getField(FOO).getInt(type.getConstructor(long.class).newInstance(0L)), is(1));
+        assertThat(type.getField(FOO).getInt(type.getConstructor(long.class).newInstance(42L)), is(2));
+    }
