+package net.bytebuddy.asm;
+
+import net.bytebuddy.ByteBuddy;
+import net.bytebuddy.description.type.TypeDescription;
+import net.bytebuddy.dynamic.ClassFileLocator;
+import net.bytebuddy.dynamic.loading.ClassLoadingStrategy;
+import net.bytebuddy.pool.TypePool;
+import org.junit.Test;
+import org.objectweb.asm.ClassWriter;
+import org.objectweb.asm.Label;
+import org.objectweb.asm.MethodVisitor;
+import org.objectweb.asm.Opcodes;
+
+import static net.bytebuddy.matcher.ElementMatchers.isConstructor;
+import static org.hamcrest.CoreMatchers.is;
+import static org.hamcrest.CoreMatchers.notNullValue;
+import static org.hamcrest.MatcherAssert.assertThat;
+
+public class AdviceConstructorFrameTest {
+
+    private static final String SAMPLE = "net.bytebuddy.asm.AdviceConstructorFrameTestSample";
+
+    @Test
+    public void testCompactFrameWithLongParameter() throws Exception {
+        Class<?> type = new ByteBuddy()
+                .redefine(LongChild.class)
+                .visit(Advice.to(EmptyExit.class).on(isConstructor()))
+                .make()
+                .load(Parent.class.getClassLoader(), ClassLoadingStrategy.Default.CHILD_FIRST)
+                .getLoaded();
+        assertThat(type.getField("value").getInt(type.getDeclaredConstructor(long.class).newInstance(0L)), is(1));
+        assertThat(type.getField("value").getInt(type.getDeclaredConstructor(long.class).newInstance(5L)), is(2));
+    }
+
+    @Test
+    public void testCompactFrameWithDoubleParameter() throws Exception {
+        Class<?> type = new ByteBuddy()
+                .redefine(DoubleChild.class)
+                .visit(Advice.to(EmptyExit.class).on(isConstructor()))
+                .make()
+                .load(Parent.class.getClassLoader(), ClassLoadingStrategy.Default.CHILD_FIRST)
+                .getLoaded();
+        assertThat(type.getField("value").getInt(type.getDeclaredConstructor(double.class).newInstance(0d)), is(1));
+        assertThat(type.getField("value").getInt(type.getDeclaredConstructor(double.class).newInstance(5d)), is(2));
+    }
+
+    @Test(expected = IllegalStateException.class)
+    public void testFullFrameDropsUninitializedThis() throws Exception {
+        transform(true);
+    }
+
+    @Test
+    public void testFullFrameDropsInitializedThis() throws Exception {
+        Class<?> type = transform(false)
+                .load(ClassLoadingStrategy.BOOTSTRAP_LOADER, ClassLoadingStrategy.Default.WRAPPER)
+                .getLoaded();
+        assertThat(type.getDeclaredConstructor().newInstance(), notNullValue(Object.class));
+    }
+
+    private static net.bytebuddy.dynamic.DynamicType.Unloaded<?> transform(boolean beforeSuperConstructor) {
+        byte[] binaryRepresentation = sample(beforeSuperConstructor);
+        ClassFileLocator classFileLocator = new ClassFileLocator.Compound(ClassFileLocator.Simple.of(SAMPLE, binaryRepresentation),
+                ClassFileLocator.ForClassLoader.ofSystemLoader());
+        TypeDescription typeDescription = TypePool.Default.of(classFileLocator).describe(SAMPLE).resolve();
+        return new ByteBuddy()
+                .redefine(typeDescription, classFileLocator)
+                .visit(Advice.to(EmptyExit.class).on(isConstructor()))
+                .make();
+    }
+
+    /**
+     * Creates a class with a constructor that declares a full frame followed by a frame that chops the implicit {@code this}
+     * reference, either before the super constructor is invoked, where {@code this} is still uninitialized, or after.
+     */
+    private static byte[] sample(boolean beforeSuperConstructor) {
+        String internalName = SAMPLE.replace('.', '/');
+        ClassWriter classWriter = new ClassWriter(0);
+        classWriter.visit(Opcodes.V1_8, Opcodes.ACC_PUBLIC | Opcodes.ACC_SUPER, internalName, null, "java/lang/Object", null);
+        MethodVisitor methodVisitor = classWriter.visitMethod(Opcodes.ACC_PUBLIC, "<init>", "()V", null, null);
+        methodVisitor.visitCode();
+        if (!beforeSuperConstructor) {
+            methodVisitor.visitVarInsn(Opcodes.ALOAD, 0);
+            methodVisitor.visitMethodInsn(Opcodes.INVOKESPECIAL, "java/lang/Object", "<init>", "()V", false);
+        }
+        Label first = new Label(), second = new Label();
+        methodVisitor.visitInsn(Opcodes.ICONST_0);
+        methodVisitor.visitJumpInsn(Opcodes.IFEQ, first);
+        methodVisitor.visitLabel(first);
+        methodVisitor.visitFrame(Opcodes.F_FULL,
+                1,
+                new Object[]{beforeSuperConstructor ? Opcodes.UNINITIALIZED_THIS : internalName},
+                0,
+                new Object[0]);
+        methodVisitor.visitInsn(Opcodes.ICONST_0);
+        methodVisitor.visitJumpInsn(Opcodes.IFEQ, second);
+        methodVisitor.visitLabel(second);
+        methodVisitor.visitFrame(Opcodes.F_CHOP, 1, null, 0, null);
+        if (beforeSuperConstructor) {
+            methodVisitor.visitVarInsn(Opcodes.ALOAD, 0);
+            methodVisitor.visitMethodInsn(Opcodes.INVOKESPECIAL, "java/lang/Object", "<init>", "()V", false);
+        }
+        methodVisitor.visitInsn(Opcodes.RETURN);
+        methodVisitor.visitMaxs(1, 1);
+        methodVisitor.visitEnd();
+        classWriter.visitEnd();
+        return classWriter.toByteArray();
+    }
+
+    public static class Parent {
+
+        public final int value;
+
+        public Parent(int value) {
+            this.value = value;
+        }
+    }
+
+    public static class LongChild extends Parent {
+
+        public LongChild(long value) {
+            super(value == 0 ? 1 : 2);
+        }
+    }
+
+    public static class DoubleChild extends Parent {
+
+        public DoubleChild(double value) {
+            super(value == 0 ? 1 : 2);
+        }
+    }
+
+    public static class EmptyExit {
+
+        @Advice.OnMethodExit(suppress = Throwable.class)
+        public static void exit() {
+            /* empty */
+        }
+    }
+}
