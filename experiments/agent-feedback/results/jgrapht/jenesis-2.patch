+    private static Graph<Integer, DefaultWeightedEdge> weightedGraph(int[][] edges)
+    {
+        Graph<Integer, DefaultWeightedEdge> g =
+            new DirectedWeightedPseudograph<>(DefaultWeightedEdge.class);
+        for (int[] e : edges) {
+            Graphs.addEdgeWithVertices(g, e[0], e[1], e[2]);
+        }
+        return g;
+    }
+
+    private static void assertCycle(
+        Graph<Integer, DefaultWeightedEdge> g, GraphPath<Integer, DefaultWeightedEdge> cycle,
+        List<Integer> expectedVertices, double expectedMean)
+    {
+        assertEquals(expectedVertices, cycle.getVertexList());
+        double weight = 0;
+        Integer v = cycle.getStartVertex();
+        for (DefaultWeightedEdge e : cycle.getEdgeList()) {
+            assertEquals(v, g.getEdgeSource(e));
+            v = g.getEdgeTarget(e);
+            weight += g.getEdgeWeight(e);
+        }
+        assertEquals(cycle.getEndVertex(), v);
+        assertEquals(weight, cycle.getWeight(), 1e-9);
+        assertEquals(expectedMean, cycle.getWeight() / cycle.getLength(), 1e-9);
+    }
+
+    @Test
+    public void testPolicyChangedAfterLastCycleTerminates()
+    {
+        Graph<Integer, DefaultWeightedEdge> g1 = weightedGraph(
+            new int[][] { { 0, 2, 2 }, { 1, 2, 1 }, { 2, 3, 2 }, { 3, 0, 1 }, { 3, 1, 2 } });
+        Graph<Integer, DefaultWeightedEdge> g2 =
+            weightedGraph(new int[][] { { 0, 1, 4 }, { 1, 2, 2 }, { 2, 0, 5 }, { 2, 1, 5 } });
+
+        assertTimeoutPreemptively(Duration.ofSeconds(10), () -> {
+            assertCycle(
+                g1, new HowardMinimumMeanCycle<>(g1).getCycle(), Arrays.asList(0, 2, 3, 0),
+                5.0 / 3);
+            assertEquals(5.0 / 3, new HowardMinimumMeanCycle<>(g1).getCycleMean(), 1e-9);
+            assertCycle(
+                g2, new HowardMinimumMeanCycle<>(g2).getCycle(), Arrays.asList(1, 2, 1), 3.5);
+            assertCycle(
+                g2, new HowardMinimumMeanCycle<>(g2, 1).getCycle(),
+                Arrays.asList(0, 1, 2, 0), 11.0 / 3);
+        });
+    }
