+    private static Graph<Integer, DefaultWeightedEdge> weighted(int n, int[][] edges)
+    {
+        Graph<Integer, DefaultWeightedEdge> g =
+            new DirectedWeightedPseudograph<>(DefaultWeightedEdge.class);
+        for (int v = 0; v < n; v++) {
+            g.addVertex(v);
+        }
+        for (int[] e : edges) {
+            Graphs.addEdge(g, e[0], e[1], e[2]);
+        }
+        return g;
+    }
+
+    private static void assertCycle(
+        Graph<Integer, DefaultWeightedEdge> g, GraphPath<Integer, DefaultWeightedEdge> cycle,
+        List<Integer> expectedVertices, double expectedMean)
+    {
+        assertNotNull(cycle);
+        assertEquals(expectedVertices, cycle.getVertexList());
+        double sum = 0;
+        Integer v = cycle.getStartVertex();
+        for (DefaultWeightedEdge e : cycle.getEdgeList()) {
+            assertEquals(v, g.getEdgeSource(e));
+            v = g.getEdgeTarget(e);
+            sum += g.getEdgeWeight(e);
+        }
+        assertEquals(cycle.getEndVertex(), v);
+        assertEquals(cycle.getStartVertex(), v);
+        assertEquals(sum, cycle.getWeight(), 1e-9);
+        assertEquals(expectedMean, cycle.getWeight() / cycle.getLength(), 1e-9);
+    }
+
