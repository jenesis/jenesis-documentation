+    private Graph<Integer, DefaultEdge> buildGraph(int[][] graphArray)
+    {
+        Graph<Integer, DefaultEdge> graph = new DirectedWeightedPseudograph<>(DefaultEdge.class);
+        TestUtil.constructGraph(graph, graphArray);
+        return graph;
+    }
+
+    private void assertConsistentCycle(GraphPath<Integer, DefaultEdge> cycle)
+    {
+        Graph<Integer, DefaultEdge> graph = cycle.getGraph();
+        assertEquals(cycle.getStartVertex(), cycle.getEndVertex());
+        List<Integer> vertices = cycle.getVertexList();
+        List<DefaultEdge> edges = cycle.getEdgeList();
+        assertEquals(edges.size() + 1, vertices.size());
+        double weight = 0.0;
+        for (int i = 0; i < edges.size(); i++) {
+            DefaultEdge e = edges.get(i);
+            assertEquals(vertices.get(i), graph.getEdgeSource(e));
+            assertEquals(vertices.get(i + 1), graph.getEdgeTarget(e));
+            weight += graph.getEdgeWeight(e);
+        }
+        assertEquals(weight, cycle.getWeight(), 1e-9);
+    }
