+    private static Graph<Integer, DefaultWeightedEdge> weightedGraph(int n)
+    {
+        Graph<Integer, DefaultWeightedEdge> graph =
+            new DirectedWeightedPseudograph<>(DefaultWeightedEdge.class);
+        for (int v = 0; v < n; v++) {
+            graph.addVertex(v);
+        }
+        return graph;
+    }
+
+    private static void checkCycle(
+        Graph<Integer, DefaultWeightedEdge> graph, int maximumIterations, double expectedMean,
+        List<Integer> expectedVertices)
+    {
+        HowardMinimumMeanCycle<Integer, DefaultWeightedEdge> mmc =
+            new HowardMinimumMeanCycle<>(graph, maximumIterations);
+        GraphPath<Integer, DefaultWeightedEdge> cycle =
+            assertTimeoutPreemptively(Duration.ofSeconds(10), mmc::getCycle);
+
+        assertEquals(expectedVertices, cycle.getVertexList());
+        assertEquals(cycle.getStartVertex(), cycle.getEndVertex());
+        double weight = 0.0;
+        Integer v = cycle.getStartVertex();
+        for (DefaultWeightedEdge e : cycle.getEdgeList()) {
+            assertEquals(v, graph.getEdgeSource(e));
+            v = graph.getEdgeTarget(e);
+            weight += graph.getEdgeWeight(e);
+        }
+        assertEquals(cycle.getEndVertex(), v);
+        assertEquals(weight, cycle.getWeight(), 1e-9);
+        assertEquals(expectedMean, cycle.getWeight() / cycle.getLength(), 1e-9);
+        assertEquals(expectedMean, mmc.getCycleMean(), 1e-9);
+    }
