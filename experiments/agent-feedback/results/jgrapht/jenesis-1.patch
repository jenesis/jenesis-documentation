+    private void assertConsistent(Graph<Integer, DefaultEdge> graph, GraphPath<Integer, DefaultEdge> cycle)
+    {
+        Integer v = cycle.getStartVertex();
+        assertEquals(v, cycle.getEndVertex());
+        double weight = 0.0;
+        for (DefaultEdge e : cycle.getEdgeList()) {
+            assertEquals(v, graph.getEdgeSource(e));
+            v = graph.getEdgeTarget(e);
+            weight += graph.getEdgeWeight(e);
+        }
+        assertEquals(cycle.getStartVertex(), v);
+        assertEquals(cycle.getWeight(), weight, 1e-9);
+    }
