+    @Test
+    public void testCycleIsTakenFromPolicyGraphWhenFound()
+    {
+        Graph<Integer, DefaultEdge> graph = new DirectedWeightedPseudograph<>(DefaultEdge.class);
+        int[][] edges = { { 0, 2, 2 }, { 1, 2, 1 }, { 2, 3, 2 }, { 3, 0, 1 }, { 3, 1, 2 } };
+        addEdges(graph, 4, edges);
+        assertConsistentCycle(
+            new HowardMinimumMeanCycle<>(graph), graph, 5.0 / 3,
+            new int[][] { { 0, 2 }, { 2, 3 }, { 3, 0 } });
+    }
+
+    @Test
+    public void testCycleIsTakenFromPolicyGraphWhenFoundWithIterationLimit()
+    {
+        Graph<Integer, DefaultEdge> graph = new DirectedWeightedPseudograph<>(DefaultEdge.class);
+        int[][] edges = { { 0, 1, 4 }, { 1, 2, 2 }, { 2, 0, 5 }, { 2, 1, 5 } };
+        addEdges(graph, 3, edges);
+        assertConsistentCycle(
+            new HowardMinimumMeanCycle<>(graph), graph, 3.5, new int[][] { { 1, 2 }, { 2, 1 } });
+        assertConsistentCycle(
+            new HowardMinimumMeanCycle<>(graph, 1), graph, 11.0 / 3,
+            new int[][] { { 0, 1 }, { 1, 2 }, { 2, 0 } });
+    }
+
+    private void addEdges(Graph<Integer, DefaultEdge> graph, int n, int[][] edges)
+    {
+        for (int v = 0; v < n; v++) {
+            graph.addVertex(v);
+        }
+        for (int[] e : edges) {
+            graph.setEdgeWeight(graph.addEdge(e[0], e[1]), e[2]);
+        }
+    }
+
+    private void assertConsistentCycle(
+        HowardMinimumMeanCycle<Integer, DefaultEdge> mmc, Graph<Integer, DefaultEdge> graph,
+        double expectedMean, int[][] expectedPath)
+    {
+        GraphPath<Integer, DefaultEdge> cycle = mmc.getCycle();
+        double sum = 0;
+        int v = cycle.getStartVertex();
+        for (DefaultEdge e : cycle.getEdgeList()) {
+            assertEquals(v, (int) graph.getEdgeSource(e));
+            v = graph.getEdgeTarget(e);
+            sum += graph.getEdgeWeight(e);
+        }
+        assertEquals(cycle.getEndVertex(), v);
+        assertEquals(cycle.getStartVertex(), cycle.getEndVertex());
+        assertEquals(sum, cycle.getWeight(), 1e-9);
+        assertEquals(expectedMean, cycle.getWeight() / cycle.getLength(), 1e-9);
+        assertEquals(expectedMean, mmc.getCycleMean(), 1e-9);
+        assertEquals(readPath(expectedPath, graph), cycle);
+    }
