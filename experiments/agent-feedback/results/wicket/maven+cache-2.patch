+
+/**
+ * Resources served by components from their own listener URL must be authorized like resources
+ * requested by a resource URL.
+ */
+class ComponentResourceAuthorizationTest extends WicketTestCase
+{
+	private final List<IResource> askedResources = new ArrayList<>();
+	private final List<PageParameters> askedParameters = new ArrayList<>();
+	private Predicate<IResource> allowed;
+
+	private final List<IResource> served = new ArrayList<>();
+	private boolean clicked;
+
+	private final IResource secret = new Res("secret");
+	private final IResource open = new Res("open");
+	private final IResource open2 = new Res("open2");
+
+	private class Res extends ByteArrayResource
+	{
+		private final String name;
+
+		Res(String name)
+		{
+			super("text/plain", name.getBytes());
+			this.name = name;
+		}
+
+		@Override
+		public void respond(Attributes attributes)
+		{
+			served.add(this);
+			super.respond(attributes);
+		}
+
+		@Override
+		public String toString()
+		{
+			return name;
+		}
+	}
+
+	@BeforeEach
+	void installStrategy()
+	{
+		allowed = r -> r != secret;
+		tester.getApplication()
+			.getSecuritySettings()
+			.setAuthorizationStrategy(new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					askedResources.add(resource);
+					askedParameters.add(parameters);
+					return allowed.test(resource);
+				}
+			});
+	}
+
+	private void assertRefused(IResource resource)
+	{
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals("The request to resource '" + resource +
+			"' with parameters '' cannot be authorized.", tester.getLastResponse().getErrorMessage());
+		assertTrue(served.isEmpty());
+		assertNotNullParameters();
+	}
+
+	private void assertNotNullParameters()
+	{
+		for (PageParameters p : askedParameters)
+		{
+			assertNotNull(p);
+			assertTrue(p.isEmpty());
+		}
+	}
+
+	@Test
+	void resourceLinkRefused()
+	{
+		tester.startPage(new TestPage(secret));
+		tester.clickLink("link", false);
+
+		assertEquals(List.of(secret), askedResources);
+		assertRefused(secret);
+		assertFalse(clicked);
+	}
+
+	@Test
+	void resourceLinkAllowed()
+	{
+		tester.startPage(new TestPage(open));
+		tester.clickLink("link", false);
+
+		assertEquals(List.of(open), askedResources);
+		assertNotNullParameters();
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals("open", tester.getLastResponseAsString());
+		assertTrue(clicked);
+	}
+
+	@Test
+	void refusalGoesToInstalledListener()
+	{
+		List<IResource> refused = new ArrayList<>();
+		tester.getApplication()
+			.getSecuritySettings()
+			.setUnauthorizedResourceRequestListener((resource, parameters) -> refused.add(resource));
+
+		tester.startPage(new TestPage(secret));
+		tester.clickLink("link", false);
+
+		assertEquals(List.of(secret), refused);
+		assertTrue(served.isEmpty());
+		assertFalse(clicked);
+	}
+
+	@Test
+	void imageRefused()
+	{
+		TestPage page = tester.startPage(new TestPage(secret));
+		tester.executeListener(page.get("image"));
+
+		assertSame(secret, askedResources.get(0));
+		assertRefused(secret);
+	}
+
+	@Test
+	void imageSrcsetEntryRefused()
+	{
+		TestPage page = tester.startPage(new TestPage(open, secret));
+		tester.executeListener(page.get("image"));
+
+		assertEquals(List.of(open, secret), askedResources);
+		assertRefused(secret);
+	}
+
+	@Test
+	void imageWithSrcsetAllowed()
+	{
+		TestPage page = tester.startPage(new TestPage(open, open2));
+		tester.executeListener(page.get("image"));
+
+		assertEquals(List.of(open, open2), askedResources);
+		assertNotNullParameters();
+		assertEquals(List.of(open, open2), served);
+	}
+
+	@Test
+	void imageButtonRefused()
+	{
+		TestPage page = tester.startPage(new TestPage(secret));
+		tester.executeListener(page.get("form:button"));
+
+		assertEquals(List.of(secret), askedResources);
+		assertRefused(secret);
+	}
+
+	@Test
+	void imageButtonAllowed()
+	{
+		TestPage page = tester.startPage(new TestPage(open));
+		tester.executeListener(page.get("form:button"));
+
+		assertEquals(List.of(open), askedResources);
+		assertEquals(List.of(open), served);
+	}
+
+	private class TestPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		TestPage(IResource resource, IResource... srcset)
+		{
+			add(new ResourceLink<Void>("link", resource)
+			{
+				@Override
+				public void onClick()
+				{
+					clicked = true;
+				}
+			});
+			add(new Image("image", resource, srcset));
+			Form<Void> form = new Form<>("form");
+			add(form);
+			form.add(new ImageButton("button", resource));
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><a wicket:id='link'>link</a>" +
+				"<img wicket:id='image'/><form wicket:id='form'>" +
+				"<input type='image' wicket:id='button'/></form></body></html>");
+		}
+	}
+}
