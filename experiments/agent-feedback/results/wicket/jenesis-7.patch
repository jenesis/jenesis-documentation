+import org.apache.wicket.util.tester.WicketTestCase;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Resources served by a component from its own listener URL must be authorized like those served
+ * by a resource URL.
+ */
+class ListenerResourceAuthorizationTest extends WicketTestCase
+{
+	private final List<IResource> refused = new ArrayList<>();
+	private final List<IResource> asked = new ArrayList<>();
+	private final List<PageParameters> askedParameters = new ArrayList<>();
+	private final List<IResource> responded = new ArrayList<>();
+
+	@Override
+	protected WebApplication newApplication()
+	{
+		return new MockApplication()
+		{
+			@Override
+			protected void init()
+			{
+				super.init();
+				getSecuritySettings().setAuthorizationStrategy(
+					new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+					{
+						@Override
+						public boolean isResourceAuthorized(IResource resource,
+							PageParameters parameters)
+						{
+							asked.add(resource);
+							askedParameters.add(parameters);
+							return !refused.contains(resource);
+						}
+					});
+			}
+		};
+	}
+
+	private IResource resource(String content)
+	{
+		return new ByteArrayResource("text/plain", content.getBytes())
+		{
+			@Override
+			public void respond(Attributes attributes)
+			{
+				responded.add(this);
+				super.respond(attributes);
+			}
+		};
+	}
+
+	@Test
+	void refusedResourceLink()
+	{
+		IResource secret = resource("secret");
+		refused.add(secret);
+		TestPage page = new TestPage(secret, null);
+
+		tester.startPage(page);
+		tester.clickLink("link", false);
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+		assertEquals(List.of(secret), asked);
+		assertNotNull(askedParameters.get(0));
+		assertTrue(askedParameters.get(0).isEmpty());
+		assertTrue(responded.isEmpty());
+		assertFalse(page.clicked);
+	}
+
+	@Test
+	void refusedResourceLinkWithCustomListener()
+	{
+		List<IResource> notified = new ArrayList<>();
+		tester.getApplication()
+			.getSecuritySettings()
+			.setUnauthorizedResourceRequestListener((resource, parameters) -> notified.add(resource));
+		IResource secret = resource("secret");
+		refused.add(secret);
+		TestPage page = new TestPage(secret, null);
+
+		tester.startPage(page);
+		tester.clickLink("link", false);
+
+		assertEquals(List.of(secret), notified);
+		assertTrue(responded.isEmpty());
+		assertFalse(page.clicked);
+	}
+
+	@Test
+	void allowedResourceLink()
+	{
+		IResource data = resource("data");
+		TestPage page = new TestPage(data, null);
+
+		tester.startPage(page);
+		tester.clickLink("link", false);
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals("data", tester.getLastResponseAsString());
+		assertEquals(List.of(data), asked);
+		assertEquals(List.of(data), responded);
+		assertTrue(page.clicked);
+	}
+
+	@Test
+	void refusedImage()
+	{
+		IResource secret = resource("secret");
+		refused.add(secret);
+		TestPage page = new TestPage(resource("link"), secret);
+
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals(List.of(secret), asked);
+		assertTrue(askedParameters.get(0).isEmpty());
+		assertTrue(responded.isEmpty());
+	}
+
+	@Test
+	void refusedSrcSetEntry()
+	{
+		IResource src = resource("src");
+		IResource secret = resource("secret");
+		refused.add(secret);
+		TestPage page = new TestPage(resource("link"), src, secret);
+
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals(List.of(src, secret), asked);
+		assertFalse(responded.contains(secret));
+	}
+
+	@Test
+	void allowedImageWithSrcSet()
+	{
+		IResource src = resource("src");
+		IResource entry = resource("entry");
+		TestPage page = new TestPage(resource("link"), src, entry);
+
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(List.of(src, entry), asked);
+		assertEquals(List.of(src, entry), responded);
+	}
+
+	/** */
+	public static class TestPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		boolean clicked;
+
+		TestPage(IResource linkResource, IResource imageResource, IResource... srcSet)
+		{
+			add(new ResourceLink<Void>("link", linkResource)
+			{
+				@Override
+				public void onClick()
+				{
+					clicked = true;
+				}
+			});
+			if (imageResource != null)
+			{
+				add(new Image("image", imageResource, srcSet));
+			}
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><a wicket:id='link'>link</a>" +
+				(get("image") != null ? "<img wicket:id='image'/>" : "") + "</body></html>");
+		}
+	}
+}
