+import org.apache.wicket.markup.html.form.ImageButton;
+import org.apache.wicket.markup.html.image.Image;
+import org.apache.wicket.markup.html.link.ResourceLink;
+import org.apache.wicket.request.mapper.parameter.PageParameters;
+import org.apache.wicket.request.resource.ByteArrayResource;
+import org.apache.wicket.request.resource.IResource;
+import org.apache.wicket.util.resource.IResourceStream;
+import org.apache.wicket.util.resource.StringResourceStream;
+import org.apache.wicket.util.tester.WicketTestCase;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Resources served by a component from its own listener URL must be authorized like resources
+ * requested by a resource URL.
+ */
+class ListenerResourceAuthorizationTest extends WicketTestCase
+{
+	/** resources the strategy refuses */
+	private final Set<IResource> refused = new HashSet<>();
+
+	/** resources the strategy was asked about */
+	private final List<IResource> asked = new ArrayList<>();
+
+	/** parameters the strategy was asked with */
+	private final List<PageParameters> askedParameters = new ArrayList<>();
+
+	/** resources that responded */
+	private final List<IResource> responded = new ArrayList<>();
+
+	private boolean clicked;
+
+	@BeforeEach
+	void installStrategy()
+	{
+		tester.getApplication()
+			.getSecuritySettings()
+			.setAuthorizationStrategy(new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					asked.add(resource);
+					askedParameters.add(parameters);
+					return refused.contains(resource) == false;
+				}
+			});
+	}
+
+	private IResource resource(String content)
+	{
+		return new ByteArrayResource("text/plain", content.getBytes())
+		{
+			@Override
+			public void respond(Attributes attributes)
+			{
+				responded.add(this);
+				super.respond(attributes);
+			}
+		};
+	}
+
+	@Test
+	void refusedResourceLink()
+	{
+		IResource report = resource("secret");
+		refused.add(report);
+
+		tester.startPage(new LinkPage(report));
+		tester.clickLink("link", false);
+
+		assertEquals(403, tester.getLastResponse().getStatus());
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+		assertEquals(List.of(report), asked);
+		assertNotNull(askedParameters.get(0));
+		assertTrue(askedParameters.get(0).isEmpty());
+		assertTrue(responded.isEmpty());
+		assertFalse(clicked);
+	}
+
+	@Test
+	void refusedResourceLinkCallsInstalledListener()
+	{
+		IResource report = resource("secret");
+		refused.add(report);
+		List<IResource> notified = new ArrayList<>();
+		tester.getApplication()
+			.getSecuritySettings()
+			.setUnauthorizedResourceRequestListener((resource, parameters) -> {
+				assertNotNull(parameters);
+				notified.add(resource);
+			});
+
+		tester.startPage(new LinkPage(report));
+		tester.clickLink("link", false);
+
+		assertEquals(List.of(report), notified);
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+		assertTrue(responded.isEmpty());
+		assertFalse(clicked);
+	}
+
+	@Test
+	void allowedResourceLink()
+	{
+		IResource report = resource("public");
+
+		tester.startPage(new LinkPage(report));
+		tester.clickLink("link", false);
+
+		assertEquals(200, tester.getLastResponse().getStatus());
+		assertEquals("public", tester.getLastResponseAsString());
+		assertEquals(List.of(report), asked);
+		assertEquals(List.of(report), responded);
+		assertTrue(clicked);
+	}
+
+	@Test
+	void refusedImage()
+	{
+		IResource src = resource("src");
+		refused.add(src);
+
+		ImagePage page = new ImagePage(new Image("image", src));
+		tester.startPage(page);
+		asked.clear();
+		tester.executeListener(page.get("image"));
+
+		assertEquals(403, tester.getLastResponse().getStatus());
+		assertEquals(List.of(src), asked);
+		assertTrue(responded.isEmpty());
+	}
+
+	@Test
+	void refusedSrcsetEntry()
+	{
+		IResource src = resource("src");
+		IResource set1 = resource("set1");
+		IResource set2 = resource("set2");
+		refused.add(set2);
+
+		ImagePage page = new ImagePage(new Image("image", src, set1, set2));
+		tester.startPage(page);
+		asked.clear();
+		tester.executeListener(page.get("image"));
+
+		assertEquals(403, tester.getLastResponse().getStatus());
+		assertEquals(List.of(src, set1, set2), asked);
+		assertTrue(responded.isEmpty());
+	}
+
+	@Test
+	void allowedImageWithSrcset()
+	{
+		IResource src = resource("src");
+		IResource set1 = resource("set1");
+
+		ImagePage page = new ImagePage(new Image("image", src, set1));
+		tester.startPage(page);
+		asked.clear();
+		tester.executeListener(page.get("image"));
+
+		assertEquals(200, tester.getLastResponse().getStatus());
+		assertEquals(List.of(src, set1), asked);
+		assertEquals(List.of(src, set1), responded);
+	}
+
+	@Test
+	void refusedImageButton()
+	{
+		IResource src = resource("src");
+		refused.add(src);
+
+		ImageButtonPage page = new ImageButtonPage(src);
+		tester.startPage(page);
+		asked.clear();
+		tester.executeListener(page.get("form:button"));
+
+		assertEquals(403, tester.getLastResponse().getStatus());
+		assertEquals(1, asked.size());
+		assertSame(src, asked.get(0));
+		assertTrue(responded.isEmpty());
+	}
+
+	private class LinkPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+
+		LinkPage(IResource resource)
+		{
+			add(new ResourceLink<Void>("link", resource)
+			{
+				private static final long serialVersionUID = 1L;
+
+				@Override
+				public void onClick()
+				{
+					clicked = true;
+				}
+			});
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream(
+				"<html><body><a wicket:id='link'>link</a></body></html>");
+		}
+	}
+
+	private static class ImagePage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+
+		ImagePage(Image image)
+		{
+			add(image);
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><img wicket:id='image'/></body></html>");
+		}
+	}
+
+	private static class ImageButtonPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+
+		ImageButtonPage(IResource resource)
+		{
+			Form<Void> form = new Form<>("form");
+			add(form);
+			form.add(new ImageButton("button", resource));
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream(
+				"<html><body><form wicket:id='form'><input type='image' wicket:id='button'/></form></body></html>");
+		}
+	}
+}
