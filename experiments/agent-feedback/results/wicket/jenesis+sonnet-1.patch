+package org.apache.wicket.markup.html.link;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import org.apache.wicket.util.tester.WicketTestCase;
+import org.apache.wicket.authorization.IAuthorizationStrategy;
+import org.apache.wicket.markup.html.WebPage;
+import org.apache.wicket.markup.IMarkupResourceStreamProvider;
+import org.apache.wicket.request.mapper.parameter.PageParameters;
+import org.apache.wicket.request.resource.IResource;
+import org.apache.wicket.util.resource.IResourceStream;
+import org.apache.wicket.util.resource.StringResourceStream;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+/**
+ * Tests that a resource served from a component's listener URL is authorized.
+ */
+class ResourceLinkAuthorizationTest extends WicketTestCase
+{
+	public static class LinkPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		static IResource resource;
+		static boolean clicked;
+
+		public LinkPage()
+		{
+			add(new ResourceLink<Void>("link", resource)
+			{
+				@Override
+				public void onClick()
+				{
+					clicked = true;
+				}
+			});
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(
+			org.apache.wicket.MarkupContainer container, Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><a wicket:id=\"link\">x</a></body></html>");
+		}
+	}
+
+	private void run(boolean allow, List<PageParameters> asked)
+	{
+		LinkPage.clicked = false;
+		LinkPage.resource = new org.apache.wicket.request.resource.ByteArrayResource("text/plain",
+			"secret".getBytes());
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(
+			new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					assertSame(LinkPage.resource, resource);
+					asked.add(parameters);
+					return allow;
+				}
+			});
+		tester.startPage(LinkPage.class);
+		tester.clickLink("link", false);
+	}
+
+	@Test
+	void refused()
+	{
+		List<PageParameters> asked = new ArrayList<>();
+		run(false, asked);
+		assertEquals(1, asked.size());
+		assertNotNull(asked.get(0));
+		assertEquals(403, tester.getLastResponse().getStatus());
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+		assertFalse(LinkPage.clicked);
+	}
+
+	@Test
+	void allowed()
+	{
+		List<PageParameters> asked = new ArrayList<>();
+		run(true, asked);
+		assertEquals(1, asked.size());
+		assertEquals("secret", tester.getLastResponseAsString());
+		assertTrue(LinkPage.clicked);
+	}
+}
