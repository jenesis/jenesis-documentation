+package org.apache.wicket.extensions.ajax;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import jakarta.servlet.http.HttpServletResponse;
+
+import org.apache.wicket.MarkupContainer;
+import org.apache.wicket.authorization.IAuthorizationStrategy;
+import org.apache.wicket.behavior.Behavior;
+import org.apache.wicket.markup.IMarkupResourceStreamProvider;
+import org.apache.wicket.markup.html.WebMarkupContainer;
+import org.apache.wicket.markup.html.WebPage;
+import org.apache.wicket.request.mapper.parameter.PageParameters;
+import org.apache.wicket.request.resource.ByteArrayResource;
+import org.apache.wicket.request.resource.IResource;
+import org.apache.wicket.util.resource.IResourceStream;
+import org.apache.wicket.util.resource.StringResourceStream;
+import org.apache.wicket.util.tester.WicketTestCase;
+import org.junit.jupiter.api.Test;
+
+/**
+ * An {@link AjaxDownloadBehavior} serving an {@link IResource} from its own listener is authorized
+ * like a resource requested by a resource URL.
+ */
+class AjaxDownloadBehaviorAuthorizationTest extends WicketTestCase
+{
+	private static class RecordingResource extends ByteArrayResource
+	{
+		private boolean responded;
+
+		RecordingResource()
+		{
+			super("text/plain", "secret".getBytes());
+		}
+
+		@Override
+		public void respond(Attributes attributes)
+		{
+			responded = true;
+			super.respond(attributes);
+		}
+	}
+
+	/** page with a download behavior */
+	public static class DownloadPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		final WebMarkupContainer container = new WebMarkupContainer("container");
+
+		DownloadPage(IResource resource)
+		{
+			add(container);
+			container.add(new AjaxDownloadBehavior(resource));
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container, Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><div wicket:id='container'></div></body></html>");
+		}
+	}
+
+	private void download(boolean refuse, RecordingResource resource, List<IResource> asked)
+	{
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(
+			new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource r, PageParameters parameters)
+				{
+					assertNotNull(parameters);
+					asked.add(r);
+					return refuse == false;
+				}
+			});
+
+		DownloadPage page = new DownloadPage(resource);
+		tester.startPage(page);
+		asked.clear();
+
+		Behavior resourceBehavior = page.container.getBehaviors()
+			.stream()
+			.filter(b -> b.getClass().getSimpleName().equals("ResourceBehavior"))
+			.findFirst()
+			.orElseThrow();
+		tester.invokeListener(page.container, resourceBehavior);
+	}
+
+	@Test
+	void refusedResourceIsNotServed()
+	{
+		RecordingResource resource = new RecordingResource();
+		List<IResource> asked = new ArrayList<>();
+
+		download(true, resource, asked);
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals(List.of(resource), asked);
+		assertFalse(resource.responded);
+	}
+
+	@Test
+	void allowedResourceIsServed()
+	{
+		RecordingResource resource = new RecordingResource();
+		List<IResource> asked = new ArrayList<>();
+
+		download(false, resource, asked);
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals(List.of(resource), asked);
+		assertTrue(resource.responded);
+	}
+}
