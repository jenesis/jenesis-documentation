+/**
+ * Resources served from a component's listener URL have to be authorized like resources served by
+ * a resource URL.
+ */
+class ListenerResourceAuthorizationTest extends WicketTestCase
+{
+	private final Set<IResource> refused = new HashSet<>();
+	private final List<IResource> asked = new ArrayList<>();
+	private final List<IResource> responded = new ArrayList<>();
+	private boolean clicked;
+
+	private class TrackedResource extends CharSequenceResource
+	{
+		TrackedResource(String data)
+		{
+			super("text/plain", data);
+		}
+
+		@Override
+		public void respond(Attributes attributes)
+		{
+			responded.add(this);
+			super.respond(attributes);
+		}
+	}
+
+	@BeforeEach
+	void installStrategy()
+	{
+		tester.getApplication()
+			.getSecuritySettings()
+			.setAuthorizationStrategy(new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					assertNotNull(parameters);
+					asked.add(resource);
+					return refused.contains(resource) == false;
+				}
+			});
+	}
+
+	@Test
+	void refusedResourceLink()
+	{
+		IResource resource = new TrackedResource("secret");
+		refused.add(resource);
+
+		tester.startPage(new LinkPage(resource));
+		tester.clickLink("link", false);
+
+		assertEquals(403, tester.getLastResponse().getStatus());
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+		assertEquals(List.of(resource), asked);
+		assertTrue(responded.isEmpty());
+		assertFalse(clicked);
+	}
+
+	@Test
+	void allowedResourceLink()
+	{
+		IResource resource = new TrackedResource("public");
+
+		tester.startPage(new LinkPage(resource));
+		tester.clickLink("link", false);
+
+		assertEquals(200, tester.getLastResponse().getStatus());
+		assertEquals("public", tester.getLastResponseAsString());
+		assertEquals(List.of(resource), asked);
+		assertEquals(List.of(resource), responded);
+		assertTrue(clicked);
+	}
+
+	@Test
+	void refusedResourceLinkUsesInstalledListener()
+	{
+		IResource resource = new TrackedResource("secret");
+		refused.add(resource);
+		List<IResource> notified = new ArrayList<>();
+		tester.getApplication()
+			.getSecuritySettings()
+			.setUnauthorizedResourceRequestListener((r, p) -> {
+				assertNotNull(p);
+				notified.add(r);
+			});
+
+		tester.startPage(new LinkPage(resource));
+		tester.clickLink("link", false);
+
+		assertEquals(List.of(resource), notified);
+		assertTrue(responded.isEmpty());
+		assertFalse(clicked);
+	}
+
+	@Test
+	void refusedImageResource()
+	{
+		IResource resource = new TrackedResource("secret");
+		refused.add(resource);
+
+		ImagePage page = new ImagePage(resource);
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(403, tester.getLastResponse().getStatus());
+		assertEquals(List.of(resource), asked);
+		assertTrue(responded.isEmpty());
+	}
+
+	@Test
+	void refusedImageSrcSetResource()
+	{
+		IResource src = new TrackedResource("src");
+		IResource srcset = new TrackedResource("secret");
+		refused.add(srcset);
+
+		ImagePage page = new ImagePage(src, srcset);
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(403, tester.getLastResponse().getStatus());
+		assertEquals(List.of(src, srcset), asked);
+		assertFalse(responded.contains(srcset));
+	}
+
+	@Test
+	void allowedImageSrcSet()
+	{
+		IResource src = new TrackedResource("src");
+		IResource srcset = new TrackedResource("set");
+
+		ImagePage page = new ImagePage(src, srcset);
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(200, tester.getLastResponse().getStatus());
+		assertEquals(List.of(src, srcset), asked);
+		assertEquals(List.of(src, srcset), responded);
+		assertSame(src, asked.get(0));
+	}
+
+	private class LinkPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		LinkPage(IResource resource)
+		{
+			add(new ResourceLink<Void>("link", resource)
+			{
+				@Override
+				public void onClick()
+				{
+					clicked = true;
+				}
+			});
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><a wicket:id='link'>link</a></body></html>");
+		}
+	}
+
+	private static class ImagePage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		ImagePage(IResource resource, IResource... resources)
+		{
+			add(new Image("image", resource, resources));
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><img wicket:id='image'/></body></html>");
+		}
+	}
+}
