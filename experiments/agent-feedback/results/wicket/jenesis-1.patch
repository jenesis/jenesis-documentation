+import org.apache.wicket.request.resource.IResource;
+import org.apache.wicket.util.resource.IResourceStream;
+import org.apache.wicket.util.resource.StringResourceStream;
+import org.apache.wicket.util.tester.WicketTestCase;
+import org.junit.jupiter.api.Test;
+
+/**
+ * An {@link Image} serving a resource from its listener url asks the authorization strategy.
+ */
+class ImageResourceAuthorizationTest extends WicketTestCase
+{
+	private final List<IResource> asked = new ArrayList<>();
+	private final List<IResource> responded = new ArrayList<>();
+
+	private IResource resource(String data)
+	{
+		return new CharSequenceResource("text/plain", data)
+		{
+			@Override
+			public void respond(Attributes attributes)
+			{
+				responded.add(this);
+				super.respond(attributes);
+			}
+		};
+	}
+
+	private void authorize(IResource refused)
+	{
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(
+			new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					assertNotNull(parameters);
+					asked.add(resource);
+					return resource != refused;
+				}
+			});
+	}
+
+	@Test
+	void refusedSrcSetEntryIsNotServed()
+	{
+		IResource src = resource("src");
+		IResource entry = resource("entry");
+		authorize(entry);
+
+		Image image = new Image("image", src, entry);
+		tester.startPage(new TestPage(image));
+		asked.clear();
+		tester.executeListener(image);
+
+		assertEquals(List.of(src, entry), asked);
+		assertTrue(responded.isEmpty());
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertFalse(tester.getLastResponseAsString().contains("entry"));
+	}
+
+	@Test
+	void refusedSrcIsNotServed()
+	{
+		IResource src = resource("src");
+		authorize(src);
+
+		Image image = new Image("image", src);
+		tester.startPage(new TestPage(image));
+		asked.clear();
+		tester.executeListener(image);
+
+		assertEquals(List.of(src), asked);
+		assertTrue(responded.isEmpty());
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+	}
+
+	@Test
+	void authorizedResourcesAreServed()
+	{
+		IResource src = resource("src");
+		IResource entry = resource("entry");
+		authorize(null);
+
+		Image image = new Image("image", src, entry);
+		tester.startPage(new TestPage(image));
+		asked.clear();
+		tester.executeListener(image);
+
+		assertEquals(List.of(src, entry), asked);
+		assertEquals(List.of(src, entry), responded);
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+	}
+
+	private static class TestPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		TestPage(Image image)
+		{
+			add(image);
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><img wicket:id=\"image\"/></body></html>");
+		}
+	}
+}
