+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * An {@link Image} serving a resource from its listener URL asks the authorization strategy.
+ */
+class ImageResourceAuthorizationTest extends WicketTestCase
+{
+	private final List<IResource> asked = new ArrayList<>();
+	private final Set<IResource> refused = new HashSet<>();
+	private final List<IResource> responded = new ArrayList<>();
+
+	@BeforeEach
+	void installStrategy()
+	{
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(
+			new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					if (parameters == null)
+					{
+						throw new AssertionError("null parameters");
+					}
+					asked.add(resource);
+					return refused.contains(resource) == false;
+				}
+			});
+	}
+
+	private IResource resource(String content)
+	{
+		return new ByteArrayResource("image/gif", content.getBytes())
+		{
+			@Override
+			public void respond(Attributes attributes)
+			{
+				responded.add(this);
+				super.respond(attributes);
+			}
+		};
+	}
+
+	@Test
+	void refusedResource()
+	{
+		IResource secret = resource("secret");
+		refused.add(secret);
+		TestPage page = new TestPage(new Image("image", secret));
+
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals(List.of(secret), asked);
+		assertEquals(List.of(), responded);
+	}
+
+	@Test
+	void refusedResourceFromModel()
+	{
+		IResource secret = resource("secret");
+		refused.add(secret);
+		TestPage page = new TestPage(new Image("image", Model.of(secret)));
+
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertSame(secret, asked.get(0));
+		assertEquals(List.of(), responded);
+	}
+
+	@Test
+	void refusedSrcSetEntry()
+	{
+		IResource src = resource("src");
+		IResource entry = resource("entry");
+		refused.add(entry);
+		TestPage page = new TestPage(new Image("image", src, entry));
+
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals(List.of(src, entry), asked);
+		assertEquals(List.of(), responded);
+	}
+
+	@Test
+	void authorizedResource()
+	{
+		IResource allowed = resource("allowed");
+		TestPage page = new TestPage(new Image("image", allowed));
+
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals("allowed", tester.getLastResponseAsString());
+		assertEquals(List.of(allowed), asked);
+		assertEquals(List.of(allowed), responded);
+	}
+
+	/** */
+	public static class TestPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		TestPage(Image image)
+		{
+			add(image);
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream(
+				"<html><body><img wicket:id=\"image\"/></body></html>");
+		}
+	}
+}
