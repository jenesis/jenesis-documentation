+/**
+ * An {@link AjaxDownloadBehavior} serving an {@link IResource} has to authorize it.
+ */
+class AjaxDownloadBehaviorAuthorizationTest extends WicketTestCase
+{
+	static class SecretResource extends ByteArrayResource
+	{
+		boolean responded;
+
+		SecretResource()
+		{
+			super("text/plain", "secret".getBytes());
+		}
+
+		@Override
+		public void respond(Attributes attributes)
+		{
+			responded = true;
+			super.respond(attributes);
+		}
+	}
+
+	/** */
+	public static class DownloadPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		final SecretResource resource = new SecretResource();
+		final WebMarkupContainer container = new WebMarkupContainer("container");
+
+		/** */
+		public DownloadPage()
+		{
+			add(container);
+			container.add(new AjaxDownloadBehavior(resource));
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream(
+				"<html><body><div wicket:id='container'></div></body></html>");
+		}
+	}
+
+	@Test
+	void rejected()
+	{
+		List<IResource> asked = new ArrayList<>();
+		List<PageParameters> parameters = new ArrayList<>();
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(
+			new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters pp)
+				{
+					asked.add(resource);
+					parameters.add(pp);
+					return false;
+				}
+			});
+
+		DownloadPage page = tester.startPage(DownloadPage.class);
+		Behavior resourceBehavior = page.container.getBehaviors()
+			.stream()
+			.filter(b -> b instanceof IRequestListener && !(b instanceof AjaxDownloadBehavior))
+			.findFirst()
+			.orElseThrow();
+		CharSequence url = page.container.urlForListener(resourceBehavior, null);
+		tester.executeUrl(Url.parse(url.toString()).toString());
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals(1, asked.size());
+		assertSame(page.resource, asked.get(0));
+		assertNotNull(parameters.get(0));
+		assertFalse(page.resource.responded);
+	}
+}
