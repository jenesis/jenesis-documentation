+# What the root pom configures on maven-surefire-plugin and Jenesis does not read from a plugin block:
+# <includes><include>**/*Test.java</include></includes>, so a class whose name does not end in Test is no test.
+jenesis.test.exclude=.*(?<!Test)
+# Surefire runs the tests against target/classes and target/test-classes; tests here open their resources as files.
+jenesis.test.jars=false
