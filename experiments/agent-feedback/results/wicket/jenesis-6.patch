+package org.apache.wicket.markup.html.link;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import org.apache.wicket.MarkupContainer;
+import org.apache.wicket.authorization.IAuthorizationStrategy;
+import org.apache.wicket.markup.IMarkupResourceStreamProvider;
+import org.apache.wicket.markup.html.WebPage;
+import org.apache.wicket.markup.html.form.Form;
+import org.apache.wicket.markup.html.form.ImageButton;
+import org.apache.wicket.markup.html.image.Image;
+import org.apache.wicket.request.mapper.parameter.PageParameters;
+import org.apache.wicket.request.resource.ByteArrayResource;
+import org.apache.wicket.request.resource.IResource;
+import org.apache.wicket.util.resource.IResourceStream;
+import org.apache.wicket.util.resource.StringResourceStream;
+import org.apache.wicket.util.tester.WicketTestCase;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Resources served from a component's own listener URL must be authorized like resources requested
+ * by a resource URL.
+ */
+class ResourceListenerAuthorizationTest extends WicketTestCase
+{
+	private final List<IResource> asked = new ArrayList<>();
+	private final List<IResource> refused = new ArrayList<>();
+	private boolean allow;
+
+	@BeforeEach
+	void installStrategy()
+	{
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(
+			new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					assertNotNull(parameters);
+					asked.add(resource);
+					return allow;
+				}
+			});
+	}
+
+	static class RecordingResource extends ByteArrayResource
+	{
+		private static final long serialVersionUID = 1L;
+		boolean responded;
+
+		RecordingResource()
+		{
+			super("text/plain", "secret".getBytes());
+		}
+
+		@Override
+		public void respond(Attributes attributes)
+		{
+			responded = true;
+			super.respond(attributes);
+		}
+	}
+
+	static class TestPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+		final RecordingResource link = new RecordingResource();
+		final RecordingResource src = new RecordingResource();
+		final RecordingResource srcset = new RecordingResource();
+		final RecordingResource button = new RecordingResource();
+		boolean clicked;
+
+		TestPage()
+		{
+			add(new ResourceLink<Void>("link", link)
+			{
+				private static final long serialVersionUID = 1L;
+
+				@Override
+				public void onClick()
+				{
+					clicked = true;
+				}
+			});
+			add(new Image("image", src, srcset));
+			Form<Void> form = new Form<>("form");
+			add(form);
+			form.add(new ImageButton("button", button));
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><a wicket:id='link'>link</a>" +
+				"<img wicket:id='image'/><form wicket:id='form'>" +
+				"<input type='image' wicket:id='button'/></form></body></html>");
+		}
+	}
+
+	@Test
+	void refusedResourceLinkIsNotServed()
+	{
+		TestPage page = tester.startPage(new TestPage());
+		tester.clickLink("link", false);
+
+		assertEquals(403, tester.getLastResponse().getStatus());
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+		assertFalse(page.link.responded);
+		assertFalse(page.clicked);
+		assertEquals(List.of(page.link), asked);
+	}
+
+	@Test
+	void refusalGoesToInstalledListener()
+	{
+		tester.getApplication().getSecuritySettings().setUnauthorizedResourceRequestListener(
+			(resource, parameters) -> {
+				assertNotNull(parameters);
+				refused.add(resource);
+			});
+		TestPage page = tester.startPage(new TestPage());
+		tester.clickLink("link", false);
+
+		assertEquals(List.of(page.link), refused);
+		assertFalse(page.link.responded);
+		assertFalse(page.clicked);
+	}
+
+	@Test
+	void allowedResourceLinkIsServed()
+	{
+		allow = true;
+		TestPage page = tester.startPage(new TestPage());
+		tester.clickLink("link", false);
+
+		assertEquals(200, tester.getLastResponse().getStatus());
+		assertEquals("secret", tester.getLastResponseAsString());
+		assertTrue(page.clicked);
+		assertEquals(List.of(page.link), asked);
+	}
+
+	@Test
+	void refusedImageIsNotServed()
+	{
+		TestPage page = tester.startPage(new TestPage());
+		tester.executeListener(page.get("image"));
+
+		assertEquals(403, tester.getLastResponse().getStatus());
+		assertFalse(page.src.responded);
+		assertFalse(page.srcset.responded);
+		assertSame(page.src, asked.get(0));
+	}
+
+	@Test
+	void allowedImageAsksForEverySrcsetEntry()
+	{
+		allow = true;
+		TestPage page = tester.startPage(new TestPage());
+		tester.executeListener(page.get("image"));
+
+		assertTrue(page.src.responded);
+		assertTrue(page.srcset.responded);
+		assertEquals(List.of(page.src, page.srcset), asked);
+	}
+
+	@Test
+	void refusedImageButtonIsNotServed()
+	{
+		TestPage page = tester.startPage(new TestPage());
+		tester.executeListener(page.get("form:button"));
+
+		assertEquals(403, tester.getLastResponse().getStatus());
+		assertFalse(page.button.responded);
+		assertEquals(List.of(page.button), asked);
+	}
+}
