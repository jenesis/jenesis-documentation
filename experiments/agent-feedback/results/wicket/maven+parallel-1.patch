+import org.junit.jupiter.api.Test;
+
+/**
+ * Tests authorization of the resource an {@link AjaxDownloadBehavior} serves from its listener URL.
+ */
+class AjaxDownloadBehaviorAuthorizationTest extends WicketTestCase
+{
+	private static class RecordingResource extends ByteArrayResource
+	{
+		boolean responded;
+
+		RecordingResource()
+		{
+			super("text/plain", "secret".getBytes());
+		}
+
+		@Override
+		public void respond(Attributes attributes)
+		{
+			responded = true;
+			super.respond(attributes);
+		}
+	}
+
+	/** test page */
+	public static class DownloadPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		/**
+		 * @param resource
+		 */
+		public DownloadPage(IResource resource)
+		{
+			WebMarkupContainer download = new WebMarkupContainer("download");
+			download.add(new AjaxDownloadBehavior(resource));
+			add(download);
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container, Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><div wicket:id='download'></div></body></html>");
+		}
+	}
+
+	private void download(boolean authorized, RecordingResource resource, List<IResource> asked)
+	{
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(
+			new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource r, PageParameters parameters)
+				{
+					assertNotNull(parameters);
+					asked.add(r);
+					return authorized;
+				}
+			});
+
+		tester.startPage(new DownloadPage(resource));
+		asked.clear();
+
+		WebMarkupContainer download = (WebMarkupContainer)tester.getComponentFromLastRenderedPage("download");
+		Behavior listener = download.getBehaviors().stream()
+			.filter(b -> b instanceof IRequestListener && !(b instanceof AjaxDownloadBehavior))
+			.findFirst().get();
+		tester.executeUrl(download.urlForListener(listener, null).toString());
+	}
+
+	@Test
+	void refusedResourceIsNotServed()
+	{
+		RecordingResource resource = new RecordingResource();
+		List<IResource> asked = new ArrayList<>();
+		download(false, resource, asked);
+
+		assertEquals(List.of(resource), asked);
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertFalse(resource.responded);
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+	}
+
+	@Test
+	void authorizedResourceIsServed()
+	{
+		RecordingResource resource = new RecordingResource();
+		List<IResource> asked = new ArrayList<>();
+		download(true, resource, asked);
+
+		assertEquals(List.of(resource), asked);
+		assertTrue(resource.responded);
+		assertEquals("secret", tester.getLastResponseAsString());
+	}
+}
