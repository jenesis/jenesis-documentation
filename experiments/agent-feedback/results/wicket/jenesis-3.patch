+	@Test
+	public void unauthorizedResource()
+	{
+		List<IResource> asked = new ArrayList<>();
+		List<PageParameters> parameters = new ArrayList<>();
+		boolean[] clicked = { false };
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(
+			new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource r, PageParameters p)
+				{
+					asked.add(r);
+					parameters.add(p);
+					return false;
+				}
+			});
+
+		PageWithResourceLink page = new PageWithResourceLink(new ResourceLink<Void>("link", resource)
+		{
+			@Override
+			public void onClick()
+			{
+				clicked[0] = true;
+			}
+		});
+		tester.startPage(page);
+		tester.clickLink("link", false);
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertFalse(tester.getLastResponseAsString().contains("DATA"));
+		assertEquals(1, asked.size());
+		assertSame(resource, asked.get(0));
+		assertNotNull(parameters.get(0));
+		assertFalse(clicked[0]);
+	}
+
+	/**
+	 * An allowed resource handed directly to the link is still served.
+	 */
+	@Test
+	public void authorizedResource()
+	{
+		tester.startPage(new PageWithResourceLink(resource));
+		tester.clickLink("link", false);
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals("DATA", tester.getLastResponseAsString());
+	}
 }
