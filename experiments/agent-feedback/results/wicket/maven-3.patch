+package org.apache.wicket.markup.html.link;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+import jakarta.servlet.http.HttpServletResponse;
+
+import org.apache.wicket.MarkupContainer;
+import org.apache.wicket.authorization.IAuthorizationStrategy;
+import org.apache.wicket.authorization.IUnauthorizedResourceRequestListener;
+import org.apache.wicket.markup.IMarkupResourceStreamProvider;
+import org.apache.wicket.markup.html.WebPage;
+import org.apache.wicket.markup.html.form.Form;
+import org.apache.wicket.markup.html.form.ImageButton;
+import org.apache.wicket.markup.html.image.Image;
+import org.apache.wicket.request.mapper.parameter.PageParameters;
+import org.apache.wicket.request.resource.ByteArrayResource;
+import org.apache.wicket.request.resource.IResource;
+import org.apache.wicket.util.resource.IResourceStream;
+import org.apache.wicket.util.resource.StringResourceStream;
+import org.apache.wicket.util.tester.WicketTestCase;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Resources served from a component's listener URL must be authorized like resources served by a
+ * resource URL.
+ */
+class ListenerResourceAuthorizationTest extends WicketTestCase
+{
+	private final Set<IResource> refused = new HashSet<>();
+	private final List<IResource> asked = new ArrayList<>();
+	private final List<PageParameters> askedParameters = new ArrayList<>();
+
+	private static boolean clicked;
+	private static final List<IResource> responded = new ArrayList<>();
+
+	private static class TrackingResource extends ByteArrayResource
+	{
+		private static final long serialVersionUID = 1L;
+
+		TrackingResource(String data)
+		{
+			super("text/plain", data.getBytes());
+		}
+
+		@Override
+		public void respond(Attributes attributes)
+		{
+			responded.add(this);
+			super.respond(attributes);
+		}
+	}
+
+	@BeforeEach
+	void setUp()
+	{
+		clicked = false;
+		responded.clear();
+		tester.getApplication()
+			.getSecuritySettings()
+			.setAuthorizationStrategy(new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					asked.add(resource);
+					askedParameters.add(parameters);
+					return !refused.contains(resource);
+				}
+			});
+	}
+
+	@Test
+	void refusedResourceLink()
+	{
+		IResource report = new TrackingResource("secret");
+		refused.add(report);
+
+		tester.startPage(new LinkPage(report));
+		tester.clickLink("link", false);
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+		assertEquals(1, asked.size());
+		assertSame(report, asked.get(0));
+		assertNotNull(askedParameters.get(0));
+		assertTrue(responded.isEmpty());
+		assertFalse(clicked);
+	}
+
+	@Test
+	void allowedResourceLink()
+	{
+		IResource report = new TrackingResource("public");
+
+		tester.startPage(new LinkPage(report));
+		tester.clickLink("link", false);
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals("public", tester.getLastResponseAsString());
+		assertEquals(1, asked.size());
+		assertSame(report, asked.get(0));
+		assertTrue(clicked);
+	}
+
+	@Test
+	void refusedResourceLinkUsesInstalledListener()
+	{
+		IResource report = new TrackingResource("secret");
+		refused.add(report);
+		List<IResource> notified = new ArrayList<>();
+		tester.getApplication()
+			.getSecuritySettings()
+			.setUnauthorizedResourceRequestListener(new IUnauthorizedResourceRequestListener()
+			{
+				@Override
+				public void onUnauthorizedRequest(IResource resource, PageParameters parameters)
+				{
+					assertNotNull(parameters);
+					notified.add(resource);
+				}
+			});
+
+		tester.startPage(new LinkPage(report));
+		tester.clickLink("link", false);
+
+		assertEquals(1, notified.size());
+		assertSame(report, notified.get(0));
+		assertTrue(responded.isEmpty());
+		assertFalse(clicked);
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+	}
+
+	@Test
+	void imageWithSrcsetAsksForEveryResource()
+	{
+		IResource src = new TrackingResource("src");
+		IResource set1 = new TrackingResource("set1");
+		IResource set2 = new TrackingResource("set2");
+		refused.add(set2);
+
+		ImagePage page = new ImagePage(new Image("image", src, set1, set2));
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(List.of(src, set1, set2), asked);
+		askedParameters.forEach(p -> assertNotNull(p));
+		assertFalse(responded.contains(set2));
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+	}
+
+	@Test
+	void refusedImage()
+	{
+		IResource src = new TrackingResource("secret");
+		refused.add(src);
+
+		ImagePage page = new ImagePage(new Image("image", src));
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(List.of(src), asked);
+		assertTrue(responded.isEmpty());
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+	}
+
+	@Test
+	void refusedImageButton()
+	{
+		IResource src = new TrackingResource("secret");
+		refused.add(src);
+
+		ImageButtonPage page = new ImageButtonPage(src);
+		tester.startPage(page);
+		tester.executeListener(page.get("form:button"));
+
+		assertEquals(List.of(src), asked);
+		assertTrue(responded.isEmpty());
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+	}
+
+	/** */
+	public static class LinkPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+
+		LinkPage(IResource resource)
+		{
+			add(new ResourceLink<Void>("link", resource)
+			{
+				private static final long serialVersionUID = 1L;
+
+				@Override
+				public void onClick()
+				{
+					clicked = true;
+				}
+			});
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream(
+				"<html><body><a wicket:id=\"link\">link</a></body></html>");
+		}
+	}
+
+	/** */
+	public static class ImagePage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+
+		ImagePage(Image image)
+		{
+			add(image);
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><img wicket:id=\"image\"/></body></html>");
+		}
+	}
+
+	/** */
+	public static class ImageButtonPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+
+		ImageButtonPage(IResource resource)
+		{
+			Form<Void> form = new Form<>("form");
+			add(form);
+			form.add(new ImageButton("button", resource));
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream(
+				"<html><body><form wicket:id=\"form\"><input type=\"image\" wicket:id=\"button\"/></form></body></html>");
+		}
+	}
+}
