+/**
+ * A resource served by {@link AjaxDownloadBehavior} from its own listener URL is authorized.
+ */
+class AjaxDownloadBehaviorAuthorizationTest extends WicketTestCase
+{
+	private static class RecordingStrategy extends IAuthorizationStrategy.AllowAllAuthorizationStrategy
+	{
+		final List<IResource> resources = new ArrayList<>();
+		final List<PageParameters> parameters = new ArrayList<>();
+
+		@Override
+		public boolean isResourceAuthorized(IResource resource, PageParameters pageParameters)
+		{
+			resources.add(resource);
+			parameters.add(pageParameters);
+			return false;
+		}
+	}
+
+	private static class RecordingResource extends ByteArrayResource
+	{
+		boolean responded;
+
+		RecordingResource()
+		{
+			super("text/plain", "secret".getBytes());
+		}
+
+		@Override
+		public void respond(Attributes attributes)
+		{
+			responded = true;
+			super.respond(attributes);
+		}
+	}
+
+	public static class DownloadPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		final RecordingResource resource = new RecordingResource();
+		final WebMarkupContainer container = new WebMarkupContainer("container");
+
+		public DownloadPage()
+		{
+			add(container);
+			container.add(new AjaxDownloadBehavior(resource));
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container, Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><div wicket:id='container'></div></body></html>");
+		}
+	}
+
+	@Test
+	void refusedResourceIsNotServed()
+	{
+		RecordingStrategy strategy = new RecordingStrategy();
+		DownloadPage page = tester.startPage(new DownloadPage());
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(strategy);
+
+		Behavior listener = page.container.getBehaviors().stream()
+			.filter(b -> b instanceof IRequestListener && !(b instanceof AjaxDownloadBehavior))
+			.findFirst()
+			.orElseThrow();
+		Url url = Url.parse(page.container.urlForListener(listener, null).toString());
+		tester.executeUrl(url.toString());
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals(1, strategy.resources.size());
+		assertSame(page.resource, strategy.resources.get(0));
+		assertNotNull(strategy.parameters.get(0));
+		assertFalse(page.resource.responded);
+	}
