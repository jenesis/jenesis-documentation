+import org.apache.wicket.util.resource.StringResourceStream;
+import org.apache.wicket.util.tester.WicketTestCase;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Resources given directly to an {@link Image} are authorized when served from its listener URL.
+ */
+class ImageResourceAuthorizationTest extends WicketTestCase
+{
+	private final List<IResource> responded = new ArrayList<>();
+
+	private IResource resource(String data)
+	{
+		return new CharSequenceResource("text/plain", data)
+		{
+			@Override
+			public void respond(Attributes attributes)
+			{
+				responded.add(this);
+				super.respond(attributes);
+			}
+		};
+	}
+
+	@Test
+	void srcAndSrcSetAreAuthorized()
+	{
+		IResource src = resource("src");
+		IResource set1 = resource("set1");
+		IResource set2 = resource("set2");
+		List<IResource> asked = new ArrayList<>();
+		List<IResource> refusedNotified = new ArrayList<>();
+
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(
+			new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					assertTrue(parameters != null && parameters.isEmpty());
+					asked.add(resource);
+					return resource != set1;
+				}
+			});
+		tester.getApplication().getSecuritySettings().setUnauthorizedResourceRequestListener(
+			new IUnauthorizedResourceRequestListener()
+			{
+				@Override
+				public void onUnauthorizedRequest(IResource resource, PageParameters parameters)
+				{
+					refusedNotified.add(resource);
+				}
+			});
+
+		TestPage page = new TestPage(new Image("image", src, set1, set2));
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(List.of(src, set1, set2), asked);
+		assertEquals(List.of(set1), refusedNotified);
+		assertEquals(List.of(src, set2), responded);
+	}
+
+	@Test
+	void refusedSrcGives403()
+	{
+		IResource src = resource("secret");
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(
+			new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					assertSame(src, resource);
+					return false;
+				}
+			});
+
+		TestPage page = new TestPage(new Image("image", src));
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+		assertTrue(responded.isEmpty());
+	}
+
+	private static class TestPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		TestPage(Image image)
+		{
+			add(image);
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><img wicket:id=\"image\"/></body></html>");
+		}
+	}
+}
