+import org.junit.jupiter.api.Test;
+
+/**
+ * Resources served from a component's own listener URL must be authorized like resources
+ * requested by a resource URL.
+ */
+class ResourceListenerAuthorizationTest extends WicketTestCase
+{
+	private final Set<IResource> refused = new HashSet<>();
+	private final List<IResource> asked = new ArrayList<>();
+	private final List<IResource> responded = new ArrayList<>();
+	private boolean clicked;
+
+	@Override
+	protected WebApplication newApplication()
+	{
+		return new MockApplication()
+		{
+			@Override
+			protected void init()
+			{
+				super.init();
+				getSecuritySettings().setAuthorizationStrategy(
+					new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+					{
+						@Override
+						public boolean isResourceAuthorized(IResource resource,
+							PageParameters parameters)
+						{
+							assertNotNull(parameters);
+							asked.add(resource);
+							return !refused.contains(resource);
+						}
+					});
+			}
+		};
+	}
+
+	private IResource resource(String content)
+	{
+		return new ByteArrayResource("text/plain", content.getBytes())
+		{
+			@Override
+			public void respond(Attributes attributes)
+			{
+				responded.add(this);
+				super.respond(attributes);
+			}
+		};
+	}
+
+	@Test
+	void refusedResourceLink()
+	{
+		IResource secret = resource("secret");
+		refused.add(secret);
+		tester.startPage(new LinkPage(secret));
+		tester.clickLink("link", false);
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+		assertEquals(List.of(secret), asked);
+		assertTrue(responded.isEmpty());
+		assertFalse(clicked);
+	}
+
+	@Test
+	void refusedResourceLinkWithCustomListener()
+	{
+		List<IResource> notified = new ArrayList<>();
+		tester.getApplication().getSecuritySettings().setUnauthorizedResourceRequestListener(
+			(resource, parameters) -> notified.add(resource));
+		IResource secret = resource("secret");
+		refused.add(secret);
+		tester.startPage(new LinkPage(secret));
+		tester.clickLink("link", false);
+
+		assertEquals(List.of(secret), notified);
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+		assertTrue(responded.isEmpty());
+		assertFalse(clicked);
+	}
+
+	@Test
+	void allowedResourceLink()
+	{
+		IResource open = resource("open");
+		tester.startPage(new LinkPage(open));
+		tester.clickLink("link", false);
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals("open", tester.getLastResponseAsString());
+		assertEquals(List.of(open), asked);
+		assertTrue(clicked);
+	}
+
+	@Test
+	void refusedImage()
+	{
+		IResource secret = resource("secret");
+		refused.add(secret);
+		ImagePage page = new ImagePage(new Image("image", secret));
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertSame(secret, asked.get(0));
+		assertTrue(responded.isEmpty());
+	}
+
+	@Test
+	void imageAsksForEverySrcsetEntry()
+	{
+		IResource src = resource("src");
+		IResource set1 = resource("set1");
+		IResource set2 = resource("set2");
+		ImagePage page = new ImagePage(new Image("image", src, set1, set2));
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(List.of(src, set1, set2), asked);
+	}
+
+	@Test
+	void refusedSrcsetEntry()
+	{
+		IResource src = resource("src");
+		IResource set1 = resource("set1");
+		refused.add(set1);
+		ImagePage page = new ImagePage(new Image("image", src, set1));
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals(List.of(src, set1), asked);
+		assertFalse(responded.contains(set1));
+	}
+
+	@Test
+	void refusedImageButton()
+	{
+		IResource secret = resource("secret");
+		refused.add(secret);
+		ImageButtonPage page = new ImageButtonPage(secret);
+		tester.startPage(page);
+		tester.executeListener(page.get("form:button"));
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals(List.of(secret), asked);
+		assertTrue(responded.isEmpty());
+	}
+
+	private class LinkPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		LinkPage(IResource resource)
+		{
+			add(new ResourceLink<Void>("link", resource)
+			{
+				@Override
+				public void onClick()
+				{
+					clicked = true;
+				}
+			});
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><a wicket:id='link'>link</a></body></html>");
+		}
+	}
+
+	private static class ImagePage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		ImagePage(Image image)
+		{
+			add(image);
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><img wicket:id='image'/></body></html>");
+		}
+	}
+
+	private static class ImageButtonPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		ImageButtonPage(IResource resource)
+		{
+			Form<Void> form = new Form<>("form");
+			add(form);
+			form.add(new ImageButton("button", resource));
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream(
+				"<html><body><form wicket:id='form'><input type='image' wicket:id='button'/></form></body></html>");
+		}
+	}
+}
