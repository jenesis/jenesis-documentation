+import org.junit.jupiter.api.Test;
+
+/**
+ * A resource served by {@link AjaxDownloadBehavior} from its own listener URL must be authorized.
+ */
+class AjaxDownloadBehaviorAuthorizationTest extends WicketTestCase
+{
+	private final List<IResource> asked = new ArrayList<>();
+	private final List<IResource> responded = new ArrayList<>();
+	private boolean allow;
+
+	@Override
+	protected WebApplication newApplication()
+	{
+		return new MockApplication()
+		{
+			@Override
+			protected void init()
+			{
+				super.init();
+				getSecuritySettings().setAuthorizationStrategy(
+					new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+					{
+						@Override
+						public boolean isResourceAuthorized(IResource resource,
+							PageParameters parameters)
+						{
+							assertNotNull(parameters);
+							asked.add(resource);
+							return allow;
+						}
+					});
+			}
+		};
+	}
+
+	private void download(IResource resource)
+	{
+		DownloadPage page = new DownloadPage(new AjaxDownloadBehavior(resource));
+		tester.startPage(page);
+		MarkupContainer component = (MarkupContainer)page.get("component");
+		Behavior listener = component.getBehaviors()
+			.stream()
+			.filter(b -> b instanceof IRequestListener && !(b instanceof AjaxDownloadBehavior))
+			.findFirst()
+			.orElseThrow();
+		tester.invokeListener(component, listener);
+	}
+
+	private IResource resource()
+	{
+		return new ByteArrayResource("text/plain", "secret".getBytes())
+		{
+			@Override
+			public void respond(Attributes attributes)
+			{
+				responded.add(this);
+				super.respond(attributes);
+			}
+		};
+	}
+
+	@Test
+	void refused()
+	{
+		IResource secret = resource();
+		download(secret);
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+		assertEquals(1, asked.size());
+		assertSame(secret, asked.get(0));
+		assertEquals(0, responded.size());
+	}
+
+	@Test
+	void allowed()
+	{
+		allow = true;
+		IResource open = resource();
+		download(open);
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals("secret", tester.getLastResponseAsString());
+		assertEquals(List.of(open), asked);
+		assertEquals(List.of(open), responded);
+	}
+
+	private static class DownloadPage extends WebPage implements IMarkupResourceStreamProvider
+	{
