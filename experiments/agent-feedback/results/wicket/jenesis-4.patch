+package org.apache.wicket.core.request.handler.resource;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import jakarta.servlet.http.HttpServletResponse;
+
+import org.apache.wicket.MarkupContainer;
+import org.apache.wicket.authorization.IAuthorizationStrategy;
+import org.apache.wicket.markup.IMarkupResourceStreamProvider;
+import org.apache.wicket.markup.html.WebPage;
+import org.apache.wicket.markup.html.image.Image;
+import org.apache.wicket.markup.html.link.ResourceLink;
+import org.apache.wicket.request.mapper.parameter.PageParameters;
+import org.apache.wicket.request.resource.ByteArrayResource;
+import org.apache.wicket.request.resource.IResource;
+import org.apache.wicket.util.resource.IResourceStream;
+import org.apache.wicket.util.resource.StringResourceStream;
+import org.apache.wicket.util.tester.WicketTestCase;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Resources served from a component's listener URL must be authorized like resources served from a
+ * resource URL.
+ */
+class ListenerResourceAuthorizationTest extends WicketTestCase
+{
+	private final List<IResource> asked = new ArrayList<>();
+
+	private boolean allow;
+
+	private static class RecordingResource extends ByteArrayResource
+	{
+		boolean responded;
+
+		RecordingResource(String content)
+		{
+			super("text/plain", content.getBytes());
+		}
+
+		@Override
+		public void respond(Attributes attributes)
+		{
+			responded = true;
+			super.respond(attributes);
+		}
+
+		@Override
+		public String toString()
+		{
+			return "RecordingResource";
+		}
+	}
+
+	/** */
+	public static class LinkPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		final RecordingResource resource = new RecordingResource("secret");
+		boolean clicked;
+
+		/** */
+		public LinkPage()
+		{
+			add(new ResourceLink<Void>("report", resource)
+			{
+				@Override
+				public void onClick()
+				{
+					clicked = true;
+				}
+			});
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><a wicket:id='report'>r</a></body></html>");
+		}
+	}
+
+	/** */
+	public static class ImagePage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		final RecordingResource src = new RecordingResource("src");
+		final RecordingResource srcset = new RecordingResource("srcset");
+
+		/** */
+		public ImagePage()
+		{
+			add(new Image("image", src, srcset));
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><img wicket:id='image'/></body></html>");
+		}
+	}
+
+	@BeforeEach
+	void setUp()
+	{
+		tester.getApplication()
+			.getSecuritySettings()
+			.setAuthorizationStrategy(new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					assertNotNull(parameters);
+					asked.add(resource);
+					return allow;
+				}
+			});
+	}
+
+	@Test
+	void refusedResourceLinkIs403()
+	{
+		LinkPage page = tester.startPage(LinkPage.class);
+		tester.clickLink("report", false);
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals(
+			"The request to resource 'RecordingResource' with parameters '' cannot be authorized.",
+			tester.getLastResponse().getErrorMessage());
+		assertEquals(List.of(page.resource), asked);
+		assertFalse(page.resource.responded);
+		assertFalse(page.clicked);
+	}
+
+	@Test
+	void refusedResourceLinkCallsInstalledListener()
+	{
+		List<IResource> refused = new ArrayList<>();
+		tester.getApplication()
+			.getSecuritySettings()
+			.setUnauthorizedResourceRequestListener((resource, parameters) -> refused.add(resource));
+
+		LinkPage page = tester.startPage(LinkPage.class);
+		tester.clickLink("report", false);
+
+		assertEquals(List.of(page.resource), refused);
+		assertFalse(page.resource.responded);
+		assertFalse(page.clicked);
+	}
+
+	@Test
+	void allowedResourceLinkIsServed()
+	{
+		allow = true;
+		LinkPage page = tester.startPage(LinkPage.class);
+		tester.clickLink("report", false);
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals("secret", tester.getLastResponseAsString());
+		assertEquals(List.of(page.resource), asked);
+		assertTrue(page.clicked);
+	}
+
+	@Test
+	void refusedImageIs403()
+	{
+		ImagePage page = tester.startPage(ImagePage.class);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals(List.of(page.src), asked);
+		assertFalse(page.src.responded);
+		assertFalse(page.srcset.responded);
+	}
+
+	@Test
+	void refusedImageSrcsetIsNotServed()
+	{
+		ImagePage page = tester.startPage(ImagePage.class);
+		tester.getApplication()
+			.getSecuritySettings()
+			.setAuthorizationStrategy(new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					asked.add(resource);
+					return resource != page.srcset;
+				}
+			});
+		tester.executeListener(page.get("image"));
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals(List.of(page.src, page.srcset), asked);
+		assertFalse(page.src.responded);
+		assertFalse(page.srcset.responded);
+	}
+
+	@Test
+	void allowedImageIsServed()
+	{
+		allow = true;
+		ImagePage page = tester.startPage(ImagePage.class);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(List.of(page.src, page.srcset), asked);
+		assertTrue(page.src.responded);
+		assertTrue(page.srcset.responded);
+	}
+}
