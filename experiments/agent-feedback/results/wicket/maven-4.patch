+package org.apache.wicket.extensions.ajax;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import org.apache.wicket.IRequestListener;
+import org.apache.wicket.MarkupContainer;
+import org.apache.wicket.authorization.IAuthorizationStrategy;
+import org.apache.wicket.behavior.Behavior;
+import org.apache.wicket.markup.IMarkupResourceStreamProvider;
+import org.apache.wicket.markup.html.WebMarkupContainer;
+import org.apache.wicket.markup.html.WebPage;
+import org.apache.wicket.mock.MockApplication;
+import org.apache.wicket.protocol.http.WebApplication;
+import org.apache.wicket.request.mapper.parameter.PageParameters;
+import org.apache.wicket.request.resource.ByteArrayResource;
+import org.apache.wicket.request.resource.IResource;
+import org.apache.wicket.util.resource.IResourceStream;
+import org.apache.wicket.util.resource.StringResourceStream;
+import org.apache.wicket.util.tester.WicketTestCase;
+import org.junit.jupiter.api.Test;
+
+/**
+ * An {@link AjaxDownloadBehavior} constructed with an {@link IResource} has to authorize it.
+ */
+class AjaxDownloadBehaviorAuthorizationTest extends WicketTestCase
+{
+	private static final List<IResource> ASKED = new ArrayList<>();
+	private static final List<PageParameters> ASKED_PARAMETERS = new ArrayList<>();
+	private static final List<IResource> RESPONDED = new ArrayList<>();
+	private static boolean refuse;
+
+	@Override
+	protected WebApplication newApplication()
+	{
+		ASKED.clear();
+		ASKED_PARAMETERS.clear();
+		RESPONDED.clear();
+		refuse = true;
+		return new MockApplication()
+		{
+			@Override
+			protected void init()
+			{
+				super.init();
+				getSecuritySettings().setAuthorizationStrategy(
+					new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+					{
+						@Override
+						public boolean isResourceAuthorized(IResource resource,
+							PageParameters parameters)
+						{
+							ASKED.add(resource);
+							ASKED_PARAMETERS.add(parameters);
+							return refuse == false;
+						}
+					});
+			}
+		};
+	}
+
+	private String requestResource(IResource resource)
+	{
+		DownloadPage page = new DownloadPage(resource);
+		tester.startPage(page);
+
+		Behavior resourceBehavior = null;
+		for (Behavior behavior : page.container.getBehaviors())
+		{
+			if (behavior instanceof IRequestListener && !(behavior instanceof AjaxDownloadBehavior))
+			{
+				resourceBehavior = behavior;
+			}
+		}
+		assertNotNull(resourceBehavior);
+		String url = page.container.urlForListener(resourceBehavior, null).toString();
+		tester.executeUrl(url);
+		return tester.getLastResponseAsString();
+	}
+
+	private static IResource resource()
+	{
+		return new ByteArrayResource("text/plain", "secret".getBytes())
+		{
+			@Override
+			public void respond(Attributes attributes)
+			{
+				RESPONDED.add(this);
+				super.respond(attributes);
+			}
+		};
+	}
+
+	@Test
+	void refused()
+	{
+		IResource resource = resource();
+		String body = requestResource(resource);
+
+		assertEquals(403, tester.getLastResponse().getStatus());
+		assertFalse(body.contains("secret"));
+		assertEquals(List.of(resource), ASKED);
+		assertTrue(ASKED_PARAMETERS.get(0).isEmpty());
+		assertTrue(RESPONDED.isEmpty());
+	}
+
+	@Test
+	void allowed()
+	{
+		refuse = false;
+		IResource resource = resource();
+		String body = requestResource(resource);
+
+		assertEquals(200, tester.getLastResponse().getStatus());
+		assertEquals("secret", body);
+		assertEquals(List.of(resource), ASKED);
+		assertEquals(List.of(resource), RESPONDED);
+	}
+
+	/** */
+	public static class DownloadPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+
+		final WebMarkupContainer container;
+
+		DownloadPage(IResource resource)
+		{
+			container = new WebMarkupContainer("container");
+			container.add(new AjaxDownloadBehavior(resource));
+			add(container);
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream(
+				"<html><body><div wicket:id='container'></div></body></html>");
+		}
+	}
+}
