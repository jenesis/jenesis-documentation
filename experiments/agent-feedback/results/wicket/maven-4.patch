+package org.apache.wicket.authorization;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
+import org.apache.wicket.MarkupContainer;
+import org.apache.wicket.markup.IMarkupResourceStreamProvider;
+import org.apache.wicket.markup.html.WebPage;
+import org.apache.wicket.markup.html.form.Form;
+import org.apache.wicket.markup.html.form.ImageButton;
+import org.apache.wicket.markup.html.image.Image;
+import org.apache.wicket.markup.html.link.ResourceLink;
+import org.apache.wicket.mock.MockApplication;
+import org.apache.wicket.protocol.http.WebApplication;
+import org.apache.wicket.request.mapper.parameter.PageParameters;
+import org.apache.wicket.request.resource.ByteArrayResource;
+import org.apache.wicket.request.resource.IResource;
+import org.apache.wicket.util.resource.IResourceStream;
+import org.apache.wicket.util.resource.StringResourceStream;
+import org.apache.wicket.util.tester.WicketTestCase;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Resources served by components from their own listener URL have to be authorized like resources
+ * requested by a resource URL.
+ */
+class ComponentResourceAuthorizationTest extends WicketTestCase
+{
+	/** resources refused by the strategy */
+	private static final Set<IResource> REFUSED = ConcurrentHashMap.newKeySet();
+
+	/** resources the strategy was asked about */
+	private static final List<IResource> ASKED = new ArrayList<>();
+
+	private static final List<PageParameters> ASKED_PARAMETERS = new ArrayList<>();
+
+	/** resources whose respond was called */
+	private static final List<IResource> RESPONDED = new ArrayList<>();
+
+	private static boolean clicked;
+
+	private final List<IResource> unauthorizedListenerCalls = new ArrayList<>();
+
+	@Override
+	protected WebApplication newApplication()
+	{
+		REFUSED.clear();
+		ASKED.clear();
+		ASKED_PARAMETERS.clear();
+		RESPONDED.clear();
+		clicked = false;
+		return new MockApplication()
+		{
+			@Override
+			protected void init()
+			{
+				super.init();
+				getSecuritySettings().setAuthorizationStrategy(
+					new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+					{
+						@Override
+						public boolean isResourceAuthorized(IResource resource,
+							PageParameters parameters)
+						{
+							ASKED.add(resource);
+							ASKED_PARAMETERS.add(parameters);
+							return REFUSED.contains(resource) == false;
+						}
+					});
+			}
+		};
+	}
+
+	private static IResource resource(String content)
+	{
+		return new ByteArrayResource("text/plain", content.getBytes())
+		{
+			@Override
+			public void respond(Attributes attributes)
+			{
+				RESPONDED.add(this);
+				super.respond(attributes);
+			}
+		};
+	}
+
+	private void assertAskedWithEmptyParameters()
+	{
+		assertFalse(ASKED_PARAMETERS.isEmpty());
+		for (PageParameters parameters : ASKED_PARAMETERS)
+		{
+			assertNotNull(parameters);
+			assertTrue(parameters.isEmpty());
+		}
+	}
+
+	@Test
+	void resourceLinkRefused()
+	{
+		IResource secret = resource("secret");
+		REFUSED.add(secret);
+
+		tester.startPage(new LinkPage(secret));
+		tester.clickLink("link", false);
+
+		assertEquals(403, tester.getLastResponse().getStatus());
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+		assertEquals(List.of(secret), ASKED);
+		assertAskedWithEmptyParameters();
+		assertTrue(RESPONDED.isEmpty());
+		assertFalse(clicked);
+	}
+
+	@Test
+	void resourceLinkAllowed()
+	{
+		IResource data = resource("data");
+
+		tester.startPage(new LinkPage(data));
+		tester.clickLink("link", false);
+
+		assertEquals(200, tester.getLastResponse().getStatus());
+		assertEquals("data", tester.getLastResponseAsString());
+		assertEquals(List.of(data), ASKED);
+		assertAskedWithEmptyParameters();
+		assertEquals(List.of(data), RESPONDED);
+		assertTrue(clicked);
+	}
+
+	@Test
+	void customUnauthorizedListenerIsCalled()
+	{
+		tester.getApplication()
+			.getSecuritySettings()
+			.setUnauthorizedResourceRequestListener(
+				(resource, parameters) -> unauthorizedListenerCalls.add(resource));
+		IResource secret = resource("secret");
+		REFUSED.add(secret);
+
+		tester.startPage(new LinkPage(secret));
+		tester.clickLink("link", false);
+
+		assertEquals(List.of(secret), unauthorizedListenerCalls);
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+		assertTrue(RESPONDED.isEmpty());
+		assertFalse(clicked);
+	}
+
+	@Test
+	void imageRefused()
+	{
+		IResource secret = resource("secret");
+		REFUSED.add(secret);
+
+		ImagePage page = new ImagePage(secret);
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(403, tester.getLastResponse().getStatus());
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+		assertEquals(List.of(secret), ASKED);
+		assertAskedWithEmptyParameters();
+		assertTrue(RESPONDED.isEmpty());
+	}
+
+	@Test
+	void imageSrcsetRefused()
+	{
+		IResource src = resource("src");
+		IResource secret = resource("secret");
+		REFUSED.add(secret);
+
+		ImagePage page = new ImagePage(src, secret);
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(403, tester.getLastResponse().getStatus());
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+		assertEquals(List.of(src, secret), ASKED);
+		assertAskedWithEmptyParameters();
+		assertTrue(RESPONDED.isEmpty());
+	}
+
+	@Test
+	void imageSrcsetAllowed()
+	{
+		IResource src = resource("src");
+		IResource other = resource("other");
+
+		ImagePage page = new ImagePage(src, other);
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(200, tester.getLastResponse().getStatus());
+		assertEquals(List.of(src, other), ASKED);
+		assertEquals(List.of(src, other), RESPONDED);
+	}
+
+	@Test
+	void imageButtonRefused()
+	{
+		IResource secret = resource("secret");
+		REFUSED.add(secret);
+
+		ImageButtonPage page = new ImageButtonPage(secret);
+		tester.startPage(page);
+		tester.executeListener(page.get("form:button"));
+
+		assertEquals(403, tester.getLastResponse().getStatus());
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+		assertEquals(1, ASKED.size());
+		assertSame(secret, ASKED.get(0));
+		assertAskedWithEmptyParameters();
+		assertTrue(RESPONDED.isEmpty());
+	}
+
+	/** */
+	public static class LinkPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+
+		LinkPage(IResource resource)
+		{
+			add(new ResourceLink<Void>("link", resource)
+			{
+				private static final long serialVersionUID = 1L;
+
+				@Override
+				public void onClick()
+				{
+					clicked = true;
+				}
+			});
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream(
+				"<html><body><a wicket:id='link'>link</a></body></html>");
+		}
+	}
+
+	/** */
+	public static class ImagePage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+
+		ImagePage(IResource resource, IResource... others)
+		{
+			add(new Image("image", resource, others));
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><img wicket:id='image'/></body></html>");
+		}
+	}
+
+	/** */
+	public static class ImageButtonPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+
+		ImageButtonPage(IResource resource)
+		{
+			Form<Void> form = new Form<>("form");
+			add(form);
+			form.add(new ImageButton("button", resource));
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream(
+				"<html><body><form wicket:id='form'><input type='image' wicket:id='button'/></form></body></html>");
+		}
+	}
+}
