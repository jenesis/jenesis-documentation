+import org.apache.wicket.util.tester.WicketTestCase;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Resources served by a component from its own listener URL must be authorized like resources
+ * requested by a resource URL.
+ */
+class ListenerResourceAuthorizationTest extends WicketTestCase
+{
+	private final List<IResource> asked = new ArrayList<>();
+	private final List<IResource> refusedNotified = new ArrayList<>();
+	private final List<IResource> responded = new ArrayList<>();
+	private IResource refused;
+
+	private class TrackingResource extends ByteArrayResource
+	{
+		private static final long serialVersionUID = 1L;
+
+		TrackingResource(String data)
+		{
+			super("text/plain", data.getBytes());
+		}
+
+		@Override
+		public void respond(Attributes attributes)
+		{
+			responded.add(this);
+			super.respond(attributes);
+		}
+	}
+
+	@BeforeEach
+	void installStrategy()
+	{
+		tester.getApplication()
+			.getSecuritySettings()
+			.setAuthorizationStrategy(new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					assertNotNull(parameters);
+					asked.add(resource);
+					return resource != refused;
+				}
+			});
+	}
+
+	/** */
+	public static class TestPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+		private final String markup;
+
+		TestPage(Component component, String markup)
+		{
+			this.markup = markup;
+			add(component);
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body>" + markup + "</body></html>");
+		}
+	}
+
+	private boolean clicked;
+
+	private TestPage linkPage(IResource resource)
+	{
+		return new TestPage(new ResourceLink<Void>("link", resource)
+		{
+			private static final long serialVersionUID = 1L;
+
+			@Override
+			public void onClick()
+			{
+				clicked = true;
+			}
+		}, "<a wicket:id='link'>link</a>");
+	}
+
+	@Test
+	void refusedResourceLinkIsForbidden()
+	{
+		IResource resource = new TrackingResource("secret");
+		refused = resource;
+		tester.startPage(linkPage(resource));
+		tester.clickLink("link", false);
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+		assertEquals(List.of(resource), asked);
+		assertTrue(responded.isEmpty());
+		assertFalse(clicked);
+	}
+
+	@Test
+	void allowedResourceLinkIsServed()
+	{
+		IResource resource = new TrackingResource("public");
+		tester.startPage(linkPage(resource));
+		tester.clickLink("link", false);
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals("public", tester.getLastResponseAsString());
+		assertEquals(List.of(resource), asked);
+		assertTrue(clicked);
+	}
+
+	@Test
+	void refusalGoesToInstalledListener()
+	{
+		IResource resource = new TrackingResource("secret");
+		refused = resource;
+		tester.getApplication().getSecuritySettings().setUnauthorizedResourceRequestListener(
+			(r, p) -> {
+				assertNotNull(p);
+				refusedNotified.add(r);
+			});
+		tester.startPage(linkPage(resource));
+		tester.clickLink("link", false);
+
+		assertEquals(List.of(resource), refusedNotified);
+		assertTrue(responded.isEmpty());
+		assertFalse(clicked);
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+	}
+
+	@Test
+	void imageWithSrcsetAuthorizesEveryResource()
+	{
+		IResource src = new TrackingResource("src");
+		IResource set1 = new TrackingResource("set1");
+		IResource set2 = new TrackingResource("set2");
+		refused = set1;
+		tester.getApplication().getSecuritySettings().setUnauthorizedResourceRequestListener(
+			(r, p) -> refusedNotified.add(r));
+		Image image = new Image("image", src, set1, set2);
+		tester.startPage(new TestPage(image, "<img wicket:id='image'/>"));
+		tester.executeListener(tester.getComponentFromLastRenderedPage("image"));
+
+		assertEquals(List.of(src, set1, set2), asked);
+		assertEquals(List.of(set1), refusedNotified);
+		assertEquals(List.of(src, set2), responded);
+	}
+
+	@Test
+	void refusedImageIsForbidden()
+	{
+		IResource resource = new TrackingResource("secret");
+		refused = resource;
+		tester.startPage(new TestPage(new Image("image", resource), "<img wicket:id='image'/>"));
+		tester.executeListener(tester.getComponentFromLastRenderedPage("image"));
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals(List.of(resource), asked);
+		assertTrue(responded.isEmpty());
+	}
+
+	@Test
+	void refusedImageButtonIsForbidden()
+	{
+		IResource resource = new TrackingResource("secret");
+		refused = resource;
+		Form<Void> form = new Form<>("form");
+		form.add(new ImageButton("button", resource));
+		tester.startPage(new TestPage(form,
+			"<form wicket:id='form'><input type='image' wicket:id='button'/></form>"));
+		tester.executeListener(tester.getComponentFromLastRenderedPage("form:button"));
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals(1, asked.size());
+		assertSame(resource, asked.get(0));
+		assertTrue(responded.isEmpty());
+	}
+}
