+package org.apache.wicket.extensions.ajax;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import jakarta.servlet.http.HttpServletResponse;
+
+import org.apache.wicket.Component;
+import org.apache.wicket.IRequestListener;
+import org.apache.wicket.MarkupContainer;
+import org.apache.wicket.authorization.IAuthorizationStrategy;
+import org.apache.wicket.behavior.Behavior;
+import org.apache.wicket.extensions.markup.html.repeater.data.table.DataTable;
+import org.apache.wicket.extensions.markup.html.repeater.data.table.IColumn;
+import org.apache.wicket.extensions.markup.html.repeater.data.table.PropertyColumn;
+import org.apache.wicket.extensions.markup.html.repeater.data.table.export.CSVDataExporter;
+import org.apache.wicket.extensions.markup.html.repeater.data.table.export.ExportToolbar;
+import org.apache.wicket.markup.IMarkupResourceStreamProvider;
+import org.apache.wicket.markup.html.WebMarkupContainer;
+import org.apache.wicket.markup.html.WebPage;
+import org.apache.wicket.markup.html.link.ResourceLink;
+import org.apache.wicket.markup.repeater.data.ListDataProvider;
+import org.apache.wicket.model.Model;
+import org.apache.wicket.request.mapper.parameter.PageParameters;
+import org.apache.wicket.request.resource.ByteArrayResource;
+import org.apache.wicket.request.resource.IResource;
+import org.apache.wicket.util.resource.IResourceStream;
+import org.apache.wicket.util.resource.StringResourceStream;
+import org.apache.wicket.util.tester.WicketTestCase;
+import org.apache.wicket.util.visit.IVisitor;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Resources served from a listener URL of wicket-extensions components have to be authorized.
+ */
+class AjaxDownloadBehaviorAuthorizationTest extends WicketTestCase
+{
+	private final List<IResource> asked = new ArrayList<>();
+
+	private boolean allow;
+
+	@BeforeEach
+	void installStrategy()
+	{
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(
+			new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					assertNotNull(parameters);
+					asked.add(resource);
+					return allow;
+				}
+			});
+	}
+
+	private static class CountingResource extends ByteArrayResource
+	{
+		private static final long serialVersionUID = 1L;
+
+		int responded;
+
+		CountingResource()
+		{
+			super("text/plain", "secret".getBytes());
+		}
+
+		@Override
+		public void respond(Attributes attributes)
+		{
+			responded++;
+			super.respond(attributes);
+		}
+	}
+
+	public static class DownloadPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+
+		DownloadPage(IResource resource)
+		{
+			WebMarkupContainer container = new WebMarkupContainer("container");
+			container.add(new AjaxDownloadBehavior(resource));
+			add(container);
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream(
+				"<html><body><div wicket:id='container'></div></body></html>");
+		}
+	}
+
+	public static class ExportPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+
+		ExportPage()
+		{
+			List<IColumn<String, String>> columns = new ArrayList<>();
+			columns.add(new PropertyColumn<>(Model.of("value"), "toString"));
+			DataTable<String, String> table = new DataTable<>("table", columns,
+				new ListDataProvider<>(List.of("secret")), 10);
+			table.addBottomToolbar(new ExportToolbar(table).addDataExporter(new CSVDataExporter()));
+			add(table);
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream(
+				"<html><body><table wicket:id='table'></table></body></html>");
+		}
+	}
+
+	private void downloadFromBehavior(DownloadPage page)
+	{
+		Component container = page.get("container");
+		Behavior listener = container.getBehaviors()
+			.stream()
+			.filter(b -> b instanceof IRequestListener && !(b instanceof AjaxDownloadBehavior))
+			.findFirst()
+			.orElseThrow();
+		tester.invokeListener(container, listener);
+	}
+
+	@Test
+	void ajaxDownloadOfRefusedResource()
+	{
+		CountingResource resource = new CountingResource();
+		DownloadPage page = new DownloadPage(resource);
+		tester.startPage(page);
+		asked.clear();
+
+		downloadFromBehavior(page);
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals(List.of(resource), asked);
+		assertEquals(0, resource.responded);
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+	}
+
+	@Test
+	void ajaxDownloadOfAllowedResource()
+	{
+		allow = true;
+		CountingResource resource = new CountingResource();
+		DownloadPage page = new DownloadPage(resource);
+		tester.startPage(page);
+		asked.clear();
+
+		downloadFromBehavior(page);
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals(List.of(resource), asked);
+		assertEquals(1, resource.responded);
+		assertEquals("secret", tester.getLastResponseAsString());
+	}
+
+	private ResourceLink<?> findExportLink(ExportPage page)
+	{
+		return page.visitChildren(ResourceLink.class,
+			(IVisitor<ResourceLink<?>, ResourceLink<?>>)(link, visit) -> visit.stop(link));
+	}
+
+	@Test
+	void exportOfRefusedData()
+	{
+		ExportPage page = new ExportPage();
+		tester.startPage(page);
+		asked.clear();
+
+		ResourceLink<?> link = findExportLink(page);
+		tester.executeListener(link);
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals(1, asked.size());
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+	}
+
+	@Test
+	void exportOfAllowedData()
+	{
+		allow = true;
+		ExportPage page = new ExportPage();
+		tester.startPage(page);
+		asked.clear();
+
+		ResourceLink<?> link = findExportLink(page);
+		tester.executeListener(link);
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals(1, asked.size());
+		assertTrue(tester.getLastResponseAsString().contains("secret"));
+	}
+}
