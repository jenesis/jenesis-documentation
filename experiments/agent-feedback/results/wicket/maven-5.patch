+package org.apache.wicket.core.request.handler.resource;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.Function;
+
+import jakarta.servlet.http.HttpServletResponse;
+
+import org.apache.wicket.Component;
+import org.apache.wicket.MarkupContainer;
+import org.apache.wicket.authorization.IAuthorizationStrategy;
+import org.apache.wicket.markup.IMarkupResourceStreamProvider;
+import org.apache.wicket.markup.html.WebPage;
+import org.apache.wicket.markup.html.form.Form;
+import org.apache.wicket.markup.html.form.ImageButton;
+import org.apache.wicket.markup.html.image.Image;
+import org.apache.wicket.markup.html.link.ResourceLink;
+import org.apache.wicket.model.Model;
+import org.apache.wicket.request.cycle.RequestCycle;
+import org.apache.wicket.request.http.handler.ErrorCodeRequestHandler;
+import org.apache.wicket.request.mapper.parameter.PageParameters;
+import org.apache.wicket.request.resource.ByteArrayResource;
+import org.apache.wicket.request.resource.IResource;
+import org.apache.wicket.util.resource.IResourceStream;
+import org.apache.wicket.util.resource.StringResourceStream;
+import org.apache.wicket.util.tester.WicketTestCase;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Resources served by a component from its own listener URL have to be authorized just like
+ * resources requested by a resource URL.
+ */
+class ComponentResourceAuthorizationTest extends WicketTestCase
+{
+	private final List<IResource> asked = new ArrayList<>();
+
+	private final List<PageParameters> askedParameters = new ArrayList<>();
+
+	private boolean allow;
+
+	@BeforeEach
+	void installStrategy()
+	{
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(
+			new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					asked.add(resource);
+					askedParameters.add(parameters);
+					return allow;
+				}
+			});
+	}
+
+	private static class CountingResource extends ByteArrayResource
+	{
+		private static final long serialVersionUID = 1L;
+
+		int responded;
+
+		CountingResource(String content)
+		{
+			super("text/plain", content.getBytes());
+		}
+
+		@Override
+		public void respond(Attributes attributes)
+		{
+			responded++;
+			super.respond(attributes);
+		}
+
+		@Override
+		public String toString()
+		{
+			return "CountingResource";
+		}
+	}
+
+	public static class TestPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+
+		private final String markup;
+
+		TestPage(String markup, Function<TestPage, Component> factory)
+		{
+			this.markup = markup;
+			add(factory.apply(this));
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body>" + markup + "</body></html>");
+		}
+	}
+
+	private static class ClickTrackingLink extends ResourceLink<Void>
+	{
+		private static final long serialVersionUID = 1L;
+
+		boolean clicked;
+
+		ClickTrackingLink(String id, IResource resource)
+		{
+			super(id, resource);
+		}
+
+		@Override
+		public void onClick()
+		{
+			clicked = true;
+		}
+	}
+
+	private void assertForbidden()
+	{
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals(
+			"The request to resource 'CountingResource' with parameters '' cannot be authorized.",
+			tester.getLastResponse().getErrorMessage());
+	}
+
+	private void assertParametersNeverNull()
+	{
+		for (PageParameters parameters : askedParameters)
+		{
+			assertNotNull(parameters);
+			assertTrue(parameters.isEmpty());
+		}
+	}
+
+	@Test
+	void resourceLinkRefused()
+	{
+		CountingResource resource = new CountingResource("secret");
+		TestPage page = new TestPage("<a wicket:id='link'>link</a>",
+			p -> new ClickTrackingLink("link", resource));
+		tester.startPage(page);
+		asked.clear();
+		askedParameters.clear();
+
+		tester.clickLink("link", false);
+
+		assertForbidden();
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+		ClickTrackingLink link = (ClickTrackingLink)page.get("link");
+		assertEquals(1, asked.size());
+		assertSame(resource, asked.get(0));
+		assertParametersNeverNull();
+		assertEquals(0, resource.responded);
+		assertFalse(link.clicked);
+	}
+
+	@Test
+	void resourceLinkAllowed()
+	{
+		allow = true;
+		CountingResource resource = new CountingResource("secret");
+		TestPage page = new TestPage("<a wicket:id='link'>link</a>",
+			p -> new ClickTrackingLink("link", resource));
+		tester.startPage(page);
+		asked.clear();
+
+		tester.clickLink("link", false);
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals("secret", tester.getLastResponseAsString());
+		assertEquals(1, asked.size());
+		assertSame(resource, asked.get(0));
+		assertParametersNeverNull();
+		assertEquals(1, resource.responded);
+		assertTrue(((ClickTrackingLink)page.get("link")).clicked);
+	}
+
+	@Test
+	void customUnauthorizedListenerIsCalled()
+	{
+		List<IResource> refused = new ArrayList<>();
+		tester.getApplication().getSecuritySettings().setUnauthorizedResourceRequestListener(
+			(resource, parameters) -> {
+				refused.add(resource);
+				RequestCycle.get().replaceAllRequestHandlers(
+					new ErrorCodeRequestHandler(HttpServletResponse.SC_UNAUTHORIZED));
+			});
+		CountingResource resource = new CountingResource("secret");
+		TestPage page = new TestPage("<a wicket:id='link'>link</a>",
+			p -> new ClickTrackingLink("link", resource));
+		tester.startPage(page);
+
+		tester.clickLink("link", false);
+
+		assertEquals(HttpServletResponse.SC_UNAUTHORIZED, tester.getLastResponse().getStatus());
+		assertEquals(List.of(resource), refused);
+		assertEquals(0, resource.responded);
+	}
+
+	@Test
+	void imageRefused()
+	{
+		CountingResource resource = new CountingResource("secret");
+		CountingResource srcset = new CountingResource("srcset");
+		TestPage page = new TestPage("<img wicket:id='image'/>",
+			p -> new Image("image", resource, srcset));
+		tester.startPage(page);
+		asked.clear();
+
+		tester.executeListener(page.get("image"));
+
+		assertForbidden();
+		assertFalse(asked.isEmpty());
+		assertSame(resource, asked.get(0));
+		assertParametersNeverNull();
+		assertEquals(0, resource.responded);
+		assertEquals(0, srcset.responded);
+	}
+
+	@Test
+	void imageSrcsetRefused()
+	{
+		CountingResource resource = new CountingResource("secret");
+		CountingResource srcset = new CountingResource("srcset");
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(
+			new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource r, PageParameters parameters)
+				{
+					asked.add(r);
+					askedParameters.add(parameters);
+					return r != srcset;
+				}
+			});
+		TestPage page = new TestPage("<img wicket:id='image'/>",
+			p -> new Image("image", resource, srcset));
+		tester.startPage(page);
+		asked.clear();
+
+		tester.executeListener(page.get("image"));
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals(List.of(resource, srcset), asked);
+		assertParametersNeverNull();
+		assertEquals(0, resource.responded);
+		assertEquals(0, srcset.responded);
+	}
+
+	@Test
+	void imageAllowedAsksForEveryResource()
+	{
+		allow = true;
+		CountingResource resource = new CountingResource("secret");
+		CountingResource srcset = new CountingResource("srcset");
+		TestPage page = new TestPage("<img wicket:id='image'/>",
+			p -> new Image("image", resource, srcset));
+		tester.startPage(page);
+		asked.clear();
+
+		tester.executeListener(page.get("image"));
+
+		assertEquals(List.of(resource, srcset), asked);
+		assertParametersNeverNull();
+		assertEquals(1, resource.responded);
+		assertEquals(1, srcset.responded);
+	}
+
+	@Test
+	void imageFromModelRefused()
+	{
+		CountingResource resource = new CountingResource("secret");
+		TestPage page = new TestPage("<img wicket:id='image'/>",
+			p -> new Image("image", Model.of(resource)));
+		tester.startPage(page);
+		asked.clear();
+
+		tester.executeListener(page.get("image"));
+
+		assertForbidden();
+		assertEquals(List.of(resource), asked);
+		assertEquals(0, resource.responded);
+	}
+
+	@Test
+	void imageButtonRefused()
+	{
+		CountingResource resource = new CountingResource("secret");
+		TestPage page = new TestPage(
+			"<form wicket:id='form'><input type='image' wicket:id='button'/></form>", p -> {
+				Form<Void> form = new Form<>("form");
+				form.add(new ImageButton("button", resource));
+				return form;
+			});
+		tester.startPage(page);
+		asked.clear();
+
+		tester.executeListener(page.get("form:button"));
+
+		assertForbidden();
+		assertEquals(List.of(resource), asked);
+		assertParametersNeverNull();
+		assertEquals(0, resource.responded);
+	}
+}
