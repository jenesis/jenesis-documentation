+/**
+ * Resources served by {@link AjaxDownloadBehavior} and {@link ExportToolbar} from a listener URL
+ * must be authorized like resources requested by a resource URL.
+ */
+class ListenerResourceAuthorizationTest extends WicketTestCase
+{
+	private final List<IResource> asked = new ArrayList<>();
+	private final List<IResource> responded = new ArrayList<>();
+
+	private void install(boolean allow)
+	{
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(
+			new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					assertNotNull(parameters);
+					asked.add(resource);
+					return allow;
+				}
+			});
+	}
+
+	private IResource resource()
+	{
+		return new ByteArrayResource("text/plain", "secret".getBytes())
+		{
+			@Override
+			public void respond(Attributes attributes)
+			{
+				responded.add(this);
+				super.respond(attributes);
+			}
+		};
+	}
+
+	private static Behavior resourceBehavior(Component component)
+	{
+		return component.getBehaviors()
+			.stream()
+			.filter(b -> b instanceof IRequestListener && !(b instanceof AjaxDownloadBehavior))
+			.findFirst()
+			.orElseThrow();
+	}
+
+	private void requestResourceBehavior(DownloadPage page)
+	{
+		Component component = page.get("download");
+		int index = component.getBehaviorId(resourceBehavior(component));
+		tester.getRequest().setUrl(tester.urlFor(new ListenerRequestHandler(
+			new PageAndComponentProvider(page, component), index)));
+		tester.processRequest();
+	}
+
+	@Test
+	void refusedAjaxDownload()
+	{
+		install(false);
+		IResource secret = resource();
+		DownloadPage page = tester.startPage(new DownloadPage(secret));
+		asked.clear();
