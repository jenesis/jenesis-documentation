+import org.junit.jupiter.api.Test;
+
+/**
+ * Resources served from a component's own listener URL must be authorized like resources
+ * requested by a resource URL.
+ */
+class ListenerResourceAuthorizationTest extends WicketTestCase
+{
+	private final Set<IResource> refused = new HashSet<>();
+	private final List<IResource> asked = new ArrayList<>();
+	private final List<IResource> responded = new ArrayList<>();
+	private boolean clicked;
+
+	@BeforeEach
+	void installStrategy()
+	{
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(
+			new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					assertNotNull(parameters);
+					asked.add(resource);
+					return !refused.contains(resource);
+				}
+			});
+	}
+
+	private IResource resource(String content)
+	{
+		return new ByteArrayResource("text/plain", content.getBytes())
+		{
+			@Override
+			public void respond(Attributes attributes)
+			{
+				responded.add(this);
+				super.respond(attributes);
+			}
+		};
+	}
+
+	private void assertForbidden()
+	{
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+	}
+
+	@Test
+	void refusedResourceLink()
+	{
+		IResource secret = resource("secret");
+		refused.add(secret);
+		tester.startPage(new TestPage(secret));
+		tester.clickLink("link", false);
+
+		assertForbidden();
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+		assertEquals(List.of(secret), asked);
+		assertTrue(responded.isEmpty());
+		assertFalse(clicked);
+	}
+
+	@Test
+	void refusedResourceLinkCallsInstalledListener()
+	{
+		IResource secret = resource("secret");
+		refused.add(secret);
+		List<IResource> notified = new ArrayList<>();
+		tester.getApplication().getSecuritySettings().setUnauthorizedResourceRequestListener(
+			(resource, parameters) -> {
+				assertNotNull(parameters);
+				notified.add(resource);
+			});
+		tester.startPage(new TestPage(secret));
+		tester.clickLink("link", false);
+
+		assertEquals(List.of(secret), notified);
+		assertTrue(responded.isEmpty());
+		assertFalse(clicked);
+	}
+
+	@Test
+	void allowedResourceLink()
+	{
+		IResource open = resource("open");
+		tester.startPage(new TestPage(open));
+		tester.clickLink("link", false);
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals("open", tester.getLastResponseAsString());
+		assertEquals(List.of(open), asked);
+		assertTrue(clicked);
+	}
+
+	@Test
+	void refusedImage()
+	{
+		IResource secret = resource("secret");
+		refused.add(secret);
+		TestPage page = tester.startPage(new TestPage(secret));
+		asked.clear();
+		tester.executeListener(page.get("image"));
+
+		assertForbidden();
+		assertEquals(List.of(secret), asked);
+		assertTrue(responded.isEmpty());
+	}
+
+	@Test
+	void refusedImageFromModel()
+	{
+		IResource secret = resource("secret");
+		refused.add(secret);
+		TestPage page = tester.startPage(new TestPage(secret));
+		asked.clear();
+		tester.executeListener(page.get("modelImage"));
+
+		assertForbidden();
+		assertEquals(List.of(secret), asked);
+		assertTrue(responded.isEmpty());
+	}
+
+	@Test
+	void refusedSrcSetEntry()
+	{
+		IResource open = resource("open");
+		IResource secret = resource("secret");
+		refused.add(secret);
+		TestPage page = tester.startPage(new TestPage(open, secret));
+		asked.clear();
+		tester.executeListener(page.get("srcSetImage"));
+
+		assertForbidden();
+		assertEquals(List.of(open, secret), asked);
+		assertEquals(List.of(open), responded);
+	}
+
+	@Test
+	void refusedImageButton()
+	{
+		IResource secret = resource("secret");
+		refused.add(secret);
+		TestPage page = tester.startPage(new TestPage(secret));
+		asked.clear();
+		tester.executeListener(page.get("form:button"));
+
+		assertForbidden();
+		assertEquals(List.of(secret), asked);
+		assertTrue(responded.isEmpty());
+	}
+
+	@Test
+	void allowedImage()
+	{
+		IResource open = resource("open");
+		TestPage page = tester.startPage(new TestPage(open));
+		asked.clear();
+		tester.executeListener(page.get("image"));
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals("open", tester.getLastResponseAsString());
+		assertEquals(1, asked.size());
+		assertSame(open, asked.get(0));
+	}
+
+	private class TestPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+
+		TestPage(IResource resource)
+		{
+			this(resource, resource("srcset"));
+		}
+
+		TestPage(IResource resource, IResource srcSet)
+		{
+			add(new ResourceLink<Void>("link", resource)
+			{
+				private static final long serialVersionUID = 1L;
+
+				@Override
+				public void onClick()
+				{
+					clicked = true;
+				}
+			});
+			add(new Image("image", resource));
+			add(new Image("modelImage", org.apache.wicket.model.Model.of(resource)));
+			add(new Image("srcSetImage", resource, srcSet));
+			Form<Void> form = new Form<>("form");
+			add(form);
+			form.add(new ImageButton("button", resource));
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><a wicket:id='link'>link</a>"
+				+ "<img wicket:id='image'/><img wicket:id='modelImage'/><img wicket:id='srcSetImage'/>"
+				+ "<form wicket:id='form'><input type='image' wicket:id='button'/></form>"
+				+ "</body></html>");
+		}
+	}
+}
