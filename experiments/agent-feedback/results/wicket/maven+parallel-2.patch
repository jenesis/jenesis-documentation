+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Resources served by components from their own listener URL must be authorized like resources
+ * requested by a resource URL.
+ */
+class ComponentResourceAuthorizationTest extends WicketTestCase
+{
+	private final List<IResource> asked = new ArrayList<>();
+	private final List<PageParameters> askedParameters = new ArrayList<>();
+	private final List<IResource> refused = new ArrayList<>();
+	private final List<IResource> responded = new ArrayList<>();
+	private boolean allow;
+	private boolean clicked;
+
+	@BeforeEach
+	void setUpStrategy()
+	{
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(
+			new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					asked.add(resource);
+					askedParameters.add(parameters);
+					return allow;
+				}
+			});
+	}
+
+	private IResource resource(String content)
+	{
+		return new ByteArrayResource("text/plain", content.getBytes())
+		{
+			@Override
+			public void respond(Attributes attributes)
+			{
+				responded.add(this);
+				super.respond(attributes);
+			}
+		};
+	}
+
+	private void assertForbidden()
+	{
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertTrue(responded.isEmpty());
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+	}
+
+	@Test
+	void refusedResourceLink()
+	{
+		IResource report = resource("secret");
+		tester.startPage(new TestPage(report, null, false));
+		tester.clickLink("link", false);
+
+		assertForbidden();
+		assertFalse(clicked);
+		assertEquals(1, asked.size());
+		assertSame(report, asked.get(0));
+		assertNotNull(askedParameters.get(0));
+		assertTrue(askedParameters.get(0).isEmpty());
+	}
+
+	@Test
+	void allowedResourceLink()
+	{
+		allow = true;
+		IResource report = resource("secret");
+		tester.startPage(new TestPage(report, null, false));
+		tester.clickLink("link", false);
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals("secret", tester.getLastResponseAsString());
+		assertTrue(clicked);
+		assertEquals(List.of(report), asked);
+	}
+
+	@Test
+	void customListenerIsCalledAndNothingIsServed()
+	{
+		tester.getApplication().getSecuritySettings().setUnauthorizedResourceRequestListener(
+			(resource, parameters) -> refused.add(resource));
+		IResource report = resource("secret");
+		tester.startPage(new TestPage(report, null, false));
+		tester.clickLink("link", false);
+
+		assertEquals(List.of(report), refused);
+		assertTrue(responded.isEmpty());
+		assertFalse(clicked);
+	}
+
+	@Test
+	void refusedImage()
+	{
+		IResource image = resource("secret");
+		TestPage page = new TestPage(null, image, false);
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertForbidden();
+		assertEquals(List.of(image), asked);
+		assertTrue(askedParameters.get(0).isEmpty());
+	}
+
+	@Test
+	void imageWithSrcSetAsksForEveryResource()
+	{
+		tester.getApplication().getSecuritySettings().setUnauthorizedResourceRequestListener(
+			(resource, parameters) -> refused.add(resource));
+		IResource src = resource("secret");
+		IResource set1 = resource("secret1");
+		IResource set2 = resource("secret2");
+		TestPage page = new TestPage(null, src, false, set1, set2);
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(List.of(src, set1, set2), asked);
+		assertEquals(List.of(src, set1, set2), refused);
+		assertTrue(responded.isEmpty());
+	}
+
+	@Test
+	void allowedImage()
+	{
+		allow = true;
+		IResource image = resource("data");
+		TestPage page = new TestPage(null, image, false);
+		tester.startPage(page);
+		tester.executeListener(page.get("image"));
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals(List.of(image), responded);
+	}
+
+	@Test
+	void refusedImageButton()
+	{
+		IResource image = resource("secret");
+		TestPage page = new TestPage(null, null, true);
+		page.button.setImageResource(image);
+		tester.startPage(page);
+		tester.executeListener(page.button);
+
+		assertForbidden();
+		assertEquals(List.of(image), asked);
+	}
+
+	/** */
+	public class TestPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+
+		ImageButton button;
+
+		TestPage(IResource linkResource, IResource imageResource, boolean withButton,
+			IResource... srcSet)
+		{
+			add(new ResourceLink<Void>("link", linkResource != null ? linkResource : resource("x"))
+			{
+				@Override
+				public void onClick()
+				{
+					clicked = true;
+				}
+			});
+			add(new Image("image", imageResource != null ? imageResource : resource("y"), srcSet));
+			Form<Void> form = new Form<>("form");
+			add(form);
+			form.add(button = new ImageButton("button", resource("z")));
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><a wicket:id='link'>link</a>" +
+				"<img wicket:id='image'/><form wicket:id='form'>" +
+				"<input type='image' wicket:id='button'/></form></body></html>");
+		}
+	}
+}
