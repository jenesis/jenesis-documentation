+package org.apache.wicket.core.request.handler.resource;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.Predicate;
+
+import jakarta.servlet.http.HttpServletResponse;
+
+import org.apache.wicket.MarkupContainer;
+import org.apache.wicket.authorization.IAuthorizationStrategy;
+import org.apache.wicket.markup.IMarkupResourceStreamProvider;
+import org.apache.wicket.markup.html.WebPage;
+import org.apache.wicket.markup.html.image.Image;
+import org.apache.wicket.markup.html.link.ResourceLink;
+import org.apache.wicket.request.mapper.parameter.PageParameters;
+import org.apache.wicket.request.resource.ByteArrayResource;
+import org.apache.wicket.request.resource.IResource;
+import org.apache.wicket.util.resource.IResourceStream;
+import org.apache.wicket.util.resource.StringResourceStream;
+import org.apache.wicket.util.tester.WicketTestCase;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Resources served by components from their own listener URL have to be authorized like resources
+ * served by a resource URL.
+ */
+class ComponentResourceAuthorizationTest extends WicketTestCase
+{
+	private static class TrackingResource extends ByteArrayResource
+	{
+		private final String name;
+		boolean responded;
+
+		TrackingResource(String name)
+		{
+			super("text/plain", name.getBytes());
+			this.name = name;
+		}
+
+		@Override
+		public void respond(Attributes attributes)
+		{
+			responded = true;
+			super.respond(attributes);
+		}
+
+		@Override
+		public String toString()
+		{
+			return name;
+		}
+	}
+
+	private static class Strategy extends IAuthorizationStrategy.AllowAllAuthorizationStrategy
+	{
+		final List<IResource> asked = new ArrayList<>();
+		final Predicate<IResource> allowed;
+
+		Strategy(Predicate<IResource> allowed)
+		{
+			this.allowed = allowed;
+		}
+
+		@Override
+		public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+		{
+			assertNotNull(parameters);
+			asked.add(resource);
+			return allowed.test(resource);
+		}
+	}
+
+	public static class TestPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		final TrackingResource linkResource = new TrackingResource("secret");
+		final TrackingResource src = new TrackingResource("src");
+		final TrackingResource srcset = new TrackingResource("srcset");
+		boolean clicked;
+
+		public TestPage()
+		{
+			add(new ResourceLink<Void>("link", linkResource)
+			{
+				@Override
+				public void onClick()
+				{
+					clicked = true;
+				}
+			});
+			add(new Image("image", src, srcset));
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream(
+				"<html><body><a wicket:id='link'>link</a><img wicket:id='image'/></body></html>");
+		}
+	}
+
+	@Test
+	void refusedResourceLink()
+	{
+		Strategy strategy = new Strategy(r -> false);
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(strategy);
+
+		TestPage page = tester.startPage(TestPage.class);
+		tester.clickLink("link", false);
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals("The request to resource 'secret' with parameters '' cannot be authorized.",
+			tester.getLastResponse().getErrorMessage());
+		assertEquals(List.of(page.linkResource), strategy.asked);
+		assertFalse(page.linkResource.responded);
+		assertFalse(page.clicked);
+	}
+
+	@Test
+	void allowedResourceLink()
+	{
+		Strategy strategy = new Strategy(r -> true);
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(strategy);
+
+		TestPage page = tester.startPage(TestPage.class);
+		tester.clickLink("link", false);
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals("secret", tester.getLastResponse().getDocument());
+		assertEquals(List.of(page.linkResource), strategy.asked);
+		assertTrue(page.clicked);
+	}
+
+	@Test
+	void refusedSrcsetEntry()
+	{
+		TestPage page = tester.startPage(TestPage.class);
+		Strategy strategy = new Strategy(r -> r != page.srcset);
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(strategy);
+
+		tester.executeListener(page.get("image"));
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals(List.of(page.src, page.srcset), strategy.asked);
+		assertFalse(page.src.responded);
+		assertFalse(page.srcset.responded);
+	}
+
+	@Test
+	void refusedImageWithCustomListener()
+	{
+		List<IResource> refused = new ArrayList<>();
+		TestPage page = tester.startPage(TestPage.class);
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(new Strategy(r -> false));
+		tester.getApplication().getSecuritySettings().setUnauthorizedResourceRequestListener(
+			(resource, parameters) -> refused.add(resource));
+
+		tester.executeListener(page.get("image"));
+
+		assertEquals(List.of(page.src), refused);
+		assertFalse(page.src.responded);
+	}
+}
