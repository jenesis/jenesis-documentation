+package org.apache.wicket.core.request.handler.resource;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+import jakarta.servlet.http.HttpServletResponse;
+
+import org.apache.wicket.MarkupContainer;
+import org.apache.wicket.authorization.IAuthorizationStrategy;
+import org.apache.wicket.markup.IMarkupResourceStreamProvider;
+import org.apache.wicket.markup.html.WebPage;
+import org.apache.wicket.markup.html.form.Form;
+import org.apache.wicket.markup.html.form.ImageButton;
+import org.apache.wicket.markup.html.image.Image;
+import org.apache.wicket.markup.html.link.ResourceLink;
+import org.apache.wicket.model.Model;
+import org.apache.wicket.request.mapper.parameter.PageParameters;
+import org.apache.wicket.request.resource.ByteArrayResource;
+import org.apache.wicket.request.resource.IResource;
+import org.apache.wicket.util.resource.IResourceStream;
+import org.apache.wicket.util.resource.StringResourceStream;
+import org.apache.wicket.util.tester.WicketTestCase;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Resources served by a component from its own listener URL must be authorized like resources
+ * requested by a resource URL.
+ */
+class ListenerResourceAuthorizationTest extends WicketTestCase
+{
+	/** resources the strategy was asked about */
+	private final List<IResource> asked = new ArrayList<>();
+
+	/** resources the strategy refuses */
+	private final Set<IResource> refused = new HashSet<>();
+
+	/** resources that wrote to the response */
+	private static final List<IResource> responded = new ArrayList<>();
+
+	private static boolean clicked;
+
+	private static class TestResource extends ByteArrayResource
+	{
+		private final String name;
+
+		TestResource(String name)
+		{
+			super("text/plain", name.getBytes());
+			this.name = name;
+		}
+
+		@Override
+		public void respond(Attributes attributes)
+		{
+			responded.add(this);
+			super.respond(attributes);
+		}
+
+		@Override
+		public String toString()
+		{
+			return name;
+		}
+	}
+
+	/** */
+	public static class TestPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+
+		final IResource link = new TestResource("link");
+		final IResource src = new TestResource("src");
+		final IResource srcset1 = new TestResource("srcset1");
+		final IResource srcset2 = new TestResource("srcset2");
+		final IResource model = new TestResource("model");
+		final IResource button = new TestResource("button");
+
+		/** */
+		public TestPage()
+		{
+			add(new ResourceLink<Void>("link", link)
+			{
+				@Override
+				public void onClick()
+				{
+					clicked = true;
+				}
+			});
+			add(new Image("image", src, srcset1, srcset2));
+			add(new Image("modelImage", Model.of(model)));
+			Form<Void> form = new Form<>("form");
+			add(form);
+			form.add(new ImageButton("button", button));
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><a wicket:id='link'>link</a>" +
+				"<img wicket:id='image'/><img wicket:id='modelImage'/>" +
+				"<form wicket:id='form'><input type='image' wicket:id='button'/></form>" +
+				"</body></html>");
+		}
+	}
+
+	@BeforeEach
+	void setUp()
+	{
+		responded.clear();
+		clicked = false;
+		tester.getApplication()
+			.getSecuritySettings()
+			.setAuthorizationStrategy(new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					assertNotNull(parameters);
+					asked.add(resource);
+					return !refused.contains(resource);
+				}
+			});
+	}
+
+	private void assertForbidden(IResource resource)
+	{
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals(
+			"The request to resource '" + resource + "' with parameters '' cannot be authorized.",
+			tester.getLastResponse().getErrorMessage());
+	}
+
+	@Test
+	void resourceLinkRefused()
+	{
+		TestPage page = tester.startPage(TestPage.class);
+		refused.add(page.link);
+		asked.clear();
+
+		tester.clickLink("link", false);
+
+		assertForbidden(page.link);
+		assertEquals(List.of(page.link), asked);
+		assertTrue(responded.isEmpty());
+		assertFalse(clicked);
+	}
+
+	@Test
+	void resourceLinkAllowed()
+	{
+		TestPage page = tester.startPage(TestPage.class);
+		asked.clear();
+
+		tester.clickLink("link", false);
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals("link", tester.getLastResponseAsString());
+		assertEquals(List.of(page.link), asked);
+		assertTrue(clicked);
+	}
+
+	@Test
+	void resourceLinkRefusedCustomListener()
+	{
+		List<IResource> notified = new ArrayList<>();
+		tester.getApplication()
+			.getSecuritySettings()
+			.setUnauthorizedResourceRequestListener((resource, parameters) -> {
+				assertNotNull(parameters);
+				notified.add(resource);
+			});
+		TestPage page = tester.startPage(TestPage.class);
+		refused.add(page.link);
+
+		tester.clickLink("link", false);
+
+		assertEquals(List.of(page.link), notified);
+		assertTrue(responded.isEmpty());
+		assertFalse(clicked);
+	}
+
+	@Test
+	void imageRefused()
+	{
+		TestPage page = tester.startPage(TestPage.class);
+		refused.add(page.src);
+		asked.clear();
+
+		tester.executeListener(page.get("image"));
+
+		assertForbidden(page.src);
+		assertEquals(List.of(page.src), asked);
+		assertTrue(responded.isEmpty());
+	}
+
+	@Test
+	void imageSrcsetRefused()
+	{
+		TestPage page = tester.startPage(TestPage.class);
+		refused.add(page.srcset2);
+		asked.clear();
+
+		tester.executeListener(page.get("image"));
+
+		assertForbidden(page.srcset2);
+		assertEquals(List.of(page.src, page.srcset1, page.srcset2), asked);
+		assertFalse(responded.contains(page.srcset2));
+	}
+
+	@Test
+	void imageAllowed()
+	{
+		TestPage page = tester.startPage(TestPage.class);
+		asked.clear();
+
+		tester.executeListener(page.get("image"));
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals(List.of(page.src, page.srcset1, page.srcset2), asked);
+		assertEquals(List.of(page.src, page.srcset1, page.srcset2), responded);
+	}
+
+	@Test
+	void modelImageRefused()
+	{
+		TestPage page = tester.startPage(TestPage.class);
+		refused.add(page.model);
+		asked.clear();
+
+		tester.executeListener(page.get("modelImage"));
+
+		assertForbidden(page.model);
+		assertEquals(List.of(page.model), asked);
+		assertTrue(responded.isEmpty());
+	}
+
+	@Test
+	void imageButtonRefused()
+	{
+		TestPage page = tester.startPage(TestPage.class);
+		refused.add(page.button);
+		asked.clear();
+
+		tester.executeListener(page.get("form:button"));
+
+		assertForbidden(page.button);
+		assertEquals(List.of(page.button), asked);
+		assertTrue(responded.isEmpty());
+	}
+}
