+package org.apache.wicket.authorization;
+
+import org.apache.wicket.Application;
+import org.apache.wicket.Session;
+import org.apache.wicket.request.mapper.parameter.PageParameters;
+import org.apache.wicket.request.resource.IResource;
+import org.apache.wicket.settings.DefaultUnauthorizedResourceRequestListener;
+import org.apache.wicket.util.lang.Args;
+
+/**
+ * Authorizes a resource that is about to be served, whether it is requested by a resource URL or
+ * served by a component or behavior from its own listener URL.
+ */
+public final class ResourceAuthorization
+{
+	private ResourceAuthorization()
+	{
+	}
+
+	/**
+	 * Asks the authorization strategy whether the resource may be served. If it may not, the
+	 * {@link IUnauthorizedResourceRequestListener} of the application's security settings is
+	 * notified.
+	 *
+	 * @param resource
+	 *            the resource about to be served
+	 * @param parameters
+	 *            the resource parameters, {@code null} is replaced with empty parameters
+	 * @return {@code true} if the resource may be served, {@code false} if it was refused, in which
+	 *         case nothing of it must be written to the response
+	 */
+	public static boolean authorize(IResource resource, PageParameters parameters)
+	{
+		Args.notNull(resource, "resource");
+		if (parameters == null)
+		{
+			parameters = new PageParameters();
+		}
+
+		IAuthorizationStrategy authorizationStrategy = null;
+		if (Session.exists())
+		{
+			authorizationStrategy = Session.get().getAuthorizationStrategy();
+		}
+		else if (Application.exists())
+		{
+			authorizationStrategy = Application.get()
+				.getSecuritySettings()
+				.getAuthorizationStrategy();
+		}
+
+		if (authorizationStrategy != null &&
+			authorizationStrategy.isResourceAuthorized(resource, parameters) == false)
+		{
+			if (Application.exists())
+			{
+				Application.get()
+					.getSecuritySettings()
+					.getUnauthorizedResourceRequestListener()
+					.onUnauthorizedRequest(resource, parameters);
+			}
+			else
+			{
+				new DefaultUnauthorizedResourceRequestListener().onUnauthorizedRequest(resource,
+					parameters);
+			}
+			return false;
+		}
+		return true;
+	}
+}
