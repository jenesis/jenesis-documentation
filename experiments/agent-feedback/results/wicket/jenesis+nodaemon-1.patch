+	 *
+	 * @param parameters
+	 *            page parameters
+	 * @return {@code true} if the resource was served, {@code false} if it was refused
+	 */
+	public final boolean authorizeAndRespond(PageParameters parameters)
+	{
 		bind();
+		if (!ResourceAuthorization.authorize(resource,
+			parameters != null ? parameters : new PageParameters()))
+		{
+			return false;
+		}
 		RequestCycle requestCycle = RequestCycle.get();
 		Attributes attributes = new Attributes(requestCycle.getRequest(),
 			requestCycle.getResponse(), parameters);
