+/**
+ * A resource served by {@link AjaxDownloadBehavior} from its listener URL is authorized.
+ */
+class AjaxDownloadBehaviorAuthorizationTest extends WicketTestCase
+{
+	@Test
+	void deniedResourceIsNotServed()
+	{
+		List<IResource> asked = new ArrayList<>();
+		List<PageParameters> askedParameters = new ArrayList<>();
+		boolean[] served = { false };
+		IResource secret = new ByteArrayResource("text/plain", "secret".getBytes())
+		{
+			private static final long serialVersionUID = 1L;
+
+			@Override
+			public void respond(Attributes attributes)
+			{
+				served[0] = true;
+				super.respond(attributes);
+			}
+		};
+		tester.getApplication()
+			.getSecuritySettings()
+			.setAuthorizationStrategy(new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					asked.add(resource);
+					askedParameters.add(parameters);
+					return false;
+				}
+			});
+
+		TestPage page = new TestPage();
+		WebMarkupContainer container = new WebMarkupContainer("c");
+		container.add(new AjaxDownloadBehavior(secret));
+		page.add(container);
+		tester.startPage(page);
+
