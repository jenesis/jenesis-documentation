+import org.apache.wicket.util.tester.WicketTestCase;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Resources served from a component's listener URL must be authorized like resources served
+ * through a resource URL.
+ */
+class ListenerResourceAuthorizationTest extends WicketTestCase
+{
+	private final Set<IResource> denied = new HashSet<>();
+	private final List<IResource> asked = new ArrayList<>();
+	private final List<PageParameters> askedParameters = new ArrayList<>();
+	private final List<IResource> served = new ArrayList<>();
+	private boolean clicked;
+
+	private final IResource secret = new TrackingResource("secret");
+	private final IResource other = new TrackingResource("other");
+
+	private class TrackingResource extends ByteArrayResource
+	{
+		private static final long serialVersionUID = 1L;
+
+		TrackingResource(String data)
+		{
+			super("text/plain", data.getBytes());
+		}
+
+		@Override
+		public void respond(Attributes attributes)
+		{
+			served.add(this);
+			super.respond(attributes);
+		}
+	}
+
+	@BeforeEach
+	void installStrategy()
+	{
+		tester.getApplication()
+			.getSecuritySettings()
+			.setAuthorizationStrategy(new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					asked.add(resource);
+					askedParameters.add(parameters);
+					return !denied.contains(resource);
+				}
+			});
+	}
+
+	private void assertForbidden()
+	{
+		assertEquals(403, tester.getLastResponse().getStatus());
+		assertFalse(tester.getLastResponseAsString().contains("secret"));
+	}
+
+	@Test
+	void deniedResourceLink()
+	{
+		denied.add(secret);
+		TestPage page = new TestPage("<a wicket:id='c'>x</a>");
+		ResourceLink<Void> link = new ResourceLink<>("c", secret)
+		{
+			private static final long serialVersionUID = 1L;
+
+			@Override
+			public void onClick()
+			{
+				clicked = true;
+			}
+		};
+		page.add(link);
+		tester.startPage(page);
+		tester.clickLink("c", false);
+
+		assertForbidden();
+		assertEquals(List.of(secret), asked);
+		assertNotNull(askedParameters.get(0));
+		assertTrue(served.isEmpty());
+		assertFalse(clicked);
+	}
+
+	@Test
+	void allowedResourceLink()
+	{
+		TestPage page = new TestPage("<a wicket:id='c'>x</a>");
+		page.add(new ResourceLink<Void>("c", secret));
+		tester.startPage(page);
+		tester.clickLink("c", false);
+
+		assertEquals(200, tester.getLastResponse().getStatus());
+		assertEquals("secret", tester.getLastResponseAsString());
+		assertEquals(List.of(secret), asked);
+	}
+
+	@Test
+	void customListenerIsCalled()
+	{
+		List<IResource> refused = new ArrayList<>();
+		tester.getApplication()
+			.getSecuritySettings()
+			.setUnauthorizedResourceRequestListener((resource, parameters) -> refused.add(resource));
+		denied.add(secret);
+		TestPage page = new TestPage("<a wicket:id='c'>x</a>");
+		page.add(new ResourceLink<Void>("c", secret));
+		tester.startPage(page);
+		tester.clickLink("c", false);
+
+		assertEquals(List.of(secret), refused);
+		assertTrue(served.isEmpty());
+	}
+
+	@Test
+	void deniedImageWithSrcSet()
+	{
+		denied.add(secret);
+		TestPage page = new TestPage("<img wicket:id='c'/>");
+		Image image = new Image("c", secret, other);
+		page.add(image);
+		tester.startPage(page);
+		asked.clear();
+		tester.executeListener(image);
+
+		assertForbidden();
+		assertEquals(List.of(secret), asked);
+		assertTrue(served.isEmpty());
+	}
+
+	@Test
+	void deniedImageSrcSetEntry()
+	{
+		denied.add(secret);
+		TestPage page = new TestPage("<img wicket:id='c'/>");
+		Image image = new Image("c", other, secret);
+		page.add(image);
+		tester.startPage(page);
+		asked.clear();
+		tester.executeListener(image);
+
+		assertForbidden();
+		assertEquals(List.of(other, secret), asked);
+		assertFalse(served.contains(secret));
+	}
+
+	@Test
+	void deniedImageButton()
+	{
+		denied.add(secret);
+		TestPage page = new TestPage("<form wicket:id='f'><input type='image' wicket:id='c'/></form>");
+		Form<Void> form = new Form<>("f");
+		page.add(form);
+		ImageButton button = new ImageButton("c", secret);
+		form.add(button);
+		tester.startPage(page);
+		asked.clear();
+		tester.executeListener(button);
+
+		assertForbidden();
+		assertEquals(List.of(secret), asked);
+		assertTrue(served.isEmpty());
+	}
+
+	private static class TestPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+		private final String body;
+
+		TestPage(String body)
+		{
+			this.body = body;
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body>" + body + "</body></html>");
+		}
+	}
+}
