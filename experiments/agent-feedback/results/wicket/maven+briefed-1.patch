+		RecordingResource()
+		{
+			super("text/plain", "secret".getBytes(StandardCharsets.UTF_8));
+		}
+
+		@Override
+		public void respond(Attributes attributes)
+		{
+			responded++;
+			super.respond(attributes);
+		}
+
+		@Override
