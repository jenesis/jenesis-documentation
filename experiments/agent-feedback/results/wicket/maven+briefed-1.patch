+	/** */
+	public static class TestPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+
+		final WebMarkupContainer container;
+
+		TestPage(IResource resource)
+		{
+			container = new WebMarkupContainer("container");
+			container.add(new AjaxDownloadBehavior(resource));
+			add(container);
+
+			List<IColumn<String, String>> columns = new ArrayList<>();
+			columns.add(new ExportColumn());
+			DataTable<String, String> table = new DataTable<>("table", columns,
+				new ListDataProvider<>(List.of("secret")), 10);
+			table.addBottomToolbar(new ExportToolbar(table).addDataExporter(new CSVDataExporter()));
+			add(table);
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream(
+				"<html><body><div wicket:id='container'></div><table wicket:id='table'></table></body></html>");
+		}
+	}
+
+	private boolean allow;
+	private RecordingResource resource;
+	private TestPage page;
+
+	@BeforeEach
+	void setUp()
+	{
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(
+			new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					asked.add(resource);
+					askedParameters.add(parameters);
+					return allow;
+				}
+			});
+
+		resource = new RecordingResource();
+		page = tester.startPage(new TestPage(resource));
+		asked.clear();
+		askedParameters.clear();
+	}
+
+	private void requestDownload()
+	{
+		Behavior listener = page.container.getBehaviors(Behavior.class).stream()
+			.filter(b -> b instanceof IRequestListener && b instanceof AjaxDownloadBehavior == false).findFirst().get();
+		tester.executeUrl(tester.getRequestCycle()
+			.mapUrlFor(new ListenerRequestHandler(new PageAndComponentProvider(page, page.container),
+				page.container.getBehaviorId(listener)))
+			.toString());
+	}
+
+	private void assertAskedOnceWithEmptyParameters()
+	{
+		assertEquals(1, asked.size());
+		assertNotNull(askedParameters.get(0));
+		assertTrue(askedParameters.get(0).isEmpty());
+	}
+
+	@Test
+	void downloadRefused()
+	{
+		requestDownload();
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals("The request to resource 'RecordingResource' with parameters '' cannot be authorized.",
+			tester.getLastResponse().getErrorMessage());
+		assertAskedOnceWithEmptyParameters();
+		assertEquals(resource, asked.get(0));
+		assertEquals(0, resource.responded);
+	}
+
+	@Test
+	void downloadAllowed()
+	{
+		allow = true;
+
+		requestDownload();
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals("secret", tester.getLastResponse().getDocument());
+		assertAskedOnceWithEmptyParameters();
+		assertEquals(1, resource.responded);
+	}
+
+	@Test
+	void exportRefused()
+	{
+		tester.clickLink("table:bottomToolbars:toolbars:1:td:linkContainer:1:exportLink", false);
+
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertAskedOnceWithEmptyParameters();
+		assertInstanceOf(ResourceStreamResource.class, asked.get(0));
+		assertTrue(tester.getLastResponse().getDocument().isEmpty());
+	}
+
+	@Test
+	void exportAllowed()
+	{
+		allow = true;
+
+		tester.clickLink("table:bottomToolbars:toolbars:1:td:linkContainer:1:exportLink", false);
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertAskedOnceWithEmptyParameters();
+		assertTrue(tester.getLastResponse().getDocument().contains("secret"));
+	}
