+/**
+ * Resources served by a component from its own listener URL have to be authorized like resources
+ * requested by a resource URL.
+ */
+class ListenerResourceAuthorizationTest extends WicketTestCase
+{
+	private final Set<IResource> refused = new HashSet<>();
+	private final List<IResource> asked = new ArrayList<>();
+	private final List<PageParameters> askedParameters = new ArrayList<>();
+
+	private static class RecordingResource extends ByteArrayResource
+	{
+		private final String name;
+		int responded;
+
+		RecordingResource(String name)
+		{
+			super("image/png", name.getBytes(StandardCharsets.UTF_8));
+			this.name = name;
+		}
+
+		@Override
+		public void respond(Attributes attributes)
+		{
+			responded++;
+			super.respond(attributes);
+		}
+
+		@Override
+		public String toString()
+		{
+			return name;
+		}
+	}
+
+	/** */
+	public static class TestPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+
+		boolean clicked;
+
+		TestPage(IResource link, IResource image, IResource srcset, IResource button)
+		{
+			add(new ResourceLink<Void>("link", link)
+			{
+				private static final long serialVersionUID = 1L;
+
+				@Override
+				public void onClick()
+				{
+					clicked = true;
+				}
+			});
+			add(new Image("image", image, srcset));
+			Form<Void> form = new Form<>("form");
+			add(form);
+			form.add(new ImageButton("button", button));
+		}
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><a wicket:id='link'>link</a>" +
+				"<img wicket:id='image'/><form wicket:id='form'><input type='image' wicket:id='button'/></form>" +
+				"</body></html>");
+		}
+	}
+
+	private RecordingResource link, image, srcset, button;
+	private TestPage page;
+
+	@BeforeEach
+	void setUp()
+	{
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(
+			new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					asked.add(resource);
+					askedParameters.add(parameters);
+					return refused.contains(resource) == false;
+				}
+			});
+
+		link = new RecordingResource("link");
+		image = new RecordingResource("image");
+		srcset = new RecordingResource("srcset");
+		button = new RecordingResource("button");
+		page = tester.startPage(new TestPage(link, image, srcset, button));
+		tester.assertRenderedPage(TestPage.class);
+		asked.clear();
+		askedParameters.clear();
+	}
+
+	private void assertAskedWithEmptyParameters()
+	{
+		for (PageParameters parameters : askedParameters)
+		{
+			assertNotNull(parameters);
+			assertTrue(parameters.isEmpty());
+		}
+	}
+
+	private void assertForbidden(IResource resource)
+	{
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals("The request to resource '" + resource + "' with parameters '' cannot be authorized.",
+			tester.getLastResponse().getErrorMessage());
+	}
+
+	@Test
+	void resourceLinkRefused()
+	{
+		refused.add(link);
+
+		tester.clickLink("link", false);
+
+		assertForbidden(link);
+		assertEquals(List.of(link), asked);
+		assertAskedWithEmptyParameters();
+		assertEquals(0, link.responded);
+		assertFalse(page.clicked);
+	}
+
+	@Test
+	void resourceLinkAllowed()
+	{
+		tester.clickLink("link", false);
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals("link", tester.getLastResponse().getDocument());
+		assertEquals(List.of(link), asked);
+		assertAskedWithEmptyParameters();
+		assertEquals(1, link.responded);
+		assertTrue(page.clicked);
+	}
+
+	@Test
+	void imageRefused()
+	{
+		refused.add(image);
+
+		tester.executeListener(tester.getComponentFromLastRenderedPage("image"));
+
+		assertForbidden(image);
+		assertEquals(List.of(image), asked);
+		assertAskedWithEmptyParameters();
+		assertEquals(0, image.responded);
+		assertEquals(0, srcset.responded);
+	}
+
+	@Test
+	void imageSrcsetRefused()
+	{
+		refused.add(srcset);
+
+		tester.executeListener(tester.getComponentFromLastRenderedPage("image"));
+
+		assertForbidden(srcset);
+		assertEquals(List.of(image, srcset), asked);
+		assertAskedWithEmptyParameters();
+		assertEquals(0, srcset.responded);
+	}
+
+	@Test
+	void imageAllowed()
+	{
+		tester.executeListener(tester.getComponentFromLastRenderedPage("image"));
+
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals(List.of(image, srcset), asked);
+		assertAskedWithEmptyParameters();
+		assertEquals(1, image.responded);
+		assertEquals(1, srcset.responded);
+	}
+
+	@Test
+	void imageButtonRefused()
+	{
+		refused.add(button);
+
+		tester.executeListener(tester.getComponentFromLastRenderedPage("form:button"));
+
+		assertForbidden(button);
+		assertEquals(List.of(button), asked);
+		assertAskedWithEmptyParameters();
+		assertEquals(0, button.responded);
+	}
+
+	@Test
+	void customListenerIsCalled()
+	{
+		refused.add(link);
+		List<IResource> notified = new ArrayList<>();
+		tester.getApplication().getSecuritySettings().setUnauthorizedResourceRequestListener(
+			(resource, parameters) -> notified.add(resource));
+
+		tester.clickLink("link", false);
+
+		assertEquals(1, notified.size());
+		assertSame(link, notified.get(0));
+		assertEquals(0, link.responded);
+		assertFalse(page.clicked);
+	}
+}
