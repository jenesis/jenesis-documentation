+/**
+ * An {@link AjaxDownloadBehavior} constructed with an {@link IResource} has to authorize it.
+ */
+class AjaxDownloadBehaviorAuthorizationTest extends WicketTestCase
+{
+	private final List<IResource> asked = new ArrayList<>();
+	private final List<PageParameters> askedParameters = new ArrayList<>();
+	private boolean allow;
+	private boolean responded;
+
+	/** */
+	public static class TestPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><div wicket:id='c'></div></body></html>");
+		}
+	}
+
+	private void download()
+	{
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(
+			new IAuthorizationStrategy.AllowAllAuthorizationStrategy()
+			{
+				@Override
+				public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+				{
+					asked.add(resource);
+					askedParameters.add(parameters);
+					return allow;
+				}
+			});
+
+		IResource resource = new ByteArrayResource("text/plain", "secret".getBytes())
+		{
+			private static final long serialVersionUID = 1L;
+
+			@Override
+			public void respond(Attributes attributes)
+			{
+				responded = true;
+				super.respond(attributes);
+			}
+		};
+
+		TestPage page = new TestPage();
+		WebMarkupContainer c = new WebMarkupContainer("c");
+		page.add(c);
+		c.add(new AjaxDownloadBehavior(resource));
+		tester.startPage(page);
+		asked.clear();
+		askedParameters.clear();
+
+		Behavior resourceBehavior = null;
+		for (Behavior behavior : c.getBehaviors())
+		{
+			if (behavior.getClass().getEnclosingClass() == AjaxDownloadBehavior.class)
+			{
+				resourceBehavior = behavior;
+			}
+		}
+		assertNotNull(resourceBehavior);
+
+		tester.invokeListener(c, resourceBehavior);
