+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Resources served from a component's listener URL must be authorized like resources requested by
+ * a resource URL.
+ */
+class ListenerResourceAuthorizationTest extends WicketTestCase
+{
+	private final List<IResource> asked = new ArrayList<>();
+	private final List<PageParameters> askedParameters = new ArrayList<>();
+	private final List<IResource> refused = new ArrayList<>();
+	private final List<IResource> responded = new ArrayList<>();
+	private boolean onClickCalled;
+
+	private class RecordingStrategy extends IAuthorizationStrategy.AllowAllAuthorizationStrategy
+	{
+		@Override
+		public boolean isResourceAuthorized(IResource resource, PageParameters parameters)
+		{
+			asked.add(resource);
+			askedParameters.add(parameters);
+			return !refused.contains(resource);
+		}
+	}
+
+	private class RecordingResource extends ByteArrayResource
+	{
+		private final String name;
+
+		RecordingResource(String name)
+		{
+			super("text/plain", name.getBytes());
+			this.name = name;
+		}
+
+		@Override
+		public void respond(Attributes attributes)
+		{
+			responded.add(this);
+			super.respond(attributes);
+		}
+
+		@Override
+		public String toString()
+		{
+			return name;
+		}
+	}
+
+	/** */
+	public static class TestPage extends WebPage implements IMarkupResourceStreamProvider
+	{
+		private static final long serialVersionUID = 1L;
+
+		@Override
+		public IResourceStream getMarkupResourceStream(MarkupContainer container,
+			Class<?> containerClass)
+		{
+			return new StringResourceStream("<html><body><a wicket:id='link'>link</a>" +
+				"<img wicket:id='image'/><form wicket:id='form'><input type='image' wicket:id='button'/></form>" +
+				"</body></html>");
+		}
+	}
+
+	private RecordingResource linkResource;
+	private RecordingResource src;
+	private RecordingResource srcset;
+	private RecordingResource buttonResource;
+
+	@BeforeEach
+	void setUp()
+	{
+		tester.getApplication().getSecuritySettings().setAuthorizationStrategy(new RecordingStrategy());
+		linkResource = new RecordingResource("link");
+		src = new RecordingResource("src");
+		srcset = new RecordingResource("srcset");
+		buttonResource = new RecordingResource("button");
+	}
+
+	private TestPage startPage()
+	{
+		TestPage page = new TestPage();
+		page.add(new ResourceLink<Void>("link", linkResource)
+		{
+			private static final long serialVersionUID = 1L;
+
+			@Override
+			public void onClick()
+			{
+				onClickCalled = true;
+			}
+		});
+		page.add(new Image("image", src, srcset));
+		Form<Void> form = new Form<>("form");
+		page.add(form);
+		form.add(new ImageButton("button", buttonResource));
+		tester.startPage(page);
+		tester.assertRenderedPage(TestPage.class);
+		asked.clear();
+		askedParameters.clear();
+		return page;
+	}
+
+	private void assertAskedWithEmptyParameters()
+	{
+		for (PageParameters parameters : askedParameters)
+		{
+			assertNotNull(parameters);
+			assertTrue(parameters.isEmpty());
+		}
+	}
+
+	@Test
+	void resourceLinkRefused()
+	{
+		refused.add(linkResource);
+		startPage();
+
+		tester.clickLink("link", false);
+
+		assertEquals(1, asked.size());
+		assertSame(linkResource, asked.get(0));
+		assertAskedWithEmptyParameters();
+		assertFalse(responded.contains(linkResource));
+		assertFalse(onClickCalled);
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+		assertEquals("The request to resource 'link' with parameters '' cannot be authorized.",
+			tester.getLastResponse().getErrorMessage());
+	}
+
+	@Test
+	void resourceLinkAllowed()
+	{
+		startPage();
+
+		tester.clickLink("link", false);
+
+		assertEquals(1, asked.size());
+		assertSame(linkResource, asked.get(0));
+		assertAskedWithEmptyParameters();
+		assertTrue(responded.contains(linkResource));
+		assertTrue(onClickCalled);
+		assertEquals(HttpServletResponse.SC_OK, tester.getLastResponse().getStatus());
+		assertEquals("link", tester.getLastResponse().getDocument());
+	}
+
+	@Test
+	void customListenerIsCalled()
+	{
+		List<IResource> notified = new ArrayList<>();
+		tester.getApplication().getSecuritySettings().setUnauthorizedResourceRequestListener(
+			(resource, parameters) -> notified.add(resource));
+		refused.add(linkResource);
+		startPage();
+
+		tester.clickLink("link", false);
+
+		assertEquals(List.of(linkResource), notified);
+		assertFalse(responded.contains(linkResource));
+		assertFalse(onClickCalled);
+	}
+
+	@Test
+	void imageSrcRefused()
+	{
+		refused.add(src);
+		TestPage page = startPage();
+
+		tester.executeListener(page.get("image"));
+
+		assertSame(src, asked.get(0));
+		assertAskedWithEmptyParameters();
+		assertTrue(responded.isEmpty());
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+	}
+
+	@Test
+	void imageSrcsetRefused()
+	{
+		List<IResource> notified = new ArrayList<>();
+		tester.getApplication().getSecuritySettings().setUnauthorizedResourceRequestListener(
+			(resource, parameters) -> notified.add(resource));
+		refused.add(srcset);
+		TestPage page = startPage();
+
+		tester.executeListener(page.get("image"));
+
+		assertEquals(List.of(src, srcset), asked);
+		assertAskedWithEmptyParameters();
+		assertEquals(List.of(srcset), notified);
+		assertEquals(List.of(src), responded);
+	}
+
+	@Test
+	void imageAllowed()
+	{
+		TestPage page = startPage();
+
+		tester.executeListener(page.get("image"));
+
+		assertEquals(List.of(src, srcset), asked);
+		assertEquals(List.of(src, srcset), responded);
+	}
+
+	@Test
+	void imageButtonRefused()
+	{
+		refused.add(buttonResource);
+		TestPage page = startPage();
+
+		tester.executeListener(page.get("form:button"));
+
+		assertEquals(List.of(buttonResource), asked);
+		assertAskedWithEmptyParameters();
+		assertTrue(responded.isEmpty());
+		assertEquals(HttpServletResponse.SC_FORBIDDEN, tester.getLastResponse().getStatus());
+	}
+}
