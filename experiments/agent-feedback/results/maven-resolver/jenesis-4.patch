+    /**
+     * A dependency whose version is selected from a range must have its own dependencies collected,
+     * even if another version of the same artifact was already resolved (and would otherwise make the
+     * skipper treat it as a version conflict loser).
+     */
+    @Test
+    void testRangeResolvedDependencyKeepsChildren() throws DependencyCollectionException {
+        collector = setupCollector(newReader("range-skipper/"));
+
+        Dependency root = newDep("gid:root:ext:1", "compile");
+        CollectRequest request = new CollectRequest(root, Collections.singletonList(repository));
+        CollectResult result = collector.collectDependencies(session, request);
+
+        assertEquals(0, result.getExceptions().size());
+        DependencyNode parentNode = path(result.getRoot(), 0);
+        assertEquals("parent", parentNode.getArtifact().getArtifactId());
+        DependencyNode library3 = parentNode.getChildren().stream()
+                .filter(n -> "3".equals(n.getArtifact().getVersion()))
+                .findFirst()
+                .orElseThrow(AssertionError::new);
+        assertEquals("library", library3.getArtifact().getArtifactId());
+        assertEquals(1, library3.getChildren().size());
+        assertEquals("range-asset", library3.getChildren().get(0).getArtifact().getArtifactId());
+    }
 }
