     @Test
+    void testRangeResolvedNodeIsNotSkippedAsVersionConflict() throws Exception {
+        // A -> L 1.0
+        // |--> P -> L [2.0,4.0) => L 3.0 must be resolved
+        // |--> Q -> L 1.0       => L 1.0 here is a duplicate, not a version conflict
+        DependencyNode aNode = makeDependencyNode("some-group", "A", "1.0");
+        DependencyNode lNode = makeDependencyNode("some-group", "L", "1.0");
+        DependencyNode pNode = makeDependencyNode("some-group", "P", "1.0");
+        DependencyNode qNode = makeDependencyNode("some-group", "Q", "1.0");
+        DefaultDependencyNode l3Node = (DefaultDependencyNode) makeDependencyNode("some-group", "L", "3.0");
+        l3Node.setVersionConstraint(new org.eclipse.aether.util.version.GenericVersionScheme()
+                .parseVersionConstraint("[2.0,4.0)"));
+        DependencyNode l1Node = new DefaultDependencyNode(lNode);
+
+        try (DependencyResolutionSkipper.DefaultDependencyResolutionSkipper skipper =
+                DependencyResolutionSkipper.defaultGACESkipper()) {
+            assertFalse(skipper.skipResolution(aNode, new ArrayList<>()));
+            skipper.cache(aNode, new ArrayList<>());
+            assertFalse(skipper.skipResolution(lNode, mutableList(aNode)));
+            skipper.cache(lNode, mutableList(aNode));
+            assertFalse(skipper.skipResolution(pNode, mutableList(aNode)));
+            skipper.cache(pNode, mutableList(aNode));
+            assertFalse(skipper.skipResolution(qNode, mutableList(aNode)));
+            skipper.cache(qNode, mutableList(aNode));
+
+            assertFalse(skipper.skipResolution(l3Node, mutableList(aNode, pNode)));
+            skipper.cache(l3Node, mutableList(aNode, pNode, l3Node));
+
+            assertTrue(skipper.skipResolution(l1Node, mutableList(aNode, qNode)));
+            DependencyResolutionSkipper.DependencyResolutionResult l1Result =
+                    skipper.getResults().get(l1Node);
+            assertTrue(l1Result.skippedAsDuplicate);
+            assertFalse(l1Result.skippedAsVersionConflict);
+        }
+    }
