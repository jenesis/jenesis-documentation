+    @Test
+    void testRangeResolvedNodeIsNotSkippedAndDoesNotTurnDuplicatesIntoConflicts() throws Exception {
+        // A -> L 1.0
+        // |--> P -> L [2,4) (selected 3.0)  => must be resolved, not skipped as version conflict
+        // |--> O -> L 1.0                    => still skipped as duplicate, not as version conflict
+        DependencyNode aNode = makeDependencyNode("some-group", "A", "1.0");
+        DependencyNode l1Node = makeDependencyNode("some-group", "L", "1.0");
+        DependencyNode pNode = makeDependencyNode("some-group", "P", "1.0");
+        DependencyNode oNode = makeDependencyNode("some-group", "O", "1.0");
+        DefaultDependencyNode l3Node = (DefaultDependencyNode) makeDependencyNode("some-group", "L", "3.0");
+        l3Node.setVersionConstraint(
+                new TestVersionConstraint(new GenericVersionScheme().parseVersionRange("[2.0,4.0)")));
+        DependencyNode l1DupNode = new DefaultDependencyNode(l1Node);
+
+        try (DependencyResolutionSkipper.DefaultDependencyResolutionSkipper skipper =
+                DependencyResolutionSkipper.defaultGACESkipper()) {
+            assertFalse(skipper.skipResolution(aNode, new ArrayList<>()));
+            skipper.cache(aNode, new ArrayList<>());
+            assertFalse(skipper.skipResolution(l1Node, mutableList(aNode)));
+            skipper.cache(l1Node, mutableList(aNode));
+            assertFalse(skipper.skipResolution(pNode, mutableList(aNode)));
+            skipper.cache(pNode, mutableList(aNode));
+            assertFalse(skipper.skipResolution(oNode, mutableList(aNode)));
+            skipper.cache(oNode, mutableList(aNode));
+
+            assertFalse(skipper.skipResolution(l3Node, mutableList(aNode, pNode)));
+            skipper.cache(l3Node, mutableList(aNode, pNode, l3Node));
+
+            assertTrue(skipper.skipResolution(l1DupNode, mutableList(aNode, oNode)));
+
+            Map<DependencyNode, DependencyResolutionSkipper.DependencyResolutionResult> results = skipper.getResults();
+            assertTrue(results.get(l3Node).resolve);
+            assertTrue(results.get(l1DupNode).skippedAsDuplicate);
+            assertFalse(results.get(l1DupNode).skippedAsVersionConflict);
+        }
+    }
 }
