+    @Test
+    void testRangeResolvedDependencyHasChildren() throws DependencyCollectionException {
+        collector = setupCollector(newReader("range-transitive/"));
+
+        CollectRequest request =
+                new CollectRequest(newDep("gid:root:ext:1", "compile"), Collections.singletonList(repository));
+        CollectResult result = collector.collectDependencies(session, request);
+
+        assertEquals(0, result.getExceptions().size());
+        DependencyNode parentNode = path(result.getRoot(), 0);
+        assertEquals("parent", parentNode.getArtifact().getArtifactId());
+        DependencyNode library3 = parentNode.getChildren().stream()
+                .filter(n -> "3".equals(n.getArtifact().getVersion()))
+                .findFirst()
+                .orElseThrow(AssertionError::new);
+        assertEquals("library", library3.getArtifact().getArtifactId());
+        assertEquals(1, library3.getChildren().size(), "library:3 should have range-asset as child");
+        assertEquals("range-asset", library3.getChildren().get(0).getArtifact().getArtifactId());
+    }
