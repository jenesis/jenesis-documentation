+        CollectResult result = collector.collectDependencies(session, request);
+
+        assertEquals(0, result.getExceptions().size());
+        DependencyNode parent = path(result.getRoot(), 0);
+        assertEquals("parent", parent.getArtifact().getArtifactId());
+        assertEquals(1, parent.getChildren().size());
+        DependencyNode library = path(result.getRoot(), 0, 0);
+        assertEquals("gid:library:ext:3", library.getArtifact().toString());
+        assertEquals(1, library.getChildren().size(), "library:3 must have its children collected");
+        assertEquals(
+                "gid:range-asset:ext:1",
+                library.getChildren().get(0).getArtifact().toString());
+    }
