+    private static DependencyNode makeRangeDependencyNode(
+            String groupId, String artifactId, String version, String range) throws Exception {
+        DefaultDependencyNode node = new DefaultDependencyNode(
+                new Dependency(new DefaultArtifact(groupId + ':' + artifactId + ':' + version), "compile"));
+        GenericVersionScheme scheme = new GenericVersionScheme();
+        node.setVersion(scheme.parseVersion(version));
+        node.setVersionConstraint(scheme.parseVersionConstraint(range));
+        return node;
+    }
+
+    @Test
+    void testRangeResolvedNodeIsResolvedAndNotCached() throws Exception {
+        // A -> L 1.0
+        // |--> B -> L [2,4) => L 3.0 must be resolved (not skipped as version conflict)
+        // |--> C -> L 1.0   => skipped as duplicate (not as version conflict)
+        DependencyNode aNode = makeDependencyNode("some-group", "A", "1.0");
+        DependencyNode l1Node = makeDependencyNode("some-group", "L", "1.0");
+        DependencyNode bNode = makeDependencyNode("some-group", "B", "1.0");
+        DependencyNode cNode = makeDependencyNode("some-group", "C", "1.0");
+        DependencyNode l3Node = makeRangeDependencyNode("some-group", "L", "3.0", "[2,4)");
+        DependencyNode l1DupNode = new DefaultDependencyNode(l1Node);
+
+        try (DependencyResolutionSkipper.DefaultDependencyResolutionSkipper skipper =
+                DependencyResolutionSkipper.defaultGACESkipper()) {
+            assertFalse(skipper.skipResolution(aNode, new ArrayList<>()));
+            skipper.cache(aNode, new ArrayList<>());
+            assertFalse(skipper.skipResolution(l1Node, mutableList(aNode)));
+            skipper.cache(l1Node, mutableList(aNode));
+            assertFalse(skipper.skipResolution(bNode, mutableList(aNode)));
+            skipper.cache(bNode, mutableList(aNode));
+            assertFalse(skipper.skipResolution(cNode, mutableList(aNode)));
+            skipper.cache(cNode, mutableList(aNode));
+
+            assertFalse(skipper.skipResolution(l3Node, mutableList(aNode, bNode)));
+            skipper.cache(l3Node, mutableList(aNode, bNode, l3Node));
+
+            assertTrue(skipper.skipResolution(l1DupNode, mutableList(aNode, cNode)));
+
+            Map<DependencyNode, DependencyResolutionSkipper.DependencyResolutionResult> results = skipper.getResults();
+            assertTrue(results.get(l3Node).resolve);
+            assertTrue(results.get(l1DupNode).skippedAsDuplicate);
+            assertFalse(results.get(l1DupNode).skippedAsVersionConflict);
+        }
+    }
