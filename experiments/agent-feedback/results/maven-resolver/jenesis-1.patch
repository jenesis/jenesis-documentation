+    @Test
+    void testRangeResolvedNodeIsResolvedAndNotCached() throws Exception {
+        // A -> B -> C 3.0 (from range [2,4)) -> D  => C3.0 must be resolved
+        // | -> C 1.0
+        // | -> E -> C 1.0  => duplicate of C1.0, not version conflict
+        DependencyNode aNode = makeDependencyNode("some-group", "A", "1.0");
+        DependencyNode bNode = makeDependencyNode("some-group", "B", "1.0");
+        DependencyNode c1Node = makeDependencyNode("some-group", "C", "1.0");
+        DependencyNode eNode = makeDependencyNode("some-group", "E", "1.0");
+        DependencyNode c3Node = makeDependencyNode("some-group", "C", "3.0");
+        ((DefaultDependencyNode) c3Node)
+                .setVersionConstraint(new org.eclipse.aether.util.version.GenericVersionScheme()
+                        .parseVersionConstraint("[2,4)"));
+        DependencyNode dNode = makeDependencyNode("some-group", "D", "1.0");
+        DependencyNode c1DupNode = makeDependencyNode("some-group", "C", "1.0");
+
+        try (DependencyResolutionSkipper.DefaultDependencyResolutionSkipper skipper =
+                DependencyResolutionSkipper.defaultGACESkipper()) {
+            assertFalse(skipper.skipResolution(aNode, new ArrayList<>()));
+            skipper.cache(aNode, new ArrayList<>());
+            assertFalse(skipper.skipResolution(bNode, mutableList(aNode)));
+            skipper.cache(bNode, mutableList(aNode));
+            assertFalse(skipper.skipResolution(c1Node, mutableList(aNode)));
+            skipper.cache(c1Node, mutableList(aNode));
+            assertFalse(skipper.skipResolution(eNode, mutableList(aNode)));
+            skipper.cache(eNode, mutableList(aNode));
+            assertFalse(skipper.skipResolution(c3Node, mutableList(aNode, bNode))); // range: resolve
+            skipper.cache(c3Node, mutableList(aNode, bNode, c3Node));
+            assertFalse(skipper.skipResolution(dNode, mutableList(aNode, bNode, c3Node)));
+            skipper.cache(dNode, mutableList(aNode, bNode, c3Node, dNode));
+            assertTrue(skipper.skipResolution(c1DupNode, mutableList(aNode, eNode)));
+
+            Map<DependencyNode, DependencyResolutionSkipper.DependencyResolutionResult> results = skipper.getResults();
+            assertTrue(results.get(c3Node).resolve);
+            assertTrue(results.get(c1DupNode).skippedAsDuplicate);
+            assertFalse(results.get(c1DupNode).skippedAsVersionConflict);
+        }
+    }
 }
