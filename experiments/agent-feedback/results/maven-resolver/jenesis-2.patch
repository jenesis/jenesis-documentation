+    @Test
+    void testRangeResolvedNodeIsNotSkippedAndDoesNotChangeWinner() throws Exception {
+        // A -> C 1.0
+        // |--> B -> C [2.0,4.0) selected 3.0 => must be resolved, not skipped as version conflict
+        // |--> D -> C 1.0 => still skipped as duplicate (not as version conflict)
+        DependencyNode aNode = makeDependencyNode("some-group", "A", "1.0");
+        DependencyNode c1Node = makeDependencyNode("some-group", "C", "1.0");
+        DependencyNode bNode = makeDependencyNode("some-group", "B", "1.0");
+        DependencyNode dNode = makeDependencyNode("some-group", "D", "1.0");
+        DefaultDependencyNode c3Node = (DefaultDependencyNode) makeDependencyNode("some-group", "C", "3.0");
+        c3Node.setVersionConstraint(new GenericVersionScheme().parseVersionConstraint("[2.0,4.0)"));
+        DependencyNode c1DupNode = new DefaultDependencyNode(c1Node);
+
+        try (DependencyResolutionSkipper.DefaultDependencyResolutionSkipper skipper =
+                DependencyResolutionSkipper.defaultGACESkipper()) {
+            assertFalse(skipper.skipResolution(aNode, new ArrayList<>()));
+            skipper.cache(aNode, new ArrayList<>());
+            assertFalse(skipper.skipResolution(c1Node, mutableList(aNode)));
+            skipper.cache(c1Node, mutableList(aNode));
+            assertFalse(skipper.skipResolution(bNode, mutableList(aNode)));
+            skipper.cache(bNode, mutableList(aNode));
+            assertFalse(skipper.skipResolution(dNode, mutableList(aNode)));
+            skipper.cache(dNode, mutableList(aNode));
+
+            assertFalse(skipper.skipResolution(c3Node, mutableList(aNode, bNode)));
+            skipper.cache(c3Node, mutableList(aNode, bNode));
+
+            assertTrue(skipper.skipResolution(c1DupNode, mutableList(aNode, dNode)));
+            DependencyResolutionSkipper.DependencyResolutionResult dup =
+                    skipper.getResults().get(c1DupNode);
+            assertTrue(dup.skippedAsDuplicate);
+            assertFalse(dup.skippedAsVersionConflict);
+        }
+    }
 }
