+    /**
+     * A dependency whose version is selected from a version range must have its own dependencies collected,
+     * even if another version of the same artifact was collected before at a shallower depth.
+     * <pre>
+     *   root
+     *   ├── parent:1 → library:[2,4) → library:3 → range-asset:1
+     *   ├── library:1
+     *   └── other:1  → library:1 (duplicate)
+     * </pre>
+     */
+    @Test
+    void testRangeResolvedDependencyChildrenAreCollected() throws DependencyCollectionException {
+        collector = setupCollector(newReader("range-transitive/"));
+
+        CollectRequest request =
+                new CollectRequest(newDep("gid:root:ext:1", "compile"), Collections.singletonList(repository));
+        CollectResult result = collector.collectDependencies(session, request);
+
+        assertEquals(0, result.getExceptions().size());
+        DependencyNode rootNode = result.getRoot();
+        assertEquals(3, rootNode.getChildren().size());
+
+        DependencyNode parent = rootNode.getChildren().get(0);
+        assertEquals("parent", parent.getArtifact().getArtifactId());
+        DependencyNode library3 = parent.getChildren().stream()
+                .filter(n -> "3".equals(n.getArtifact().getVersion()))
+                .findFirst()
+                .orElseThrow(AssertionError::new);
+        assertEquals("library", library3.getArtifact().getArtifactId());
+        assertEquals(1, library3.getChildren().size(), "range-resolved library:3 must have its children");
+        assertEquals("range-asset", library3.getChildren().get(0).getArtifact().getArtifactId());
+    }
 }
