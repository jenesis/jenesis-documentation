+    @Test
+    void testSuspendRequestedJustBeforeBlockingFinishesThread() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        AtomicBoolean requestSuspend = new AtomicBoolean();
+        AtomicBoolean suspendAccepted = new AtomicBoolean();
+        AtomicReference<SingleThreadIoEventLoop> loopRef = new AtomicReference<>();
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor executor) {
+                return new OnlyWakeupWhileBlockedIoHandler(executor) {
+                    @Override
+                    protected void beforeBlocking() {
+                        if (requestSuspend.compareAndSet(true, false)) {
+                            // Request suspension from another thread while this loop is about to block for IO.
+                            Thread t = new Thread(() -> suspendAccepted.set(loopRef.get().trySuspend()));
+                            t.start();
+                            try {
+                                t.join();
+                            } catch (InterruptedException e) {
+                                Thread.currentThread().interrupt();
+                            }
+                        }
+                    }
+                };
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+        };
+        SingleThreadIoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        loopRef.set(loop);
+        try {
+            loop.submit(() -> requestSuspend.set(true)).sync();
+            Thread thread = threadFactory.threads.take();
+
+            thread.join(TimeUnit.SECONDS.toMillis(10));
+            assertTrue(suspendAccepted.get());
+            assertTrue(loop.isSuspended());
+            assertFalse(thread.isAlive(), "Event loop thread should have finished after suspension");
+        } finally {
+            loop.shutdownGracefully(0, 15, TimeUnit.SECONDS).sync();
+        }
+    }
+
+    /**
+     * {@link IoHandler} that, like the epoll one, only reacts to {@link #wakeup()} while it is actually blocked.
+     */
+    private static class OnlyWakeupWhileBlockedIoHandler extends TestIoHandler {
+        private boolean blocked;
+        private boolean woken;
+
+        OnlyWakeupWhileBlockedIoHandler(ThreadAwareExecutor executor) {
+            super(executor);
+        }
+
+        protected void beforeBlocking() {
+            // NOOP
+        }
+
+        @Override
+        public synchronized void wakeup() {
+            if (blocked) {
+                woken = true;
+                notifyAll();
+            }
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            beforeBlocking();
+            synchronized (this) {
+                if (!context.canBlock()) {
+                    return 0;
+                }
+                blocked = true;
+                try {
+                    while (!woken) {
+                        wait();
+                    }
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                } finally {
+                    blocked = false;
+                    woken = false;
+                }
+            }
+            return 0;
+        }
+    }
