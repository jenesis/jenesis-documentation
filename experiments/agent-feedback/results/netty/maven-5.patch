+    @Test
+    void testSuspendWhileAboutToBlockStopsThread() throws Exception {
+        final CountDownLatch aboutToBlock = new CountDownLatch(1);
+        final CountDownLatch proceed = new CountDownLatch(1);
+        final AtomicBoolean armed = new AtomicBoolean();
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        IoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor eventLoop) {
+                return new OnlyWhenBlockedWakeupIoHandler(eventLoop, armed, aboutToBlock, proceed);
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+        });
+        try {
+            loop.execute(() -> armed.set(true));
+            Thread thread = threadFactory.threads.take();
+            assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+
+            // The loop is in its IoHandler but not blocked yet, so the wakeup() done by trySuspend() is not seen.
+            assertTrue(loop.trySuspend());
+            assertTrue(loop.isSuspended());
+            proceed.countDown();
+
+            thread.join(TimeUnit.SECONDS.toMillis(10));
+            assertFalse(thread.isAlive(), "Thread of suspended loop is still alive");
+            assertTrue(loop.isSuspended());
+        } finally {
+            proceed.countDown();
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS);
+        }
+    }
+
+    /**
+     * {@link IoHandler} that, like the epoll one, only reacts to a {@link #wakeup()} while it is actually blocked.
+     */
+    private static final class OnlyWhenBlockedWakeupIoHandler extends TestIoHandler {
+        private final AtomicBoolean armed;
+        private final CountDownLatch aboutToBlock;
+        private final CountDownLatch proceed;
+        private boolean blocked;
+
+        OnlyWhenBlockedWakeupIoHandler(ThreadAwareExecutor executor, AtomicBoolean armed,
+                                       CountDownLatch aboutToBlock, CountDownLatch proceed) {
+            super(executor);
+            this.armed = armed;
+            this.aboutToBlock = aboutToBlock;
+            this.proceed = proceed;
+        }
+
+        @Override
+        public synchronized void wakeup() {
+            if (blocked) {
+                blocked = false;
+                notifyAll();
+            }
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            if (armed.compareAndSet(true, false)) {
+                aboutToBlock.countDown();
+                try {
+                    proceed.await();
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                    return 0;
+                }
+            }
+            synchronized (this) {
+                blocked = true;
+            }
+            if (!context.canBlock()) {
+                synchronized (this) {
+                    blocked = false;
+                }
+                return 0;
+            }
+            synchronized (this) {
+                try {
+                    while (blocked) {
+                        wait();
+                    }
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                }
+            }
+            return 0;
+        }
+    }
