+    /**
+     * An {@link IoHandler} that, like the epoll one, only reacts to {@link #wakeup()} while it is blocked.
+     */
+    private static final class WakeupOnlyWhileBlockedIoHandler extends TestIoHandler {
+        private final Semaphore semaphore = new Semaphore(0);
+        private volatile boolean blocked;
+        volatile Runnable beforeBlocking;
+
+        WakeupOnlyWhileBlockedIoHandler(ThreadAwareExecutor executor) {
+            super(executor);
+        }
+
+        @Override
+        public void wakeup() {
+            if (blocked) {
+                semaphore.release();
+            }
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            Runnable hook = beforeBlocking;
+            if (hook != null) {
+                beforeBlocking = null;
+                hook.run();
+            }
+            blocked = true;
+            try {
+                if (context.canBlock()) {
+                    semaphore.acquireUninterruptibly();
+                }
+            } finally {
+                blocked = false;
+            }
+            return 0;
+        }
+    }
+
+    @Test
+    void testSuspendRequestedRightBeforeBlockingStopsThread() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        AtomicReference<WakeupOnlyWhileBlockedIoHandler> handlerRef = new AtomicReference<>();
+        IoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor eventLoop) {
+                WakeupOnlyWhileBlockedIoHandler handler = new WakeupOnlyWhileBlockedIoHandler(eventLoop);
+                handlerRef.set(handler);
+                return handler;
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+        });
+        try {
+            AtomicBoolean suspended = new AtomicBoolean();
+            CountDownLatch taskRan = new CountDownLatch(1);
+            loop.execute(() -> {
+                // Request the suspension from another thread when the loop is about to go back to waiting for IO.
+                handlerRef.get().beforeBlocking = () -> {
+                    Thread suspender = new Thread(() -> suspended.set(loop.trySuspend()));
+                    suspender.start();
+                    try {
+                        suspender.join();
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                    }
+                };
+                taskRan.countDown();
+            });
+            assertTrue(taskRan.await(5, TimeUnit.SECONDS));
+            Thread loopThread = threadFactory.threads.take();
+
+            loopThread.join(TimeUnit.SECONDS.toMillis(5));
+            assertTrue(suspended.get());
+            assertTrue(loop.isSuspended());
+            assertFalse(loopThread.isAlive(), "suspended event loop thread is still alive");
+        } finally {
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS);
+        }
+    }
