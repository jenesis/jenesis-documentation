+    @Test
+    void testSuspendRequestedWhileAboutToBlockIsNotMissed() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        AtomicReference<IoEventLoop> loopRef = new AtomicReference<>();
+        AtomicBoolean suspendBeforeBlocking = new AtomicBoolean();
+        AtomicBoolean suspendResult = new AtomicBoolean();
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor ioExecutor) {
+                return new SuspendRaceIoHandler(loopRef, suspendBeforeBlocking, suspendResult);
+            }
+        };
+        IoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        loopRef.set(loop);
+        // Request the suspension from the next run() call, after the task ran and before the loop blocks.
+        loop.submit(() -> suspendBeforeBlocking.set(true)).sync();
+        Thread thread = threadFactory.threads.take();
+
+        thread.join(TimeUnit.SECONDS.toMillis(10));
+        assertTrue(suspendResult.get());
+        assertTrue(loop.isSuspended());
+        assertFalse(thread.isAlive(), "Suspended event loop thread is still alive");
+        loop.shutdownGracefully(0, 0, TimeUnit.SECONDS).sync();
+    }
+
+    private static final class SuspendRaceIoHandler implements IoHandler {
+        private final AtomicReference<IoEventLoop> loopRef;
+        private final AtomicBoolean suspendBeforeBlocking;
+        private final AtomicBoolean suspendResult;
+        // Like the epoll IoHandler, wakeup() only has an effect while we are actually blocked.
+        private final Semaphore semaphore = new Semaphore(0);
+        private volatile boolean blocking;
+
+        SuspendRaceIoHandler(AtomicReference<IoEventLoop> loopRef, AtomicBoolean suspendBeforeBlocking,
+                             AtomicBoolean suspendResult) {
+            this.loopRef = loopRef;
+            this.suspendBeforeBlocking = suspendBeforeBlocking;
+            this.suspendResult = suspendResult;
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            if (suspendBeforeBlocking.compareAndSet(true, false)) {
+                // Simulate trySuspend() being called from another thread just before we block.
+                Thread t = new Thread(() -> suspendResult.set(loopRef.get().trySuspend()));
+                t.start();
+                try {
+                    t.join();
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                }
+            }
+            if (!context.canBlock()) {
+                return 0;
+            }
+            blocking = true;
+            try {
+                semaphore.acquire();
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            } finally {
+                blocking = false;
+            }
+            return 0;
+        }
+
+        @Override
+        public void wakeup() {
+            if (blocking) {
+                semaphore.release();
+            }
+        }
+
+        @Override
+        public void prepareToDestroy() {
+            // NOOP
+        }
+
+        @Override
+        public void destroy() {
+            // NOOP
+        }
+
+        @Override
+        public IoRegistration register(IoHandle handle) {
+            throw new UnsupportedOperationException();
+        }
+
+        @Override
+        public boolean isCompatible(Class<? extends IoHandle> handleType) {
+            return false;
+        }
+    }
