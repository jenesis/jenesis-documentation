+    @Test
+    void testSuspendWhileAboutToBlockWithHandlerThatOnlyWakesWhenBlocked() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        final AtomicBoolean taskRan = new AtomicBoolean();
+        final CountDownLatch aboutToBlock = new CountDownLatch(1);
+        final CountDownLatch proceed = new CountDownLatch(1);
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public boolean isChangingThreadSupported() {
+                // Required for suspension support.
+                return true;
+            }
+
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor executor) {
+                return new IoHandler() {
+                    private final Semaphore semaphore = new Semaphore(0);
+                    // Like epoll: a wakeup is only delivered when the handler announced it is going to block.
+                    private final AtomicBoolean blocking = new AtomicBoolean();
+                    private boolean gateUsed;
+
+                    @Override
+                    public void wakeup() {
+                        if (blocking.getAndSet(false)) {
+                            semaphore.release();
+                        }
+                    }
+
+                    @Override
+                    public int run(IoHandlerContext context) {
+                        if (taskRan.get() && !gateUsed) {
+                            gateUsed = true;
+                            aboutToBlock.countDown();
+                            try {
+                                proceed.await();
+                            } catch (InterruptedException e) {
+                                Thread.currentThread().interrupt();
+                            }
+                        }
+                        blocking.set(true);
+                        if (context.canBlock()) {
+                            try {
+                                semaphore.tryAcquire(30, TimeUnit.SECONDS);
+                            } catch (InterruptedException e) {
+                                Thread.currentThread().interrupt();
+                            }
+                        }
+                        blocking.set(false);
+                        return 0;
+                    }
+
+                    @Override
+                    public void prepareToDestroy() {
+                        // NOOP
+                    }
+
+                    @Override
+                    public void destroy() {
+                        // NOOP
+                    }
+
+                    @Override
+                    public IoRegistration register(IoHandle handle) {
+                        throw new UnsupportedOperationException();
+                    }
+
+                    @Override
+                    public boolean isCompatible(Class<? extends IoHandle> handleType) {
+                        return false;
+                    }
+                };
+            }
+        };
+        SingleThreadIoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        try {
+            loop.execute(() -> taskRan.set(true));
+            Thread loopThread = threadFactory.threads.take();
+            assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+
+            // The loop is between its last check and blocking: the wakeup() issued by trySuspend() is lost.
+            assertTrue(loop.trySuspend());
+            assertTrue(loop.isSuspended());
+            proceed.countDown();
+
+            loopThread.join(TimeUnit.SECONDS.toMillis(10));
+            assertFalse(loopThread.isAlive(), "Event loop thread should have finished after suspension");
+            assertTrue(loop.isSuspended());
+        } finally {
+            proceed.countDown();
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS);
+        }
+    }
