+    @Test
+    void testSuspendWhileIoHandlerIsAboutToBlock() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        AtomicBoolean armed = new AtomicBoolean();
+        CountDownLatch aboutToBlock = new CountDownLatch(1);
+        CountDownLatch proceed = new CountDownLatch(1);
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor executor) {
+                return new WakeupOnlyWhenBlockedIoHandler(executor) {
+                    @Override
+                    public int run(IoHandlerContext context) {
+                        if (armed.compareAndSet(true, false)) {
+                            // Let the suspend request arrive while we are about to block.
+                            aboutToBlock.countDown();
+                            try {
+                                proceed.await();
+                            } catch (InterruptedException e) {
+                                Thread.currentThread().interrupt();
+                            }
+                        }
+                        return super.run(context);
+                    }
+                };
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+        };
+        SingleThreadIoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        try {
+            loop.submit(() -> armed.set(true)).sync();
+            Thread thread = threadFactory.threads.take();
+            assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+
+            assertTrue(loop.trySuspend());
+            assertTrue(loop.isSuspended());
+            proceed.countDown();
+
+            thread.join(TimeUnit.SECONDS.toMillis(10));
+            assertFalse(thread.isAlive());
+            assertTrue(loop.isSuspended());
+        } finally {
+            proceed.countDown();
+            loop.shutdownGracefully(0, 15, TimeUnit.SECONDS).sync();
+        }
+    }
+
+    /**
+     * Mimics the epoll IoHandler: a wakeup only has an effect if the handler is actually blocked.
+     */
+    private static class WakeupOnlyWhenBlockedIoHandler extends TestIoHandler {
+        private final AtomicBoolean blocked = new AtomicBoolean();
+        private final Semaphore wakeupSemaphore = new Semaphore(0);
+
+        WakeupOnlyWhenBlockedIoHandler(ThreadAwareExecutor executor) {
+            super(executor);
+        }
+
+        @Override
+        public void wakeup() {
+            if (blocked.getAndSet(false)) {
+                wakeupSemaphore.release();
+            }
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            if (!context.canBlock()) {
+                return 0;
+            }
+            blocked.set(true);
+            try {
+                if (context.canBlock()) {
+                    wakeupSemaphore.acquire();
+                }
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            } finally {
+                blocked.set(false);
+            }
+            return 0;
+        }
+    }
