+    /**
+     * {@link IoHandler} that, like the epoll one, only reacts to {@link #wakeup()} while it is actually blocked.
+     */
+    private static final class WakeupOnlyWhileBlockedIoHandler implements IoHandler {
+        private final CountDownLatch aboutToBlock;
+        private final CountDownLatch suspendRequested;
+        private boolean blocked;
+        private boolean woken;
+
+        WakeupOnlyWhileBlockedIoHandler(CountDownLatch aboutToBlock, CountDownLatch suspendRequested) {
+            this.aboutToBlock = aboutToBlock;
+            this.suspendRequested = suspendRequested;
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            // Wait for the suspend request once the loop is idle and the handler is just about to block.
+            if (aboutToBlock.getCount() > 0 && context.canBlock()) {
+                aboutToBlock.countDown();
+                try {
+                    suspendRequested.await();
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                    return 0;
+                }
+            }
+            synchronized (this) {
+                if (!context.canBlock()) {
+                    return 0;
+                }
+                blocked = true;
+                woken = false;
+                try {
+                    while (!woken) {
+                        wait();
+                    }
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                } finally {
+                    blocked = false;
+                }
+            }
+            return 0;
+        }
+
+        @Override
+        public synchronized void wakeup() {
+            if (blocked) {
+                woken = true;
+                notifyAll();
+            }
+        }
+
