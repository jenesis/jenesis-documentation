+    @Test
+    void testSuspendRequestedJustBeforeBlockingLetsThreadFinish() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        CountDownLatch aboutToBlock = new CountDownLatch(1);
+        CountDownLatch suspendRequested = new CountDownLatch(1);
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor executor) {
+                return new WakeupOnlyWhileBlockedIoHandler(executor, aboutToBlock, suspendRequested);
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+        };
+        SingleThreadIoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        try {
+            // Start the event loop thread.
+            loop.submit(() -> { }).sync();
+            Thread thread = threadFactory.threads.take();
+
+            // The loop is about to block for IO but has not blocked yet, so the wakeup done by trySuspend() is lost.
+            assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+            assertTrue(loop.trySuspend());
+            assertTrue(loop.isSuspended());
+            suspendRequested.countDown();
+
+            thread.join(TimeUnit.SECONDS.toMillis(10));
+            assertFalse(thread.isAlive(), "suspended event loop thread is still alive");
+            assertTrue(loop.isSuspended());
+        } finally {
+            suspendRequested.countDown();
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS).sync();
+        }
+    }
+
+    /**
+     * Behaves like the epoll {@link IoHandler}: a call to {@link #wakeup()} only has an effect while the handler is
+     * blocked (or has published that it is going to block), and {@link IoHandlerContext#canBlock()} is re-checked
+     * after publishing that.
+     */
+    private static final class WakeupOnlyWhileBlockedIoHandler extends TestIoHandler {
+        private final Semaphore semaphore = new Semaphore(0);
+        private final AtomicBoolean blocking = new AtomicBoolean();
+        private final CountDownLatch aboutToBlock;
+        private final CountDownLatch suspendRequested;
+
+        WakeupOnlyWhileBlockedIoHandler(ThreadAwareExecutor executor, CountDownLatch aboutToBlock,
+                                        CountDownLatch suspendRequested) {
+            super(executor);
+            this.aboutToBlock = aboutToBlock;
+            this.suspendRequested = suspendRequested;
+        }
+
+        @Override
+        public void wakeup() {
+            if (blocking.compareAndSet(true, false)) {
+                semaphore.release();
+            }
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            semaphore.drainPermits();
+            if (!context.canBlock()) {
+                return 0;
+            }
+            if (aboutToBlock.getCount() > 0) {
+                aboutToBlock.countDown();
+                try {
+                    suspendRequested.await();
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                    return 0;
+                }
+            }
+            blocking.set(true);
+            try {
+                if (context.canBlock()) {
+                    semaphore.acquire();
+                }
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            } finally {
+                blocking.set(false);
+            }
+            return 0;
+        }
+    }
