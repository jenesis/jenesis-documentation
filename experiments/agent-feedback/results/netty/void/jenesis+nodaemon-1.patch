+    @Test
+    void testSuspendRequestedJustBeforeBlockingTerminatesThread() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        AtomicReference<WakeupOnlyWhenBlockedIoHandler> handlerRef = new AtomicReference<>();
+        IoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor executor) {
+                WakeupOnlyWhenBlockedIoHandler handler = new WakeupOnlyWhenBlockedIoHandler();
+                handlerRef.set(handler);
+                return handler;
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+        });
+        try {
+            AtomicBoolean suspended = new AtomicBoolean();
+            CountDownLatch taskRun = new CountDownLatch(1);
+            loop.execute(() -> {
+                // Request the suspension from another thread right before the IoHandler goes back to waiting,
+                // so the wakeup() of trySuspend() arrives while the handler is not blocked yet.
+                handlerRef.get().beforeBlock = () -> {
+                    Thread t = new Thread(() -> suspended.set(loop.trySuspend()));
+                    t.start();
+                    try {
+                        t.join();
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                    }
+                };
+                taskRun.countDown();
+            });
+            assertTrue(taskRun.await(10, TimeUnit.SECONDS));
+            Thread loopThread = threadFactory.threads.take();
+
+            loopThread.join(TimeUnit.SECONDS.toMillis(10));
+            assertTrue(suspended.get(), "trySuspend() should have been accepted");
+            assertTrue(loop.isSuspended(), "Event loop should report being suspended");
+            assertFalse(loopThread.isAlive(), "Event loop thread should have terminated after suspension");
+        } finally {
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS);
+        }
+    }
+
+    /**
+     * {@link IoHandler} that, like the epoll one, only reacts to {@link #wakeup()} while it is actually blocked and
+     * re-checks {@link IoHandlerContext#canBlock()} after announcing that it is about to block.
+     */
+    private static final class WakeupOnlyWhenBlockedIoHandler implements IoHandler {
+        private final AtomicBoolean blocked = new AtomicBoolean();
+        private final Semaphore semaphore = new Semaphore(0);
+        volatile Runnable beforeBlock;
+
+        @Override
+        public int run(IoHandlerContext context) {
+            if (!context.canBlock()) {
+                return 0;
+            }
+            Runnable r = beforeBlock;
+            if (r != null) {
+                beforeBlock = null;
+                r.run();
+            }
+            blocked.set(true);
+            try {
+                if (context.canBlock()) {
+                    semaphore.acquire();
+                }
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            } finally {
+                blocked.set(false);
+            }
+            return 0;
+        }
+
+        @Override
+        public void wakeup() {
+            if (blocked.getAndSet(false)) {
+                semaphore.release();
+            }
+        }
+
+        @Override
+        public void prepareToDestroy() {
+            // NOOP
+        }
+
+        @Override
+        public void destroy() {
+            // NOOP
+        }
+
+        @Override
+        public IoRegistration register(IoHandle handle) {
+            throw new UnsupportedOperationException();
+        }
+
+        @Override
+        public boolean isCompatible(Class<? extends IoHandle> handleType) {
+            return false;
+        }
+    }
