+    @Test
+    void testSuspendWhileAboutToBlockDoesNotKeepThreadAlive() throws Exception {
+        final CountDownLatch aboutToBlock = new CountDownLatch(1);
+        final CountDownLatch proceed = new CountDownLatch(1);
+        final AtomicBoolean armed = new AtomicBoolean();
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        // An IoHandler that, like epoll, only reacts to a wakeup while it is actually blocked.
+        IoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, new IoHandlerFactory() {
+            @Override
+            public boolean isChangingThreadSupported() {
+                // Required so that the loop supports suspension.
+                return true;
+            }
+
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor eventLoop) {
+                return new IoHandler() {
+                    private final Object lock = new Object();
+                    private boolean blocked;
+
+                    @Override
+                    public int run(IoHandlerContext context) {
+                        if (armed.compareAndSet(true, false)) {
+                            aboutToBlock.countDown();
+                            try {
+                                proceed.await();
+                            } catch (InterruptedException e) {
+                                Thread.currentThread().interrupt();
+                            }
+                        }
+                        if (!context.canBlock()) {
+                            return 0;
+                        }
+                        synchronized (lock) {
+                            blocked = true;
+                            try {
+                                lock.wait();
+                            } catch (InterruptedException e) {
+                                Thread.currentThread().interrupt();
+                            } finally {
+                                blocked = false;
+                            }
+                        }
+                        return 0;
+                    }
+
+                    @Override
+                    public void wakeup() {
+                        synchronized (lock) {
+                            if (blocked) {
+                                lock.notifyAll();
+                            }
+                        }
+                    }
+
+                    @Override
+                    public void prepareToDestroy() {
+                        // NOOP
+                    }
+
+                    @Override
+                    public void destroy() {
+                        // NOOP
+                    }
+
+                    @Override
+                    public IoRegistration register(IoHandle handle) {
+                        throw new UnsupportedOperationException();
+                    }
+
+                    @Override
+                    public boolean isCompatible(Class<? extends IoHandle> handleType) {
+                        return false;
+                    }
+                };
+            }
+        });
+        try {
+            loop.execute(() -> armed.set(true));
+            Thread thread = threadFactory.threads.take();
+            assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+
+            // The loop is about to go back to waiting for IO, the wakeup issued here is not seen by the handler.
+            assertTrue(loop.trySuspend());
+            assertTrue(loop.isSuspended());
+            proceed.countDown();
+
+            thread.join(TimeUnit.SECONDS.toMillis(10));
+            assertFalse(thread.isAlive(), "Suspended event loop thread should have terminated");
+            assertTrue(loop.isSuspended());
+        } finally {
+            proceed.countDown();
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS).syncUninterruptibly();
+        }
+    }
