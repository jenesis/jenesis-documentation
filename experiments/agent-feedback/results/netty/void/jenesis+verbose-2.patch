+    @Test
+    void testSuspendWhileAboutToBlockDoesNotKeepThreadAlive() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        CountDownLatch aboutToBlock = new CountDownLatch(1);
+        CountDownLatch suspendRequested = new CountDownLatch(1);
+        AtomicBoolean armRace = new AtomicBoolean();
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor eventLoop) {
+                return new BlockedOnlyWakeupIoHandler() {
+                    @Override
+                    void beforeArm() {
+                        if (armRace.compareAndSet(true, false)) {
+                            aboutToBlock.countDown();
+                            try {
+                                suspendRequested.await();
+                            } catch (InterruptedException e) {
+                                Thread.currentThread().interrupt();
+                            }
+                        }
+                    }
+                };
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                // Suspension needs a handler that supports changing the thread.
+                return true;
+            }
+        };
+        IoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        armRace.set(true);
+        loop.execute(() -> { });
+        Thread loopThread = threadFactory.threads.take();
+        assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+
+        // The loop decided it can block but did not arm its wake-up yet, so the wake-up of trySuspend() is lost.
+        assertTrue(loop.trySuspend());
+        assertTrue(loop.isSuspended());
+        suspendRequested.countDown();
+
+        loopThread.join(TimeUnit.SECONDS.toMillis(10));
+        assertFalse(loopThread.isAlive());
+        assertTrue(loop.isSuspended());
+        loop.shutdownGracefully().syncUninterruptibly();
+    }
+
+    /**
+     * Like the epoll {@link IoHandler}, only reacts to {@link #wakeup()} while actually blocked.
+     */
+    private static class BlockedOnlyWakeupIoHandler implements IoHandler {
+        private final Semaphore semaphore = new Semaphore(0);
+        private final AtomicBoolean blocked = new AtomicBoolean();
+
+        void beforeArm() {
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            if (!context.canBlock()) {
+                return 0;
+            }
+            beforeArm();
+            blocked.set(true);
+            // Check again after arming, as a wake-up that happened before was lost.
+            if (context.canBlock()) {
+                semaphore.acquireUninterruptibly();
+            }
+            if (blocked.compareAndSet(true, false)) {
+                // Nobody woke us up.
+                return 0;
+            }
+            // wakeup() released a permit, consume it if we did not.
+            semaphore.drainPermits();
+            return 0;
+        }
+
+        @Override
+        public void wakeup() {
+            if (blocked.compareAndSet(true, false)) {
+                semaphore.release();
+            }
+        }
+
+        @Override
+        public void prepareToDestroy() {
+        }
+
+        @Override
+        public void destroy() {
+        }
+
+        @Override
+        public IoRegistration register(IoHandle handle) {
+            throw new UnsupportedOperationException();
+        }
+
+        @Override
+        public boolean isCompatible(Class<? extends IoHandle> handleType) {
+            return false;
+        }
+    }
