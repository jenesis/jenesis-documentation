+    // The handler only reacts to wakeup() once it is blocked, like epoll does, and trySuspend() is called in the
+    // window between the first canBlock() check and the handler blocking.
+    @Test
+    void testSuspendRequestedJustBeforeBlockingLetsThreadFinish() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        CountDownLatch aboutToBlock = new CountDownLatch(1);
+        CountDownLatch suspendRequested = new CountDownLatch(1);
+        AtomicBoolean blocked = new AtomicBoolean();
+        AtomicBoolean firstRun = new AtomicBoolean(true);
+        Semaphore wakeup = new Semaphore(0);
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor eventLoop) {
+                return new TestIoHandler(eventLoop) {
+                    @Override
+                    public void wakeup() {
+                        if (blocked.get()) {
+                            wakeup.release();
+                        }
+                    }
+
+                    @Override
+                    public int run(IoHandlerContext context) {
+                        try {
+                            if (context.canBlock()) {
+                                if (firstRun.compareAndSet(true, false)) {
+                                    aboutToBlock.countDown();
+                                    suspendRequested.await();
+                                }
+                                // Publish that we block, then re-check, as epoll does.
+                                blocked.set(true);
+                                if (context.canBlock()) {
+                                    wakeup.tryAcquire(30, TimeUnit.SECONDS);
+                                }
+                                blocked.set(false);
+                            }
+                        } catch (InterruptedException e) {
+                            Thread.currentThread().interrupt();
+                        }
+                        return 0;
+                    }
+                };
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+        };
+        SingleThreadIoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        try {
+            Thread thread;
+            loop.execute(() -> { });
+            thread = threadFactory.threads.take();
+            assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+            assertTrue(loop.trySuspend());
+            assertTrue(loop.isSuspended());
+            suspendRequested.countDown();
+            thread.join(10000);
+            assertFalse(thread.isAlive());
+        } finally {
+            suspendRequested.countDown();
+            wakeup.release();
+            loop.shutdownGracefully();
+        }
+    }
+
     private static class TestIoHandler implements IoHandler {
         private final Semaphore semaphore = new Semaphore(0);
         private final ThreadAwareExecutor executor;
