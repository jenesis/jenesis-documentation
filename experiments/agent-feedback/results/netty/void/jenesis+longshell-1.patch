+    @Test
+    void testSuspendRequestedWhileAboutToBlockStopsThread() throws Exception {
+        final CountDownLatch aboutToBlock = new CountDownLatch(1);
+        final CountDownLatch proceed = new CountDownLatch(1);
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor eventLoop) {
+                return new IoHandler() {
+                    // Like epoll: a wakeup is only seen when it arrives while we are actually blocked.
+                    private final Semaphore semaphore = new Semaphore(0);
+                    private volatile boolean blocked;
+                    private boolean paused;
+
+                    @Override
+                    public int run(IoHandlerContext context) {
+                        if (!context.canBlock()) {
+                            return 0;
+                        }
+                        if (!paused) {
+                            paused = true;
+                            aboutToBlock.countDown();
+                            try {
+                                proceed.await();
+                            } catch (InterruptedException e) {
+                                Thread.currentThread().interrupt();
+                                return 0;
+                            }
+                        }
+                        if (!context.canBlock()) {
+                            return 0;
+                        }
+                        blocked = true;
+                        try {
+                            semaphore.tryAcquire(30, TimeUnit.SECONDS);
+                        } catch (InterruptedException e) {
+                            Thread.currentThread().interrupt();
+                        } finally {
+                            blocked = false;
+                        }
+                        return 0;
+                    }
+
+                    @Override
+                    public void wakeup() {
+                        if (blocked) {
+                            semaphore.release();
+                        }
+                    }
+
+                    @Override
+                    public void prepareToDestroy() {
+                        // NOOP
+                    }
+
+                    @Override
+                    public void destroy() {
+                        // NOOP
+                    }
+
+                    @Override
+                    public IoRegistration register(IoHandle handle) {
+                        throw new UnsupportedOperationException();
+                    }
+
+                    @Override
+                    public boolean isCompatible(Class<? extends IoHandle> handleType) {
+                        return false;
+                    }
+                };
+            }
+        };
+        IoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        try {
+            CountDownLatch taskRan = new CountDownLatch(1);
+            loop.execute(taskRan::countDown);
+            assertTrue(taskRan.await(10, TimeUnit.SECONDS));
+            Thread thread = threadFactory.threads.take();
+
+            // The loop is about to go back to waiting for IO, but is not blocked yet: the wakeup is dropped.
+            assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+            assertTrue(loop.trySuspend());
+            assertTrue(loop.isSuspended());
+            proceed.countDown();
+
+            thread.join(TimeUnit.SECONDS.toMillis(10));
+            assertFalse(thread.isAlive(), "Suspended event loop thread is still alive");
+            assertTrue(loop.isSuspended());
+        } finally {
+            proceed.countDown();
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS);
+        }
+    }
