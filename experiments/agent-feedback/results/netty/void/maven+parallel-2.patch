+    @Test
+    void testSuspendRequestedWhileAboutToBlockIsNotLost() throws Exception {
+        final CountDownLatch aboutToBlock = new CountDownLatch(1);
+        final CountDownLatch proceed = new CountDownLatch(1);
+        final AtomicBoolean armed = new AtomicBoolean();
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        // Like the epoll transport this handler only reacts to a wakeup while it is actually blocked.
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor eventLoop) {
+                return newWakeupOnlyWhenBlockedHandler(armed, aboutToBlock, proceed);
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+        };
+        IoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        try {
+            // Arm the handler from within a task so the next IO iteration pauses right before it would block.
+            loop.execute(() -> armed.set(true));
+            Thread thread = threadFactory.threads.take();
+            assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+
+            // The wakeup triggered by trySuspend() is dropped as the handler is not blocked yet.
+            assertTrue(loop.trySuspend());
+            assertTrue(loop.isSuspended());
+            proceed.countDown();
+
+            thread.join(TimeUnit.SECONDS.toMillis(10));
+            assertFalse(thread.isAlive(), "Suspended event loop thread is still alive");
+            assertTrue(loop.isSuspended());
+        } finally {
+            proceed.countDown();
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS).syncUninterruptibly();
+        }
+    }
+
+    private static IoHandler newWakeupOnlyWhenBlockedHandler(
+            final AtomicBoolean armed, final CountDownLatch aboutToBlock, final CountDownLatch proceed) {
+        return new IoHandler() {
+            private final Semaphore semaphore = new Semaphore(0);
+            private final AtomicBoolean blocked = new AtomicBoolean();
+
+            @Override
+            public int run(IoHandlerContext context) {
+                if (armed.compareAndSet(true, false)) {
+                    aboutToBlock.countDown();
+                    try {
+                        proceed.await();
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                    }
+                }
+                blocked.set(true);
+                try {
+                    if (context.canBlock()) {
+                        semaphore.acquire();
+                    }
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                } finally {
+                    blocked.set(false);
+                    semaphore.drainPermits();
+                }
+                return 0;
+            }
+
+            @Override
+            public void wakeup() {
+                if (blocked.get()) {
+                    semaphore.release();
+                }
+            }
+
+            @Override
+            public void prepareToDestroy() {
+                // NOOP
+            }
+
+            @Override
+            public void destroy() {
+                // NOOP
+            }
+
+            @Override
+            public IoRegistration register(IoHandle handle) {
+                throw new UnsupportedOperationException();
+            }
+
+            @Override
+            public boolean isCompatible(Class<? extends IoHandle> handleType) {
+                return false;
+            }
+        };
+    }
