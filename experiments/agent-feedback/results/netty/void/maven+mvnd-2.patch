+    @Test
+    void testSuspendRequestedJustBeforeBlockingTerminatesThread() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        AtomicBoolean armed = new AtomicBoolean();
+        AtomicBoolean suspendResult = new AtomicBoolean();
+        AtomicReference<SingleThreadIoEventLoop> loopRef = new AtomicReference<>();
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor ioExecutor) {
+                return new BlockingOnlyWakeupIoHandler(() -> {
+                    if (armed.compareAndSet(true, false)) {
+                        // Request the suspension from another thread while this loop is about to block for IO.
+                        Thread t = new Thread(() -> suspendResult.set(loopRef.get().trySuspend()));
+                        t.start();
+                        try {
+                            t.join();
+                        } catch (InterruptedException e) {
+                            Thread.currentThread().interrupt();
+                        }
+                    }
+                });
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                // Required so the loop supports suspension.
+                return true;
+            }
+        };
+        SingleThreadIoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        loopRef.set(loop);
+        try {
+            loop.submit(() -> armed.set(true)).sync();
+            Thread thread = threadFactory.threads.take();
+            thread.join(TimeUnit.SECONDS.toMillis(5));
+            assertTrue(suspendResult.get());
+            assertTrue(loop.isSuspended());
+            assertFalse(thread.isAlive(), "Thread of suspended loop is still alive");
+        } finally {
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS).sync();
+        }
+    }
+
+    /**
+     * {@link IoHandler} that, like the epoll one, only reacts to {@link #wakeup()} while it is actually blocked.
+     */
+    private static final class BlockingOnlyWakeupIoHandler extends TestIoHandler {
+        private final Semaphore blocker = new Semaphore(0);
+        private final AtomicBoolean blocking = new AtomicBoolean();
+        private final Runnable beforeBlock;
+
+        BlockingOnlyWakeupIoHandler(Runnable beforeBlock) {
+            super(null);
+            this.beforeBlock = beforeBlock;
+        }
+
+        @Override
+        public void wakeup() {
+            if (blocking.compareAndSet(true, false)) {
+                blocker.release();
+            }
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            beforeBlock.run();
+            blocking.set(true);
+            if (!context.canBlock()) {
+                if (!blocking.compareAndSet(true, false)) {
+                    // A wakeup raced in and released a permit, consume it.
+                    blocker.acquireUninterruptibly();
+                }
+                return 0;
+            }
+            blocker.acquireUninterruptibly();
+            return 0;
+        }
+    }
