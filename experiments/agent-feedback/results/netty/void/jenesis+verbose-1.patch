+    @Test
+    void testSuspendRequestedWhileLoopIsAboutToBlock() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        AtomicBoolean pauseBeforeArming = new AtomicBoolean();
+        CountDownLatch aboutToBlock = new CountDownLatch(1);
+        CountDownLatch suspendRequested = new CountDownLatch(1);
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor executor) {
+                return new WakeupOnlyWhenBlockedIoHandler() {
+                    @Override
+                    void beforeArming() {
+                        if (pauseBeforeArming.getAndSet(false)) {
+                            aboutToBlock.countDown();
+                            try {
+                                suspendRequested.await();
+                            } catch (InterruptedException e) {
+                                Thread.currentThread().interrupt();
+                            }
+                        }
+                    }
+                };
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+        };
+        SingleThreadIoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        try {
+            // Start the thread; the task makes the next IO run pause right before it arms itself for blocking.
+            loop.submit(() -> pauseBeforeArming.set(true)).sync();
+            Thread thread = threadFactory.threads.take();
+            assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+
+            // The wakeup triggered by trySuspend() is dropped by the handler, as it is not blocked yet.
+            assertTrue(loop.trySuspend());
+            assertTrue(loop.isSuspended());
+            suspendRequested.countDown();
+
+            thread.join(TimeUnit.SECONDS.toMillis(10));
+            assertFalse(thread.isAlive(), "Event loop thread should have finished after suspension");
+            assertTrue(loop.isSuspended());
+        } finally {
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS);
+        }
+    }
+
+    /**
+     * Like the epoll handler: a wakeup only has an effect while {@link #run(IoHandlerContext)} is armed for blocking.
+     */
+    private static class WakeupOnlyWhenBlockedIoHandler implements IoHandler {
+        private final AtomicBoolean armed = new AtomicBoolean();
+        private final Semaphore semaphore = new Semaphore(0);
+
+        void beforeArming() {
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            beforeArming();
+            armed.set(true);
+            try {
+                if (context.canBlock()) {
+                    semaphore.acquire();
+                }
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            } finally {
+                if (!armed.getAndSet(false)) {
+                    // Consume the permit of a wakeup that raced with us leaving.
+                    semaphore.drainPermits();
+                }
+            }
+            return 0;
+        }
+
+        @Override
+        public void wakeup() {
+            if (armed.compareAndSet(true, false)) {
+                semaphore.release();
+            }
+        }
+
+        @Override
+        public void prepareToDestroy() {
+        }
+
+        @Override
+        public void destroy() {
+        }
+
+        @Override
+        public IoRegistration register(IoHandle handle) {
+            throw new UnsupportedOperationException();
+        }
+
+        @Override
+        public boolean isCompatible(Class<? extends IoHandle> handleType) {
+            return false;
+        }
+    }
