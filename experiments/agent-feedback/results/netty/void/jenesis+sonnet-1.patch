+    @Test
+    @org.junit.jupiter.api.Timeout(30)
+    void testSuspendRequestedJustBeforeBlockingEndsThread() throws Exception {
+        final CountDownLatch aboutToBlock = new CountDownLatch(1);
+        final CountDownLatch suspendRequested = new CountDownLatch(1);
+        final Semaphore blockedWakeup = new Semaphore(0);
+        final AtomicBoolean blocked = new AtomicBoolean();
+        final AtomicBoolean first = new AtomicBoolean(true);
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        // Like epoll: wakeup() only has an effect while the handler is really blocked.
+        IoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, new IoHandlerFactory() {
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor eventLoop) {
+                return new TestIoHandler(eventLoop) {
+            @Override
+            public void wakeup() {
+                if (blocked.get()) {
+                    blockedWakeup.release();
+                }
+            }
+
+            @Override
+            public int run(IoHandlerContext context) {
+                if (first.compareAndSet(true, false)) {
+                    aboutToBlock.countDown();
+                    try {
+                        suspendRequested.await();
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                    }
+                }
+                if (context.canBlock()) {
+                    blocked.set(true);
+                    try {
+                        blockedWakeup.acquire();
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                    } finally {
+                        blocked.set(false);
+                    }
+                }
+                return 0;
+            }
+                };
+            }
+        });
+        loop.execute(() -> { });
+        Thread thread = threadFactory.threads.take();
+        assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+        assertTrue(loop.trySuspend());
+        assertTrue(loop.isSuspended());
+        suspendRequested.countDown();
+        thread.join(10000);
+        assertFalse(thread.isAlive());
+        loop.shutdownGracefully();
+    }
