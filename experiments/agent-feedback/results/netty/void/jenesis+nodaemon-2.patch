+    @Test
+    void testSuspendRequestedJustBeforeBlockingDoesNotKeepThreadAlive() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        CountDownLatch aboutToBlock = new CountDownLatch(1);
+        CountDownLatch proceed = new CountDownLatch(1);
+        AtomicBoolean armed = new AtomicBoolean(true);
+        IoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor eventLoop) {
+                return new OnlyWakeupWhileBlockedIoHandler() {
+                    @Override
+                    void beforeBlocking() throws InterruptedException {
+                        if (armed.compareAndSet(true, false)) {
+                            aboutToBlock.countDown();
+                            assertTrue(proceed.await(10, TimeUnit.SECONDS));
+                        }
+                    }
+                };
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+        });
+        try {
+            loop.execute(() -> { });
+            Thread thread = threadFactory.threads.take();
+            assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+
+            // The loop is about to block, but is not blocked yet, so the wakeup triggered by trySuspend() is lost.
+            assertTrue(loop.trySuspend());
+            assertTrue(loop.isSuspended());
+            proceed.countDown();
+
+            thread.join(TimeUnit.SECONDS.toMillis(10));
+            assertFalse(thread.isAlive(), "Thread of suspended loop should have finished");
+            assertTrue(loop.isSuspended());
+        } finally {
+            proceed.countDown();
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS).syncUninterruptibly();
+        }
+    }
+
+    /**
+     * An {@link IoHandler} that, like the epoll one, only reacts to {@link #wakeup()} while it is blocked.
+     */
+    private static class OnlyWakeupWhileBlockedIoHandler extends TestIoHandler {
+        private final Semaphore wake = new Semaphore(0);
+        private volatile boolean blocked;
+
+        OnlyWakeupWhileBlockedIoHandler() {
+            super(null);
+        }
+
+        void beforeBlocking() throws InterruptedException {
+            // NOOP
+        }
+
+        @Override
+        public void wakeup() {
+            if (blocked) {
+                wake.release();
+            }
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            if (!context.canBlock()) {
+                return 0;
+            }
+            try {
+                beforeBlocking();
+                blocked = true;
+                try {
+                    if (context.canBlock()) {
+                        wake.acquire();
+                    }
+                } finally {
+                    blocked = false;
+                    wake.drainPermits();
+                }
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            }
+            return 0;
+        }
+    }
