+    @Test
+    void testSuspendRequestedRightBeforeBlockingTerminatesThread() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        final AtomicBoolean suspendRequested = new AtomicBoolean();
+        final AtomicBoolean suspendResult = new AtomicBoolean();
+        final AtomicBoolean taskRan = new AtomicBoolean();
+        final IoEventLoop[] loopRef = new IoEventLoop[1];
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor eventLoop) {
+                return new TestIoHandler(eventLoop) {
+            private final Semaphore blocked = new Semaphore(0);
+            private volatile boolean blocking;
+
+            @Override
+            public void wakeup() {
+                // Like epoll: a wakeup only has an effect while actually blocked.
+                if (blocking) {
+                    blocked.release();
+                }
+            }
+
+            @Override
+            public int run(IoHandlerContext context) {
+                if (taskRan.get() && suspendRequested.compareAndSet(false, true)) {
+                    // Suspend request arrives (and its wakeup is lost) right before we decide to block.
+                    Thread t = new Thread(() -> suspendResult.set(loopRef[0].trySuspend()));
+                    t.start();
+                    try {
+                        t.join();
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                    }
+                }
+                if (context.canBlock()) {
+                    blocking = true;
+                    try {
+                        blocked.tryAcquire(10, TimeUnit.SECONDS);
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                    } finally {
+                        blocking = false;
+                    }
+                }
+                return 0;
+            }
+                };
+            }
+        };
+        IoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        loopRef[0] = loop;
+        loop.execute(() -> taskRan.set(true));
+        Thread thread = threadFactory.threads.take();
+        thread.join(5000);
+        assertTrue(suspendResult.get());
+        assertTrue(loop.isSuspended());
+        assertFalse(thread.isAlive());
+        loop.shutdownGracefully();
+    }
+
