+    @Test
+    void testSuspendWhileAboutToBlockWithHandlerIgnoringEarlyWakeup() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        final AtomicBoolean suspendBeforeBlock = new AtomicBoolean();
+        final AtomicBoolean suspendResult = new AtomicBoolean();
+        IoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, new IoHandlerFactory() {
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor eventLoop) {
+                return newEarlyWakeupIgnoringHandler(eventLoop, suspendBeforeBlock, suspendResult);
+            }
+        });
+        loop.submit(() -> suspendBeforeBlock.set(true)).sync();
+        Thread thread = threadFactory.threads.take();
+        thread.join(5000);
+        assertTrue(suspendResult.get());
+        assertTrue(loop.isSuspended());
+        assertFalse(thread.isAlive());
+        loop.shutdownGracefully();
+    }
+
+    private static IoHandler newEarlyWakeupIgnoringHandler(ThreadAwareExecutor eventLoop,
+            AtomicBoolean suspendBeforeBlock, AtomicBoolean suspendResult) {
+        return new IoHandler() {
+            private final Object lock = new Object();
+            private boolean blocked;
+            private boolean woken;
+
+            @Override
+            public int run(IoHandlerContext context) {
+                if (suspendBeforeBlock.compareAndSet(true, false)) {
+                    Thread t = new Thread(() -> suspendResult.set(eventLoop instanceof IoEventLoop &&
+                            ((IoEventLoop) eventLoop).trySuspend()));
+                    t.start();
+                    try {
+                        t.join();
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                    }
+                }
+                if (!context.canBlock()) {
+                    return 0;
+                }
+                synchronized (lock) {
+                    blocked = true;
+                    woken = false;
+                    try {
+                        while (!woken) {
+                            lock.wait();
+                        }
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                    } finally {
+                        blocked = false;
+                    }
+                }
+                return 0;
+            }
+
+            @Override
+            public void wakeup() {
+                // Like epoll: only a wakeup while actually blocked has an effect.
+                synchronized (lock) {
+                    if (blocked) {
+                        woken = true;
+                        lock.notifyAll();
+                    }
+                }
+            }
+
+            @Override
+            public void prepareToDestroy() {
+            }
+
+            @Override
+            public void destroy() {
+            }
+
+            @Override
+            public IoRegistration register(IoHandle handle) {
+                throw new UnsupportedOperationException();
+            }
+
+            @Override
+            public boolean isCompatible(Class<? extends IoHandle> handleType) {
+                return false;
+            }
+        };
+    }
