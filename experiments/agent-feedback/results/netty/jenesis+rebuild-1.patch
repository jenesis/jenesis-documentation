+    @Test
+    void testSuspendRequestedJustBeforeBlockingTerminatesThread() throws Exception {
+        final CountDownLatch aboutToBlock = new CountDownLatch(1);
+        final CountDownLatch proceed = new CountDownLatch(1);
+        final AtomicBoolean armed = new AtomicBoolean();
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        // An IoHandler that, like the epoll one, only reacts to a wakeup() while it is actually blocked.
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor executor) {
+                return newLostWakeupHandler(executor, armed, aboutToBlock, proceed);
+            }
+        };
+        IoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        try {
+            loop.execute(() -> armed.set(true));
+            Thread thread = threadFactory.threads.take();
+            assertTrue(aboutToBlock.await(5, TimeUnit.SECONDS));
+
+            // The wakeup() issued by trySuspend() is lost as the IoHandler is not blocked yet.
+            assertTrue(loop.trySuspend());
+            assertTrue(loop.isSuspended());
+            proceed.countDown();
+
+            thread.join(TimeUnit.SECONDS.toMillis(5));
+            assertFalse(thread.isAlive(), "Suspended event loop thread is still alive");
+            assertTrue(loop.isSuspended());
+        } finally {
+            proceed.countDown();
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS).syncUninterruptibly();
+        }
+    }
+
+    private static IoHandler newLostWakeupHandler(ThreadAwareExecutor executor, final AtomicBoolean armed,
+                                                  final CountDownLatch aboutToBlock, final CountDownLatch proceed) {
+        return new TestIoHandler(executor) {
+            private final AtomicBoolean blocked = new AtomicBoolean();
+            private final Semaphore wakeups = new Semaphore(0);
+
+            @Override
+            public void wakeup() {
+                if (blocked.get()) {
+                    wakeups.release();
+                }
+            }
+
+            @Override
+            public int run(IoHandlerContext context) {
+                if (armed.compareAndSet(true, false)) {
+                    aboutToBlock.countDown();
+                    try {
+                        proceed.await();
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                    }
+                }
+                blocked.set(true);
+                try {
+                    if (context.canBlock()) {
+                        wakeups.acquire();
+                    }
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                } finally {
+                    blocked.set(false);
+                    wakeups.drainPermits();
+                }
+                return 0;
+            }
+        };
+    }
