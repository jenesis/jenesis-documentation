+    @Test
+    void testSuspendRequestedWhileAboutToBlockFinishesThread() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        AtomicBoolean armed = new AtomicBoolean();
+        CountDownLatch aboutToBlock = new CountDownLatch(1);
+        CountDownLatch proceed = new CountDownLatch(1);
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor executor) {
+                return new WakeupOnlyWhileBlockedIoHandler(executor) {
+                    @Override
+                    public int run(IoHandlerContext context) {
+                        if (armed.compareAndSet(true, false)) {
+                            // Let the test request the suspension right before we go back to waiting for IO.
+                            aboutToBlock.countDown();
+                            try {
+                                proceed.await();
+                            } catch (InterruptedException e) {
+                                Thread.currentThread().interrupt();
+                            }
+                        }
+                        return super.run(context);
+                    }
+                };
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                // Required so the event loop supports suspension.
+                return true;
+            }
+        };
+        SingleThreadIoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        try {
+            // Start the thread; the next runIo() call after this task is the one that will be intercepted.
+            loop.submit(() -> armed.set(true)).sync();
+            Thread thread = threadFactory.threads.take();
+            assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+
+            // The wakeup issued by trySuspend() is lost as the IoHandler is not blocked yet.
+            assertTrue(loop.trySuspend());
+            assertTrue(loop.isSuspended());
+            proceed.countDown();
+
+            thread.join(TimeUnit.SECONDS.toMillis(10));
+            assertFalse(thread.isAlive(), "Suspended event loop thread is still alive");
+            assertTrue(loop.isSuspended());
+        } finally {
+            proceed.countDown();
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS).sync();
+        }
+    }
+
+    /**
+     * Mimics the behaviour of the epoll transport: a wakeup is only seen if the handler is actually blocked.
+     */
+    private static class WakeupOnlyWhileBlockedIoHandler extends TestIoHandler {
+        private final Semaphore semaphore = new Semaphore(0);
+        private volatile boolean blocking;
+
+        WakeupOnlyWhileBlockedIoHandler(ThreadAwareExecutor executor) {
+            super(executor);
+        }
+
+        @Override
+        public void wakeup() {
+            if (blocking) {
+                semaphore.release();
+            }
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            blocking = true;
+            try {
+                if (context.canBlock()) {
+                    semaphore.acquire();
+                }
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            } finally {
+                blocking = false;
+            }
+            return 0;
+        }
+    }
