+    @Test
+    void testSuspendRequestedJustBeforeBlockingTerminatesThread() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        AtomicBoolean suspendBeforeBlocking = new AtomicBoolean();
+        AtomicBoolean suspendResult = new AtomicBoolean();
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor executor) {
+                return new WakeupOnlyWhenBlockedIoHandler(executor) {
+                    @Override
+                    void beforeBlocking() {
+                        if (suspendBeforeBlocking.getAndSet(false)) {
+                            // Request the suspend from another thread while this loop is awake and about to block.
+                            Thread t = new Thread(() -> suspendResult.set(((IoEventLoop) executor).trySuspend()));
+                            t.start();
+                            try {
+                                t.join();
+                            } catch (InterruptedException e) {
+                                Thread.currentThread().interrupt();
+                            }
+                        }
+                    }
+                };
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+        };
+        IoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        try {
+            loop.submit(() -> suspendBeforeBlocking.set(true)).sync();
+            Thread thread = threadFactory.threads.take();
+
+            thread.join(TimeUnit.SECONDS.toMillis(10));
+            assertTrue(suspendResult.get());
+            assertTrue(loop.isSuspended());
+            assertFalse(thread.isAlive(), "suspended event loop thread is still alive");
+        } finally {
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS).sync();
+        }
+    }
+
+    /**
+     * Behaves like the epoll {@link IoHandler}: a {@link #wakeup()} only has an effect while the handler is blocked
+     * (or about to block after having checked {@link IoHandlerContext#canBlock()}).
+     */
+    private static class WakeupOnlyWhenBlockedIoHandler extends TestIoHandler {
+        private final Semaphore wakeupSemaphore = new Semaphore(0);
+        private final AtomicBoolean awake = new AtomicBoolean(true);
+
+        WakeupOnlyWhenBlockedIoHandler(ThreadAwareExecutor executor) {
+            super(executor);
+        }
+
+        void beforeBlocking() {
+            // NOOP
+        }
+
+        @Override
+        public void wakeup() {
+            if (awake.compareAndSet(false, true)) {
+                wakeupSemaphore.release();
+            }
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            beforeBlocking();
+            awake.set(false);
+            try {
+                if (context.canBlock()) {
+                    wakeupSemaphore.acquire();
+                }
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            } finally {
+                awake.set(true);
+            }
+            return 0;
+        }
+    }
