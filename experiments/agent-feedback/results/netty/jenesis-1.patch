+    @Test
+    void testSuspendRequestedWhileAboutToBlock() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        CountDownLatch aboutToBlock = new CountDownLatch(1);
+        CountDownLatch proceed = new CountDownLatch(1);
+        AtomicBoolean gate = new AtomicBoolean(true);
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor executor) {
+                return new OnlyWakeupWhileBlockedIoHandler() {
+                    @Override
+                    void beforeBlocking() {
+                        if (gate.compareAndSet(true, false)) {
+                            aboutToBlock.countDown();
+                            try {
+                                proceed.await();
+                            } catch (InterruptedException e) {
+                                Thread.currentThread().interrupt();
+                            }
+                        }
+                    }
+                };
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+        };
+        SingleThreadIoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        try {
+            // Start the thread and let it go back to waiting for IO.
+            loop.execute(() -> { });
+            Thread thread = threadFactory.threads.take();
+            assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+
+            // The loop is not blocked yet, so the wakeup issued by trySuspend() is lost for this handler.
+            assertTrue(loop.trySuspend());
+            proceed.countDown();
+
+            thread.join(TimeUnit.SECONDS.toMillis(10));
+            assertFalse(thread.isAlive(), "Suspended event loop thread is still alive");
+            assertTrue(loop.isSuspended());
+        } finally {
+            proceed.countDown();
+            loop.shutdownGracefully(0, 15, TimeUnit.SECONDS).sync();
+        }
+    }
+
+    /**
+     * Behaves like the epoll {@link IoHandler}: a wakeup only has an effect while the handler is actually blocked.
+     */
+    private abstract static class OnlyWakeupWhileBlockedIoHandler extends TestIoHandler {
+        private final Semaphore semaphore = new Semaphore(0);
+        private final AtomicBoolean blocked = new AtomicBoolean();
+
+        OnlyWakeupWhileBlockedIoHandler() {
+            super(null);
+        }
+
+        abstract void beforeBlocking();
+
+        @Override
+        public void wakeup() {
+            if (blocked.compareAndSet(true, false)) {
+                semaphore.release();
+            }
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            if (!context.canBlock()) {
+                return 0;
+            }
+            beforeBlocking();
+            blocked.set(true);
+            try {
+                if (context.canBlock()) {
+                    semaphore.acquire();
+                }
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            } finally {
+                if (!blocked.getAndSet(false)) {
+                    // A wakeup released a permit; consume it if we did not block on it.
+                    semaphore.tryAcquire();
+                }
+            }
+            return 0;
+        }
+    }
