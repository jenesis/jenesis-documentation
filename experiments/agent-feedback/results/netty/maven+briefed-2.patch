+    @Test
+    void testSuspendRequestedJustBeforeBlockingTerminatesThread() throws Exception {
+        final AtomicBoolean hookEnabled = new AtomicBoolean();
+        final CountDownLatch aboutToBlock = new CountDownLatch(1);
+        final CountDownLatch proceed = new CountDownLatch(1);
+        TestThreadFactory threadFactory = new TestThreadFactory();
+
+        // Mimics EpollIoHandler: wakeup() only has an effect while the handler is armed (about to block / blocked),
+        // and canBlock() is checked again after arming.
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor executor) {
+                return new TestIoHandler(executor) {
+                    private final Semaphore wakeups = new Semaphore(0);
+                    private final AtomicBoolean armed = new AtomicBoolean();
+
+                    @Override
+                    public void wakeup() {
+                        if (armed.getAndSet(false)) {
+                            wakeups.release();
+                        }
+                    }
+
+                    @Override
+                    public int run(IoHandlerContext context) {
+                        if (!context.canBlock()) {
+                            return 0;
+                        }
+                        if (hookEnabled.compareAndSet(true, false)) {
+                            aboutToBlock.countDown();
+                            try {
+                                proceed.await();
+                            } catch (InterruptedException e) {
+                                Thread.currentThread().interrupt();
+                            }
+                        }
+                        armed.set(true);
+                        try {
+                            if (context.canBlock()) {
+                                wakeups.acquireUninterruptibly();
+                            }
+                        } finally {
+                            armed.set(false);
+                        }
+                        return 0;
+                    }
+                };
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+        };
+        SingleThreadIoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        try {
+            loop.execute(() -> hookEnabled.set(true));
+            Thread thread = threadFactory.threads.take();
+            assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+
+            // The wakeup() done by trySuspend() is lost as the handler is not armed yet.
+            assertTrue(loop.trySuspend());
+            assertTrue(loop.isSuspended());
+            proceed.countDown();
+
+            thread.join(TimeUnit.SECONDS.toMillis(10));
+            assertFalse(thread.isAlive(), "Thread of suspended loop should have terminated");
+            assertTrue(loop.isSuspended());
+        } finally {
+            proceed.countDown();
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS).syncUninterruptibly();
+        }
+    }
+
     private static class TestIoHandler implements IoHandler {
         private final Semaphore semaphore = new Semaphore(0);
         private final ThreadAwareExecutor executor;
