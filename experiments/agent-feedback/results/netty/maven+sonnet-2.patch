+    @Test
+    void testSuspendRequestedJustBeforeBlockingIsNotLost() throws Exception {
+        CountDownLatch aboutToBlock = new CountDownLatch(1);
+        CountDownLatch suspendRequested = new CountDownLatch(1);
+        AtomicBoolean blocked = new AtomicBoolean();
+        AtomicBoolean firstRun = new AtomicBoolean(false);
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor executor) {
+                return new TestIoHandler(executor) {
+                    private final Semaphore sem = new Semaphore(0);
+
+                    @Override
+                    public void wakeup() {
+                        // Like epoll: only effective while actually blocked.
+                        if (blocked.get()) {
+                            sem.release();
+                        }
+                    }
+
+                    @Override
+                    public int run(IoHandlerContext context) {
+                        try {
+                            if (firstRun.compareAndSet(true, false)) {
+                                aboutToBlock.countDown();
+                                suspendRequested.await();
+                            }
+                            blocked.set(true);
+                            if (context.canBlock()) {
+                                sem.acquire();
+                            }
+                        } catch (InterruptedException e) {
+                            Thread.currentThread().interrupt();
+                        } finally {
+                            blocked.set(false);
+                        }
+                        return 0;
+                    }
+                };
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+        };
+        IoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        loop.submit(() -> { }).sync();
+        Thread thread = threadFactory.threads.take();
+        // The loop thread is now running; arm the handler so the next run() simulates the race.
+        firstRun.set(true);
+        loop.execute(() -> { });
+        aboutToBlock.await();
+        assertTrue(loop.trySuspend());
+        assertTrue(loop.isSuspended());
+        suspendRequested.countDown();
+        thread.join(5000);
+        assertFalse(thread.isAlive());
+        loop.shutdownGracefully();
+    }
+
     private static class TestIoHandler implements IoHandler {
         private final Semaphore semaphore = new Semaphore(0);
         private final ThreadAwareExecutor executor;
