+    @Test
+    void testSuspendWhileAboutToBlockTerminatesThread() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        CountDownLatch aboutToBlock = new CountDownLatch(1);
+        CountDownLatch proceed = new CountDownLatch(1);
+        AtomicBoolean armed = new AtomicBoolean();
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor ioExecutor) {
+                return new WakeupOnlyWhileBlockedIoHandler(armed, aboutToBlock, proceed);
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+        };
+        SingleThreadIoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        try {
+            // Start the thread and arm the handler, so the next run() pauses before it starts to block.
+            loop.submit(() -> armed.set(true)).sync();
+            Thread thread = threadFactory.threads.take();
+            assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+
+            // The wakeup() issued by trySuspend() is ignored as the handler is not blocked yet.
+            assertTrue(loop.trySuspend());
+            assertTrue(loop.isSuspended());
+            proceed.countDown();
+
+            thread.join(TimeUnit.SECONDS.toMillis(10));
+            assertFalse(thread.isAlive(), "suspended event loop thread is still alive");
+            assertTrue(loop.isSuspended());
+        } finally {
+            loop.shutdownGracefully(0, 5, TimeUnit.SECONDS).sync();
+        }
+    }
+
+    /**
+     * An {@link IoHandler} that, like the epoll one, only reacts to {@link #wakeup()} while it is blocked.
+     */
+    private static final class WakeupOnlyWhileBlockedIoHandler implements IoHandler {
+        private final Semaphore semaphore = new Semaphore(0);
+        private final AtomicBoolean blocking = new AtomicBoolean();
+        private final AtomicBoolean armed;
+        private final CountDownLatch aboutToBlock;
+        private final CountDownLatch proceed;
+
+        WakeupOnlyWhileBlockedIoHandler(AtomicBoolean armed, CountDownLatch aboutToBlock, CountDownLatch proceed) {
+            this.armed = armed;
+            this.aboutToBlock = aboutToBlock;
+            this.proceed = proceed;
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            if (armed.compareAndSet(true, false)) {
+                aboutToBlock.countDown();
+                try {
+                    proceed.await();
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                }
+            }
+            blocking.set(true);
+            try {
+                if (context.canBlock()) {
+                    semaphore.acquire();
+                }
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            } finally {
+                blocking.set(false);
+            }
+            return 0;
+        }
+
+        @Override
+        public void wakeup() {
+            if (blocking.getAndSet(false)) {
+                semaphore.release();
+            }
+        }
+
+        @Override
+        public void prepareToDestroy() {
+            // NOOP
+        }
+
+        @Override
+        public void destroy() {
+            // NOOP
+        }
+
+        @Override
+        public IoRegistration register(IoHandle handle) {
+            throw new UnsupportedOperationException();
+        }
+
+        @Override
+        public boolean isCompatible(Class<? extends IoHandle> handleType) {
+            return false;
+        }
+    }
