+    @Test
+    void testSuspendRequestedJustBeforeBlocking() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        AtomicBoolean suspendOnNextRun = new AtomicBoolean();
+        IoEventLoop[] loopRef = new IoEventLoop[1];
+        IoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, new IoHandlerFactory() {
+          @Override
+          public boolean isChangingThreadSupported() {
+            return true;
+          }
+
+          @Override
+          public IoHandler newHandler(ThreadAwareExecutor executor) {
+            return new TestIoHandler(executor) {
+            private final Semaphore sem = new Semaphore(0);
+            private volatile boolean blocking;
+
+            @Override
+            public void wakeup() {
+                // Like epoll: only react to a wakeup while actually blocked.
+                if (blocking) {
+                    sem.release();
+                }
+            }
+
+            @Override
+            public int run(IoHandlerContext context) {
+                if (suspendOnNextRun.compareAndSet(true, false)) {
+                    Thread t = new Thread(() -> assertTrue(loopRef[0].trySuspend()));
+                    t.start();
+                    try {
+                        t.join();
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                    }
+                }
+                if (context.canBlock()) {
+                    blocking = true;
+                    try {
+                        sem.acquire();
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                    } finally {
+                        blocking = false;
+                    }
+                }
+                return 0;
+            }
+            };
+          }
+        });
+        loopRef[0] = loop;
+        loop.submit(() -> suspendOnNextRun.set(true)).sync();
+        Thread thread = threadFactory.threads.take();
+        thread.join(5000);
+        assertTrue(loop.isSuspended());
+        boolean alive = thread.isAlive();
+        loop.shutdownGracefully(0, 0, TimeUnit.SECONDS);
+        assertFalse(alive, "Suspended loop thread still alive");
+    }
