+    @Test
+    void testSuspendRequestedWhileNotBlockedTerminatesThread() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        AtomicReference<WakeupOnlyWhileBlockedIoHandler> handlerRef = new AtomicReference<>();
+        IoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor ioExecutor) {
+                WakeupOnlyWhileBlockedIoHandler handler = new WakeupOnlyWhileBlockedIoHandler();
+                handlerRef.set(handler);
+                return handler;
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+        });
+        WakeupOnlyWhileBlockedIoHandler handler = handlerRef.get();
+        try {
+            // Run a task so the thread starts, and make the next run(...) pause before it prepares to block.
+            loop.execute(() -> handler.pauseNext = true);
+            Thread thread = threadFactory.threads.take();
+            assertTrue(handler.paused.await(10, TimeUnit.SECONDS));
+
+            // The loop is not blocked, so the wakeup() issued by trySuspend() has no effect on the handler.
+            assertTrue(loop.trySuspend());
+            assertTrue(loop.isSuspended());
+            handler.resume.countDown();
+
+            thread.join(TimeUnit.SECONDS.toMillis(5));
+            assertFalse(thread.isAlive(), "Suspended event loop thread is still alive");
+            assertTrue(loop.isSuspended());
+        } finally {
+            handler.resume.countDown();
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS).syncUninterruptibly();
+        }
+    }
+
+    /**
+     * Mimics the epoll IoHandler: wakeup() only has an effect while run(...) is (about to be) blocked.
+     */
+    private static final class WakeupOnlyWhileBlockedIoHandler extends TestIoHandler {
+        private final Object lock = new Object();
+        private boolean awake = true;
+        volatile boolean pauseNext;
+        final CountDownLatch paused = new CountDownLatch(1);
+        final CountDownLatch resume = new CountDownLatch(1);
+
+        WakeupOnlyWhileBlockedIoHandler() {
+            super(null);
+        }
+
+        @Override
+        public void wakeup() {
+            synchronized (lock) {
+                if (!awake) {
+                    awake = true;
+                    lock.notifyAll();
+                }
+            }
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            if (pauseNext) {
+                pauseNext = false;
+                paused.countDown();
+                try {
+                    resume.await();
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                }
+            }
+            synchronized (lock) {
+                awake = false;
+                try {
+                    if (context.canBlock()) {
+                        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(30);
+                        long remaining;
+                        while (!awake && (remaining = deadline - System.nanoTime()) > 0) {
+                            TimeUnit.NANOSECONDS.timedWait(lock, remaining);
+                        }
+                    }
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                } finally {
+                    awake = true;
+                }
+            }
+            return 0;
+        }
+    }
