+    @Test
+    void testSuspendRequestedWhileAboutToBlockStopsThread() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        AtomicBoolean taskRan = new AtomicBoolean();
+        AtomicBoolean hooked = new AtomicBoolean();
+        CountDownLatch aboutToBlock = new CountDownLatch(1);
+        CountDownLatch proceed = new CountDownLatch(1);
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public boolean isChangingThreadSupported() {
+                // Needed so the loop supports suspension.
+                return true;
+            }
+
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor executor) {
+                return new TestIoHandler(executor) {
+                    private final Semaphore wakeups = new Semaphore(0);
+                    private volatile boolean blocked;
+
+                    @Override
+                    public void wakeup() {
+                        // Like the epoll transport: a wakeup only has an effect while we are blocked.
+                        if (blocked) {
+                            wakeups.release();
+                        }
+                    }
+
+                    @Override
+                    public int run(IoHandlerContext context) {
+                        if (taskRan.get() && hooked.compareAndSet(false, true)) {
+                            aboutToBlock.countDown();
+                            try {
+                                proceed.await();
+                            } catch (InterruptedException e) {
+                                Thread.currentThread().interrupt();
+                            }
+                        }
+                        if (!context.canBlock()) {
+                            return 0;
+                        }
+                        blocked = true;
+                        try {
+                            wakeups.acquire();
+                        } catch (InterruptedException e) {
+                            Thread.currentThread().interrupt();
+                        } finally {
+                            blocked = false;
+                        }
+                        return 0;
+                    }
+                };
+            }
+        };
+        SingleThreadIoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        try {
+            loop.execute(() -> taskRan.set(true));
+            Thread thread = threadFactory.threads.take();
+            assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+
+            // The loop is about to go back to waiting for IO, so the wakeup done by trySuspend() is missed.
+            assertTrue(loop.trySuspend());
+            assertTrue(loop.isSuspended());
+            proceed.countDown();
+
+            thread.join(TimeUnit.SECONDS.toMillis(10));
+            assertFalse(thread.isAlive());
+            assertTrue(loop.isSuspended());
+        } finally {
+            proceed.countDown();
+            loop.shutdownGracefully(0, 5, TimeUnit.SECONDS);
+        }
+    }
