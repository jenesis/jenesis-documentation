+    @Test
+    void testSuspendRequestedBeforeIoHandlerBlocksTerminatesThread() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        AtomicBoolean suspendBeforeBlocking = new AtomicBoolean();
+        AtomicReference<IoEventLoop> loopRef = new AtomicReference<>();
+        AtomicBoolean suspendResult = new AtomicBoolean();
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor ioExecutor) {
+                // Like the epoll IoHandler: a wakeup() is only seen while we are actually blocked.
+                return new TestIoHandler(ioExecutor) {
+                    private final Semaphore semaphore = new Semaphore(0);
+                    private volatile boolean blocked;
+
+                    @Override
+                    public void wakeup() {
+                        if (blocked) {
+                            semaphore.release();
+                        }
+                    }
+
+                    @Override
+                    public int run(IoHandlerContext context) {
+                        if (suspendBeforeBlocking.compareAndSet(true, false)) {
+                            // Suspension is requested after the loop checked canSuspend() but before we are armed for
+                            // wakeups, so the wakeup() it triggers is lost.
+                            Thread t = new Thread(() -> suspendResult.set(loopRef.get().trySuspend()));
+                            t.start();
+                            try {
+                                t.join();
+                            } catch (InterruptedException e) {
+                                Thread.currentThread().interrupt();
+                            }
+                        }
+                        // Arm for wakeups and only then check if we can block, like the epoll IoHandler does.
+                        blocked = true;
+                        try {
+                            if (context.canBlock()) {
+                                semaphore.acquire();
+                            }
+                        } catch (InterruptedException e) {
+                            Thread.currentThread().interrupt();
+                        } finally {
+                            blocked = false;
+                            semaphore.drainPermits();
+                        }
+                        return 0;
+                    }
+                };
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+        };
+        IoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        loopRef.set(loop);
+        try {
+            CountDownLatch latch = new CountDownLatch(1);
+            loop.execute(() -> {
+                suspendBeforeBlocking.set(true);
+                latch.countDown();
+            });
+            latch.await();
+            Thread thread = threadFactory.threads.take();
+
+            thread.join(TimeUnit.SECONDS.toMillis(5));
+            assertTrue(suspendResult.get());
+            assertTrue(loop.isSuspended());
+            assertFalse(thread.isAlive(), "Event loop thread should have terminated after suspension");
+        } finally {
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS).sync();
+        }
+    }
