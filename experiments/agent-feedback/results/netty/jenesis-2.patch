+    @Test
+    void testSuspendRequestedJustBeforeBlockingStopsThread() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        AtomicBoolean pauseBeforeBlock = new AtomicBoolean();
+        CountDownLatch aboutToBlock = new CountDownLatch(1);
+        CountDownLatch proceed = new CountDownLatch(1);
+        SingleThreadIoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor ioExecutor) {
+                return new WakeupOnlyWhileBlockedIoHandler(pauseBeforeBlock, aboutToBlock, proceed);
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+        });
+        // Start the thread and arrange for the next runIo() to pause right before it decides to block.
+        loop.execute(() -> pauseBeforeBlock.set(true));
+        Thread thread = threadFactory.threads.take();
+        assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+
+        // The wakeup issued by trySuspend() is lost, as the IoHandler is not blocked yet.
+        assertTrue(loop.trySuspend());
+        assertTrue(loop.isSuspended());
+        proceed.countDown();
+
+        thread.join(TimeUnit.SECONDS.toMillis(10));
+        try {
+            assertFalse(thread.isAlive(), "Suspended event loop thread is still alive");
+            assertTrue(loop.isSuspended());
+        } finally {
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS);
+        }
+    }
+
+    /**
+     * An {@link IoHandler} that, like the epoll one, only reacts to {@link #wakeup()} while it is actually blocked.
+     */
+    private static final class WakeupOnlyWhileBlockedIoHandler extends TestIoHandler {
+        private final AtomicBoolean pauseBeforeBlock;
+        private final CountDownLatch aboutToBlock;
+        private final CountDownLatch proceed;
+        private boolean blocked;
+        private boolean woken;
+
+        WakeupOnlyWhileBlockedIoHandler(AtomicBoolean pauseBeforeBlock, CountDownLatch aboutToBlock,
+                                        CountDownLatch proceed) {
+            super(null);
+            this.pauseBeforeBlock = pauseBeforeBlock;
+            this.aboutToBlock = aboutToBlock;
+            this.proceed = proceed;
+        }
+
+        @Override
+        public synchronized void wakeup() {
+            if (blocked) {
+                woken = true;
+                notifyAll();
+            }
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            if (pauseBeforeBlock.compareAndSet(true, false)) {
+                aboutToBlock.countDown();
+                try {
+                    proceed.await();
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                    return 0;
+                }
+            }
+            if (!context.canBlock()) {
+                return 0;
+            }
+            synchronized (this) {
+                blocked = true;
+                try {
+                    while (!woken) {
+                        wait();
+                    }
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                } finally {
+                    blocked = false;
+                    woken = false;
+                }
+            }
+            return 0;
+        }
+    }
