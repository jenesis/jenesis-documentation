+    @Test
+    void testSuspendWhileAboutToBlockDoesNotKeepThreadAlive() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        AtomicBoolean armed = new AtomicBoolean();
+        AtomicBoolean suspendResult = new AtomicBoolean();
+        AtomicReference<SingleThreadIoEventLoop> loopRef = new AtomicReference<>();
+        SingleThreadIoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, new IoHandlerFactory() {
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor eventLoop) {
+                return new IoHandler() {
+                    // Like the epoll IoHandler: a wakeup is only seen while the handler is actually blocked.
+                    private final AtomicBoolean blocking = new AtomicBoolean();
+                    private final Semaphore semaphore = new Semaphore(0);
+
+                    @Override
+                    public void prepareToDestroy() {
+                    }
+
+                    @Override
+                    public void destroy() {
+                    }
+
+                    @Override
+                    public IoRegistration register(IoHandle handle) {
+                        throw new UnsupportedOperationException();
+                    }
+
+                    @Override
+                    public void wakeup() {
+                        if (blocking.compareAndSet(true, false)) {
+                            semaphore.release();
+                        }
+                    }
+
+                    @Override
+                    public int run(IoHandlerContext context) {
+                        if (armed.compareAndSet(true, false)) {
+                            // Request the suspension right before we start to block, so its wakeup is missed.
+                            Thread t = new Thread(() -> suspendResult.set(loopRef.get().trySuspend()));
+                            t.start();
+                            try {
+                                t.join();
+                            } catch (InterruptedException e) {
+                                Thread.currentThread().interrupt();
+                                return 0;
+                            }
+                        }
+                        blocking.set(true);
+                        try {
+                            if (context.canBlock()) {
+                                semaphore.acquire();
+                            }
+                        } catch (InterruptedException e) {
+                            Thread.currentThread().interrupt();
+                        } finally {
+                            blocking.set(false);
+                        }
+                        return 0;
+                    }
+
+                    @Override
+                    public boolean isCompatible(Class<? extends IoHandle> handleType) {
+                        return false;
+                    }
+                };
+            }
+        });
+        loopRef.set(loop);
+        CountDownLatch taskRun = new CountDownLatch(1);
+        loop.execute(() -> {
+            armed.set(true);
+            taskRun.countDown();
+        });
+        assertTrue(taskRun.await(10, TimeUnit.SECONDS));
+        Thread loopThread = threadFactory.threads.take();
+
+        loopThread.join(TimeUnit.SECONDS.toMillis(10));
+        assertTrue(suspendResult.get());
+        assertTrue(loop.isSuspended());
+        assertFalse(loopThread.isAlive(), "Thread of the suspended loop is still alive");
+        loop.shutdownGracefully(0, 0, TimeUnit.SECONDS).sync();
+    }
