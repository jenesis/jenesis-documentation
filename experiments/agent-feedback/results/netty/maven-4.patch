+    @Test
+    void testSuspendWhileAboutToBlockStopsThread() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        CountDownLatch aboutToBlock = new CountDownLatch(1);
+        CountDownLatch proceed = new CountDownLatch(1);
+        IoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory,
+                new IoHandlerFactory() {
+                    @Override
+                    public IoHandler newHandler(ThreadAwareExecutor ioExecutor) {
+                        return new OnlyWakeupWhenBlockedIoHandler(aboutToBlock, proceed);
+                    }
+
+                    @Override
+                    public boolean isChangingThreadSupported() {
+                        // Required for suspension support.
+                        return true;
+                    }
+                });
+        try {
+            loop.execute(() -> { });
+            Thread loopThread = threadFactory.threads.take();
+            assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+
+            // The loop decided it can block but did not publish that it is blocked yet, so the wakeup is ignored.
+            assertTrue(loop.trySuspend());
+            assertTrue(loop.isSuspended());
+            proceed.countDown();
+
+            loopThread.join(TimeUnit.SECONDS.toMillis(10));
+            assertFalse(loopThread.isAlive(), "thread of suspended loop still alive");
+            assertTrue(loop.isSuspended());
+        } finally {
+            proceed.countDown();
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS).sync();
+        }
+    }
+
+    /**
+     * Mimics the epoll IoHandler: a wakeup is only acted upon if the handler is blocked, and the handler re-checks
+     * {@link IoHandlerContext#canBlock()} after it published that it is about to block.
+     */
+    private static final class OnlyWakeupWhenBlockedIoHandler extends TestIoHandler {
+        private final Semaphore blocker = new Semaphore(0);
+        private final AtomicBoolean blocked = new AtomicBoolean();
+        private final CountDownLatch aboutToBlock;
+        private final CountDownLatch proceed;
+
+        OnlyWakeupWhenBlockedIoHandler(CountDownLatch aboutToBlock, CountDownLatch proceed) {
+            super(null);
+            this.aboutToBlock = aboutToBlock;
+            this.proceed = proceed;
+        }
+
+        @Override
+        public void wakeup() {
+            if (blocked.getAndSet(false)) {
+                blocker.release();
+            }
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            if (!context.canBlock()) {
+                return 0;
+            }
+            if (aboutToBlock.getCount() > 0) {
+                aboutToBlock.countDown();
+                try {
+                    proceed.await();
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                    return 0;
+                }
+            }
+            blocked.set(true);
+            try {
+                if (context.canBlock()) {
+                    blocker.acquire();
+                }
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            } finally {
+                blocked.set(false);
+            }
+            return 0;
+        }
+    }
