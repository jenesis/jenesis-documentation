+    /**
+     * An {@link IoHandler} that, like the epoll one, only reacts to a wake-up while it is actually blocked. It can be
+     * paused just before it goes to block so a suspension request can be sent at exactly that moment.
+     */
+    private static final class BlockingOnlyWakeupIoHandler extends TestIoHandler {
+        private final Semaphore blocker = new Semaphore(0);
+        private final AtomicBoolean blocking = new AtomicBoolean();
+        final CountDownLatch aboutToBlock = new CountDownLatch(1);
+        final CountDownLatch proceed = new CountDownLatch(1);
+        volatile boolean pauseBeforeBlocking;
+
+        BlockingOnlyWakeupIoHandler(ThreadAwareExecutor executor) {
+            super(executor);
+        }
+
+        @Override
+        public void wakeup() {
+            if (blocking.getAndSet(false)) {
+                blocker.release();
+            }
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            if (pauseBeforeBlocking) {
+                pauseBeforeBlocking = false;
+                aboutToBlock.countDown();
+                try {
+                    proceed.await();
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                    return 0;
+                }
+            }
+            blocking.set(true);
+            try {
+                if (context.canBlock()) {
+                    blocker.acquire();
+                }
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            } finally {
+                blocking.set(false);
+            }
+            return 0;
+        }
+    }
+
+    @Test
+    void testSuspendRequestedJustBeforeBlockingTerminatesThread() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        AtomicReference<BlockingOnlyWakeupIoHandler> handlerRef = new AtomicReference<>();
+        IoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor executor) {
+                BlockingOnlyWakeupIoHandler handler = new BlockingOnlyWakeupIoHandler(executor);
+                handlerRef.set(handler);
+                return handler;
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                // Required for the loop to support suspension.
+                return true;
+            }
+        });
+        try {
+            BlockingOnlyWakeupIoHandler handler = handlerRef.get();
+            loop.submit(() -> handler.pauseBeforeBlocking = true).sync();
+            Thread thread = threadFactory.threads.take();
+
+            // The loop is now just about to go back to waiting for I/O.
+            assertTrue(handler.aboutToBlock.await(10, TimeUnit.SECONDS));
+            assertTrue(loop.trySuspend());
+            assertTrue(loop.isSuspended());
+            handler.proceed.countDown();
+
+            thread.join(TimeUnit.SECONDS.toMillis(10));
+            assertFalse(thread.isAlive(), "suspended event loop thread is still alive");
+            assertTrue(loop.isSuspended());
+        } finally {
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS).syncUninterruptibly();
+        }
+    }
