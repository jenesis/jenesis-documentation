+    @Test
+    void testSuspendWhileAboutToBlockWithHandlerIgnoringWakeupWhenNotBlocked() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        AtomicBoolean pauseBeforeBlocking = new AtomicBoolean();
+        CountDownLatch aboutToBlock = new CountDownLatch(1);
+        CountDownLatch suspendRequested = new CountDownLatch(1);
+        SingleThreadIoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, new IoHandlerFactory() {
+            @Override
+            public boolean isChangingThreadSupported() {
+                // Required for suspension support.
+                return true;
+            }
+
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor executor) {
+                return new TestIoHandler(executor) {
+                    // Like the epoll IoHandler: a wakeup only has an effect while the handler is blocked.
+                    private final AtomicBoolean awake = new AtomicBoolean(true);
+                    private final Semaphore wakeups = new Semaphore(0);
+
+                    @Override
+                    public void wakeup() {
+                        if (!executor.isExecutorThread(Thread.currentThread()) && awake.compareAndSet(false, true)) {
+                            wakeups.release();
+                        }
+                    }
+
+                    @Override
+                    public int run(IoHandlerContext context) {
+                        if (pauseBeforeBlocking.getAndSet(false)) {
+                            aboutToBlock.countDown();
+                            try {
+                                suspendRequested.await();
+                            } catch (InterruptedException e) {
+                                Thread.currentThread().interrupt();
+                            }
+                        }
+                        awake.set(false);
+                        try {
+                            if (context.canBlock()) {
+                                wakeups.acquire();
+                            }
+                        } catch (InterruptedException e) {
+                            Thread.currentThread().interrupt();
+                        } finally {
+                            awake.set(true);
+                        }
+                        return 0;
+                    }
+                };
+            }
+        });
+        try {
+            // Start the thread; the next IO iteration after this task pauses just before it goes to block.
+            loop.submit(() -> pauseBeforeBlocking.set(true)).sync();
+            Thread thread = threadFactory.threads.take();
+            assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+
+            assertTrue(loop.trySuspend());
+            assertTrue(loop.isSuspended());
+            suspendRequested.countDown();
+
+            thread.join(TimeUnit.SECONDS.toMillis(10));
+            assertFalse(thread.isAlive(), "suspended event loop thread is still alive");
+            assertTrue(loop.isSuspended());
+        } finally {
+            suspendRequested.countDown();
+            assertTrue(loop.shutdownGracefully(0, 0, TimeUnit.SECONDS).await(10, TimeUnit.SECONDS));
+        }
+    }
