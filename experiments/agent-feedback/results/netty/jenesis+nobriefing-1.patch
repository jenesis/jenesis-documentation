+    @Test
+    void testSuspendRequestedBeforeIoHandlerBlocksStopsThread() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        CountDownLatch aboutToBlock = new CountDownLatch(1);
+        CountDownLatch suspendRequested = new CountDownLatch(1);
+        AtomicReference<WakeupOnlyWhileBlockedIoHandler> handlerRef = new AtomicReference<>();
+        SingleThreadIoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor executor) {
+                WakeupOnlyWhileBlockedIoHandler handler = new WakeupOnlyWhileBlockedIoHandler(executor);
+                handlerRef.set(handler);
+                return handler;
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                // Needed so the loop supports suspension.
+                return true;
+            }
+        });
+        try {
+            // Start the thread and arm the gate from inside the loop, so the next run() call stops just before it
+            // checks whether it can block.
+            loop.submit(() -> handlerRef.get().arm(aboutToBlock, suspendRequested)).sync();
+            Thread loopThread = threadFactory.threads.take();
+            assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+
+            // The handler is not blocked yet, so like the epoll one it drops this wake-up.
+            assertTrue(loop.trySuspend());
+            assertTrue(loop.isSuspended());
+            suspendRequested.countDown();
+
+            loopThread.join(TimeUnit.SECONDS.toMillis(10));
+            assertFalse(loopThread.isAlive(), "suspended event loop thread is still alive");
+            assertTrue(loop.isSuspended());
+        } finally {
+            suspendRequested.countDown();
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS).sync();
+        }
+    }
+
+    /**
+     * An {@link IoHandler} that, like the epoll one, only reacts to {@link #wakeup()} while it is actually blocked.
+     */
+    private static final class WakeupOnlyWhileBlockedIoHandler extends TestIoHandler {
+        private final Semaphore wakeups = new Semaphore(0);
+        private final AtomicBoolean blocking = new AtomicBoolean();
+        private volatile CountDownLatch aboutToBlock;
+        private volatile CountDownLatch proceed;
+
+        WakeupOnlyWhileBlockedIoHandler(ThreadAwareExecutor executor) {
+            super(executor);
+        }
+
+        void arm(CountDownLatch aboutToBlock, CountDownLatch proceed) {
+            this.proceed = proceed;
+            this.aboutToBlock = aboutToBlock;
+        }
+
+        @Override
+        public void wakeup() {
+            if (blocking.compareAndSet(true, false)) {
+                wakeups.release();
+            }
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            CountDownLatch gate = aboutToBlock;
+            if (gate != null) {
+                aboutToBlock = null;
+                gate.countDown();
+                try {
+                    proceed.await();
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                    return 0;
+                }
+            }
+            blocking.set(true);
+            try {
+                if (context.canBlock()) {
+                    wakeups.acquire();
+                }
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            } finally {
+                blocking.set(false);
+                wakeups.drainPermits();
+            }
+            return 0;
+        }
+    }
