+    @Test
+    void testSuspendRequestedBeforeBlockingIsNotLost() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        AtomicBoolean suspendBeforeBlocking = new AtomicBoolean();
+        AtomicBoolean suspendResult = new AtomicBoolean();
+        AtomicReference<IoEventLoop> loopRef = new AtomicReference<>();
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor eventLoop) {
+                return new WakeupOnlyWhenBlockedIoHandler(() -> {
+                    if (suspendBeforeBlocking.compareAndSet(true, false)) {
+                        // Request the suspension from another thread while the loop is about to block.
+                        Thread t = new Thread(() -> suspendResult.set(loopRef.get().trySuspend()));
+                        t.start();
+                        try {
+                            t.join();
+                        } catch (InterruptedException e) {
+                            Thread.currentThread().interrupt();
+                        }
+                    }
+                });
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+        };
+        SingleThreadIoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, factory);
+        loopRef.set(loop);
+        suspendBeforeBlocking.set(true);
+        loop.execute(() -> { });
+        Thread thread = threadFactory.threads.take();
+        try {
+            thread.join(TimeUnit.SECONDS.toMillis(5));
+            assertTrue(suspendResult.get());
+            assertTrue(loop.isSuspended());
+            assertFalse(thread.isAlive(), "suspended event loop thread is still alive");
+        } finally {
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS).syncUninterruptibly();
+        }
+    }
+
+    /**
+     * An {@link IoHandler} that, like the epoll one, only reacts to {@link #wakeup()} while it is blocked.
+     */
+    private static final class WakeupOnlyWhenBlockedIoHandler extends TestIoHandler {
+        private final Semaphore wakeups = new Semaphore(0);
+        private final AtomicBoolean blocking = new AtomicBoolean();
+        private final Runnable beforeBlocking;
+
+        WakeupOnlyWhenBlockedIoHandler(Runnable beforeBlocking) {
+            super(null);
+            this.beforeBlocking = beforeBlocking;
+        }
+
+        @Override
+        public void wakeup() {
+            if (blocking.compareAndSet(true, false)) {
+                wakeups.release();
+            }
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            if (!context.canBlock()) {
+                return 0;
+            }
+            beforeBlocking.run();
+            blocking.set(true);
+            try {
+                if (context.canBlock()) {
+                    wakeups.acquire();
+                }
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            } finally {
+                blocking.set(false);
+            }
+            return 0;
+        }
+    }
