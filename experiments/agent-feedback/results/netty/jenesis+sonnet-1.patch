+    @Test
+    void testSuspendWhileAboutToBlockDoesNotKeepThreadAlive() throws Exception {
+        // Mimics handlers like epoll: wakeup() only has an effect while the handler is really blocked.
+        CountDownLatch entered = new CountDownLatch(1);
+        CountDownLatch go = new CountDownLatch(1);
+        AtomicInteger runs = new AtomicInteger();
+        AtomicBoolean blocked = new AtomicBoolean();
+        Semaphore wakeups = new Semaphore(0);
+        IoHandlerFactory factory = new IoHandlerFactory() {
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor executor) {
+                return new TestIoHandler(executor) {
+            @Override
+            public void wakeup() {
+                if (blocked.get()) {
+                    wakeups.release();
+                }
+            }
+
+            @Override
+            public int run(IoHandlerContext context) {
+                if (runs.incrementAndGet() != 2) {
+                    return 0;
+                }
+                entered.countDown();
+                try {
+                    go.await();
+                    blocked.set(true);
+                    if (context.canBlock()) {
+                        wakeups.tryAcquire(30, TimeUnit.SECONDS);
+                    }
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                } finally {
+                    blocked.set(false);
+                }
+                return 0;
+            }
+                };
+            }
+        };
+        LinkedBlockingQueue<Thread> threads = new LinkedBlockingQueue<>();
+        SingleThreadIoEventLoop loop = new SingleThreadIoEventLoop(null, r -> {
+            Thread t = new Thread(r);
+            threads.add(t);
+            return t;
+        }, factory);
+        loop.execute(() -> { });
+        Thread thread = threads.take();
+        assertTrue(entered.await(5, TimeUnit.SECONDS));
+        assertTrue(loop.trySuspend());
+        assertTrue(loop.isSuspended());
+        go.countDown();
+        thread.join(10000);
+        assertFalse(thread.isAlive());
+        loop.shutdownGracefully();
+    }
+
     private static class TestIoHandler implements IoHandler {
         private final Semaphore semaphore = new Semaphore(0);
         private final ThreadAwareExecutor executor;
