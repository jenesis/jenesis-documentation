+    @Test
+    void testSuspendRequestedJustBeforeIoHandlerBlocks() throws Exception {
+        TestThreadFactory threadFactory = new TestThreadFactory();
+        CountDownLatch aboutToBlock = new CountDownLatch(1);
+        CountDownLatch proceed = new CountDownLatch(1);
+        SingleThreadIoEventLoop loop = new SingleThreadIoEventLoop(null, threadFactory, new IoHandlerFactory() {
+            @Override
+            public IoHandler newHandler(ThreadAwareExecutor executor) {
+                return new WakeupOnlyWhileBlockedIoHandler(executor, aboutToBlock, proceed);
+            }
+
+            @Override
+            public boolean isChangingThreadSupported() {
+                return true;
+            }
+        });
+        try {
+            // Start the thread and let it go back to waiting for IO.
+            loop.submit(() -> { }).sync();
+            Thread thread = threadFactory.threads.take();
+            assertTrue(aboutToBlock.await(10, TimeUnit.SECONDS));
+
+            // The IoHandler is not blocked yet, so the wakeup() issued by trySuspend() is lost.
+            assertTrue(loop.trySuspend());
+            proceed.countDown();
+
+            thread.join(TimeUnit.SECONDS.toMillis(10));
+            assertFalse(thread.isAlive());
+            assertTrue(loop.isSuspended());
+        } finally {
+            proceed.countDown();
+            loop.shutdownGracefully(0, 0, TimeUnit.SECONDS);
+        }
+    }
+
+    /**
+     * Like the epoll IoHandler, reacts to {@link #wakeup()} only while it is actually blocked.
+     */
+    private static final class WakeupOnlyWhileBlockedIoHandler extends TestIoHandler {
+        private final AtomicBoolean blocked = new AtomicBoolean();
+        private final Semaphore wakeups = new Semaphore(0);
+        private final CountDownLatch aboutToBlock;
+        private final CountDownLatch proceed;
+
+        WakeupOnlyWhileBlockedIoHandler(ThreadAwareExecutor executor, CountDownLatch aboutToBlock,
+                                        CountDownLatch proceed) {
+            super(executor);
+            this.aboutToBlock = aboutToBlock;
+            this.proceed = proceed;
+        }
+
+        @Override
+        public void wakeup() {
+            if (blocked.compareAndSet(true, false)) {
+                wakeups.release();
+            }
+        }
+
+        @Override
+        public int run(IoHandlerContext context) {
+            if (!context.canBlock()) {
+                return 0;
+            }
+            if (aboutToBlock.getCount() > 0) {
+                aboutToBlock.countDown();
+                try {
+                    proceed.await();
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                    return 0;
+                }
+            }
+            blocked.set(true);
+            try {
+                // Check again after announcing that we block, as the epoll IoHandler does.
+                if (context.canBlock()) {
+                    wakeups.acquire();
+                }
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            } finally {
+                blocked.set(false);
+            }
+            return 0;
+        }
+    }
