+    static InputStream failingStream(final byte[] prefix) {
+        return new InputStream() {
+
+            int pos;
+
+            @Override
+            public int read() throws IOException {
+                if (pos < prefix.length) {
+                    return prefix[pos++] & 0xff;
+                }
+                throw new EOFException("Unexpected end of stream");
+            }
+
+        };
+    }
+
+    @Test
+    void testWriteRequestChunkedEntityFailure() throws Exception {
+        final ByteArrayOutputStream outStream = new ByteArrayOutputStream();
+        Mockito.when(socket.getOutputStream()).thenReturn(outStream);
+
+        conn.bind(socket);
+
+        final ClassicHttpRequest request = new BasicClassicHttpRequest(Method.POST, "/stuff");
+        request.addHeader("Transfer-Encoding", "chunked");
+        request.setEntity(new InputStreamEntity(
+                failingStream("123".getBytes(StandardCharsets.US_ASCII)), -1, ContentType.TEXT_PLAIN));
+
+        conn.sendRequestHeader(request);
+        Assertions.assertThrows(EOFException.class, () -> conn.sendRequestEntity(request));
+
+        Assertions.assertFalse(conn.isOpen());
+        Assertions.assertFalse(conn.isConsistent());
+        final String s = new String(outStream.toByteArray(), StandardCharsets.US_ASCII);
+        Assertions.assertFalse(s.endsWith("0\r\n\r\n"), s);
+    }
+
+    @Test
+    void testWriteRequestChunkedEntityEarlyResponse() throws Exception {
+        conn = new DefaultBHttpClientConnection(Http1Config.DEFAULT,
+                null, null,
+                DefaultContentLengthStrategy.INSTANCE,
+                DefaultContentLengthStrategy.INSTANCE,
+                (request, connection, inputStream, totalBytesSent, nextWriteSize) -> true,
+                DefaultHttpRequestWriterFactory.INSTANCE,
+                DefaultHttpResponseParserFactory.INSTANCE);
+        final ByteArrayOutputStream outStream = new ByteArrayOutputStream();
+        Mockito.when(socket.getOutputStream()).thenReturn(outStream);
+        final String r = "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n";
+        Mockito.when(socket.getInputStream()).thenReturn(
+                new ByteArrayInputStream(r.getBytes(StandardCharsets.US_ASCII)));
+
+        conn.bind(socket);
+
+        final ClassicHttpRequest request = new BasicClassicHttpRequest(Method.POST, "/stuff");
+        request.addHeader("Transfer-Encoding", "chunked");
+        request.setEntity(new ByteArrayEntity(new byte[100000], ContentType.APPLICATION_OCTET_STREAM));
+
+        conn.sendRequestHeader(request);
+        conn.sendRequestEntity(request);
+
+        Assertions.assertTrue(conn.isOpen());
+        Assertions.assertFalse(conn.isConsistent());
+        final String s = new String(outStream.toByteArray(), StandardCharsets.US_ASCII);
+        Assertions.assertFalse(s.endsWith("0\r\n\r\n"), s);
+
+        final ClassicHttpResponse response = conn.receiveResponseHeader();
+        Assertions.assertEquals(400, response.getCode());
+    }
+
 }
