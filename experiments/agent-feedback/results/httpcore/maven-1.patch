+    /**
+     * Aborts an outgoing message whose content could not be written completely.
+     * The content stream is not closed (so that a chunk-coded message is never
+     * terminated with the closing chunk), data written so far is flushed on a best effort
+     * basis and the connection gets closed, as it is no longer usable.
+     */
+    void abortContentStream(final OutputStream outStream) {
+        final SocketHolder socketHolder = this.socketHolderRef.get();
+        if (socketHolder != null) {
+            try {
+                outStream.flush();
+            } catch (final IOException | RuntimeException ignore) {
+                // best effort
+            }
+        }
+        close(CloseMode.GRACEFUL);
+    }
