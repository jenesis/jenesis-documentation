+    @Test
+    void testWriteRequestEntityChunkCodedFailure() throws Exception {
+        final ByteArrayOutputStream outStream = new ByteArrayOutputStream();
+        Mockito.when(socket.getOutputStream()).thenReturn(outStream);
+
+        conn.bind(socket);
+
+        final ClassicHttpRequest request = new BasicClassicHttpRequest(Method.POST, "/stuff");
+        request.addHeader("Transfer-Encoding", "chunked");
+        request.setEntity(new AbstractHttpEntity(ContentType.TEXT_PLAIN, null, true) {
+
+            @Override
+            public InputStream getContent() {
+                throw new UnsupportedOperationException();
+            }
+
+            @Override
+            public void writeTo(final OutputStream out) throws java.io.IOException {
+                out.write(new byte[] {'1', '2', '3'});
+                out.flush();
+                throw new EOFException("Premature end");
+            }
+
+            @Override
+            public boolean isStreaming() {
+                return false;
+            }
+
+            @Override
+            public long getContentLength() {
+                return -1;
+            }
+
+            @Override
+            public void close() {
+            }
+
+        });
+
+        conn.sendRequestHeader(request);
+        Assertions.assertThrows(EOFException.class, () -> conn.sendRequestEntity(request));
+
+        final String s = new String(outStream.toByteArray(), StandardCharsets.US_ASCII);
+        Assertions.assertTrue(s.endsWith("3\r\n123\r\n"), s);
+        Assertions.assertFalse(s.endsWith("0\r\n\r\n"), s);
+        Assertions.assertFalse(conn.isOpen());
+        Assertions.assertFalse(conn.isConsistent());
+    }
