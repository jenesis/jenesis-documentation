+    /**
+     * Aborts an outgoing message whose content could not be written completely.
+     * The content stream is not closed, so the message does not get terminated
+     * (for instance with the last chunk of a chunked message). Whatever content
+     * has been written so far is flushed on a best effort basis and the connection
+     * gets closed, so the peer can tell that the message is incomplete.
+     */
+    void abortMessage(final OutputStream outStream) {
+        if (this.socketHolderRef.get() != null) {
+            try {
+                // Flushing (unlike closing) never writes the message terminator
+                outStream.flush();
+            } catch (final IOException | RuntimeException ignore) {
+                // best effort
+            }
+        }
+        close(CloseMode.GRACEFUL);
+    }
