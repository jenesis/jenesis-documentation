+    /**
+     * Resolves the action method that is going to be invoked. A method named explicitly in the mapping must exist,
+     * the implicit {@code execute()} may be missing (an unknown handler may serve it), then {@code null} is returned.
+     */
+    private Method resolveInvokedMethod(ActionInvocation invocation, Object action) throws NoSuchMethodException {
+        String methodName = invocation.getProxy().getMethod();
+        if (invocation.getProxy().isMethodSpecified()) {
+            return action.getClass().getMethod(methodName);
+        }
+        if (methodName == null || methodName.isEmpty()) {
+            methodName = ActionConfig.DEFAULT_METHOD;
+        }
+        try {
+            return action.getClass().getMethod(methodName);
+        } catch (NoSuchMethodException e) {
+            LOG.debug("Action: {} has no method: {}, skipping method level check", action, methodName);
+            return null;
+        }
+    }
+
+    /**
+     * Finds the nearest declaration of the invoked method annotated with an http method annotation, walking up
+     * the classes and checking each class before its interfaces (and their super-interfaces).
+     */
+    private Method findAnnotatedMethod(Class<?> actionClass, Method invoked) {
+        if (AnnotationUtils.isAnnotatedBy(invoked, HTTP_METHOD_ANNOTATIONS)) {
+            return invoked;
+        }
+        Set<Class<?>> visited = new HashSet<>();
+        for (Class<?> current = actionClass; current != null; current = current.getSuperclass()) {
+            Method found = findAnnotatedDeclaredMethod(current, invoked);
+            if (found != null) {
+                return found;
+            }
+            for (Class<?> iface : current.getInterfaces()) {
+                found = findAnnotatedMethodInInterface(iface, invoked, visited);
+                if (found != null) {
+                    return found;
+                }
+            }
+        }
+        return null;
+    }
+
+    private Method findAnnotatedMethodInInterface(Class<?> iface, Method invoked, Set<Class<?>> visited) {
+        if (!visited.add(iface)) {
+            return null;
+        }
+        Method found = findAnnotatedDeclaredMethod(iface, invoked);
+        if (found != null) {
+            return found;
+        }
+        for (Class<?> superIface : iface.getInterfaces()) {
+            found = findAnnotatedMethodInInterface(superIface, invoked, visited);
+            if (found != null) {
+                return found;
+            }
+        }
+        return null;
+    }
+
+    private Method findAnnotatedDeclaredMethod(Class<?> type, Method invoked) {
+        Method declared;
+        try {
+            declared = type.getDeclaredMethod(invoked.getName(), invoked.getParameterTypes());
+        } catch (NoSuchMethodException e) {
+            return null;
+        }
+        if (!canBeOverriddenBy(declared) || !AnnotationUtils.isAnnotatedBy(declared, HTTP_METHOD_ANNOTATIONS)) {
+            return null;
+        }
+        return declared;
+    }
+
+    private boolean canBeOverriddenBy(Method declared) {
+        int modifiers = declared.getModifiers();
+        return !Modifier.isStatic(modifiers)
+            && !declared.isBridge()
+            && (Modifier.isPublic(modifiers) || Modifier.isProtected(modifiers));
+    }
+
+    /**
+     * Finds the nearest type in the hierarchy of the action class annotated with an http method annotation:
+     * the class, then its interfaces and their super-interfaces, then the superclass.
+     */
+    private Class<?> findAnnotatedType(Class<?> actionClass) {
+        Set<Class<?>> visited = new HashSet<>();
+        for (Class<?> current = actionClass; current != null; current = current.getSuperclass()) {
+            if (AnnotationUtils.isAnnotatedBy(current, HTTP_METHOD_ANNOTATIONS)) {
+                return current;
+            }
+            for (Class<?> iface : current.getInterfaces()) {
+                Class<?> found = findAnnotatedInterface(iface, visited);
+                if (found != null) {
+                    return found;
+                }
+            }
+        }
+        return null;
+    }
+
+    private Class<?> findAnnotatedInterface(Class<?> iface, Set<Class<?>> visited) {
+        if (!visited.add(iface)) {
+            return null;
+        }
+        if (AnnotationUtils.isAnnotatedBy(iface, HTTP_METHOD_ANNOTATIONS)) {
+            return iface;
+        }
+        for (Class<?> superIface : iface.getInterfaces()) {
+            Class<?> found = findAnnotatedInterface(superIface, visited);
+            if (found != null) {
+                return found;
+            }
+        }
+        return null;
+    }
