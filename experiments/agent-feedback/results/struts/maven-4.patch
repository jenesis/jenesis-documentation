+    /**
+     * Resolves the public no-arg method which is going to be invoked. A method named explicitly in the mapping
+     * must exist, an implicit {@code execute()} may be missing (e.g. served by an unknown handler).
+     */
+    private Method resolveActionMethod(ActionInvocation invocation, Object action) throws NoSuchMethodException {
+        String methodName = invocation.getProxy().getMethod();
+        if (invocation.getProxy().isMethodSpecified()) {
+            return action.getClass().getMethod(methodName);
+        }
+        if (methodName == null) {
+            return null;
+        }
+        try {
+            return action.getClass().getMethod(methodName);
+        } catch (NoSuchMethodException e) {
+            LOG.trace("Action: {} has no method: {}, skipping method level http method check", action, methodName);
+            return null;
+        }
+    }
+
+    /**
+     * Finds the nearest declaration of the given method carrying any http method annotation, walking up the
+     * class hierarchy and checking each class before its interfaces (and their super-interfaces).
+     */
+    private AnnotatedElement findAnnotatedMethod(Class<?> actionClass, Method method) {
+        if (AnnotationUtils.isAnnotatedBy(method, HTTP_METHOD_ANNOTATIONS)) {
+            return method;
+        }
+        Set<Class<?>> visitedInterfaces = new HashSet<>();
+        for (Class<?> clazz = actionClass; clazz != null; clazz = clazz.getSuperclass()) {
+            Method declared = findOverridableMethod(clazz, method);
+            if (declared != null && AnnotationUtils.isAnnotatedBy(declared, HTTP_METHOD_ANNOTATIONS)) {
+                return declared;
+            }
+            Method fromInterface = findAnnotatedInterfaceMethod(clazz.getInterfaces(), method, visitedInterfaces);
+            if (fromInterface != null) {
+                return fromInterface;
+            }
+        }
+        return null;
+    }
+
+    private Method findAnnotatedInterfaceMethod(Class<?>[] interfaces, Method method, Set<Class<?>> visited) {
+        for (Class<?> iface : interfaces) {
+            if (!visited.add(iface)) {
+                continue;
+            }
+            Method declared = findOverridableMethod(iface, method);
+            if (declared != null && AnnotationUtils.isAnnotatedBy(declared, HTTP_METHOD_ANNOTATIONS)) {
+                return declared;
+            }
+            Method fromSuper = findAnnotatedInterfaceMethod(iface.getInterfaces(), method, visited);
+            if (fromSuper != null) {
+                return fromSuper;
+            }
+        }
+        return null;
+    }
+
+    /**
+     * @return the method declared by the given type which the invoked method can stand for (same signature,
+     * public or protected and not static), or null
+     */
+    private Method findOverridableMethod(Class<?> type, Method method) {
+        Method declared;
+        try {
+            declared = type.getDeclaredMethod(method.getName(), method.getParameterTypes());
+        } catch (NoSuchMethodException e) {
+            return null;
+        }
+        int modifiers = declared.getModifiers();
+        if (Modifier.isStatic(modifiers) || declared.isBridge() || declared.isSynthetic()) {
+            return null;
+        }
+        if (!Modifier.isPublic(modifiers) && !Modifier.isProtected(modifiers)) {
+            return null;
+        }
+        return declared;
+    }
+
+    /**
+     * Finds the nearest type carrying any http method annotation: the class, then its interfaces and their
+     * super-interfaces, then the superclass and so on.
+     */
+    private AnnotatedElement findAnnotatedType(Class<?> actionClass) {
+        Set<Class<?>> visitedInterfaces = new HashSet<>();
+        for (Class<?> clazz = actionClass; clazz != null; clazz = clazz.getSuperclass()) {
+            if (AnnotationUtils.isAnnotatedBy(clazz, HTTP_METHOD_ANNOTATIONS)) {
+                return clazz;
+            }
+            Class<?> fromInterface = findAnnotatedInterface(clazz.getInterfaces(), visitedInterfaces);
+            if (fromInterface != null) {
+                return fromInterface;
+            }
+        }
+        return null;
+    }
+
+    private Class<?> findAnnotatedInterface(Class<?>[] interfaces, Set<Class<?>> visited) {
+        for (Class<?> iface : interfaces) {
+            if (!visited.add(iface)) {
+                continue;
+            }
+            if (AnnotationUtils.isAnnotatedBy(iface, HTTP_METHOD_ANNOTATIONS)) {
+                return iface;
+            }
+            Class<?> fromSuper = findAnnotatedInterface(iface.getInterfaces(), visited);
+            if (fromSuper != null) {
+                return fromSuper;
+            }
+        }
+        return null;
+    }
