+    /**
+     * @return the public method the invocation is going to call, or {@code null} when the implicit
+     * {@code execute()} does not exist (an unknown handler may still serve the action)
+     * @throws NoSuchMethodException when a method named explicitly in the mapping does not exist
+     */
+    private Method resolveInvokedMethod(ActionInvocation invocation) throws NoSuchMethodException {
+        Class<?> actionClass = invocation.getAction().getClass();
+        String methodName = invocation.getProxy().getMethod();
+        if (invocation.getProxy().isMethodSpecified()) {
+            return actionClass.getMethod(methodName);
+        }
+        try {
+            return actionClass.getMethod(methodName != null ? methodName : "execute");
+        } catch (NoSuchMethodException e) {
+            LOG.trace("Action: {} has no method: {}, skipping method annotations", actionClass, methodName);
+            return null;
+        }
+    }
+
+    /**
+     * Finds the nearest declaration of the invoked method carrying an http method annotation, looking at each
+     * class, then at the interfaces it implements (and their super-interfaces), and then at its superclass.
+     */
+    private AnnotatedElement findAnnotatedMethod(Class<?> actionClass, Method invoked) {
+        if (isHttpMethodAnnotated(invoked)) {
+            return invoked;
+        }
+        Set<Class<?>> visited = new HashSet<>();
+        for (Class<?> type = actionClass; type != null; type = type.getSuperclass()) {
+            Method found = findAnnotatedDeclaration(type, invoked);
+            if (found != null) {
+                return found;
+            }
+            for (Class<?> iface : type.getInterfaces()) {
+                found = findAnnotatedMethodInInterface(iface, invoked, visited);
+                if (found != null) {
+                    return found;
+                }
+            }
+        }
+        return null;
+    }
+
+    private Method findAnnotatedMethodInInterface(Class<?> iface, Method invoked, Set<Class<?>> visited) {
+        if (!visited.add(iface)) {
+            return null;
+        }
+        Method found = findAnnotatedDeclaration(iface, invoked);
+        if (found != null) {
+            return found;
+        }
+        for (Class<?> superIface : iface.getInterfaces()) {
+            found = findAnnotatedMethodInInterface(superIface, invoked, visited);
+            if (found != null) {
+                return found;
+            }
+        }
+        return null;
+    }
+
+    private Method findAnnotatedDeclaration(Class<?> type, Method invoked) {
+        for (Method candidate : type.getDeclaredMethods()) {
+            if (candidate.getName().equals(invoked.getName())
+                && candidate.getParameterCount() == invoked.getParameterCount()
+                && Arrays.equals(candidate.getParameterTypes(), invoked.getParameterTypes())
+                && !candidate.isBridge() && !candidate.isSynthetic()
+                && isOverridable(candidate)
+                && isHttpMethodAnnotated(candidate)) {
+                return candidate;
+            }
+        }
+        return null;
+    }
+
+    private boolean isOverridable(Method method) {
+        int modifiers = method.getModifiers();
+        return !Modifier.isStatic(modifiers) && (Modifier.isPublic(modifiers) || Modifier.isProtected(modifiers));
+    }
+
+    /**
+     * Finds the nearest type in the hierarchy carrying an http method annotation: the class, then its interfaces
+     * (and their super-interfaces), then its superclass.
+     */
+    private AnnotatedElement findAnnotatedType(Class<?> actionClass) {
+        Set<Class<?>> visited = new HashSet<>();
+        for (Class<?> type = actionClass; type != null; type = type.getSuperclass()) {
+            if (isHttpMethodAnnotated(type)) {
+                return type;
+            }
+            for (Class<?> iface : type.getInterfaces()) {
+                Class<?> found = findAnnotatedInterface(iface, visited);
+                if (found != null) {
+                    return found;
+                }
+            }
+        }
+        return null;
+    }
+
+    private Class<?> findAnnotatedInterface(Class<?> iface, Set<Class<?>> visited) {
+        if (!visited.add(iface)) {
+            return null;
+        }
+        if (isHttpMethodAnnotated(iface)) {
+            return iface;
+        }
+        for (Class<?> superIface : iface.getInterfaces()) {
+            Class<?> found = findAnnotatedInterface(superIface, visited);
+            if (found != null) {
+                return found;
+            }
+        }
+        return null;
+    }
+
+    private boolean isHttpMethodAnnotated(AnnotatedElement element) {
+        for (Class<? extends Annotation> annotation : HTTP_METHOD_ANNOTATIONS) {
+            if (element.getDeclaredAnnotation(annotation) != null) {
+                return true;
+            }
+        }
+        return false;
+    }
+
     protected String doIntercept(ActionInvocation invocation, AnnotatedElement element) throws Exception {
         Set<HttpMethod> allowedMethods = EnumSet.noneOf(HttpMethod.class);
         allowedMethods.addAll(readAllowedMethods(element));
