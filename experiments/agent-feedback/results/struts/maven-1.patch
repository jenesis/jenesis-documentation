+    public void testImplicitExecuteAnnotationIsEnforced() throws Exception {
+        assertEquals("405 POST", interceptWith(new ExecutePost(), "execute", false, "GET"));
+        assertEquals("success", interceptWith(new ExecutePost(), "execute", false, "POST"));
+    }
+
+    public void testInheritedAnnotationsAreEnforced() throws Exception {
+        assertEquals("405 POST", interceptWith(new SubOfClassPost(), "execute", false, "GET"));
+        assertEquals("success", interceptWith(new SubOfClassPost(), "execute", false, "POST"));
+        assertEquals("405 POST", interceptWith(new OverridesSave(), "save", true, "GET"));
+        assertEquals("405 POST", interceptWith(new ImplementsDerived(), "execute", false, "GET"));
+        assertEquals("405 PUT", interceptWith(new SubOfImplementsSaveOnPut(), "save", true, "GET"));
+        assertEquals("success", interceptWith(new SubOfImplementsSaveOnPut(), "save", true, "PUT"));
+    }
+
+    public void testSuperclassMethodAnnotationWinsOverInterface() throws Exception {
