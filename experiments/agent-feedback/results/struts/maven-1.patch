+    private String interceptWith(Object action, String method, boolean specified, String httpMethod) throws Exception {
+        prepareActionInvocation(action, actionConfig());
+        actionProxy.setMethod(method);
+        actionProxy.setMethodSpecified(specified);
+        invocation.setResultCode("success");
+        MockHttpServletResponse response = prepareRequest(httpMethod);
+        String result = interceptor.intercept(invocation);
+        return Action.NONE.equals(result) ? response.getStatus() + " " + response.getHeader("Allow") : result;
+    }
