+    public void testInheritedAndImplicitAnnotationsAreEnforced() throws Exception {
+        Object[][] cases = {
+            {new ExecutePost(), null},
+            {new ExecutePost(), "execute"},
+            {new SubOfClassPost(), null},
+            {new SubSave(), "save"},
+            {new ImplementsDerived(), null},
+            {new SubOfImplementsMarker(), null},
+            {new ImplementsDefaultSave(), "save"},
+            {new SubOfImplementsDefaultSave(), "save"},
+            {new SuperclassWinsOverInterface(), "save"},
+        };
+        for (Object[] c : cases) {
+            String label = c[0].getClass().getSimpleName() + "#" + c[1];
+            assertEquals(label, Action.NONE, interceptFor(c[0], (String) c[1], "GET"));
+            assertEquals(label, HttpServletResponse.SC_METHOD_NOT_ALLOWED,
+                ((MockHttpServletResponse) ActionContext.getContext().getServletResponse()).getStatus());
+            assertEquals(label, "POST",
+                ((MockHttpServletResponse) ActionContext.getContext().getServletResponse()).getHeader("Allow"));
+            assertEquals(label, "success", interceptFor(c[0], (String) c[1], "POST"));
+        }
+    }
+
