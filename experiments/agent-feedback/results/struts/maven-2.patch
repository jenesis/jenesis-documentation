+    /**
+     * Resolves the public method that is going to be invoked: the one named in the mapping, or the implicit
+     * {@code execute()}. A method named explicitly that does not exist fails with {@link NoSuchMethodException},
+     * a missing implicit {@code execute()} results in {@code null}.
+     */
+    private Method resolveInvokedMethod(ActionInvocation invocation, Object action) throws NoSuchMethodException {
+        String methodName = invocation.getProxy().getMethod();
+        boolean specified = invocation.getProxy().isMethodSpecified();
+        if (methodName == null || methodName.isEmpty()) {
+            if (specified) {
+                return null;
+            }
+            methodName = ActionConfig.DEFAULT_METHOD;
+        }
+        try {
+            return action.getClass().getMethod(methodName);
+        } catch (NoSuchMethodException e) {
+            if (specified) {
+                throw e;
+            }
+            LOG.debug("Action: {} has no implicit method: {}, skipping method level checks", action, methodName);
+            return null;
+        }
+    }
+
+    /**
+     * Finds the declaration of the invoked method carrying an http method annotation: the method itself first,
+     * then walking up the classes, then the interfaces (and their super-interfaces) of each class in turn, so that
+     * a declaration in a superclass wins over one on an interface. Only declarations the invoked public method can
+     * stand for (public or protected, non-static) are considered.
+     */
+    private AnnotatedElement findAnnotatedMethod(Class<?> actionClass, Method method) {
+        if (AnnotationUtils.isAnnotatedBy(method, HTTP_METHOD_ANNOTATIONS)) {
+            return method;
+        }
+        for (Class<?> current = actionClass; current != null; current = current.getSuperclass()) {
+            Method candidate = findOverridableDeclaration(current, method);
+            if (candidate != null && AnnotationUtils.isAnnotatedBy(candidate, HTTP_METHOD_ANNOTATIONS)) {
+                return candidate;
+            }
+        }
+        for (Class<?> current = actionClass; current != null; current = current.getSuperclass()) {
+            for (Class<?> iface : collectInterfaces(current)) {
+                Method candidate = findOverridableDeclaration(iface, method);
+                if (candidate != null && AnnotationUtils.isAnnotatedBy(candidate, HTTP_METHOD_ANNOTATIONS)) {
+                    return candidate;
+                }
+            }
+        }
+        return null;
+    }
+
+    /**
+     * Finds the type carrying an http method annotation: the class, then its interfaces (and their
+     * super-interfaces), then the superclass.
+     */
+    private AnnotatedElement findAnnotatedType(Class<?> actionClass) {
+        for (Class<?> current = actionClass; current != null; current = current.getSuperclass()) {
+            if (AnnotationUtils.isAnnotatedBy(current, HTTP_METHOD_ANNOTATIONS)) {
+                return current;
+            }
+            for (Class<?> iface : collectInterfaces(current)) {
+                if (AnnotationUtils.isAnnotatedBy(iface, HTTP_METHOD_ANNOTATIONS)) {
+                    return iface;
+                }
+            }
+        }
+        return null;
+    }
+
+    private static Method findOverridableDeclaration(Class<?> type, Method method) {
+        for (Method candidate : type.getDeclaredMethods()) {
+            int modifiers = candidate.getModifiers();
+            if (candidate.isBridge() || candidate.isSynthetic()
+                || Modifier.isStatic(modifiers) || Modifier.isPrivate(modifiers)
+                || !(Modifier.isPublic(modifiers) || Modifier.isProtected(modifiers))) {
+                continue;
+            }
+            if (candidate.getName().equals(method.getName())
+                && Arrays.equals(candidate.getParameterTypes(), method.getParameterTypes())) {
+                return candidate;
+            }
+        }
+        return null;
+    }
+
+    /**
+     * @return interfaces directly implemented by the given type followed by their super-interfaces, breadth first
+     */
+    private static Set<Class<?>> collectInterfaces(Class<?> type) {
+        Set<Class<?>> result = new LinkedHashSet<>();
+        Deque<Class<?>> queue = new ArrayDeque<>(Arrays.asList(type.getInterfaces()));
+        while (!queue.isEmpty()) {
+            Class<?> iface = queue.poll();
+            if (result.add(iface)) {
+                queue.addAll(Arrays.asList(iface.getInterfaces()));
+            }
+        }
+        return result;
+    }
+
     protected String doIntercept(ActionInvocation invocation, AnnotatedElement element) throws Exception {
         Set<HttpMethod> allowedMethods = EnumSet.noneOf(HttpMethod.class);
         allowedMethods.addAll(readAllowedMethods(element));
