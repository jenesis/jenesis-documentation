+    /**
+     * @return the public method the invocation is going to call, or {@code null} when the method was not named
+     * explicitly and the action does not declare it (e.g. no {@code execute()})
+     * @throws NoSuchMethodException when the explicitly named method does not exist
+     */
+    private Method findInvokedMethod(ActionInvocation invocation, Class<?> actionClass) throws NoSuchMethodException {
+        String methodName = invocation.getProxy().getMethod();
+        if (invocation.getProxy().isMethodSpecified()) {
+            return actionClass.getMethod(methodName);
+        }
+        if (methodName == null) {
+            return null;
+        }
+        try {
+            return actionClass.getMethod(methodName);
+        } catch (NoSuchMethodException e) {
+            LOG.trace("Action: {} has no method: {}, skipping method level annotations", actionClass, methodName);
+            return null;
+        }
+    }
+
+    /**
+     * Looks up the nearest declaration of the invoked method annotated with one of the http method annotations:
+     * the invoked method itself, then each class up the hierarchy followed by its interfaces (and their
+     * super-interfaces), before its superclass.
+     */
+    private Method findAnnotatedMethod(Class<?> actionClass, Method invoked) {
+        if (AnnotationUtils.isAnnotatedBy(invoked, HTTP_METHOD_ANNOTATIONS)) {
+            return invoked;
+        }
+        Set<Class<?>> visitedInterfaces = new HashSet<>();
+        for (Class<?> current = actionClass; current != null; current = current.getSuperclass()) {
+            Method declared = findOverridableDeclaration(current, invoked);
+            if (declared != null && AnnotationUtils.isAnnotatedBy(declared, HTTP_METHOD_ANNOTATIONS)) {
+                return declared;
+            }
+            for (Class<?> iface : interfacesOf(current, visitedInterfaces)) {
+                declared = findOverridableDeclaration(iface, invoked);
+                if (declared != null && AnnotationUtils.isAnnotatedBy(declared, HTTP_METHOD_ANNOTATIONS)) {
+                    return declared;
+                }
+            }
+        }
+        return null;
+    }
+
+    /**
+     * Looks up the class level annotation: the class, then its interfaces (and their super-interfaces),
+     * then its superclass.
+     */
+    private Class<?> findAnnotatedType(Class<?> actionClass) {
+        Set<Class<?>> visitedInterfaces = new HashSet<>();
+        for (Class<?> current = actionClass; current != null; current = current.getSuperclass()) {
+            if (AnnotationUtils.isAnnotatedBy(current, HTTP_METHOD_ANNOTATIONS)) {
+                return current;
+            }
+            for (Class<?> iface : interfacesOf(current, visitedInterfaces)) {
+                if (AnnotationUtils.isAnnotatedBy(iface, HTTP_METHOD_ANNOTATIONS)) {
+                    return iface;
+                }
+            }
+        }
+        return null;
+    }
+
+    private static Method findOverridableDeclaration(Class<?> type, Method invoked) {
+        Method declared;
+        try {
+            declared = type.getDeclaredMethod(invoked.getName(), invoked.getParameterTypes());
+        } catch (NoSuchMethodException e) {
+            return null;
+        }
+        int modifiers = declared.getModifiers();
+        if (Modifier.isStatic(modifiers) || !(Modifier.isPublic(modifiers) || Modifier.isProtected(modifiers))) {
+            return null;
+        }
+        return declared;
+    }
+
+    /**
+     * @return the interfaces directly implemented by the type, each followed by its super-interfaces,
+     * skipping those already visited
+     */
+    private static List<Class<?>> interfacesOf(Class<?> type, Set<Class<?>> visited) {
+        List<Class<?>> result = new ArrayList<>();
+        Deque<Class<?>> stack = new ArrayDeque<>();
+        Class<?>[] direct = type.getInterfaces();
+        for (int i = direct.length - 1; i >= 0; i--) {
+            stack.push(direct[i]);
+        }
+        while (!stack.isEmpty()) {
+            Class<?> iface = stack.pop();
+            if (!visited.add(iface)) {
+                continue;
+            }
+            result.add(iface);
+            Class<?>[] supers = iface.getInterfaces();
+            for (int i = supers.length - 1; i >= 0; i--) {
+                stack.push(supers[i]);
+            }
+        }
+        return result;
+    }
