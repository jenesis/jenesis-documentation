+package org.apache.struts2.interceptor.httpmethod;
+
+import org.apache.struts2.ActionSupport;
+
+/**
+ * Actions inheriting http method annotations through classes and interfaces.
+ */
+final class HttpMethodHierarchyActions {
+
+    private HttpMethodHierarchyActions() {
+    }
+
+    public static class ExecutePost extends ActionSupport {
+        @HttpPost
+        @Override
+        public String execute() {
+            return SUCCESS;
+        }
+    }
+
+    @HttpPost
+    public static class ClassPost extends ActionSupport {
+    }
+
+    public static class SubOfClassPost extends ClassPost {
+    }
+
+    public static class BaseWithSave extends ActionSupport {
+        @HttpPost
+        public String save() {
+            return SUCCESS;
+        }
+    }
+
+    public static class SubOverridingSave extends BaseWithSave {
+        @Override
+        public String save() {
+            return SUCCESS;
+        }
+    }
+
+    @HttpPost
+    public interface PostOnly {
+    }
+
+    public interface Derived extends PostOnly {
+    }
+
+    public static class ImplementsMarker extends ActionSupport implements PostOnly {
+    }
+
+    public static class SubOfImplementsMarker extends ImplementsMarker {
+    }
+
+    public static class ImplementsDerived extends ActionSupport implements Derived {
+    }
+
+    public interface SaveContract {
+        @HttpPost
+        String save();
+    }
+
+    public interface DerivedSaveContract extends SaveContract {
+    }
+
+    public static class ImplementsDerivedMethod extends ActionSupport implements DerivedSaveContract {
+        public String save() {
+            return SUCCESS;
+        }
+    }
+
+    public interface DefaultSave {
+        @HttpPost
+        default String save() {
+            return "success";
+        }
+    }
+
+    public static class ImplementsDefaultSave extends ActionSupport implements DefaultSave {
+    }
+
+    public interface PutSave {
+        @HttpPut
+        String save();
+    }
+
+    public static class BaseWithSaveImplementingPut extends ActionSupport implements PutSave {
+        @HttpPost
+        @Override
+        public String save() {
+            return SUCCESS;
+        }
+    }
+
+    public static class SuperclassVsInterface extends BaseWithSaveImplementingPut {
+        @Override
+        public String save() {
+            return SUCCESS;
+        }
+    }
+
+    public static class PrivateExecuteBase {
+        @HttpPost
+        private String execute() {
+            return "success";
+        }
+    }
+
+    public static class HidesPrivateExecute extends PrivateExecuteBase {
+        public String execute() {
+            return "success";
+        }
+    }
+}
