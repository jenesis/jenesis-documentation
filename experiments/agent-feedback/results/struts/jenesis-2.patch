+    private String interceptImplicit(Object action, String httpMethod, MockHttpServletResponse[] responseHolder) throws Exception {
+        prepareActionInvocation(action, actionConfig());
+        actionProxy.setMethod("execute");
+        actionProxy.setMethodSpecified(false);
+        invocation.setResultCode("success");
+        responseHolder[0] = prepareRequest(httpMethod);
+        return interceptor.intercept(invocation);
+    }
+
+    private void assertPostOnlyImplicit(Object action) throws Exception {
+        MockHttpServletResponse[] response = new MockHttpServletResponse[1];
+        assertEquals(Action.NONE, interceptImplicit(action, "get", response));
+        assertEquals(HttpServletResponse.SC_METHOD_NOT_ALLOWED, response[0].getStatus());
+        assertEquals("POST", response[0].getHeader("Allow"));
+        assertEquals("success", interceptImplicit(action, "post", response));
+    }
+
+    private void assertPostOnlySave(Object action) throws Exception {
+        for (String httpMethod : new String[]{"get", "post"}) {
+            prepareActionInvocation(action, actionConfig());
+            actionProxy.setMethod("save");
+            invocation.setResultCode("success");
+            MockHttpServletResponse response = prepareRequest(httpMethod);
+            String result = interceptor.intercept(invocation);
+            if ("get".equals(httpMethod)) {
+                assertEquals(Action.NONE, result);
+                assertEquals("POST", response.getHeader("Allow"));
+            } else {
+                assertEquals("success", result);
+            }
+        }
+    }
+
+    public void testImplicitExecuteAnnotationIsEnforced() throws Exception {
+        assertPostOnlyImplicit(new HttpMethodHierarchyActions.ExecutePost());
+    }
+
+    public void testInheritedClassAnnotationIsEnforced() throws Exception {
+        assertPostOnlyImplicit(new HttpMethodHierarchyActions.SubOfClassPost());
+    }
+
+    public void testOverriddenMethodInheritsAnnotation() throws Exception {
+        assertPostOnlySave(new HttpMethodHierarchyActions.SubOverridingSave());
+    }
+
+    public void testInterfaceAnnotationsThroughSuperclassAndSuperInterface() throws Exception {
+        assertPostOnlyImplicit(new HttpMethodHierarchyActions.SubOfImplementsMarker());
+        assertPostOnlyImplicit(new HttpMethodHierarchyActions.ImplementsDerived());
+        assertPostOnlySave(new HttpMethodHierarchyActions.ImplementsDerivedMethod());
+        assertPostOnlySave(new HttpMethodHierarchyActions.ImplementsDefaultSave());
+    }
+
+    public void testSuperclassMethodAnnotationWinsOverInterface() throws Exception {
+        prepareActionInvocation(new HttpMethodHierarchyActions.SuperclassVsInterface(), actionConfig());
+        actionProxy.setMethod("save");
+        invocation.setResultCode("success");
+        MockHttpServletResponse response = prepareRequest("put");
+        assertEquals(Action.NONE, interceptor.intercept(invocation));
+        assertEquals("POST", response.getHeader("Allow"));
+    }
+
+    public void testPrivateOrStaticAncestorMethodIsIgnored() throws Exception {
+        MockHttpServletResponse[] response = new MockHttpServletResponse[1];
+        assertEquals("success", interceptImplicit(new HttpMethodHierarchyActions.HidesPrivateExecute(), "get", response));
+    }
+
+    public void testMissingImplicitExecuteDoesNotFail() throws Exception {
+        MockHttpServletResponse[] response = new MockHttpServletResponse[1];
+        assertEquals("success", interceptImplicit(new Object(), "get", response));
+    }
+
+    public void testMissingSpecifiedMethodFails() throws Exception {
+        prepareActionInvocation(new HttpMethodHierarchyActions.ExecutePost(), actionConfig());
+        actionProxy.setMethod("doesNotExist");
+        prepareRequest("post");
+        try {
+            interceptor.intercept(invocation);
+            fail();
+        } catch (NoSuchMethodException e) {
+            assertTrue(e.getMessage().contains("doesNotExist"));
+        }
+    }
