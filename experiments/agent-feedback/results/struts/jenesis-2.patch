+    /**
+     * Resolves the public no-arg method that is going to be invoked. A method named explicitly in the mapping
+     * must exist, the implicit one ({@code execute}) may be missing, then {@code null} is returned.
+     */
+    private Method resolveInvokedMethod(ActionInvocation invocation, Class<?> actionClass) throws NoSuchMethodException {
+        String methodName = invocation.getProxy().getMethod();
+        if (invocation.getProxy().isMethodSpecified()) {
+            return actionClass.getMethod(methodName);
+        }
+        if (methodName == null) {
+            return null;
+        }
+        try {
+            return actionClass.getMethod(methodName);
+        } catch (NoSuchMethodException e) {
+            LOG.trace("Action: {} has no method: {}, skipping method level annotations", actionClass, methodName);
+            return null;
+        }
+    }
+
+    /**
+     * Finds the declaration of the given method carrying an http method annotation: the method itself first,
+     * then walking up the classes, each class before its interfaces (and their super-interfaces).
+     */
+    private AnnotatedElement findAnnotatedMethod(Class<?> actionClass, Method method) {
+        if (AnnotationUtils.isAnnotatedBy(method, HTTP_METHOD_ANNOTATIONS)) {
+            return method;
+        }
+        Set<Class<?>> visited = new HashSet<>();
+        for (Class<?> type = actionClass; type != null; type = type.getSuperclass()) {
+            Method declared = findOverridableDeclaration(type, method);
+            if (declared != null && AnnotationUtils.isAnnotatedBy(declared, HTTP_METHOD_ANNOTATIONS)) {
+                return declared;
+            }
+            for (Class<?> iface : type.getInterfaces()) {
+                Method found = findAnnotatedInterfaceMethod(iface, method, visited);
+                if (found != null) {
+                    return found;
+                }
+            }
+        }
+        return null;
+    }
+
+    private Method findAnnotatedInterfaceMethod(Class<?> iface, Method method, Set<Class<?>> visited) {
+        if (!visited.add(iface)) {
+            return null;
+        }
+        Method declared = findOverridableDeclaration(iface, method);
+        if (declared != null && AnnotationUtils.isAnnotatedBy(declared, HTTP_METHOD_ANNOTATIONS)) {
+            return declared;
+        }
+        for (Class<?> superIface : iface.getInterfaces()) {
+            Method found = findAnnotatedInterfaceMethod(superIface, method, visited);
+            if (found != null) {
+                return found;
+            }
+        }
+        return null;
+    }
+
+    /**
+     * @return the method of the same signature declared by the type, if the invoked method can stand for it
+     * (not private, not package-private, not static)
+     */
+    private Method findOverridableDeclaration(Class<?> type, Method method) {
+        Method declared;
+        try {
+            declared = type.getDeclaredMethod(method.getName(), method.getParameterTypes());
+        } catch (NoSuchMethodException e) {
+            return null;
+        }
+        int modifiers = declared.getModifiers();
+        if (Modifier.isStatic(modifiers) || declared.isSynthetic()
+            || !(Modifier.isPublic(modifiers) || Modifier.isProtected(modifiers))) {
+            return null;
+        }
+        return declared;
+    }
+
+    /**
+     * Finds the type carrying an http method annotation: the class, then its interfaces
+     * (and their super-interfaces), then the superclass.
+     */
+    private AnnotatedElement findAnnotatedType(Class<?> actionClass) {
+        Set<Class<?>> visited = new HashSet<>();
+        for (Class<?> type = actionClass; type != null; type = type.getSuperclass()) {
+            if (AnnotationUtils.isAnnotatedBy(type, HTTP_METHOD_ANNOTATIONS)) {
+                return type;
+            }
+            for (Class<?> iface : type.getInterfaces()) {
+                Class<?> found = findAnnotatedInterface(iface, visited);
+                if (found != null) {
+                    return found;
+                }
+            }
+        }
+        return null;
+    }
+
+    private Class<?> findAnnotatedInterface(Class<?> iface, Set<Class<?>> visited) {
+        if (!visited.add(iface)) {
+            return null;
+        }
+        if (AnnotationUtils.isAnnotatedBy(iface, HTTP_METHOD_ANNOTATIONS)) {
+            return iface;
+        }
+        for (Class<?> superIface : iface.getInterfaces()) {
+            Class<?> found = findAnnotatedInterface(superIface, visited);
+            if (found != null) {
+                return found;
+            }
+        }
+        return null;
+    }
