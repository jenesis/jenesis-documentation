+    // A setter rejecting a value of its own type is not a type mismatch
+    public static class Guarded {
+        private int age;
+        private String code;
+
+        public int getAge() { return age; }
+        public void setAge(int age) {
+            if (age < 0) throw new IllegalArgumentException("age must be >= 0");
+            this.age = age;
+        }
+
+        public String getCode() { return code; }
+        public void setCode(String code) {
+            if (code.isEmpty()) throw new IllegalArgumentException("empty code");
+            this.code = code;
+        }
+    }
+
+    @JsonDeserialize(builder = GuardedValue.Builder.class)
+    public static class GuardedValue {
+        final int age;
+        final String code;
+
+        GuardedValue(int age, String code) { this.age = age; this.code = code; }
+
+        @JsonPOJOBuilder
+        public static class Builder {
+            private int age;
+            private String code;
+
+            public Builder withAge(int age) {
+                if (age < 0) throw new IllegalArgumentException("age must be >= 0");
+                this.age = age;
+                return this;
+            }
+
+            public Builder withCode(String code) {
+                if (code.isEmpty()) throw new IllegalArgumentException("empty code");
+                this.code = code;
+                return this;
+            }
+
+            public GuardedValue build() { return new GuardedValue(age, code); }
+        }
+    }
+
+    @Test
+    public void testRejectingSetterMessageMatchesVanilla() throws Exception {
+        ObjectMapper vanilla = newVanillaJSONMapper();
+        ObjectMapper blackbird = newObjectMapper();
+        assertGeneratedReader(blackbird, Guarded.class);
+        String[][] cases = {
+                { a2q("{'age':-1}"), "Problem setting property 'age': age must be >= 0" },
+                { a2q("{'code':''}"), "Problem setting property 'code': empty code" },
+        };
+        for (Class<?> type : new Class<?>[] { Guarded.class, GuardedValue.class }) {
+            for (String[] c : cases) {
+                String desc = type.getSimpleName() + ", " + c[0];
+                DatabindException expected = assertThrows(DatabindException.class,
+                        () -> vanilla.readValue(c[0], type), desc);
+                DatabindException actual = assertThrows(DatabindException.class,
+                        () -> blackbird.readValue(c[0], type), desc);
+                assertEquals(c[1], expected.getOriginalMessage(), desc);
+                assertEquals(expected.getOriginalMessage(), actual.getOriginalMessage(), desc);
+                assertEquals(expected.getMessage(), actual.getMessage(), desc);
+                assertEquals(expected.getPathReference(), actual.getPathReference(), desc);
+            }
+        }
+    }
 
