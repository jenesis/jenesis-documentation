    <div class="lp-need__text">
      <p class="lp-eyebrow">{{ loop.index }} of {{ loop.length }}</p>
      <h2 id="{{ s.id }}-title">{{ s.title }}</h2>
      {{ s.lede | safe }}
      <ul class="lp-verdicts" aria-label="How each tool does it">
        {% for t in bc.tools %}{% set e = s.tools[t.key] %}
        <li class="lp-verdict">
          <span class="lp-verdict__who">
            <span class="lp-verdict__tool">{{ t.name }}</span>
            <span class="lp-badge lp-badge--{{ e.status }}">{{ e.badge or bc.statuses[e.status] }}</span>
          </span>
          <span class="lp-verdict__text">{{ e.verdict | safe }}</span>
        </li>
        {% endfor %}
      </ul>
    </div>

    <div class="lp-tabs lp-tabs--code" data-tabs>
      <div class="lp-tabs__list" role="tablist" aria-label="{{ s.title }}, by tool">
        {% for t in bc.tools %}{% set e = s.tools[t.key] %}
        <button role="tab" id="tab-{{ s.id }}-{{ t.key }}" aria-controls="panel-{{ s.id }}-{{ t.key }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>
{{ t.name }}</button>
        {% endfor %}
      </div>
      {% for t in bc.tools %}{% set e = s.tools[t.key] %}
      <div class="lp-tabs__panel" role="tabpanel" id="panel-{{ s.id }}-{{ t.key }}" aria-labelledby="tab-{{ s.id }}-{{ t.key }}"{% if not loop.first %} hidden{% endif %}>
        {% if e.gap %}
        <div class="lp-gap"><p>{{ e.gap | safe }}</p></div>
        {% endif %}
        {% for f in e.files %}
          {% if f.generated or not f.lines %}
          <details class="lp-file lp-file--generated">
            <summary><code>{{ f.path }}</code><span class="lp-file__meta">{% if f.generated %}written by <code>{{ f.generated }}</code>{% else %}{{ f.note }}{% endif %}{% if f.count %} · {{ f.count }} line{{ '' if f.count == 1 else 's' }}{% endif %}</span></summary>
            {% if f.lines %}<pre><code>{% for l in f.lines %}<span class="lp-line{% if l.added %} lp-line--add{% endif %}">{{ l.text }}</span>{% endfor %}</code></pre>{% endif %}
            {% if f.generated and f.note %}<p class="lp-file__note">{{ f.note }}</p>{% endif %}
          </details>
          {% else %}
          <figure class="lp-file">
            <figcaption class="lp-file__head"><code>{{ f.path }}</code><span class="lp-file__meta">{{ f.count }} line{{ '' if f.count == 1 else 's' }}</span></figcaption>
            {% if f.segments %}
            {% for seg in f.segments %}
            {% if seg.folded %}
            <details class="lp-fold">
              <summary>{{ seg.label }}</summary>
              <pre><code>{% for l in seg.lines %}<span class="lp-line">{{ l.text }}</span>{% endfor %}</code></pre>
            </details>
            {% else %}
            <pre class="lp-seg"><code>{% for l in seg.lines %}<span class="lp-line lp-line--own{% if l.added %} lp-line--add{% endif %}">{{ l.text }}</span>{% endfor %}</code></pre>
            {% endif %}
            {% endfor %}
            {% else %}
            <pre><code>{% for l in f.lines %}<span class="lp-line{% if l.added %} lp-line--add{% endif %}">{{ l.text }}</span>{% endfor %}</code></pre>
            {% endif %}
            {% if f.note %}<p class="lp-file__note">{{ f.note }}</p>{% endif %}
          </figure>
          {% endif %}
        {% endfor %}
        {% if e.layout %}
        <figure class="lp-file">
          <figcaption class="lp-file__head"><code>Where the sources go</code></figcaption>
          <pre><code>{% for l in e.layout.split("\n") %}<span class="lp-line">{{ l }}</span>{% endfor %}</code></pre>
        </figure>
        {% endif %}
        {% if e.terminal %}
        <figure class="lp-file">
          <figcaption class="lp-file__head"><code>Terminal</code></figcaption>
          <pre><code>{% for l in e.terminal %}{% if l.startsWith("$ ") %}<span class="lp-line"><span class="lp-prompt">$</span> {{ l.slice(2) }}</span>{% else %}<span class="lp-line lp-line--out">{{ l }}</span>{% endif %}{% endfor %}</code></pre>
        </figure>
        {% endif %}
        {% if e.commands %}
        <figure class="lp-file">
          <figcaption class="lp-file__head"><code>Commands</code></figcaption>
          <pre><code>{% for l in e.commands.split("\n") %}<span class="lp-line">$ {{ l }}</span>{% endfor %}</code></pre>
        </figure>
        {% endif %}
        {% if e.notes %}
        <div class="lp-notes">
          <p class="lp-notes__title">Worth knowing</p>
          <ul>{% for n in e.notes %}<li>{{ n | safe }}</li>{% endfor %}</ul>
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% if s.extra %}{% include "landing-tool/" + s.extra + ".njk" %}{% endif %}
