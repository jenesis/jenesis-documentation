module(name = "app", version = "1.0.0")

bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "bazel_jar_jar", version = "0.1.15")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = ["com.fasterxml.jackson.core:jackson-core:2.22.3"],
    repositories = ["https://repo1.maven.org/maven2"],
)
maven.install(
    name = "maven_library",
    artifacts = ["com.fasterxml.jackson.core:jackson-core:2.15.4"],
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "maven", "maven_library")
