module(name = "app", version = "1.0.0")

bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "contrib_rules_jvm", version = "0.34.0")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "org.slf4j:slf4j-api:2.0.20",
        "com.fasterxml.jackson.core:jackson-databind:2.22.3",
        "info.picocli:picocli:4.7.7",
        "org.jspecify:jspecify:1.0.1",
        "org.junit.jupiter:junit-jupiter-api:6.1.3",
        "org.junit.jupiter:junit-jupiter-engine:6.1.3",
        "org.junit.platform:junit-platform-launcher:6.1.3",
        "org.junit.platform:junit-platform-reporting:6.1.3",
    ],
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "maven")
