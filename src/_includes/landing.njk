<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="icon" href="/assets/logos/light/{{ logo }}.svg">
  <link rel="stylesheet" href="/assets/css/pico.min.css">
  <link rel="stylesheet" href="/assets/css/app.css">
  <link rel="stylesheet" href="/assets/css/docs.css">
  <link rel="stylesheet" href="/assets/css/landing.css">
  <!-- Set the theme before first paint so there is no flash. -->
  <script>
    (function () {
      var t = localStorage.getItem("jenesis-theme");
      if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
      else if (window.matchMedia("(prefers-color-scheme: dark)").matches) document.documentElement.setAttribute("data-theme", "dark");
    })();
  </script>
</head>
<body class="lp">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="lp-header">
    <div class="lp-header__inner">
      <a class="lp-brand" href="#top" aria-label="{{ product }}">
        <img src="/assets/logos/light/{{ logo }}.svg" alt="" width="30" height="30" data-logo="{{ logo }}">
        <span>{{ product }}</span>
      </a>
      <nav class="lp-nav" aria-label="Page">
        {% for item in nav %}<a href="{{ item.href }}">{{ item.label }}</a>
        {% endfor %}<a href="{{ docs }}">Docs</a>
      </nav>
      <a class="lp-repo" href="{{ repo }}" aria-label="{{ product }} on GitHub" title="{{ product }} on GitHub">
        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
      <button class="theme-toggle" type="button" title="Switch theme" aria-label="Switch colour theme"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg></button>
      <a class="lp-button lp-button--small" href="mailto:{{ contact }}?subject={{ contactSubject | urlencode }}">Get in touch</a>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="lp-footer">
    <div class="lp-footer__inner">
      <div class="lp-footer__brand">
        <img src="/assets/logos/light/{{ logo }}.svg" alt="" width="24" height="24" data-logo="{{ logo }}">
        <span>{{ product }}</span>
      </div>
      <nav aria-label="Footer">
        <a href="{{ docs }}">Documentation</a>
        <a href="{{ repo }}">GitHub</a>
        <a href="{{ repo }}/blob/main/LICENSE">Apache License 2.0</a>
        <a href="/">The Jenesis project</a>
        <a href="mailto:{{ contact }}">{{ contact }}</a>
      </nav>
      <p>Made in Oslo, Norway</p>
    </div>
  </footer>

  <script src="/assets/js/theme.js" defer></script>
  <script src="/assets/js/landing.js" defer></script>
</body>
</html>
