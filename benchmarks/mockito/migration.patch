+package raw;
+
+import module build.jenesis;
+import module java.base;
+
+public class RawFactory implements BuildModuleFactory {
+
+    @Override
+    public BuildExecutorModule create(Environment environment,
+                                      SequencedMap<String, String> properties,
+                                      Permits permits,
+                                      String group,
+                                      Map<String, Repository> repositories,
+                                      Map<String, Resolver> resolvers) {
+        Set<String> unknown = new TreeSet<>(properties.sequencedKeySet());
+        unknown.removeAll(Set.of("entry", "resource"));
+        if (!unknown.isEmpty()) {
+            throw new IllegalArgumentException("The raw plugin takes the values entry and resource, not " + unknown);
+        }
+        String entry = properties.get("entry"), resource = properties.get("resource");
+        if (entry == null || entry.isBlank() || resource == null || resource.isBlank()) {
+            throw new IllegalArgumentException("The raw plugin needs entry=<path of a file in a dependency's jar>"
+                    + " and resource=<path in this module's jar>, given " + properties);
+        }
+        return new RawModule(entry, resource);
+    }
+}
