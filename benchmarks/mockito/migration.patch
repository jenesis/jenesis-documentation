diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 5c9d971..86eb752 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -98,6 +98,31 @@ jobs:
         files: build/reports/jacoco/mockitoCoverage/mockitoCoverage.xml
         fail_ci_if_error: true
 
+  #
+  # Jenesis build: the pom.xml build, strictly pinned, with sources and javadoc staged
+  #
+  jenesis:
+    runs-on: ubuntu-latest
+    if: "! contains(toJSON(github.event.commits.*.message), '[skip ci]')"
+
+    steps:
+    - name: 1. Check out code
+      uses: actions/checkout@v7
+
+    - name: 2. Set up Java for running the Jenesis build
+      uses: actions/setup-java@v6
+      with:
+        distribution: 'zulu'
+        java-version: 25
+
+    - name: 3. Build, test and stage
+      run: >
+        java
+        -Djenesis.dependency.pin=strict
+        -Djenesis.make.profiles=release,coverage
+        build/jenesis/Make.java
+        stage
+
   #
   # Android build job
   #
@@ -232,7 +257,7 @@ jobs:
     permissions:
       contents: write
     runs-on: ubuntu-latest
-    needs: [java, android, graalvm] # all build jobs must pass before we can release
+    needs: [java, jenesis, android, graalvm] # all build jobs must pass before we can release
 
     if: github.event_name == 'push'
         && (github.ref == 'refs/heads/main' || startsWith(github.ref, 'refs/tags/v'))
