+++ b/mockito-integration-tests/osgi-tests/runtime-bundles/src/main/java/org/mockito/osgitest/bundles/RuntimeBundles.java
@@ -0,0 +1,61 @@
+/*
+ * Copyright (c) 2026 Mockito contributors
+ * This program is made available under the terms of the MIT License.
+ */
+package org.mockito.osgitest.bundles;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.UncheckedIOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+
+import org.junit.platform.launcher.LauncherSession;
+import org.junit.platform.launcher.LauncherSessionListener;
+
+/**
+ * Hands the OSGi tests the bundles they install, as the Gradle build does with -DtestRuntimeBundles: the build
+ * places the bundle jars among the test resources below osgi-bundles/, named in osgi-bundles/index.txt.
+ */
+public class RuntimeBundles implements LauncherSessionListener {
+
+    private static final String PROPERTY = "testRuntimeBundles", FOLDER = "osgi-bundles/";
+
+    @Override
+    public void launcherSessionOpened(LauncherSession session) {
+        if (System.getProperty(PROPERTY) != null) {
+            return;
+        }
+        ClassLoader loader = Thread.currentThread().getContextClassLoader();
+        try (InputStream index = loader.getResourceAsStream(FOLDER + "index.txt")) {
+            if (index == null) {
+                return;
+            }
+            Path folder = Files.createTempDirectory("osgi-bundles");
+            folder.toFile().deleteOnExit();
+            List<String> paths = new ArrayList<>();
+            for (String name :
+                    new String(index.readAllBytes(), StandardCharsets.UTF_8).split("\n")) {
+                if (name.isBlank()) {
+                    continue;
+                }
+                Path target = folder.resolve(name.trim());
+                try (InputStream bundle = loader.getResourceAsStream(FOLDER + name.trim())) {
+                    if (bundle == null) {
+                        throw new IllegalStateException("No resource " + FOLDER + name.trim());
+                    }
+                    Files.copy(bundle, target);
+                }
+                target.toFile().deleteOnExit();
+                paths.add(target.toString());
+            }
+            System.setProperty(PROPERTY, String.join(File.pathSeparator, paths));
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+}
