diff --git a/mockito-integration-tests/osgi-tests/runtime-bundles/src/main/java/org/mockito/osgitest/bundles/RuntimeBundles.java b/mockito-integration-tests/osgi-tests/runtime-bundles/src/main/java/org/mockito/osgitest/bundles/RuntimeBundles.java
