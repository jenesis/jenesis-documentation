+package bundles;
+
+import module build.jenesis;
+import module java.base;
+
+public class BundlesFactory implements BuildModuleFactory {
+
+    @Override
+    public BuildExecutorModule create(Environment environment,
+                                      SequencedMap<String, String> properties,
+                                      Permits permits,
+                                      String group,
+                                      Map<String, Repository> repositories,
+                                      Map<String, Resolver> resolvers) {
+        Set<String> unknown = new TreeSet<>(properties.sequencedKeySet());
+        unknown.remove("folder");
+        if (!unknown.isEmpty()) {
+            throw new IllegalArgumentException("The bundles plugin takes the value folder, not " + unknown);
+        }
+        String folder = properties.get("folder");
+        if (folder == null || folder.isBlank()) {
+            throw new IllegalArgumentException("The bundles plugin needs folder=<resource folder the jars are written to>");
+        }
+        return new BundlesModule(group + ":runtime", folder);
+    }
+}
