+++ b/plugins/raw/raw/RawModule.java
@@ -0,0 +1,60 @@
+package raw;
+
+import module build.jenesis;
+import module java.base;
+
+import build.jenesis.step.Dependencies;
+
+public class RawModule implements BuildExecutorModule {
+
+    private final String entry, resource;
+
+    public RawModule(String entry, String resource) {
+        this.entry = entry;
+        this.resource = resource;
+    }
+
+    @Override
+    public void accept(BuildExecutor executor, SequencedMap<String, Path> inherited) {
+        SequencedSet<String> inputs = new LinkedHashSet<>();
+        for (String key : inherited.sequencedKeySet()) {
+            if (key.endsWith("/dependencies/artifacts")) {
+                inputs.add(key);
+            }
+        }
+        executor.addStep("raw", new Copy(entry, resource), inputs.isEmpty() ? inherited.sequencedKeySet() : inputs);
+    }
+
+    private record Copy(String entry, String resource) implements BuildStep {
+
+        @Override
+        public CompletionStage<BuildStepResult> apply(Executor executor,
+                                                      BuildStepContext context,
+                                                      SequencedMap<String, BuildStepArgument> arguments)
+                throws IOException {
+            for (BuildStepArgument argument : arguments.values()) {
+                if (argument.removed()) {
+                    continue;
+                }
+                for (Path jar : Dependencies.all(argument.folder())) {
+                    if (!jar.getFileName().toString().endsWith(".jar")) {
+                        continue;
+                    }
+                    try (ZipFile zip = new ZipFile(jar.toFile())) {
+                        ZipEntry found = zip.getEntry(entry);
+                        if (found != null) {
+                            Path target = BuildStep.resolveContained(context.next().resolve(BuildStep.CLASSES), resource);
+                            Files.createDirectories(target.getParent());
+                            try (InputStream input = zip.getInputStream(found)) {
+                                Files.copy(input, target);
+                            }
+                            return CompletableFuture.completedStage(new BuildStepResult(true));
+                        }
+                    }
+                }
+            }
+            throw new IllegalStateException("No resolved dependency holds " + entry
+                    + ": declare the module that compiles it as a dependency, such as of scope provided");
+        }
+    }
+}
