+++ b/plugins/bundles/bundles/BundlesModule.java
@@ -0,0 +1,52 @@
+package bundles;
+
+import module build.jenesis;
+import module java.base;
+
+import build.jenesis.step.Dependencies;
+
+public class BundlesModule implements BuildExecutorModule {
+
+    private final String group, folder;
+
+    public BundlesModule(String group, String folder) {
+        this.group = group;
+        this.folder = folder;
+    }
+
+    @Override
+    public void accept(BuildExecutor executor, SequencedMap<String, Path> inherited) {
+        SequencedSet<String> inputs = new LinkedHashSet<>();
+        for (String key : inherited.sequencedKeySet()) {
+            if (key.endsWith("/dependencies/artifacts")) {
+                inputs.add(key);
+            }
+        }
+        executor.addStep("bundles", new Copy(group, folder), inputs.isEmpty() ? inherited.sequencedKeySet() : inputs);
+    }
+
+    private record Copy(String group, String folder) implements BuildStep {
+
+        @Override
+        public CompletionStage<BuildStepResult> apply(Executor executor,
+                                                      BuildStepContext context,
+                                                      SequencedMap<String, BuildStepArgument> arguments)
+                throws IOException {
+            Path target = BuildStep.resolveContained(context.next().resolve(BuildStep.CLASSES), folder);
+            Files.createDirectories(target);
+            SequencedSet<String> names = new LinkedHashSet<>();
+            for (Path jar : Dependencies.paths(arguments, group, "plugin")) {
+                String name = jar.getFileName().toString();
+                if (name.endsWith(".jar") && names.add(name)) {
+                    Files.copy(jar, target.resolve(name));
+                }
+            }
+            if (names.isEmpty()) {
+                throw new IllegalStateException("No jar resolved in " + group + " - name each bundle as"
+                        + " <!--jenesis.plugin " + group + " maven/<groupId>/<artifactId>-->");
+            }
+            Files.writeString(target.resolve("index.txt"), String.join("\n", names) + "\n");
+            return CompletableFuture.completedStage(new BuildStepResult(true));
+        }
+    }
+}
