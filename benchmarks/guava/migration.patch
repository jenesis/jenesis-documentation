+package build.bnd;
+
+import module build.jenesis;
+import module java.base;
+
+public class BndFactory implements BuildModuleFactory {
+
+    @Override
+    public BuildExecutorModule create(Environment environment,
+                                      SequencedMap<String, String> properties,
+                                      Permits permits,
+                                      String group,
+                                      Map<String, Repository> repositories,
+                                      Map<String, Resolver> resolvers) {
+        return (executor, inherited) -> executor.addStep("manifest",
+                new BndManifest(new LinkedHashMap<>(properties), group + ":tool"),
+                inherited.sequencedKeySet());
+    }
+}
diff --git a/build/bnd/build/bnd/BndManifest.java b/build/bnd/build/bnd/BndManifest.java
new file mode 100644
index 0000000..1ff0f14
--- /dev/null
+++ b/build/bnd/build/bnd/BndManifest.java
@@ -0,0 +1,112 @@
+package build.bnd;
+
+import module build.jenesis;
+import module java.base;
+
+import build.jenesis.step.Dependencies;
+
+record BndManifest(LinkedHashMap<String, String> instructions, String tool) implements BuildStep {
+
+    private static final String MANIFEST = "manifest.mf";
+
+    @Override
+    public CompletionStage<BuildStepResult> apply(Executor executor,
+                                                  BuildStepContext context,
+                                                  SequencedMap<String, BuildStepArgument> arguments) throws IOException {
+        Path compiled = arguments.firstEntry().getValue().folder();
+        SequencedSet<Path> folders = new LinkedHashSet<>();
+        List<Path> bnd = new ArrayList<>(), classPath = new ArrayList<>();
+        for (BuildStepArgument argument : arguments.values()) {
+            if (!argument.removed()) {
+                folders.add(argument.folder());
+                bnd.addAll(Dependencies.select(argument.folder(), tool, "plugin"));
+                classPath.addAll(Dependencies.select(argument.folder(), "main", "compile"));
+            }
+        }
+        if (bnd.isEmpty()) {
+            throw new IllegalStateException("No bnd jar is resolved in the group " + tool
+                    + ": declare <!--jenesis.plugin " + tool + " maven/biz.aQute.bnd/biz.aQute.bndlib--> in pom.xml");
+        }
+        Path described = BuildStep.locate(folders, BuildStep.METADATA);
+        Properties metadata = new Properties();
+        if (described != null) {
+            try (Reader reader = Files.newBufferedReader(described)) {
+                metadata.load(reader);
+            }
+        }
+        Manifest base = new Manifest();
+        Path handed = compiled.resolve(MANIFEST);
+        if (Files.isRegularFile(handed)) {
+            try (InputStream input = Files.newInputStream(handed)) {
+                base.read(input);
+            }
+        }
+        URL[] urls = new URL[bnd.size()];
+        for (int index = 0; index < urls.length; index++) {
+            urls[index] = bnd.get(index).toUri().toURL();
+        }
+        Manifest calculated;
+        try (URLClassLoader loader = new URLClassLoader(urls, ClassLoader.getPlatformClassLoader())) {
+            calculated = calculate(loader, compiled.resolve(BuildStep.CLASSES), classPath, metadata);
+        } catch (ReflectiveOperationException exception) {
+            throw new IllegalStateException("bnd could not compute the OSGi manifest", exception);
+        }
+        base.getMainAttributes().putAll(calculated.getMainAttributes());
+        try (OutputStream output = Files.newOutputStream(context.next().resolve(MANIFEST))) {
+            base.write(output);
+        }
+        return CompletableFuture.completedStage(new BuildStepResult(true));
+    }
+
+    private Manifest calculate(ClassLoader loader,
+                               Path classes,
+                               List<Path> classPath,
+                               Properties metadata) throws ReflectiveOperationException, IOException {
+        Class<?> analyzerType = Class.forName("aQute.bnd.osgi.Analyzer", true, loader),
+                jarType = Class.forName("aQute.bnd.osgi.Jar", true, loader);
+        Properties properties = new Properties();
+        String group = metadata.getProperty("project"), artifact = metadata.getProperty("artifact");
+        if (group != null && artifact != null) {
+            properties.setProperty("Bundle-SymbolicName",
+                    group.endsWith("." + artifact) || group.equals(artifact) ? group : group + "." + artifact);
+        }
+        String version = metadata.getProperty("version");
+        if (version != null) {
+            properties.setProperty("Bundle-Version",
+                    (String) analyzerType.getMethod("cleanupVersion", String.class).invoke(null, version));
+        }
+        put(properties, "Bundle-Name", metadata.getProperty("name"));
+        put(properties, "Bundle-Description", metadata.getProperty("description"));
+        put(properties, "Bundle-Vendor", metadata.getProperty("organization.name"));
+        put(properties, "Bundle-License", metadata.stringPropertyNames().stream()
+                .filter(key -> key.startsWith("license.") && key.endsWith(".url"))
+                .sorted()
+                .map(metadata::getProperty)
+                .reduce((left, right) -> left + "," + right)
+                .orElse(null));
+        properties.setProperty("-noextraheaders", "true");
+        properties.setProperty("-reproducible", "true");
+        properties.putAll(instructions);
+        Object analyzer = analyzerType.getConstructor().newInstance();
+        try {
+            analyzerType.getMethod("setJar", jarType).invoke(analyzer, jarType.getConstructor(File.class).newInstance(classes.toFile()));
+            analyzerType.getMethod("setProperties", Properties.class).invoke(analyzer, properties);
+            analyzerType.getMethod("setClasspath", File[].class).invoke(analyzer,
+                    (Object) classPath.stream().map(Path::toFile).toArray(File[]::new));
+            Manifest manifest = (Manifest) analyzerType.getMethod("calcManifest").invoke(analyzer);
+            List<?> errors = (List<?>) analyzerType.getMethod("getErrors").invoke(analyzer);
+            if (!errors.isEmpty()) {
+                throw new IllegalStateException("bnd reported errors for " + classes + ": " + errors);
+            }
+            return manifest;
+        } finally {
+            analyzerType.getMethod("close").invoke(analyzer);
+        }
+    }
+
+    private static void put(Properties properties, String key, String value) {
+        if (value != null && !value.isBlank()) {
+            properties.setProperty(key, value);
+        }
+    }
+}
