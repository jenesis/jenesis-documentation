@@ -0,0 +1,43 @@
+/*
+ * Copyright 2026 the original author or authors.
+ *
+ * All rights reserved. This program and the accompanying materials are
+ * made available under the terms of the Eclipse Public License v2.0 which
+ * accompanies this distribution and is available at
+ *
+ * https://www.eclipse.org/legal/epl-v20.html
+ */
+
+package org.junit.migration.exclusions;
+
+import java.util.Arrays;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+import org.junit.platform.engine.FilterResult;
+import org.junit.platform.engine.TestDescriptor;
+import org.junit.platform.engine.support.descriptor.MethodSource;
+import org.junit.platform.launcher.PostDiscoveryFilter;
+
+/**
+ * Leaves out of a run the test methods named by the system property
+ * {@code junit.migration.excludedTests}, as {@code <class name>#<method name>}.
+ */
+public final class ExcludedTestsFilter implements PostDiscoveryFilter {
+
+	private final Set<String> excluded = Arrays.stream(
+		System.getProperty("junit.migration.excludedTests", "").split(",")).map(String::trim).filter(
+			name -> !name.isEmpty()).collect(Collectors.toUnmodifiableSet());
+
+	@Override
+	public FilterResult apply(TestDescriptor descriptor) {
+		return descriptor.getSource() //
+				.filter(MethodSource.class::isInstance) //
+				.map(MethodSource.class::cast) //
+				.map(source -> source.getClassName() + "#" + source.getMethodName()) //
+				.filter(excluded::contains) //
+				.map(name -> FilterResult.excluded(name + " is excluded by junit.migration.excludedTests")) //
+				.orElseGet(() -> FilterResult.included("not excluded"));
+	}
+
+}
