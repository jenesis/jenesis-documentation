@@ -0,0 +1,31 @@
+package junitbuild.generator;
+
+import module build.jenesis;
+import module java.base;
+
+public class JteFactory implements BuildModuleFactory {
+
+    @Override
+    public BuildExecutorModule create(Environment environment,
+                                      SequencedMap<String, String> properties,
+                                      Permits permits,
+                                      String group,
+                                      Map<String, Repository> repositories,
+                                      Map<String, Resolver> resolvers) {
+        SequencedMap<String, String> values = new TreeMap<>();
+        for (Map.Entry<String, String> entry : properties.entrySet()) {
+            String key = entry.getKey();
+            int dot = key.lastIndexOf('.');
+            String name = dot == -1 ? key : key.substring(dot + 1);
+            if (!Set.of("maxVersion", "fileNamePrefix", "classNamePrefix").contains(name) || dot == -1) {
+                throw new IllegalArgumentException("The jte plugin takes no value " + key
+                        + ": name <input>.maxVersion, <input>.fileNamePrefix or <input>.classNamePrefix for a"
+                        + " templates input bound as @<input>=<folder>, beside @model=<jre.yaml> and @header=<file>");
+            }
+            values.put(key, entry.getValue());
+        }
+        return (executor, inherited) -> executor.addStep("jte",
+                new JteModule.Generate(values, Year.now().getValue(), 1),
+                inherited.sequencedKeySet());
+    }
+}
diff --git a/plugins/jte/junitbuild/generator/JteModule.java b/plugins/jte/junitbuild/generator/JteModule.java
new file mode 100644
index 0000000..2a5e3dd
--- /dev/null
+++ b/plugins/jte/junitbuild/generator/JteModule.java
@@ -0,0 +1,138 @@
+package junitbuild.generator;
+
+import module build.jenesis;
+import module java.base;
+
+import gg.jte.ContentType;
+import gg.jte.TemplateEngine;
+import gg.jte.output.FileOutput;
+import gg.jte.resolve.DirectoryCodeResolver;
+import junitbuild.generator.model.JRE;
+
+final class JteModule {
+
+    private static final int MIN_RUNTIME_VERSION = 17;
+    private static final Pattern VERSION = Pattern.compile("-\\s*version:\\s*(\\d+)\\s*"),
+            SINCE = Pattern.compile("\\s+since:\\s*'([^']*)'\\s*");
+
+    private JteModule() {
+    }
+
+    record Generate(SequencedMap<String, String> values, int year, int revision) implements BuildStep {
+
+        @Override
+        public CompletionStage<BuildStepResult> apply(Executor executor,
+                                                      BuildStepContext context,
+                                                      SequencedMap<String, BuildStepArgument> arguments)
+                throws IOException {
+            SequencedMap<String, Path> inputs = new LinkedHashMap<>();
+            for (Map.Entry<String, BuildStepArgument> argument : arguments.entrySet()) {
+                if (argument.getValue().removed()) {
+                    continue;
+                }
+                List<String> segments = List.of(argument.getKey().split("/"));
+                int index = segments.indexOf("inputs");
+                if (index != -1 && index + 1 < segments.size()) {
+                    inputs.put(segments.get(index + 1), argument.getValue().folder());
+                }
+            }
+            Path model = single(inputs, "model"), header = single(inputs, "header");
+            List<JRE> all = new ArrayList<>();
+            Integer version = null;
+            for (String line : Files.readAllLines(model)) {
+                Matcher matcher = VERSION.matcher(line);
+                if (matcher.matches()) {
+                    if (version != null) {
+                        all.add(new JRE(version, null));
+                    }
+                    version = Integer.parseInt(matcher.group(1));
+                    continue;
+                }
+                matcher = SINCE.matcher(line);
+                if (matcher.matches() && version != null) {
+                    all.add(new JRE(version, matcher.group(1)));
+                    version = null;
+                }
+            }
+            if (version != null) {
+                all.add(new JRE(version, null));
+            }
+            String licenseHeader = Files.readString(header).stripTrailing().replace("$YEAR", Integer.toString(year)) + "\n";
+            Path sources = Files.createDirectories(context.next().resolve(BuildStep.SOURCES));
+            Path classes = Files.createDirectories(context.supplement().resolve("jte-classes"));
+            List<String> classPath = Stream.of(TemplateEngine.class, DirectoryCodeResolver.class, JRE.class)
+                    .map(type -> {
+                        try {
+                            return Path.of(type.getProtectionDomain().getCodeSource().getLocation().toURI()).toString();
+                        } catch (URISyntaxException e) {
+                            throw new IllegalStateException(e);
+                        }
+                    })
+                    .distinct()
+                    .toList();
+            for (Map.Entry<String, Path> input : inputs.entrySet()) {
+                if (!input.getKey().startsWith("templates")) {
+                    continue;
+                }
+                String name = input.getKey();
+                Path templates = input.getValue();
+                List<JRE> jres = all;
+                String maxVersion = values.get(name + ".maxVersion");
+                if (maxVersion != null) {
+                    int max = Integer.parseInt(maxVersion.trim());
+                    jres = jres.stream().filter(jre -> jre.getVersion() <= max).toList();
+                }
+                List<JRE> supported = jres.stream().filter(jre -> jre.getVersion() >= MIN_RUNTIME_VERSION).toList();
+                Map<String, Object> parameters = new HashMap<>();
+                String classNamePrefix = values.get(name + ".classNamePrefix");
+                if (classNamePrefix != null) {
+                    parameters.put("classNamePrefix", classNamePrefix);
+                }
+                parameters.put("minRuntimeVersion", MIN_RUNTIME_VERSION);
+                parameters.put("allJres", jres);
+                parameters.put("supportedJres", supported);
+                parameters.put("supportedJresSortedByStringValue", supported.stream()
+                        .sorted(Comparator.comparing(jre -> Integer.toString(jre.getVersion())))
+                        .toList());
+                parameters.put("licenseHeader", licenseHeader);
+                TemplateEngine engine = TemplateEngine.create(new DirectoryCodeResolver(templates),
+                        Files.createDirectories(classes.resolve(name)),
+                        ContentType.Plain,
+                        JteModule.class.getClassLoader());
+                engine.setClassPath(classPath);
+                List<Path> files;
+                try (Stream<Path> walk = Files.walk(templates)) {
+                    files = walk.filter(file -> file.getFileName().toString().endsWith(".jte")).sorted().toList();
+                }
+                String fileNamePrefix = values.getOrDefault(name + ".fileNamePrefix", "");
+                for (Path file : files) {
+                    Path relative = templates.relativize(file);
+                    String fileName = relative.getFileName().toString();
+                    fileName = fileNamePrefix + fileName.substring(0, fileName.length() - ".jte".length());
+                    Path target = sources.resolve(relative).resolveSibling(fileName);
+                    Files.createDirectories(target.getParent());
+                    try (FileOutput output = new FileOutput(target)) {
+                        engine.render(relative.toString().replace(File.separatorChar, '/'), parameters, output);
+                    }
+                }
+            }
+            return CompletableFuture.completedStage(new BuildStepResult(true));
+        }
+
+        private static Path single(SequencedMap<String, Path> inputs, String name) throws IOException {
+            Path folder = inputs.get(name);
+            if (folder == null) {
+                throw new IllegalArgumentException("The jte plugin needs the input @" + name + "=<file>, found "
+                        + inputs.sequencedKeySet());
+            }
+            try (Stream<Path> files = Files.list(folder)) {
+                List<Path> found = files.filter(Files::isRegularFile).toList();
+                if (found.size() != 1) {
+                    throw new IllegalArgumentException("The input @" + name + " of the jte plugin holds " + found
+                            + " - bind exactly one file");
+                }
+                return found.getFirst();
+            }
+        }
+    }
+}
