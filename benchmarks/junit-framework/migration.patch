@@ -0,0 +1,59 @@
+package bnd;
+
+import module java.base;
+
+public final class BndDriver {
+
+    private BndDriver() {
+    }
+
+    @SuppressWarnings("unchecked")
+    public static int main(String[] arguments) throws Exception {
+        Class<?> jarType = Class.forName("aQute.bnd.osgi.Jar"), builderType = Class.forName("aQute.bnd.osgi.Builder");
+        Properties instructions = new Properties();
+        try (Reader reader = Files.newBufferedReader(Path.of(arguments[2]), StandardCharsets.UTF_8)) {
+            instructions.load(reader);
+        }
+        try (AutoCloseable builder = (AutoCloseable) builderType.getConstructor().newInstance()) {
+            builderType.getMethod("setBase", File.class).invoke(builder, new File(arguments[0]));
+            builderType.getMethod("setProperties", Properties.class).invoke(builder, instructions);
+            Object jar = jarType.getConstructor(String.class, File.class).newInstance("classes", new File(arguments[0]));
+            Map<String, ?> resources = (Map<String, ?>) jarType.getMethod("getResources").invoke(jar);
+            for (String name : new ArrayList<>(resources.keySet())) {
+                if (name.startsWith("META-INF/versions/")) {
+                    jarType.getMethod("remove", String.class).invoke(jar, name);
+                }
+            }
+            builderType.getMethod("setJar", jarType).invoke(builder, jar);
+            List<File> classPath = new ArrayList<>();
+            for (int index = 4; index < arguments.length; index++) {
+                classPath.add(new File(arguments[index]));
+            }
+            builderType.getMethod("setClasspath", File[].class).invoke(builder, (Object) classPath.toArray(File[]::new));
+            Object built = builderType.getMethod("build").invoke(builder);
+            Manifest manifest = (Manifest) jarType.getMethod("getManifest").invoke(built);
+            for (String warning : (List<String>) builderType.getMethod("getWarnings").invoke(builder)) {
+                System.err.println("warning: " + warning);
+            }
+            List<String> errors = (List<String>) builderType.getMethod("getErrors").invoke(builder);
+            for (String error : errors) {
+                System.err.println("error: " + error);
+            }
+            if (!errors.isEmpty() || manifest == null) {
+                return 1;
+            }
+            Manifest merged = new Manifest();
+            Path handed = Path.of(arguments[3]);
+            if (Files.isRegularFile(handed)) {
+                try (InputStream input = Files.newInputStream(handed)) {
+                    merged.read(input);
+                }
+            }
+            merged.getMainAttributes().putAll(manifest.getMainAttributes());
+            try (OutputStream output = Files.newOutputStream(Path.of(arguments[1]))) {
+                merged.write(output);
+            }
+            return 0;
+        }
+    }
+}
