diff --git a/.github/workflows/_jenesis.yml b/.github/workflows/_jenesis.yml
new file mode 100644
index 0000000..adbd40d
--- /dev/null
+++ b/.github/workflows/_jenesis.yml
@@ -0,0 +1,29 @@
+name: Jenesis build
+
+on:
+  workflow_call:
+
+permissions: {}
+
+jobs:
+  jenesis:
+    name: Jenesis (${{ matrix.os }})
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ ubuntu-latest, windows-latest, macos-latest ]
+    runs-on: ${{ matrix.os }}
+    permissions:
+      contents: read
+    steps:
+      - name: Check out repository
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - name: Set up JDK 25
+        uses: actions/setup-java@b843ebf9b913146b38da2eaa7aeddf76074ae1ad # v6.1.0
+        with:
+          distribution: temurin
+          java-version: 25
+      - name: Build, test and stage with Jenesis
+        run: java -Djenesis.dependency.pin=strict -Djenesis.make.profiles=release build/jenesis/Make.java stage
