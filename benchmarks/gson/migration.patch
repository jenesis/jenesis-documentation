--- /dev/null
+++ b/plugins/templating/templating/TemplatingModule.java
@@ -0,0 +1,63 @@
+package templating;
+
+import module build.jenesis;
+import module java.base;
+
+public class TemplatingModule implements BuildExecutorModule {
+
+    private static final String TEMPLATES = "../inputs/templates";
+    private static final Pattern PLACEHOLDER = Pattern.compile("\\$\\{project\\.([a-zA-Z]+)}");
+
+    @Override
+    public void accept(BuildExecutor executor, SequencedMap<String, Path> inherited) {
+        executor.addStep("templating", new Filter(), inherited.sequencedKeySet());
+    }
+
+    private record Filter() implements BuildStep {
+
+        @Override
+        public CompletionStage<BuildStepResult> apply(Executor executor,
+                                                      BuildStepContext context,
+                                                      SequencedMap<String, BuildStepArgument> arguments)
+                throws IOException {
+            BuildStepArgument templates = arguments.get(TEMPLATES);
+            if (templates == null || templates.removed()) {
+                throw new IllegalStateException("Bind the folder of templates as @templates=<folder> in "
+                        + "plugin-templates.properties");
+            }
+            SequencedSet<Path> folders = new LinkedHashSet<>();
+            arguments.values().stream().filter(argument -> !argument.removed())
+                    .forEach(argument -> folders.add(argument.folder()));
+            Path metadataFile = BuildStep.locate(folders, BuildStep.METADATA);
+            if (metadataFile == null) {
+                throw new IllegalStateException("No " + BuildStep.METADATA + " among the arguments of the templating step");
+            }
+            Properties metadata = new Properties();
+            try (Reader reader = Files.newBufferedReader(metadataFile)) {
+                metadata.load(reader);
+            }
+            Path root = templates.folder(), target = context.next().resolve(BuildStep.SOURCES);
+            try (Stream<Path> files = Files.walk(root)) {
+                for (Path file : files.filter(Files::isRegularFile).sorted().toList()) {
+                    String text = Files.readString(file);
+                    Matcher matcher = PLACEHOLDER.matcher(text);
+                    StringBuilder filtered = new StringBuilder();
+                    while (matcher.find()) {
+                        String value = metadata.getProperty(matcher.group(1));
+                        if (value == null) {
+                            throw new IllegalStateException("Template " + root.relativize(file) + " names ${project."
+                                    + matcher.group(1) + "}, which the module's metadata does not hold: "
+                                    + new TreeSet<>(metadata.stringPropertyNames()));
+                        }
+                        matcher.appendReplacement(filtered, Matcher.quoteReplacement(value));
+                    }
+                    matcher.appendTail(filtered);
+                    Path written = target.resolve(root.relativize(file).toString());
+                    Files.createDirectories(written.getParent());
+                    Files.writeString(written, filtered);
+                }
+            }
+            return CompletableFuture.completedStage(new BuildStepResult(true));
+        }
+    }
+}
