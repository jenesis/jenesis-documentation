@@ -0,0 +1,21 @@
+package bnd;
+
+import module build.jenesis;
+import module java.base;
+
+public class BndFactory implements BuildModuleFactory {
+
+    @Override
+    public BuildExecutorModule create(Environment environment,
+                                      SequencedMap<String, String> properties,
+                                      Permits permits,
+                                      String group,
+                                      Map<String, Repository> repositories,
+                                      Map<String, Resolver> resolvers) {
+        if (!properties.isEmpty()) {
+            throw new IllegalArgumentException("The bnd plugin takes no values but its @instructions input, which"
+                    + " binds the bnd file, not " + properties.sequencedKeySet());
+        }
+        return new BndModule(environment, permits, group + ":tool", repositories, resolvers);
+    }
+}
