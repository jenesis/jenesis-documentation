+package templating;
+
+import module build.jenesis;
+import module java.base;
+
+public class TemplatingFactory implements BuildModuleFactory {
+
+    @Override
+    public BuildExecutorModule create(Environment environment,
+                                      SequencedMap<String, String> properties,
+                                      Permits permits,
+                                      String group,
+                                      Map<String, Repository> repositories,
+                                      Map<String, Resolver> resolvers) {
+        if (!properties.isEmpty()) {
+            throw new IllegalArgumentException("The templating plugin takes no values but the @templates input, not "
+                    + properties.sequencedKeySet());
+        }
+        return new TemplatingModule();
+    }
+}
