diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index c74c55c..0ad5d53 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -54,6 +54,23 @@ jobs:
         # This also runs javadoc:jar to detect any issues with the Javadoc generated during release
         run: mvn verify javadoc:jar ${{ matrix.extra-mvn-args || '' }}
 
+  # Build, test and stage with Jenesis (build/jenesis), beside the Maven build until it is retired
+  build-jenesis:
+    name: "Build with Jenesis on JDK 25"
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
+        with:
+          persist-credentials: false
+      - name: Set up JDK
+        uses: actions/setup-java@de7274f081f381c8f8158605e0321c36c376e2e6  # v6.0.1
+        with:
+          distribution: 'temurin'
+          java-version: 25
+      - name: Build with Jenesis
+        # The release profile adds the sources and javadoc jars, which `mvn verify javadoc:jar` checks above
+        run: java -Djenesis.dependency.pin=strict -Djenesis.make.profiles=release build/jenesis/Make.java stage
+
   # Build a subset of the Gson API, see also https://github.com/google/gson/pull/2946
   build-gson-subset:
     name: Build Gson subset
