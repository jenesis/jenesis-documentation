+package bnd;
+
+import module build.jenesis;
+import module java.base;
+
+import build.jenesis.step.Dependencies;
+import build.jenesis.step.ProcessBuildStep;
+import build.jenesis.step.ProcessHandler;
+
+public class BndModule implements BuildExecutorModule {
+
+    private static final String REQUIRED = "required", DEPENDENCIES = "dependencies", INSTRUCTIONS = "../inputs/instructions";
+    private static final String MAVEN_GROUP = "biz.aQute.bnd", MAVEN_ARTIFACT = "biz.aQute.bndlib";
+    private static final Pattern TOKEN = Pattern.compile("[A-Za-z0-9_.-]+");
+
+    private final Dependencies dependencies;
+    private final Pinning pinning;
+    private final String tool;
+    private final ProcessBuildStep.Terms terms;
+
+    public BndModule(Environment environment,
+                     Permits permits,
+                     String tool,
+                     Map<String, Repository> repositories,
+                     Map<String, Resolver> resolvers) {
+        dependencies = Dependencies.ofEnvironment(environment, repositories, resolvers);
+        pinning = Pinning.ofEnvironment(environment);
+        this.tool = tool;
+        terms = ProcessBuildStep.Terms.ofEnvironment(environment, "bnd").permits(permits);
+    }
+
+    @Override
+    public void accept(BuildExecutor executor, SequencedMap<String, Path> inherited) {
+        executor.addStep(REQUIRED, new Requires(tool), inherited.sequencedKeySet());
+        SequencedSet<String> resolveInputs = new LinkedHashSet<>();
+        resolveInputs.add(REQUIRED);
+        resolveInputs.addAll(inherited.sequencedKeySet());
+        executor.addModule(DEPENDENCIES, dependencies.pinning(pinning).group(tool), resolveInputs);
+        SequencedSet<String> inputs = new LinkedHashSet<>(inherited.sequencedKeySet());
+        inputs.add(DEPENDENCIES);
+        executor.addStep("bnd", new Bnd(terms, tool), inputs);
+    }
+
+    private record Requires(String tool) implements BuildStep {
+
+        @Override
+        public boolean shouldRun(SequencedMap<String, BuildStepArgument> arguments) {
+            return false;
+        }
+
+        @Override
+        public CompletionStage<BuildStepResult> apply(Executor executor,
+                                                      BuildStepContext context,
+                                                      SequencedMap<String, BuildStepArgument> arguments)
+                throws IOException {
+            SequencedProperties requires = new SequencedProperties();
+            requires.setProperty(tool + "/runtime/maven/" + MAVEN_GROUP + "/" + MAVEN_ARTIFACT + "/RELEASE", "");
+            requires.store(context.next().resolve(BuildStep.REQUIRES));
+            return CompletableFuture.completedStage(new BuildStepResult(true));
+        }
+    }
+
+    private static class Bnd extends ProcessBuildStep {
+
+        private static final long serialVersionUID = 1L;
+
+        private final String tool;
+
+        private Bnd(ProcessBuildStep.Terms terms, String tool) {
+            super("bnd", ProcessHandler.OfProcess.ofJavaMain(), terms);
+            this.tool = tool;
+        }
+
+        @Override
+        public CompletionStage<List<String>> process(Executor executor,
+                                                     BuildStepContext context,
+                                                     SequencedMap<String, BuildStepArgument> arguments,
+                                                     SequencedMap<String, SequencedMap<String, String>> properties)
+                throws IOException {
+            BuildStepArgument classes = arguments.firstEntry().getValue();
+            BuildStepArgument bound = arguments.get(INSTRUCTIONS);
+            if (bound == null || bound.removed()) {
+                throw new IllegalStateException("Bind the bnd file as @instructions/bnd.bnd=<file> in plugin-bnd.properties");
+            }
+            Path file = bound.folder().resolve("bnd.bnd");
+            if (!Files.isRegularFile(file)) {
+                throw new IllegalStateException("No bnd.bnd in the @instructions input - bind it as"
+                        + " @instructions/bnd.bnd=<file>");
+            }
+            List<String> jars = new ArrayList<>(), classPath = new ArrayList<>();
+            SequencedSet<Path> folders = new LinkedHashSet<>();
+            for (BuildStepArgument argument : arguments.values()) {
+                if (argument.removed()) {
+                    continue;
+                }
+                folders.add(argument.folder());
+                for (Path jar : Dependencies.select(argument.folder(), tool, "runtime")) {
+                    jars.add(jar.toString());
+                }
+                for (Path jar : Dependencies.select(argument.folder(), "main", "compile")) {
+                    classPath.add(jar.toString());
+                }
+            }
+            if (jars.isEmpty()) {
+                throw new IllegalStateException("No bnd jars resolved upstream of the bnd step");
+            }
+            Properties metadata = new Properties();
+            Path metadataFile = BuildStep.locate(folders, BuildStep.METADATA);
+            if (metadataFile != null) {
+                try (Reader reader = Files.newBufferedReader(metadataFile)) {
+                    metadata.load(reader);
+                }
+            }
+            Properties instructions = new Properties();
+            try (Reader reader = Files.newBufferedReader(file, StandardCharsets.UTF_8)) {
+                instructions.load(reader);
+            }
+            metadata.stringPropertyNames().forEach(key -> instructions.setProperty("project." + key, metadata.getProperty(key)));
+            instructions.putIfAbsent("-reproducible", "true");
+            instructions.putIfAbsent("-noextraheaders", "true");
+            putIfPresent(instructions, "Bundle-Name", metadata.getProperty("name"));
+            String version = metadata.getProperty("version");
+            putIfPresent(instructions, "Bundle-Version", version == null ? null : osgi(version));
+            if (version != null) {
+                instructions.putIfAbsent("-snapshot", version.endsWith("-SNAPSHOT") ? "SNAPSHOT" : "${tstamp}");
+            }
+            putIfPresent(instructions, "Bundle-Description", metadata.getProperty("description"));
+            putIfPresent(instructions, "Bundle-Vendor", metadata.getProperty("organization.name"));
+            putIfPresent(instructions, "Bundle-DocURL", metadata.getProperty("url"));
+            putIfPresent(instructions, "Bundle-License", licenses(metadata));
+            putIfPresent(instructions, "Bundle-SCM", scm(metadata));
+            putIfPresent(instructions, "Bundle-Developers", developers(metadata));
+            Path merged = context.supplement().resolve("bnd.properties");
+            try (Writer writer = Files.newBufferedWriter(merged, StandardCharsets.UTF_8)) {
+                instructions.store(writer, null);
+            }
+            List<String> commands = new ArrayList<>(List.of(
+                    "-cp",
+                    ProcessHandler.OfProcess.driver(BndDriver.class) + File.pathSeparator
+                            + String.join(File.pathSeparator, jars),
+                    BndDriver.class.getName(),
+                    classes.folder().resolve(BuildStep.CLASSES).toString(),
+                    context.next().resolve("manifest.mf").toString(),
+                    merged.toString(),
+                    classes.folder().resolve("manifest.mf").toString()));
+            commands.addAll(classPath);
+            return CompletableFuture.completedStage(commands);
+        }
+
+        private static String osgi(String version) {
+            int dash = version.indexOf('-');
+            String base = dash < 0 ? version : version.substring(0, dash), qualifier = dash < 0 ? "" : version.substring(dash + 1);
+            List<String> segments = new ArrayList<>(List.of(base.split("\\.")));
+            if (segments.size() > 3 || !segments.stream().allMatch(segment -> segment.matches("[0-9]+"))) {
+                return version;
+            }
+            while (segments.size() < 3) {
+                segments.add("0");
+            }
+            String osgi = String.join(".", segments);
+            return qualifier.isEmpty() ? osgi : osgi + "." + qualifier.replaceAll("[^A-Za-z0-9_-]", "_");
+        }
+
+        private static void putIfPresent(Properties instructions, String key, String value) {
+            if (value != null && !value.isBlank()) {
+                instructions.putIfAbsent(key, value);
+            }
+        }
+
+        private static String quoted(String value) {
+            return TOKEN.matcher(value).matches() ? value : "\"" + value.replace("\"", "\\\"") + "\"";
+        }
+
+        private static SortedSet<String> ids(Properties metadata, String prefix) {
+            SortedSet<String> ids = new TreeSet<>();
+            for (String key : metadata.stringPropertyNames()) {
+                if (key.startsWith(prefix)) {
+                    ids.add(key.substring(prefix.length(), key.indexOf('.', prefix.length())));
+                }
+            }
+            return ids;
+        }
+
+        private static String licenses(Properties metadata) {
+            List<String> clauses = new ArrayList<>();
+            for (String id : ids(metadata, "license.")) {
+                String name = metadata.getProperty("license." + id + ".name"), url = metadata.getProperty("license." + id + ".url");
+                StringBuilder clause = new StringBuilder("\"").append(name == null ? url : name).append("\"");
+                if (url != null) {
+                    clause.append(";link=").append(quoted(url));
+                }
+                clauses.add(clause.toString());
+            }
+            return String.join(",", clauses);
+        }
+
+        private static String scm(Properties metadata) {
+            List<String> attributes = new ArrayList<>();
+            for (String[] pair : new String[][] {{"url", "url"}, {"connection", "connection"},
+                    {"developerConnection", "developer-connection"}, {"tag", "tag"}}) {
+                String value = metadata.getProperty("scm." + pair[0]);
+                if (value != null) {
+                    attributes.add(pair[1] + "=" + quoted(value));
+                }
+            }
+            return String.join(",", attributes);
+        }
+
+        private static String developers(Properties metadata) {
+            List<String> clauses = new ArrayList<>();
+            for (String id : ids(metadata, "developer.")) {
+                String developerId = metadata.getProperty("developer." + id + ".id");
+                if (developerId == null) {
+                    continue;
+                }
+                StringBuilder clause = new StringBuilder(quoted(developerId));
+                for (String key : List.of("email", "name", "organization", "organizationUrl", "roles", "timezone")) {
+                    String value = metadata.getProperty("developer." + id + "." + key);
+                    if (value != null) {
+                        clause.append(';').append(key).append('=').append(quoted(value));
+                    }
+                }
+                clauses.add(clause.toString());
+            }
+            return String.join(",", clauses);
+        }
+    }
+}
