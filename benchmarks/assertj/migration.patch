+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.assertj.build.bnd;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.URL;
+import java.net.URLClassLoader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Properties;
+import java.util.SequencedMap;
+import java.util.TreeMap;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionStage;
+import java.util.concurrent.Executor;
+import java.util.jar.Manifest;
+
+import build.jenesis.BuildStep;
+import build.jenesis.BuildStepArgument;
+import build.jenesis.BuildStepContext;
+import build.jenesis.BuildStepResult;
+import build.jenesis.step.Dependencies;
+
+/**
+ * Computes the OSGi manifest of the compiled classes with bnd's Builder, as bnd-maven-plugin does: the instructions
+ * are the values of plugin-bnd.properties, the Bundle-* headers come from the module's metadata.
+ */
+record BndManifest(String group, TreeMap<String, String> instructions) implements BuildStep {
+
+  private static final long serialVersionUID = 1L;
+
+  @Override
+  public CompletionStage<BuildStepResult> apply(Executor executor, BuildStepContext context,
+                                                SequencedMap<String, BuildStepArgument> arguments) throws IOException {
+    var folders = new LinkedHashSet<Path>();
+    arguments.values().stream().filter(argument -> !argument.removed()).forEach(argument -> folders.add(argument.folder()));
+    Path classes = arguments.firstEntry().getValue().folder();
+    var metadata = new LinkedHashMap<String, String>();
+    Path metadataFile = BuildStep.locate(folders, BuildStep.METADATA);
+    if (metadataFile != null) {
+      try (var reader = Files.newBufferedReader(metadataFile, StandardCharsets.UTF_8)) {
+        new Properties() {
+          @Override
+          public synchronized Object put(Object key, Object value) {
+            return metadata.put(key.toString(), value.toString());
+          }
+        }.load(reader);
+      }
+    }
+    var tool = Dependencies.paths(arguments, group + ":tool", "plugin");
+    if (tool.isEmpty()) {
+      throw new IllegalStateException("bnd is not resolved - name it as <!--jenesis.plugin " + group
+                                      + ":tool maven/biz.aQute.bnd/biz.aQute.bndlib/<version>--> in the module's pom.xml");
+    }
+    var classpath = new ArrayList<File>();
+    for (Path jar : Dependencies.paths(arguments, "main", "compile")) classpath.add(jar.toFile());
+    var properties = new Properties();
+    headers(metadata, properties);
+    properties.putAll(instructions);
+    var urls = new ArrayList<URL>();
+    for (Path jar : tool) urls.add(jar.toUri().toURL());
+    Manifest manifest;
+    try (var loader = new URLClassLoader(urls.toArray(URL[]::new), ClassLoader.getPlatformClassLoader())) {
+      Class<?> builderType = loader.loadClass("aQute.bnd.osgi.Builder");
+      Object builder = builderType.getConstructor().newInstance();
+      try {
+        builderType.getMethod("setProperties", Properties.class).invoke(builder, properties);
+        builderType.getMethod("setJar", File.class).invoke(builder, classes.resolve(BuildStep.CLASSES).toFile());
+        for (File jar : classpath) builderType.getMethod("addClasspath", File.class).invoke(builder, jar);
+        manifest = (Manifest) builderType.getMethod("calcManifest").invoke(builder);
+        @SuppressWarnings("unchecked")
+        List<String> errors = (List<String>) builderType.getMethod("getErrors").invoke(builder);
+        @SuppressWarnings("unchecked")
+        List<String> warnings = (List<String>) builderType.getMethod("getWarnings").invoke(builder);
+        if (!errors.isEmpty()) {
+          throw new IllegalStateException("bnd failed to compute the OSGi manifest: " + errors + " " + warnings);
+        }
+      } finally {
+        builderType.getMethod("close").invoke(builder);
+      }
+    } catch (ReflectiveOperationException e) {
+      throw new IllegalStateException("Cannot run bnd's Builder", e);
+    }
+    Path handed = classes.resolve("manifest.mf");
+    if (Files.exists(handed)) {
+      try (InputStream in = Files.newInputStream(handed)) {
+        new Manifest(in).getMainAttributes().forEach(manifest.getMainAttributes()::putIfAbsent);
+      }
+    }
+    try (OutputStream out = Files.newOutputStream(context.next().resolve("manifest.mf"))) {
+      manifest.write(out);
+    }
+    return CompletableFuture.completedStage(new BuildStepResult(true));
+  }
+
+  private static void headers(Map<String, String> metadata, Properties properties) {
+    put(properties, "Bundle-SymbolicName", metadata.get("artifact"));
+    String version = metadata.get("version");
+    if (version != null) put(properties, "Bundle-Version", version.replaceFirst("-", "."));
+    put(properties, "Bundle-Name", metadata.get("name"));
+    put(properties, "Bundle-Description", metadata.get("description"));
+    put(properties, "Bundle-Vendor", metadata.get("organization.name"));
+    put(properties, "Bundle-DocURL", metadata.get("url"));
+    var licenses = new ArrayList<String>();
+    var developers = new ArrayList<String>();
+    for (String key : metadata.keySet()) {
+      if (key.startsWith("license.") && key.endsWith(".name")) {
+        String id = key.substring("license.".length(), key.length() - ".name".length());
+        String url = metadata.get("license." + id + ".url");
+        licenses.add(metadata.get(key) + (url == null ? "" : ";link=\"" + url + "\""));
+      }
+    }
+    var ids = new LinkedHashSet<String>();
+    for (String name : metadata.keySet()) {
+      if (name.startsWith("developer.")) ids.add(name.substring("developer.".length(), name.lastIndexOf('.')));
+    }
+    for (String id : ids) {
+      var developer = new StringBuilder(id);
+      append(developer, ";", "email", metadata.get("developer." + id + ".email"));
+      append(developer, ";", "name", metadata.get("developer." + id + ".name"));
+      append(developer, ";", "organization", metadata.get("developer." + id + ".organization"));
+      append(developer, ";", "roles", metadata.get("developer." + id + ".roles"));
+      developers.add(developer.toString());
+    }
+    if (!licenses.isEmpty()) put(properties, "Bundle-License", String.join(",", licenses));
+    if (!developers.isEmpty()) put(properties, "Bundle-Developers", String.join(",", developers));
+    var scm = new StringBuilder();
+    append(scm, ",", "url", metadata.get("scm.url"));
+    append(scm, ",", "connection", metadata.get("scm.connection"));
+    append(scm, ",", "developer-connection", metadata.get("scm.developerConnection"));
+    append(scm, ",", "tag", metadata.get("scm.tag"));
+    if (!scm.isEmpty()) put(properties, "Bundle-SCM", scm.toString());
+  }
+
+  private static void append(StringBuilder builder, String separator, String key, String value) {
+    if (value == null || value.isBlank()) return;
+    if (!builder.isEmpty()) builder.append(separator);
+    builder.append(key).append("=\"").append(value).append('"');
+  }
+
+  private static void put(Properties properties, String key, String value) {
+    if (value != null && !value.isBlank()) properties.setProperty(key, value);
+  }
+}
