@@ -0,0 +1,79 @@
+package replacer;
+
+import module build.jenesis;
+import module java.base;
+
+public class ReplacerModule implements BuildExecutorModule {
+
+    static final Map<String, String> PROJECT = Map.of(
+            "projectgroupid", "project",
+            "projectartifactid", "artifact",
+            "projectversion", "version");
+    private static final String TEMPLATES = "../inputs/template";
+    private static final Pattern PLACEHOLDER = Pattern.compile("@([A-Za-z0-9_.-]+)@");
+
+    private final TreeMap<String, String> tokens;
+
+    public ReplacerModule(TreeMap<String, String> tokens) {
+        this.tokens = tokens;
+    }
+
+    @Override
+    public void accept(BuildExecutor executor, SequencedMap<String, Path> inherited) {
+        executor.addStep("replace", new Replace(tokens), inherited.sequencedKeySet());
+    }
+
+    private record Replace(TreeMap<String, String> tokens) implements BuildStep {
+
+        @Override
+        public CompletionStage<BuildStepResult> apply(Executor executor,
+                                                      BuildStepContext context,
+                                                      SequencedMap<String, BuildStepArgument> arguments)
+                throws IOException {
+            BuildStepArgument templates = arguments.get(TEMPLATES);
+            if (templates == null || templates.removed()) {
+                throw new IllegalStateException("Bind each template as @template/<path of the source>=<template file>"
+                        + " in plugin-replacer.properties");
+            }
+            SequencedSet<Path> folders = new LinkedHashSet<>();
+            arguments.values().stream().filter(argument -> !argument.removed())
+                    .forEach(argument -> folders.add(argument.folder()));
+            Path metadataFile = BuildStep.locate(folders, BuildStep.METADATA);
+            if (metadataFile == null) {
+                throw new IllegalStateException("No " + BuildStep.METADATA + " among the arguments of the replace step");
+            }
+            Properties metadata = new Properties();
+            try (Reader reader = Files.newBufferedReader(metadataFile)) {
+                metadata.load(reader);
+            }
+            Map<String, String> values = new TreeMap<>(tokens);
+            PROJECT.forEach((token, key) -> {
+                String value = metadata.getProperty(key);
+                if (value != null) {
+                    values.put(token, value);
+                }
+            });
+            Path root = templates.folder(), target = context.next().resolve(BuildStep.SOURCES);
+            try (Stream<Path> files = Files.walk(root)) {
+                for (Path file : files.filter(Files::isRegularFile).sorted().toList()) {
+                    Matcher matcher = PLACEHOLDER.matcher(Files.readString(file));
+                    StringBuilder replaced = new StringBuilder();
+                    while (matcher.find()) {
+                        String value = values.get(matcher.group(1));
+                        if (value == null) {
+                            throw new IllegalStateException("Template " + root.relativize(file) + " names @"
+                                    + matcher.group(1) + "@, which is neither a value of plugin-replacer.properties"
+                                    + " nor one of " + PROJECT.keySet() + ": " + values.keySet());
+                        }
+                        matcher.appendReplacement(replaced, Matcher.quoteReplacement(value));
+                    }
+                    matcher.appendTail(replaced);
+                    Path written = target.resolve(root.relativize(file).toString());
+                    Files.createDirectories(written.getParent());
+                    Files.writeString(written, replaced);
+                }
+            }
+            return CompletableFuture.completedStage(new BuildStepResult(true));
+        }
+    }
+}
