diff --git a/src/main/build.jenesis/bnd.bnd b/src/main/build.jenesis/bnd.bnd
new file mode 100644
index 0000000..e4c6eef
--- /dev/null
+++ b/src/main/build.jenesis/bnd.bnd
@@ -0,0 +1,19 @@
+# The OSGi manifest maven-bundle-plugin writes from the instructions of jackson-base and
+# jackson-parent (osgi.export, osgi.import and the pom's metadata), read by the bnd plugin
+# of plugins/bnd; the plugin adds Bundle-Version, Bundle-Vendor and Bundle-License.
+-removeheaders: Include-Resource,Private-Package,JAVA_1_3_HOME,JAVA_1_4_HOME,JAVA_1_5_HOME,JAVA_1_6_HOME,JAVA_1_7_HOME
+-versionpolicy: ${range;[===,=+);${@}}
+
+Bundle-Name: jackson-databind
+Bundle-SymbolicName: tools.jackson.core.jackson-databind
+Bundle-DocURL: https://github.com/FasterXML/jackson
+Export-Package: tools.jackson.databind.*;version=${Bundle-Version}
+# fix for databind#2299: using jackson-databind in an OSGi environment under Android
+Import-Package: org.w3c.dom.bootstrap;resolution:=optional, *
+
+X-Compile-Source-JDK: 17
+X-Compile-Target-JDK: 17
+Implementation-Vendor-Id: ${project.project}
+Specification-Title: ${project.artifact}
+Specification-Version: ${project.version}
+Specification-Vendor: ${project.organization.name}
