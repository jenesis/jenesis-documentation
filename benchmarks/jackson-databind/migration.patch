+package replacer;
+
+import module build.jenesis;
+import module java.base;
+
+public class ReplacerFactory implements BuildModuleFactory {
+
+    private static final Pattern TOKEN = Pattern.compile("[A-Za-z0-9_.-]+");
+
+    @Override
+    public BuildExecutorModule create(Environment environment,
+                                      SequencedMap<String, String> properties,
+                                      Permits permits,
+                                      String group,
+                                      Map<String, Repository> repositories,
+                                      Map<String, Resolver> resolvers) {
+        for (String token : properties.sequencedKeySet()) {
+            if (!TOKEN.matcher(token).matches()) {
+                throw new IllegalArgumentException("A value of the replacer plugin names a token @<token>@ by letters,"
+                        + " digits, '_', '.' and '-' alone, not " + token);
+            }
+            if (ReplacerModule.PROJECT.containsKey(token)) {
+                throw new IllegalArgumentException("The token " + token + " is the module's own "
+                        + ReplacerModule.PROJECT.get(token) + " and cannot be set");
+            }
+        }
+        return new ReplacerModule(new TreeMap<>(properties));
+    }
+}
